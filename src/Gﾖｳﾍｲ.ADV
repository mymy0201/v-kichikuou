		\L_00a36:
		\L_009e2:
		ZH 1:
		'Cecil.'
		\L_00b07:
		\L_00afa:
		\L_00a52:
		ZH 1:
		'Cecil「À... Milli.」'
		R
		'Milli「Cô đi đâu thế?」'
		\L_00b07:
		\L_00afa:
		\L_00a52:
		ZH 1:
		'Việc của tôi ở đây xong rồi,'
		R
		'giờ đi tìm việc mới...'
		\L_00b07:
		\L_00afa:
		\L_009e2:
		ZH 1:
		'Thế à...'
		\L_00b07:
		ZH 1:
		'Mong là chúng ta sẽ không'
		R
		'thành kẻ địch.'
		\L_00b07:
		ZH 1:
		'Đối đầu với cô thì tôi chịu'
		R
		'không nổi đâu.'
		\L_00b07:
		\L_00afa:
		\L_00a52:
		ZH 1:
		'Hì hì... Tôi cũng vậy thôi.'
		R
		'Hẹn gặp lại...'
		\L_00b07:
		\L_00afa:
		\L_009e2:
		ZH 1:
		'Ừ, bảo trọng nhé.'
		\L_00b07:
		\L_00afa:
	}
	\L_00a1a:
	ZH 1:
	'Cecil rời thành Leazas.'
