		\L_01056:
		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến Cái gì?'
		\L_01143:
		\L_01136:
		\L_01056:
		ZH 1:
		'Hanty đến theo lệnh'
		R
		'triệu tập của Rance.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Này... Ngươi còn'
		R
		'trinh phải không? Vì tinh'
		R
		'thể của ngươi có màu đỏ.'
		\L_01143:
		ZH 1:
		'Ta thích cách Kalar khiến'
		R
		'mọi việc trở nên thuận tiện.'
		\L_01143:
		ZH 1:
		'Ngươi có thể nói chỉ'
		R
		'bằng cách nhìn. Gahahahaha!'
		\L_01143:
		ZH 1:
		'aha. không'
		R
		'có gì lạ khi một Kalar'
		R
		'có trinh tiết của nàng.'
		\L_01143:
		ZH 1:
		'Bảo vệ nó là'
		R
		'điều quan trọng nhất'
		R
		'đối với một Kalar.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Điều đó không đúng với'
		R
		'phụ nữ loài người sao?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Tôi đâu có ý đó!'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Dù sao thì, ta'
		R
		'cho rằng ngươi đang'
		R
		'đưa nó cho Patton.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Đồ ngốc!!!!!'
		\L_01143:
		\L_01136:
		\L_010f0:
		\L_010c6:
		ZH 1:
		'Hanty hét lên và giận dữ bỏ đi.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'... Ta có đúng không...?'
		\L_01143:
		\L_01136:
		!VAR0516 : 6!
		\L_010e2:
		\L_0108e:
		ZH 1:
		'Nàng không có ý'
		R
		'định có mối quan hệ'
		R
		'như Vậy với Patton.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Hanty nói với cô thế à?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Không.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Vậy làm thế'
		R
		'nào để ngươi biết?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Chỉ là cảm'
		\L_01143:
		ZH 1:
		'giác...'
		\L_01143:
		ZH 1:
		'Có người đàn ông khiến mình'
		R
		'muốn giữ quan hệ như vậy'
		R
		'cũng đâu lạ...'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ta không hiểu.'
		\L_01143:
		ZH 1:
		'Thế là tốt. Người mà hiểu'
		R
		'được, thần sẽ gọi thầy thuốc'
		R
		'ngay.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ngươi đang khen ta'
		R
		'hay đang xúc phạm ta?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Chẳng phải khen hay chê'
		R
		'đâu... Hì hì...'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Hừm! Phụ nữ luôn'
		R
		'nhanh chóng tập hợp và xúc'
		R
		'phạm đàn ông... Thật thô lỗ.'
		\L_01143:
		\L_01136:
		!VAR0516 : 0!
