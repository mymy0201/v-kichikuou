		\L_010e2:
		\L_01056:
		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến Muốn'
		R
		'một cái gì đó với tôi?'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Vâng... Ta muốn'
		R
		'hỏi điều gì đó.'
		\L_01143:
		ZH 1:
		'Ngươi có thực'
		R
		'sự thích Patton không?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'............'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Nếu không thì'
		R
		'ngươi nên đến gặp ta. Ta'
		R
		'sẽ đối xử tốt với ngươi.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Nếu tôi nói tôi thích'
		R
		'Patton, cậu sẽ bỏ cuộc chứ?'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Người tốt không cố chấp.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Tôi hiểu rồi...'
		\L_01143:
		ZH 1:
		'Tôi muốn nếu'
		R
		'cậu bỏ cuộc, vậy thì...'
		R
		'đó là những gì tôi nghĩ.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Vâng, Sau đó...'
		\L_01143:
		ZH 1:
		'Ít nhất hãy để anh được'
		R
		'quan hệ với em một lần nhé.'
		\L_01143:
		ZH 1:
		'Ta sẽ đưa ngươi'
		R
		'lên thiên đường. Gahahahaha!'
		\L_01143:
		ZH 1:
		'haha.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Kể cả khi'
		R
		'nó giết chết tôi.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ngay cả khi điều đó'
		R
		'có nghĩa là sẽ có chuyện'
		R
		'gì đó xảy ra với Patton?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Sau đó, Tôi sẽ'
		R
		'Đưa Patton và rời đi!'
		\L_01143:
		\L_01136:
		\L_010f0:
		!VAR0516 : 6!
		\L_010e2:
		\L_0108e:
		ZH 1:
		'Vua Rance...'
		\L_01143:
		\L_01136:
		\L_01056:
		ZH 1:
		'Maris thì thầm với Rance.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Dựa trên điều'
		R
		'tra của tôi, nàng có khả'
		R
		'năng dịch chuyển tức thời.'
		\L_01143:
		ZH 1:
		'vì vậy, nàng'
		R
		'rất có thể bỏ chạy nếu có'
		R
		'bất cứ điều gì xảy ra...'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Điều đó không tốt...'
		\L_01143:
		ZH 1:
		'vì vậy, ngay bây giờ,'
		\L_01143:
		ZH 1:
		'ta không nghĩ rằng nó sẽ'
		R
		'là một ý tưởng tốt để làm'
		\L_01143:
		ZH 1:
		'cho một kẻ thù của Quân'
		R
		'Đội Của Hoàng Tử Patton...'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ừm.'
		\L_01143:
		ZH 1:
		'Hanty.'
		\L_01143:
		\L_01136:
		\L_010f0:
		!VAR0516 : 424!
		\L_010e2:
		\L_0108e:
		ZH 1:
		'Cái gì?'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ta chỉ đùa thôi.'
		R
		'Ta chỉ muốn điều tra xem'
		R
		'ngươi nghĩ gì về Patton.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Tôi không phải'
		R
		'là người thích những'
		R
		'trò đùa khó chịu.'
		\L_01143:
		ZH 1:
		'Tôi muốn cậu đừng'
		R
		'kiểm tra tôi như thế.'
		\L_01143:
		ZH 1:
		'Suy nghĩ của tôi về'
		R
		'Patton không phải là điều mà'
		R
		'mọi người có thể hiểu được.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Chà, Ta là một anh'
		R
		'hùng, vì vậy ta có thể hiểu.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'............'
		\L_01143:
		\L_01136:
		\L_010f0:
		\L_010c6:
		ZH 1:
		'Hanty nhanh chóng rời khỏi phòng'
		R
		'ngai vàng mà không nói một lời.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Này, đợi đã! Ai nói'
		R
		'ngươi có thể rời đi?!!'
		\L_01143:
		\L_01136:
		!VAR0516 : 6!
		\L_010e2:
		\L_0108e:
		ZH 1:
		'Vua Rance...'
		\L_01143:
		ZH 1:
		'Chẳng phải nàng đã nói'
		R
		'rõ ràng rằng nàng sẽ không'
		R
		'nói về cảm xúc của mình sao?'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Chết tiệt...'
		R
		'Nàng thực sự là một cô'
		R
		'nàng tomboy! Grrr...'
		\L_01143:
