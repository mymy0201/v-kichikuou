		\L_01072:
		!VAR0516 : 424!
		\L_010e2:
		\L_01056:
		ZM 32:
		ZH 1:
		'Thành Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến. Cậu tìm tôi'
		R
		'có việc gì?'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ừ, muốn hỏi một chuyện.'
		\L_01143:
		ZH 1:
		'Cô thật lòng yêu Patton sao?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'............'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Nếu không thì theo ta. Ta sẽ'
		R
		'quý trọng cô.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Nếu tôi yêu Patton thì cậu'
		R
		'chịu bỏ cuộc dễ dàng sao?'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Đàn ông tốt đâu ép buộc phụ'
		R
		'nữ.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Vậy...'
		\L_01143:
		ZH 1:
		'Hanty「Vậy mong cậu bỏ'
		R
		'cuộc.」 Rance「Biết ngay'
		R
		'mà.」'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Vâng, Sau đó...'
		\L_01143:
		ZH 1:
		'Ít nhất hãy để anh được'
		R
		'quan hệ với em một lần nhé.'
		\L_01143:
		ZH 1:
		'Ta sẽ đưa ngươi'
		R
		'lên thiên đường. Gahahahaha!'
		\L_01143:
		ZH 1:
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Chết cũng không.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ngay cả khi điều đó'
		R
		'có nghĩa là sẽ có chuyện'
		R
		'gì đó xảy ra với Patton?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Sau đó, Tôi sẽ'
		R
		'Đưa Patton và rời đi!'
		\L_01143:
		\L_01136:
		\L_010f0:
		!VAR0516 : 6!
		\L_010e2:
		\L_0108e:
		ZH 1:
		'Bệ hạ Rance...'
		\L_01143:
		\L_01136:
		\L_01056:
		ZH 1:
		'Maris thì thầm với Rance.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Theo điều tra, cô ấy có khả'
		R
		'năng dịch chuyển tức thời.'
		\L_01143:
		ZH 1:
		'Dù xảy ra chuyện gì cũng có'
		R
		'thể trốn đi...'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Phiền thật...'
		\L_01143:
		ZH 1:
		'Vì thế lúc này,'
		\L_01143:
		ZH 1:
		'để quân ngài Patton trở'
		R
		'thành'
		\L_01143:
		ZH 1:
		'kẻ thù sẽ bất lợi cho chúng'
		R
		'ta...'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ừm.'
		\L_01143:
		ZH 1:
		'Hanty.'
		\L_01143:
		\L_01136:
		\L_010f0:
		!VAR0516 : 424!
		\L_010e2:
		\L_0108e:
		ZH 1:
		'Cái gì?'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Vừa rồi là nói dối. Ta chỉ'
		R
		'thử xem cô nghĩ gì về'
		R
		'Patton.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Tôi không thích đùa ác. Đừng'
		R
		'thử'
		\L_01143:
		ZH 1:
		'lòng như thế. Tình cảm tôi'
		\L_01143:
		ZH 1:
		'dành cho Patton... con người'
		R
		'chẳng hiểu được đâu.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ta là anh hùng mà, ta hiểu'
		R
		'được đấy.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'............'
		\L_01143:
		\L_01136:
		\L_010f0:
		\L_010c6:
		ZH 1:
		'Không nói thêm lời nào,'
		R
		'Hanty rảo bước rời trước'
		R
		'ngai vàng.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Này! Ai cho cô đi hả?!'
		\L_01143:
		\L_01136:
		!VAR0516 : 6!
		\L_010e2:
		\L_0108e:
		ZH 1:
		'Bệ hạ Rance...'
		\L_01143:
		ZH 1:
		'Chẳng phải cô ấy đã tỏ rõ'
		R
		'rằng không muốn nói về tình'
		R
		'cảm sao...?'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Thật tình... Đúng là cô nàng'
		R
		'ngỗ nghịch! Lẩm bẩm...'
		\L_01143:
		\L_01136:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
