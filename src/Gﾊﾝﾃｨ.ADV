		\L_01136:
		\L_0108e:
		ZH 1:
		'Không giống nhau đâu!'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Dù sao thì, ta'
		R
		'cho rằng ngươi đang'
		R
		'đưa nó cho Patton.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Đồ ngốc!!!!!'
		\L_01143:
		\L_01136:
		\L_010f0:
		\L_010c6:
		ZH 1:
		'Hanty hét lên và giận dữ bỏ đi.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'... Ta có đúng không...?'
		\L_01143:
		\L_01136:
		!VAR0516 : 6!
		\L_010e2:
		\L_0108e:
		ZH 1:
		'Nàng không có ý'
		R
		'định có mối quan hệ'
		R
		'như Vậy với Patton.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ngươi có nghe điều'
		R
		'đó từ Hanty không?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Không.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Vậy làm thế'
		R
		'nào để ngươi biết?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Tôi chỉ...'
		\L_01143:
		ZH 1:
		'biết.'
		\L_01143:
		ZH 1:
		'Ngay cả với những người muốn'
		R
		'có những mối quan hệ như'
		R
		'vậy cũng không có gì lạ...'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ta không hiểu. đó là tốt.'
		\L_01143:
		ZH 1:
		'Nếu ngươi nói rằng'
		R
		'ngươi đã nhận được nó, ta'
		R
		'sẽ gọi bác sĩ ngay lập tức.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ngươi đang khen ta'
		R
		'hay đang xúc phạm ta?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Cũng không... Heh...'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Hừm! Phụ nữ luôn'
		R
		'nhanh chóng tập hợp và xúc'
		R
		'phạm đàn ông... Thật thô lỗ.'
