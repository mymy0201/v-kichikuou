		ZH 1:
		'Tôi không quan tâm.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Chẳng ích gì khi nói'
		R
		'về hôn nhân với một loài'
		\L_01143:
		ZH 1:
		'có thể biến mất khỏi'
		R
		'thế giới bất cứ lúc nào.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Ngươi đang nói'
		R
		'về sự thức tỉnh...?'
		\L_01143:
		ZH 1:
		'Điều đó có thể khiến việc'
		R
		'trở thành một người vợ tốt'
		R
		'trở nên khó khăn, đúng vậy.'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Chuyện là vậy đó.'
		\L_01143:
		ZH 1:
		'... Tuy nhiên tôi'
		R
		'cũng có chút vui mừng.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Về cái gì?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'Tôi thực sự thích những'
		R
		'từ “Tôi không quan tâm.”'
		R
		'Ừm? Điều đó có gì tuyệt vời?'
		\L_01143:
		\L_01136:
		\L_0108e:
		ZH 1:
		'... Patton sẽ nói điều'
		R
		'tương tự khi hắn còn nhỏ...'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'............'
		\L_01143:
		ZH 1:
		'Anh sẽ không bao giờ'
		R
		'nói lại điều đó khi có em ở'
		R
		'bên. thật là một kẻ ngốc...'
		\L_01143:
		ZH 1:
		'Làm bất cứ'
		R
		'điều gì ngươi muốn.'
		\L_01143:
		\L_01136:
		\L_0101e:
		ZH 1:
		'Hừm, ta sẽ làm vậy.'
		\L_01143:
		\L_01136:
		\L_010f0:
		!VAR0516 : 6!
		\L_010e2:
		\L_010aa:
		ZH 1:
		'... Đứa trẻ...'
		\L_01143:
		\L_01136:
		!VAR0516 : 0!
