	ZM 24:
	ZH 1:
	R
	'Phòng ngủ của Rance Rance'
	R
	'cau mày trong khi tự nghĩ.'
	\L_013d1:
	\L_013c4:
	\L_012ac:
	ZH 1:
	'Được rồi.'
	\L_013d1:
	\L_013c4:
	\L_012e4:
	ZH 1:
	'Anh ta đập đầu gối...'
	\L_013d1:
	\L_013c4:
	\L_012ac:
	ZH 1:
	'Ai đó, gọi Elisabeth đi.'
	\L_013d1:
	\L_013c4:
	\L_012e4:
	ZH 1:
	'Rance đợi Elisabeth.'
	\L_013d1:
	ZH 1:
	'Vậy thì...'
