		\L_053ed:
		ZH 1:
		'Rance gọi quân của mình.'
		\L_054da:
		\L_054cd:
		!VAR0516 : 471!
		\L_05479:
		\L_05425:
		ZH 1:
		'Vâng, nó là gì?'
		\L_054da:
		\L_054cd:
		\L_053b5:
		ZH 1:
		'Ta sẽ nghỉ ngơi'
		R
		'ở đây một chút.'
		\L_054da:
		ZH 1:
		'Các ngươi tìm kiếm xung'
		R
		'quanh thêm một chút nữa.'
		\L_054da:
		ZH 1:
		'Tuy nhiên!'
		\L_054da:
		ZH 1:
		'Làm điều đó một cách'
		R
		'lặng lẽ để ngươi không'
		\L_054da:
		ZH 1:
		'giết chết tâm trạng của'
		R
		'ta khi ta đang nghỉ ngơi.'
		\L_054da:
		ZH 1:
		'Nếu ta nghe thấy bất'
		R
		'cứ điều gì thì tất cả các'
		R
		'người sẽ bị xử tử. Hiểu rồi?'
		\L_054da:
		\L_054cd:
		\L_05425:
		ZH 1:
		'N-Nhưng áo giáp của'
		R
		'chúng tôi phát ra tiếng động'
		R
		'khi chúng tôi di chuyển!'
		\L_054da:
		\L_054cd:
		\L_053b5:
		ZH 1:
		'Im đi. Khi ta bảo'
		R
		'ngươi làm điều gì đó, ngươi'
		R
		'làm điều đó. Bây giờ đi!'
		\L_054da:
		\L_054cd:
		\L_05425:
		ZH 1:
		'Y-Vâng! tất cả'
