		'quân đội đều nhón chân'
		R
		'sâu hơn vào hang động.'
		\L_054da:
		\L_054cd:
		\L_053d1:
		ZH 1:
		'Bây giờ... ta'
		R
		'sẽ làm điều này.'
		\L_054da:
	}
	\L_054cd:
	\L_05417:
	\L_053ed:
	ZH 1:
	'Rance kéo xác của Orochi'
	R
	'vào bóng tối để giấu nó.'
	\L_054da:
