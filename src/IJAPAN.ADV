		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance đến một căn'
		R
		'phòng sâu bất thường'
		R
		'bên trong lâu đài.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Đây...?'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance cắt xuyên qua'
		R
		'cánh cửa trượt rực lửa'
		R
		'chỉ bằng một cú xoay.'
		\L_077a5:
		\L_07798:
