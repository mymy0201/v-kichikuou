	'kiểm soát của gia đình Oda.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 420!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Hoh...'
	\L_077a5:
	ZH 1:
	'Thế thì thiếp xin lỗi vì'
