		\L_07744:
		\L_07680:
		ZH 1:
		'Lê-...'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance nhìn thấy'
		R
		'Leila trong hình dạng'
		R
		'hoàn toàn thay đổi.'
		\L_077a5:
		ZH 1:
		'Hắn không nói nên lời.'
		\L_077a5:
		ZH 1:
		'Nước mắt dâng lên trong'
