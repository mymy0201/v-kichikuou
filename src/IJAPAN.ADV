	'Biểu cảm'
	R
	'của Nobunaga hoàn toàn'
	R
	'chuyển sang nghiêm túc.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Chiến tranh làm cho nhân'
	R
	'dân đau khổ. Có vô số trẻ'
	R
	'mồ côi xung quanh lâu đài...'
	\L_077a5:
	ZH 1:
	'Chúng ta chưa có'
	R
	'đủ sao? Đất nước này có'
	R
	'rất nhiều thứ riêng...'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'... Ừm.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Nobunaga giả vờ'
	R
	'không nhìn thấy đôi'
	R
	'mắt cầu xin của Kou,'
	\L_077a5:
	ZH 1:
	'như thể hắn không thể'
	R
	'chịu nổi khi nhìn vào chúng.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Được rồi. Lần'
	R
	'này ta sẽ cố gắng không'
	R
	'để chiến tranh kéo dài.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Cha... Có vẻ như cha'
	R
	'sẽ không ngừng chiến đấu.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Kou cúi đầu'
	R
	'và cúi xuống sàn.'
	\L_077a5:
	ZH 1:
	'Trong khi cô'
	R
	'lặng lẽ khóc, Nobunaga'
	R
	'nói với cô từ phía sau.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Ngươi ơi, ta phải'
	R
	'bảo vệ đất nước này.'
	\L_077a5:
	ZH 1:
	'Đối với tất cả những người'
	R
	'đã chết trong các cuộc chiến'
	R
	'trước đây của chúng ta.'
	\L_077a5:
	ZH 1:
	'Chúng ta không thể'
	R
	'để người nước ngoài trên'
	\L_077a5:
	ZH 1:
	'lục địa có được những'
	R
	'ngọn núi và dòng sông này.'
	\L_077a5:
	ZH 1:
	'Những cánh đồng'
	R
	'và ngôi làng này...'
	\L_077a5:
	ZH 1:
	'Ta không bảo'
	R
	'ngươi phải hiểu.'
	\L_077a5:
	ZH 1:
	'Tất cả những gì ngươi'
	R
	'cần làm là cầu nguyện'
	R
	'cho sự an toàn của ta.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Nobunaga để lại cho Kou'
	R
	'những lời đó và đứng dậy.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Thưa cha, cha'
	R
	'đi đâu vậy...?'
	\L_077a5:
	{VAR0326 \ 1:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ta sẽ chuẩn'
		R
		'bị cho chiến tranh.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'... Con hy vọng sự'
		R
		'an toàn của cha, thưa Cha.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ừm.'
		\L_077a5:
	}
	{VAR0326 = 1:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ta nên kiểm tra'
		R
		'cô gái đó trước khi'
		R
		'chiến tranh bắt đầu.'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Kou cứng người vì'
		R
		'sốc. Nobunaga mở cánh'
		R
		'cửa trượt trong phòng.'
		\L_077a5:
		\L_07798:
		\L_076e2:
		\L_07752:
		\L_076b8:
		ZH 1:
		'Hắn đi qua một số cửa trượt'
		R
		'để đến một căn phòng nhất định.'
		\L_077a5:
		ZH 1:
		'Đó là một căn phòng trống rỗng đến kinh ngạc.'
		\L_077a5:
		ZH 1:
		'Đơn sơ như nhà tù, nhưng chỉ'
		R
		'có một lối vào và lối ra.'
		\L_077a5:
		ZH 1:
		'Ngoài cánh cửa Nobunaga mở ra,'
		R
		'thậm chí còn không có cửa sổ.'
		\L_077a5:
		ZH 1:
		'Ở một góc phòng là thứ mà Nobunaga tìm đến.'
		\L_077a5:
		\L_07798:
		!VAR0516 : 417!
		\L_076d4:
		!VAR0516 : 30!
		\L_07744:
		\L_07680:
		ZH 1:
		'Ta mong đợi'
		R
		'không kém nữ kiếm sĩ'
		R
		'giỏi nhất của Leazas.'
		\L_077a5:
		ZH 1:
		'Việc mang thai'
		R
		'đứa con của ta vẫn chưa'
		R
		'khiến ngươi phát điên.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'...'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Đó là Leila, giờ'
		R
		'đã hoàn toàn khác.'
		\L_077a5:
		ZH 1:
		'Cái bụng'
		R
		'khó coi của cô phình ra và'
		R
		'khuôn mặt trông hốc hác.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ngươi đang'
		R
		'buồn về điều gì vậy? Đó là'
		R
		'nơi vợ sinh con cho chồng.'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Nobunaga cười toe toét.'
		\L_077a5:
		ZH 1:
		'Khi hắn làm vậy, cái'
		R
		'bụng căng phồng của Leila'
		R
		'cử động một cách kỳ lạ.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'...!'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ôi, một đứa trẻ khá năng'
		R
		'động. Ta chắc rằng bây giờ'
		R
		'ngươi đã quen với nó rồi.'
		\L_077a5:
		ZH 1:
		'Trước đây nó khá tệ.'
		\L_077a5:
		ZH 1:
		'Lúc đầu, ngươi đã cố gắng'
		R
		'tự sát bằng cách cắn đứt'
		R
		'lưỡi hoặc đập đầu vào cột.'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Nếu nhìn kỹ,'
		R
		'ngươi có thể thấy một số vết'
		R
		'sẹo nhẹ trên trán của Leila.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'...'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Bây giờ ta đã'
		R
		'cắt lưỡi của ngươi và'
		R
		'lính canh sẽ ngăn cản'
		\L_077a5:
		ZH 1:
		'ngươi nếu ngươi cố đập'
		R
		'đầu vào bất cứ thứ gì.'
		\L_077a5:
		ZH 1:
		'Em không cần phải'
		R
		'lo lắng gì cả, cứ nuôi con'
		R
		'của anh trong bụng em đi.'
		\L_077a5:
		ZH 1:
		'Đừng mổ bụng'
		R
		'cho đến lúc đó.'
		\L_077a5:
		ZH 1:
		'Haahahahahah!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Leila trừng mắt'
		R
		'nhìn Nobunaga trong'
		R
		'khi hắn cười lớn.'
		\L_077a5:
		\L_07798:
		\L_0770c:
		ZH 1:
		'Tôi đã trở'
		R
		'thành vợ của người đàn'
		R
		'ông này cho Leazas.'
		\L_077a5:
		ZH 1:
		'Nhưng đối'
		R
		'với anh, phụ nữ chỉ là nơi'
		R
		'gieo hạt giống của anh...'
		\L_077a5:
		ZH 1:
		'Người đàn ông này...'
		\L_077a5:
		ZH 1:
		'Không, anh ta thậm chí'
		R
		'còn không phải là con người.'
		R
		'Anh ta là một con quỷ!'
		\L_077a5:
		ZH 1:
		'Tôi đã bị cưỡng hiếp...'
		\L_077a5:
		ZH 1:
		'Thậm chí không phải thế,'
		R
		'chỉ là cấy vào bên trong,'
		R
		'và trong vòng một tuần,'
		\L_077a5:
		ZH 1:
		'bụng tôi sưng lên!'
		\L_077a5:
		ZH 1:
		'Và mỗi khi đứa trẻ này'
		R
		'di chuyển trong tôi, cơn đau'
		R
		'lại chạy khắp cơ thể tôi...'
		\L_077a5:
		ZH 1:
		'Bên trong tôi'
		R
		'là gì vậy? Cái gì đang'
		R
		'ăn mòn cơ thể tôi vậy?!'
		\L_077a5:
		ZH 1:
		'Tôi sợ hãi và đã nhiều'
		R
		'lần nghĩ đến việc tự sát,'
		\L_077a5:
		ZH 1:
		'nhưng mọi nỗ lực của'
		R
		'tôi đều bị dừng lại...'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Leila trừng'
		R
		'mắt nhìn Nobunaga, nhưng'
		R
		'sau đó chán nản cúi đầu.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Leila?... Hm,'
		R
		'mất ý thức rồi.'
		\L_077a5:
		ZH 1:
		'Hãy sinh con cho'
		R
		'ta. Ta sẽ để ngươi'
		R
		'sống cho đến lúc đó.'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Nobunaga cười'
		R
		'vào bụng Leila. Bụng cô lại'
		R
		'quằn quại một cách kỳ lạ.'
		\L_077a5:
	}
	\L_07798:
	\L_076e2:
	\L_07752:
	\L_0778a:
	%0:
*L_03fe6:
	!VAR0516 : 0!
	%#M.ADV:
	!VAR0158 : 55!
	!VAR0045 : VAR0142!
	!VAR0046 : VAR0143!
	!VAR0516 : 1!
	%#M.ADV:
	!VAR0043 : VAR0045!
	!VAR0044 : VAR0046!
	!VAR0516 : 10!
	%#M.ADV:
	!VAR0516 : 1005!
	\L_0777c:
	SS 13:
	\L_076b8:
	ZM 32:
	ZH 1:
	'NHẬT BẢN'
	R
	ZM 24:
	ZH 1:
	R
	'Nagasaki Nagasaki.'
	\L_077a5:
	ZH 1:
	'Là thành phố duy nhất ở NHẬT BẢN nối'
	\L_077a5:
	ZH 1:
	'liền với lục địa nên nơi đây luôn nhộn nhịp.'
	\L_077a5:
	ZH 1:
	'Nhưng lúc này, thành phố đang bao'
	R
	'phủ trong một sự im lặng khác thường.'
	\L_077a5:
	ZH 1:
	'Không có ai ở trên đường phố.'
	\L_077a5:
	ZH 1:
	'Không có gì thắc mắc tại sao.'
	\L_077a5:
	ZH 1:
	'Trong vài giờ nữa, thành phố'
	R
	'sẽ trở thành chiến trường.'
	\L_077a5:
	ZH 1:
	'Bộ chỉ huy quân sự NHẬT BẢN.'
	\L_077a5:
	ZH 1:
	'Hai vị tướng túc trực để bảo vệ'
	R
	'Nagasaki khỏi cuộc tấn công của Leazas.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 420!
	\L_076d4:
	\L_07680:
	ZH 1:
	'Những kẻ ngu ngốc'
	R
	'đến từ lục địa...'
	\L_077a5:
	ZH 1:
	'Họ không được'
	R
	'phép biết vị trí của mình'
	R
	'nếu họ tấn công chúng ta.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 24!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Katsuie, đừng mất'
	R
	'cảnh giác. Theo cảnh báo thì'
	R
	'họ đã đi qua cầu Tenma rồi.'
	\L_077a5:
	ZH 1:
	'Chỉ còn là vấn đề'
	R
	'thời gian cho đến khi'
	R
	'chúng xuất hiện ở đây.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Người khiển trách'
	R
	'Katsuie là một người phụ nữ'
	R
	'mang theo một cây cung lớn.'
	\L_077a5:
	ZH 1:
	'Ở NHẬT BẢN, việc phụ nữ'
	R
	'sử dụng vũ khí để chiến đấu'
	R
	'là điều hết sức bất thường.'
	\L_077a5:
	ZH 1:
	'Nhưng vị tướng'
	R
	'này, Isoroku Yamamoto,'
	\L_077a5:
	ZH 1:
	'đã được trao quyền'
	R
	'kiểm soát quân đội mặc'
	R
	'dù thân phận là phụ nữ.'
	\L_077a5:
	ZH 1:
	'Ở NHẬT BẢN,'
	R
	'đó là một hiện tượng hiếm'
	R
	'hoi gần như một phép lạ.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Hừm...'
	\L_077a5:
	ZH 1:
	'Chẳng có gì'
	R
	'phải sợ cả, Isoroku.'
	\L_077a5:
	ZH 1:
	'Ngươi có nghĩ tôi,'
	R
	'Katsuie, sẽ tụt lại phía'
	R
	'sau những kẻ ngốc đó không?'
	\L_077a5:
	ZH 1:
	'Cậu có thể'
	R
	'đứng lùi lại và xem'
	R
	'nếu muốn, Isoroku.'
	\L_077a5:
	ZH 1:
	'Chỗ của phụ nữ'
	R
	'là cầu nguyện cho sự'
	R
	'bình an của đàn ông.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Đừng đánh giá thấp thiếp!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Isoroku gạt'
	R
	'tay Katsuie mà anh đã đặt'
	R
	'lên vai cô từ lúc nào đó.'
	\L_077a5:
	ZH 1:
	'Sau đó,'
	\L_077a5:
	ZH 1:
	'cô trừng mắt nhìn khuôn'
	R
	'mặt đồi trụy của Katsuie'
	R
	'với ánh mắt hung bạo.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Vẫn bướng'
	R
	'bỉnh như ngày nào.'
	\L_077a5:
	ZH 1:
	'Với ngoại hình giống'
	R
	'của ngươi, ngươi sẽ có thể'
	R
	'có được một daimyo tử tế.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Isoroku mặc quần áo tương'
	R
	'tự như của nam giới vì chúng'
	R
	'giúp di chuyển dễ dàng hơn,'
	\L_077a5:
	ZH 1:
	'nhưng nó lại phản tác dụng'
	R
	'vào những lúc như thế này.'
	\L_077a5:
	ZH 1:
	'Cánh tay mảnh'
	R
	'khảnh và phần ngực'
	R
	'lộ ra dưới ánh nắng.'
	\L_077a5:
	ZH 1:
	'Họ có một sự'
	R
	'tròn trịa đầy nữ tính.'
	\L_077a5:
	ZH 1:
	'Katsuie nhìn chằm'
	R
	'chằm vào những phần này'
	R
	'một cách thô lỗ khi nói.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Ngươi có cơ thể của'
	R
	'một công chúa, nhưng để'
	R
	'hồi sinh gia đình mình,'
	\L_077a5:
	ZH 1:
	'ngươi phải cầm kiếm...'
	\L_077a5:
	ZH 1:
	'Hoặc cung. Khá gì đó.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Ngài có ý xúc'
	R
	'phạm thiếp phải không?'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Tôi định khen ngợi ngươi.'
	R
	'Ngươi là một người ấn tượng,'
	R
	'không giống phụ nữ chút nào.'
	\L_077a5:
	ZH 1:
	'Chúa công'
	R
	'không chỉ đơn giản biến'
	\L_077a5:
	ZH 1:
	'ngươi thành một vị'
	R
	'tướng như một trò đùa.'
	\L_077a5:
	ZH 1:
	'Tôi cũng thừa nhận'
	R
	'kỹ năng của ngươi.'
	\L_077a5:
	ZH 1:
	'Chỉ tiếc là bố'
	R
	'ngươi không bằng một'
	R
	'nửa con người ngươi.'
	\L_077a5:
	ZH 1:
	'Nếu vậy thì gia'
	R
	'đình Yamamoto sẽ ổn thôi.'
	\L_077a5:
	ZH 1:
	'Ngươi có thể đang'
	R
	'tận hưởng cuộc sống của một'
	R
	'người phụ nữ ngay bây giờ.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Katsuie thậm chí còn không'
	R
	'thèm che giấu sự khinh bỉ'
	R
	'trong tiếng cười của mình.'
	\L_077a5:
	ZH 1:
	'Isoroku hạ người'
	R
	'xuống tư thế ngay lập tức.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Đừng xúc phạm thiếp'
	R
	'nữa, nếu không thiếp sẽ...!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Ánh mắt của Isoroku có'
	R
	'thể sẽ khiến một người đàn'
	R
	'ông bình thường phải sợ hãi.'
	\L_077a5:
	ZH 1:
	'Nhưng Katsuie lại tỏ'
	R
	'ra như không có chuyện gì.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Ngươi sẽ làm gì?'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Giết ngài!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Isoroku rút thanh'
	R
	'katana ra khỏi vỏ ở hông.'
	\L_077a5:
	ZH 1:
	'Gahshiiiiin...'
	\L_077a5:
	ZH 1:
	'Thanh katana rơi'
	R
	'xuống đất. Isoroku đang quỳ,'
	R
	'hai tay chống xuống đất.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Đánh ngươi bằng'
	R
	'lưng kiếm của ta. Có lẽ'
	R
	'để lại một vết bầm tím.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Katsuie đã có lúc'
	R
	'rút thanh katana của mình'
	R
	'ra. Anh đang nhìn xuống cô.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Vậy, Isoroku,'
	R
	'trở thành người phụ'
	R
	'nữ của tôi thì sao?'
	\L_077a5:
	ZH 1:
	'Thậm chí có thể đưa cậu'
	R
	'đến gần hơn với việc khôi'
	\L_077a5:
	ZH 1:
	'phục gia đình nếu tôi'
	R
	'hỏi Chúa công.'
	\L_077a5:
	ZH 1:
	'Ít nhất,'
	\L_077a5:
	ZH 1:
	'lựa chọn tốt hơn cho'
	R
	'ngươi là cố gắng sử dụng'
	\L_077a5:
	ZH 1:
	'thanh katana mà ngươi'
	R
	'thực sự không thể sử dụng.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Isoroku cắn môi'
	R
	'và không trả lời.'
	\L_077a5:
	\L_07798:
	\L_0770c:
	ZH 1:
	'Thiếp...'
	\L_077a5:
	\L_07798:
	!VAR0516 : 418!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Tướng quân Katsuie, Tướng'
	R
	'quân Isoroku! Họ đang đến!'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Họ đến rồi à?!'
	R
	'Giết tất cả những người'
	R
	'nước ngoài bẩn thỉu!'
	\L_077a5:
	\L_07798:
	\L_07752:
	\L_076b8:
	ZH 1:
	'Katsuie tra thanh katana của mình'
	R
	'vào bao, quay người và đi ra ngoài.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 24!
	\L_07744:
	\L_07680:
	ZH 1:
	'Isoroku... Nếu ngươi'
	R
	'muốn giết ta, hãy nhắm vào'
	R
	'lưng ta bằng cây cung đó.'
	\L_077a5:
	ZH 1:
	'Với kỹ năng bắn'
	R
	'cung của ngươi, nó sẽ không'
	R
	'gây khó khăn gì phải không?'
	\L_077a5:
	ZH 1:
	'Tức là, nếu ngươi đủ'
	R
	'can đảm và hèn hạ để bắn sau'
	R
	'lưng ai đó! Gahahahaha!hah!'
	\L_077a5:
	\L_07798:
	\L_076e2:
	\L_076b8:
	ZH 1:
	'Isoroku nhìn chằm chằm'
	R
	'vào lưng Katsuie một cách'
	\L_077a5:
	ZH 1:
	'đầy căm ghét khi anh'
	R
	'ta cười lớn và bỏ đi.'
	\L_077a5:
	\L_07798:
	\L_0770c:
	ZH 1:
	'Bây giờ thiếp chỉ nên'
	R
	'nghĩ về cuộc chiến thôi...'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Isoroku lắc đầu'
	R
	'mạnh mẽ và đứng dậy.'
	\L_077a5:
	ZH 1:
	'Cô nhặt thanh katana bị'
	R
	'rơi và trả nó lại bên mình.'
	\L_077a5:
	\L_07798:
	\L_0770c:
	ZH 1:
	'Ngay lúc này...'
	R
	'Tất cả những gì thiếp có'
	R
	'thể làm là chiến đấu...'
	\L_077a5:
	\L_07798:
	\L_07752:
	\L_0778a:
