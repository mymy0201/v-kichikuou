*L_072ab:
	!VAR0516 : 1005!
	\L_0777c:
	\L_076b8:
	ZM 32:
	ZH 1:
	'Lâu đài Osaka'
	R
	ZM 24:
	ZH 1:
	R
	'Tháp lâu đài Chúa tể của lâu'
	R
	'đài Osaka ở trong tháp lâu đài.'
	\L_077a5:
	ZH 1:
	'Hắn đang ở trong một tâm trạng tồi tệ hiếm thấy.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 417!
	\L_076d4:
	\L_07680:
	ZH 1:
	'Còn những người theo'
	R
	'chủ nghĩa Tenshi thì sao?'
	\L_077a5:
	\L_07798:
	!VAR0516 : 418!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Tôi tìm thấy'
	R
	'một nhóm tiếp tục'
	R
	'thách thức chúng tôi,'
	\L_077a5:
	ZH 1:
	'vì vậy tôi đã'
	R
	'ra lệnh cho cấp dưới của'
	R
	'mình giết hết bọn chúng.'
	\L_077a5:
	ZH 1:
	'Nhiều người trong số'
	R
	'họ sợ rằng họ sẽ xuống'
	\L_077a5:
	ZH 1:
	'Địa ngục nếu giết'
	R
	'một linh mục Tenshi...'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Giết chúng.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Vâng,'
	\L_077a5:
	ZH 1:
	'nhiều binh lính của tôi'
	R
	'không tuân theo lời dạy của'
	\L_077a5:
	ZH 1:
	'Tenshiism và chặt các'
	R
	'nhà sư thành từng mảnh...'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Không, ta đang nói'
	R
	'là giết những kẻ hèn nhát'
	R
	'sợ phải xuống Địa ngục.'
	\L_077a5:
	ZH 1:
	'Ngươi sẽ không'
	R
	'xuống Địa ngục'
	\L_077a5:
	ZH 1:
	'cho dù ngươi có giết bao'
	R
	'nhiêu linh mục đi chăng nữa.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'N-Nhưng đó là một'
	R
	'hình phạt quá tàn bạo!'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Hãy nói với'
	R
	'toàn quân điều này.'
	\L_077a5:
	ZH 1:
	'Ta, Nobunaga,'
	\L_077a5:
	ZH 1:
	'sẽ dạy cho bất cứ'
	R
	'ai theo tôn giáo ngu ngốc'
	R
	'đó ý nghĩa của Địa ngục.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Vâng. Vậy'
	R
	'thì những người lính'
	R
	'kể trên phải là...'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'（Toukichirou） Được rồi.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Toukichirou nói,'
	\L_077a5:
	ZH 1:
	'“Giết chúng.” Vị'
	R
	'tướng cúi đầu không nói'
	R
	'gì rồi rời khỏi phòng.'
	\L_077a5:
	\L_07798:
	\L_0769c:
	ZH 1:
	'Hừm... Lũ'
	R
	'Tenshi chết tiệt...'
	\L_077a5:
	ZH 1:
	'Ngay khi cuộc chiến'
	R
	'với Leazas bắt đầu, họ nhân'
	R
	'cơ hội này để rao giảng...'
	\L_077a5:
	ZH 1:
	'Không chỉ vậy...'
	\L_077a5:
	ZH 1:
	'Họ còn đang che giấu'
	R
	'điều gì đó. Nếu không thì họ'
	R
	'không thể phản đối ta...'
	\L_077a5:
	ZH 1:
	'đến mức này.'
	\L_077a5:
	ZH 1:
	'Chẳng lẽ họ'
	R
	'biết về cơ thể ta?'
	\L_077a5:
	ZH 1:
	'Có thể...'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Nobunaga nhìn'
	R
	'xuống và tự nhủ.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'（Toukichirou） Ôi...'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Con khỉ trên vai Nobunaga'
	R
	'lo lắng liếc nhìn mặt hắn.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Đừng lo lắng, Toukichirou.'
	\L_077a5:
	ZH 1:
	'Nếu chúng ta'
	R
	'giết hết bọn chúng thì sẽ'
	R
	'không còn vấn đề gì nữa.'
	\L_077a5:
	ZH 1:
	'Khi ta phục hồi'
	R
	'hoàn toàn cơ thể,'
	\L_077a5:
	ZH 1:
	'ta không cần phải'
	R
	'bận tâm đến một quốc gia'
	R
	'nhỏ bé như NHẬT BẢN nữa...'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Nobunaga nhìn ra cửa sổ'
	R
	'lục địa ở phía tây. Bầu trời'
	R
	'đỏ rực trong ánh hoàng hôn.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Hãy đợi ta nhé, lục địa.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Đôi mắt của'
	R
	'Nobunaga đỏ rực.'
	\L_077a5:
	ZH 1:
	'Nó có màu'
	R
	'đỏ sống động đến mức rõ ràng'
	R
	'không phải chỉ vì hoàng hôn.'
	\L_077a5:
	\L_07798:
	\L_076e2:
