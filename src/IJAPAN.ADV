	\L_0777c:
	SS 14:
	\L_076b8:
	ZM 32:
	ZH 1:
	'Ōsaka'
	R
	ZM 24:
	ZH 1:
	R
	'Lâu đài Osaka Hòn'
	R
	'đảo nổi nằm ở phía đông lục'
	R
	'địa được gọi là NHẬT BẢN.'
	\L_077a5:
	ZH 1:
	'Osaka là một thành'
	R
	'phố gần trung tâm của nó.'
	\L_077a5:
	ZH 1:
	'Tại thành phố đó,'
	\L_077a5:
	ZH 1:
	'có một vị chỉ huy đã dễ dàng'
	R
	'chinh phục được nhiều quốc'
	R
	'gia bị chiến tranh tàn phá.'
	\L_077a5:
	ZH 1:
	'Đó là người đàn ông đang'
	R
	'cố gắng thống nhất NHẬT BẢN.'
	R
	'Tên ông ấy là Nobunaga Oda.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 417!
	\L_076d4:
	\L_07680:
	ZH 1:
	'Hohoh... Rance,'
	R
	'ngươi nói vậy.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 418!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Có.'
	\L_077a5:
	ZH 1:
	'Anh ta đã chinh phục hầu'
	R
	'hết các Thành phố Tự do và'
	\L_077a5:
	ZH 1:
	'đã chiếm được thành phố'
	R
	'biên giới của Bồ Đào Nha.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Bồ Đào Nha đã thất'
	R
	'thủ...? Thật đáng thất vọng.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 420!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Lạy Chúa,'
	R
	'chúng con không được phép'
	R
	'im lặng trước chuyện này!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Katsuie Shibata, người'
	R
	'chỉ huy đã đẩy vị tướng đang'
	R
	'báo cáo ra khỏi đường đi,'
	\L_077a5:
	ZH 1:
	'tiến lên một bước.'
	\L_077a5:
	ZH 1:
	'Đó là một điều không'
	R
	'đúng đắn khi làm trước'
	R
	'mặt chúa tể của ngươi,'
	\L_077a5:
	ZH 1:
	'nhưng Nobunaga'
	R
	'dường như không để ý'
	R
	'đến bất kỳ điều gì.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Những kẻ ngoại quốc'
	R
	'bẩn thỉu đó chắc chắn sẽ'
	R
	'tấn công đất nước chúng ta!'
	\L_077a5:
	ZH 1:
	'Điều đó có nghĩa'
	R
	'là chúng ta nên tấn công'
	R
	'bất ngờ và ra tay trước!'
	\L_077a5:
	ZH 1:
	'Chúng ta không'
	R
	'được xem nhẹ chúng!'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'（Toukichirou） Được rồi, ồ!'
	\L_077a5:
	ZH 1:
	'（Toukichirou） Được'
	R
	'rồi được rồi, được'
	R
	'rồi được rồi! Ố ồ ồ!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Con khỉ đang giữ vai'
	R
	'Nobunaga bị Katsuie đuổi đi.'
	R
	'Nó nhe răng và gây náo loạn.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Con khỉ chết tiệt'
	R
	'này đang làm gì vậy?!'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Haahahahahah! Katsuie,'
	R
	'Toukichirou nói, “Im đi,'
	R
	'đồ ngốc!” Ngh, hrnnngh!'
	\L_077a5:
	ZH 1:
	'Con khỉ này, sao'
	R
	'ngươi dám chế nhạo ta?!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Katsuie chuẩn bị lao'
	R
	'vào con khỉ Toukichirou.'
	R
	'Nó ẩn sau đầu Nobunaga.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Cậu định nhảy'
	R
	'vào tôi à, Katsuie?'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Tôi-tôi...! Lời'
	R
	'xin lỗi của tôi...'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Hãy thoải mái. Nhưng'
	R
	'tôi đồng ý với Toukichirou'
	R
	'rằng ngươi hơi khó chịu.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Hah... Gahahahaha!aah...'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'（Toukichirou） Ồ ồ ồ ồ!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Toukichirou ngóc đầu'
	R
	'lên và lè lưỡi với Katsuie.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Ôi, mmmgh... Aaargh!'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Haahahah! Hai ngươi thật'
	R
	'hoàn hảo khi ở bên nhau!'
	\L_077a5:
	!VAR0154 : 5!
	{VAR0102 = 0:
		!VAR0325 : 2!
		!VAR0718 : VAR0517 + 4!
		ZH 1:
		'Trong mọi trường hợp,'
		\L_077a5:
		ZH 1:
		'chúng ta có thể'
		R
		'lo lắng về việc họ sẽ tấn'
		R
		'công khi thời điểm đó đến.'
		\L_077a5:
		ZH 1:
		'Chúng ta có thể chống trả.'
		\L_077a5:
		ZH 1:
		'Chúng ta vẫn'
		R
		'còn một số việc phải'
		R
		'làm trước phải không?'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'... Ý ngươi là'
		R
		'thống nhất NHẬT BẢN?'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Chính xác.'
		\L_077a5:
		ZH 1:
		'Mặc dù kẻ thù lớn nhất'
		R
		'của chúng ta, gia tộc Hara,'
		\L_077a5:
		ZH 1:
		'đã bị tiêu diệt nhưng'
		R
		'một số phe phái vẫn tồn tại.'
		\L_077a5:
		ZH 1:
		'Katsuie, tình hình ở'
		R
		'Etchu thế nào kể từ khi'
		R
		'gia tộc Kaki bị đàn áp?'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'Gahahahaha!h, chúng tôi đang'
		R
		'tấn công chúng với toàn lực,'
		R
		'nhưng chúng khá dai dẳng…'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'（Toukichirou）'
		R
		'Được rồi được rồi!'
		R
		'Được rồi, được rồi!'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'... Toukichirou đã nói gì?'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Anh ta nói, “Họ'
		R
		'sẽ tấn công trước,'
		\L_077a5:
		ZH 1:
		'ngươi có thể tấn'
		R
		'công bất ngờ gì khi thậm chí'
		R
		'không thể đứng vững?” Gah...'
		\L_077a5:
		ZH 1:
		'Con khỉ chết tiệt này!'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'（Toukichirou） Ôi!'
		\L_077a5:
		ZH 1:
		'Haahahahahah!'
		\L_077a5:
		\L_07798:
