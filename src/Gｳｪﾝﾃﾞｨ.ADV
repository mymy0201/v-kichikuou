	ZH 1:
	'Phá vỡ nó rồi...'
	\L_03021:
	\L_03014:
	\L_02efc:
	ZH 1:
	'B-...'
	\L_03021:
	ZH 1:
	'Phá vỡ nó, em nói...'
	\L_03021:
	\L_03014:
	\L_02f6c:
	ZH 1:
	'Em rất xin lỗi!'
	\L_03021:
	\L_03014:
