	'đầu đang hành quân.'
	\L_01c7d:
	\L_01c70:
	!VAR0516 : 263!
	\L_01c1c:
	\L_01bc8:
	ZH 1:
	'Ừm...'
	\L_01c7d:
	ZH 1:
	'Đội trưởng Sanakia, hình như'
