	\L_07085:
	\L_07031:
	ZH 1:
	'Này, có ai không hả!! Này!!'
	\L_070e6:
	ZH 1:
	'Hừnggg!'
	\L_070e6:
	ZH 1:
	'Mau ra đây đi ạ~!'
	\L_070e6:
	\L_070d9:
