	'trong kho ở Lang Bau.'
	\L_03b47:
	\L_03b3a:
	!VAR0516 : 1!
	\L_03ae6:
	\L_03a92:
	ZH 1:
	'Pha Lê Kiếm...... à,'
	R
	'thứ vũ khí hiểm ác quân'
	R
	'của con mụ Mineva dùng.'
	\L_03b47:
	ZH 1:
	'Được, mang về đi.'
	\L_03b47:
	\L_03b3a:
	\L_03a22:
	ZH 1:
	'Rõ.'
	\L_03b47:
	\L_03b3a:
	\L_03a84:
	\L_03a5a:
	ZH 1:
	'Thu được một lượng lớn'
	R
	'Pha Lê Kiếm đủ trang'
	R
	'bị cho cả một đạo quân.'
