	!VAR0150 : 100!
	!VAR0516 : 261!
	\L_03a76:
	\L_03a22:
	ZH 1:
	'Bệ hạ Rance,'
	\L_03b47:
	ZH 1:
	'thần tìm thấy rất'
	R
	'nhiều Pha Lê Kiếm'
