	!VAR0516 : 1!
	\L_0463b:
	!VAR0516 : 6!
	\L_046ab:
	\L_0461f:
	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng yết kiến Vua'
	R
	'Rance. Lực lượng của'
	R
	'Redeye đang đến gần.'
	\L_0470c:
	ZH 1:
	'Nếu họ đi qua'
	R
	'dãy núi, lũ quái vật'
	R
	'sẽ đến được Leazas...'
	\L_0470c:
	\L_046ff:
	\L_045e7:
	ZH 1:
	'............ chúng ta không'
	R
	'có một phút để lãng phí.'
	\L_0470c:
	\L_046ff:
	\L_045e7:
	ZH 1:
	'Ta biết điều đó.'
	\L_0470c:
	\L_046ff:
	\L_04657:
	ZH 1:
	'Xin hãy đưa ra'
	R
	'quyết định, Vua Rance.'
	\L_0470c:
	\L_046ff:
	\L_045e7:
	ZH 1:
	'Ta biết. Ta'
	R
	'sẽ chặn chúng lại.'
	\L_0470c:
	\L_046ff:
	\L_04657:
	ZH 1:
	'Không phải vậy.'
	\L_0470c:
	ZH 1:
	'Ra lệnh cho cô gái'
	R
	'tên Rona bị ám sát để kết'
	R
	'thúc Cuộc đời Của Redeye...'
	\L_0470c:
	\L_046ff:
	\L_045e7:
	ZH 1:
	'Ngươi đang bảo ta'
	R
	'ám sát một cô gái?'
	\L_0470c:
	\L_046ff:
	\L_04657:
	ZH 1:
	'Vâng... Đó là lựa chọn'
	R
	'duy nhất chúng tôi còn lại.'
	\L_0470c:
	ZH 1:
	'không có đủ thời gian'
	R
	'trước khi Lực Lượng Của'
	R
	'Redeye đi qua dãy núi...'
	\L_0470c:
	ZH 1:
	'Một ninja có'
	R
	'thể ám sát Rona.'
	\L_0470c:
	\L_046ff:
	\L_045e7:
	ZH 1:
	'Hmmmmmmmm.'
	\L_0470c:
	\L_046ff:
	\L_04657:
	ZH 1:
	'Vua Rance... Xin hãy'
	R
	'quyết định cử ai đi.'
	\L_0470c:
	\L_046ff:
