	'tôi thấy...!!'
	\L_02c33:
	\L_02c26:
	\L_02b0e:
	ZH 1:
	'Haurein?'
	\L_02c33:
	\L_02c26:
	\L_02b7e:
	ZH 1:
	'A... Bệ hạ Rance...'
	\L_02c33:
	\L_02c26:
	\L_02b0e:
	ZH 1:
	'Sẽ không xin'
