	'nhìn thấy nó ở đâu, Haurein?'
	R
	'Hãy kể chi tiết cho ta.'
	\L_02c33:
	\L_02c26:
	\L_02b7e:
	ZH 1:
	'Tôi không nhớ.'
	\L_02c33:
	\L_02c26:
