	ZH 1:
	'Đồ ngốc.'
	\L_05f13:
	\L_05f06:
	\L_05e26:
	ZH 1:
	'Dù nghĩ như vậy,'
	\L_05f13:
	ZH 1:
	'Reincock nhẹ nhàng nắm'
