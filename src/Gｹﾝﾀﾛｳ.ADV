	\L_0239a:
	\L_0238d:
	\L_022e5:
	ZH 1:
	'............'
	\L_0239a:
	\L_0238d:
	\L_02301:
	ZH 1:
	'Ôi trời... Ta'
	R
	'nên làm gì...?'
	\L_0239a:
	\L_0238d:
	\L_022ad:
	ZH 1:
	'Kentarou bối'
	R
	'rối khi xem cuộc tranh cãi'
	R
	'(?) giữa Rance và Chaos.'
	\L_0239a:
	\L_0238d:
	\L_02347:
	!VAR0516 : 34!
	\L_02339:
	\L_022e5:
	ZH 1:
	'Hai người đang làm phiền chủ nhân Kentarou.'
	\L_0239a:
	\L_0238d:
	\L_02275:
	ZH 1:
	'Này, Nikkou. Tao đã'
	R
