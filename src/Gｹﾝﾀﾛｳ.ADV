	\L_0239a:
	\L_0238d:
	\L_02275:
	ZH 1:
	'Từ khi mày còn nhỏ...'
	\L_0239a:
	\L_0238d:
	\L_022e5:
	ZH 1:
	'Vâng.'
	\L_0239a:
	ZH 1:
	'Những ngôi nhà của'
	R
	'chúng tao gần nhau,'
	\L_0239a:
	ZH 1:
