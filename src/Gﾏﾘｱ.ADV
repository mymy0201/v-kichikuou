		ZH 1:
		'khổ ghê...'
		\L_069ed:
		ZH 1:
		'thật tình...」'
		\L_069ed:
		ZH 1:
		'Rance（............）'
		\L_069ed:
		ZH 1:
		'Rance（???）'
		\L_069ed:
