	'một bước nữa...'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a3cb:
	ZH 1:
	'Ờ...!!'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a403:
	ZH 1:
