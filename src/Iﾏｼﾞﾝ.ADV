		!VAR0516 : 402!
		\L_0a48f:
		\L_0a43b:
		ZH 1:
		'Bệ hạ Rance, mục tiêu của'
		R
		'chúng ta là thống nhất nhân'
		\L_0a4f0:
		ZH 1:
		'loại. Không nên dây vào Ma'
		R
		'Nhân.'
		\L_0a4f0:
		\L_0a4e3:
		\L_0a3cb:
		ZH 1:
		'Vậy ngươi đề nghị'
		R
		'chúng ta làm gì, Barres?'
		\L_0a4f0:
		ZH 1:
		'Ngươi muốn'
		R
		'chúng ta giao một cô gái'
		R
		'dễ thương cho quỷ dữ?'
		\L_0a4f0:
		\L_0a4e3:
		\L_0a43b:
		ZH 1:
		'Không... Ý lão thần'
		R
		'không phải vậy...'
		\L_0a4f0:
		ZH 1:
		'Tuy nhiên, chúng ta đang'
		R
		'nói về một điều gì đó quan'
		R
		'trọng hơn một mạng sống...'
		\L_0a4f0:
		\L_0a4e3:
		\L_0a3cb:
		ZH 1:
		'Hừm, mạng sống'
		R
		'của một cô gái còn quý'
		R
		'hơn vô số thứ rác rưởi.'
		\L_0a4f0:
		ZH 1:
		'Làm sao ngươi có'
		R
		'thể không biết điều đó?'
		\L_0a4f0:
		\L_0a4e3:
	}
