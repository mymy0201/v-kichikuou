	ZM 32:
	ZH 1:
	'Cascade'
	R
	ZM 24:
	ZH 1:
	R
	'Bau Pháo đài quân Hornet Nằm'
	R
	'giữa hai phe, nơi'
	\L_0a4f0:
	ZH 1:
	'đây từng là chiến trường'
	R
	'quyết định'
	\L_0a4f0:
	ZH 1:
	'bao lần. Trước kia, Nos,'
	R
	'Eisel, Meglass,'
	\L_0a4f0:
	ZH 1:
	'Satella, Silky và Hawzel'
	R
	'cùng 500.000 quân trấn giữ.'
	\L_0a4f0:
	ZH 1:
	'Nay phần lớn sức mạnh đã'
	R
	'mất.'
	\L_0a4f0:
	ZH 1:
	'Chỉ còn Silky, Hawzel và'
	R
	'chưa đầy'
	\L_0a4f0:
	ZH 1:
	'100.000 quân. Đối diện họ là'
	\L_0a4f0:
	ZH 1:
	'Kesselring, Medusa, Babora,'
	R
	'Warg, Galtia của phe Kayblis'
	\L_0a4f0:
	ZH 1:
	'cùng 600.000 Quái Vật. Silky'
	\L_0a4f0:
	ZH 1:
	'nhìn đội quân đông đến'
	R
	'choáng ngợp phía xa.'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a3cb:
	ZH 1:
	'... Họ đến rồi.'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a43b:
	ZH 1:
	'Vâng...'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a3cb:
	ZH 1:
	'...Liệu chúng ta có chết'
	R
	'không?'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a43b:
	ZH 1:
	'Không thử'
	R
	'thì không biết...'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a3cb:
	ZH 1:
	'...Ừ...'
	\L_0a4f0:
	ZH 1:
	'Toàn quân...'
	\L_0a4f0:
	ZH 1:
	'Xuất kích!'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a43b:
	ZH 1:
	'Được rồi!'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a42d:
	\L_0a49d:
	\L_0a403:
	ZH 1:
	'Trận'
	\L_0a4f0:
	ZH 1:
	'quyết chiến giữa Quái Vật'
