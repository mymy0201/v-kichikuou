	\L_0a3cb:
	ZH 1:
	'Kh...!!'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a42d:
	\L_0a49d:
	\L_0a403:
	ZH 1:
	'Nhân đó, quân Hawzel vỡ'
	R
