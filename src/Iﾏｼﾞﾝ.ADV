	!VAR0516 : 455!
	\L_0a41f:
	\L_0a3cb:
	ZH 1:
	'Aah... Còn chưa'
	R
	'chạm tay vào nó...'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a403:
	ZH 1:
	'Alefgard nhìn'
	R
	'chiếc khay đặt bên ngoài'
	R
	'phòng Medusa và thở dài.'
	\L_0a4f0:
	ZH 1:
	'Những món ăn yêu'
	R
	'thích của Medusa được xếp'
	R
	'thành một hàng trên khay.'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a3cb:
	ZH 1:
	'Aah... Đã hai ngày rồi...'
	R
	'Cô Medusa quá tập trung'
	R
	'vào món đồ chơi của mình.'
	\L_0a4f0:
	ZH 1:
	'Nàng không ăn gì cả...'
	\L_0a4f0:
	ZH 1:
	'Ngay cả khi'
	R
	'tôi bảo nàng phải báo'
	R
	'cáo với ông Kayblis,'
	\L_0a4f0:
	ZH 1:
	'nàng cũng không nghe…'
	\L_0a4f0:
	ZH 1:
	'Nhưng nếu tôi làm gián'
	R
	'đoạn cuộc vui của nàng,'
	\L_0a4f0:
	ZH 1:
	'nàng sẽ từ chối dùng tôi'
	R
	'làm gối trong một tuần...'
	\L_0a4f0:
	ZH 1:
	'Aah... Ôi trời ơi...'
	R
	'Tôi phải làm sao đây...?'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a403:
	ZH 1:
	'Alefgard không'
	R
	'thể làm gì khác ngoài'
	\L_0a4f0:
	ZH 1:
	'việc lo lắng lảng vảng'
	R
	'bên ngoài phòng của Medusa.'
