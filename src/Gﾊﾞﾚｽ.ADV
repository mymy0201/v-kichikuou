		\L_00f04:
		\L_00ef7:
		\L_00ddf:
		ZH 1:
		'............'
		\L_00f04:
		\L_00ef7:
		\L_00dfb:
		ZH 1:
		'Ta định bắt nạt nếu lão'
		R
		'không trồng cây chuối được,'
		R
		'vậy mà...'
		\L_00f04:
		\L_00ef7:
		\L_00e4f:
		ZH 1:
		'Bệ hạ Rance?'
		\L_00f04:
		\L_00ef7:
		\L_00ddf:
		ZH 1:
		'Đủ rồi.'
		\L_00f04:
		\L_00ef7:
		\L_00e4f:
		ZH 1:
		'Dạ, vâng...'
		\L_00f04:
		\L_00ef7:
