		\L_06a32:
		!VAR0516 : 423!
		\L_06aa2:
		\L_06a16:
		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'- Phòng yết kiến Cậu gọi tôi'
		R
		'à?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Đến rồi! Ta chờ mãi. Mau'
		R
		'lên! Chuyện gì vậy...?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Mhm, vậy ra chuyện là...'
		\L_06b03:
		ZH 1:
		'Ta cứ nghĩ về'
		R
		'điều này nhiều đến nỗi nó'
		R
		'khiến ta mất ngủ cả đêm.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'...??'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Vấn đề là...'
		\L_06b03:
		ZH 1:
		'Mày đã hỏi Hanty điều'
		R
		'gì về màu tóc của nàng chưa?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'............'
		\L_06b03:
		ZH 1:
		'Hả? Điều đó làm'
		R
		'phiền cậu đến mức khiến'
		R
		'cậu không thể ngủ được?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Vâng, đúng vậy. Đó là'
		R
		'những gì xảy ra khi ta đang'
		R
		'tự hỏi về một cái gì đó.'
		\L_06b03:
		ZH 1:
		'Vì vậy, hãy cho ta'
		R
		'biết về nó ngay bây giờ.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Vâng... Về mái'
		R
		'tóc của nàng...'
		\L_06b03:
		ZH 1:
		'... Tôi chưa bao'
		R
		'giờ hỏi về chuyện đó...'
		\L_06b03:
		ZH 1:
		'Cậu đã hỏi rất nhiều Về'
		R
		'Hanty, Vua Của Leazas. Cậu'
		R
		'có quan tâm đến nàng không?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Gái xinh nào ta cũng thích.'
		\L_06b03:
		ZH 1:
		'Cô ấy là người của mày nhỉ?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Giả sử cô ấy là người'
		R
		'của tôi thì cậu làm gì?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Gahahahaha! Còn gì nữa. Cướp'
		R
		'thôi. Giờ ta còn'
		\L_06b03:
		ZH 1:
		'nói chuyện tử tế. Nhường cho'
		R
		'ta đi.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Rõ ràng là tôi'
		R
		'không thể sống sót nếu'
		R
		'không có nàng. Vậy...'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Thì mày là hoàng đế mà.'
		\L_06b03:
		ZH 1:
		'Thuê mười hay trăm hầu gái'
		R
		'là được.'
		\L_06b03:
		ZH 1:
		'Nhường cô ấy cho ta.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Không... Hầu gái đâu được.'
		\L_06b03:
		ZH 1:
		'Tôi còn cần người luyện tập'
		R
		'cùng...'
		\L_06b03:
		ZH 1:
		'Với lại nhiều'
		\L_06b03:
		ZH 1:
		'chuyện...'
		\L_06b03:
		ZH 1:
		'Phải rồi, cô ấy bướng bỉnh'
		R
		'lắm.'
		\L_06b03:
		ZH 1:
		'Cậu hợp với người dịu dàng'
		R
		'hơn. Đúng thế.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Biết rồi, biết rồi. Là người'
		R
		'của mày thì cứ nói thẳng.'
		\L_06b03:
		ZH 1:
		'Đừng cuống lên thế.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Không, nàng chỉ...'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Thôi, đừng lo.'
		\L_06b03:
		ZH 1:
		'Thấy mày thảm quá ta hết'
		R
		'muốn cướp'
		\L_06b03:
		ZH 1:
		'rồi... Chỉ có một người nên'
		R
		'cũng đành vậy.'
		\L_06b03:
		ZH 1:
		'Gahahahaha!'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'............'
		\L_06b03:
		\L_06af6:
		!VAR0516 : 0!
