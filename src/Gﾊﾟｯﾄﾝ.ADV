		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến Ngươi'
		R
		'gọi là Vua của Leazas?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Vâng. Lại đây.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Nó là gì?'
		R
		'cậu sẽ làm Gì với Tư cách'
		R
		'Là Hoàng Đế Của Helman?'
		\L_06b03:
		ZH 1:
		'Cậu sẽ phá vỡ'
		R
		'đất nước ra khỏi tầm'
		R
		'kiểm soát của ta?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Tôi sẽ không'
		R
		'bao giờ dám nghĩ đến'
		R
		'việc thách thức cậu.'
		\L_06b03:
		ZH 1:
		'chúng tôi chỉ'
		R
		'quay trở lại cách chúng'
		R
		'tôi trước chiến tranh.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Ta không có'
		R
		'ý định giải quyết'
		R
		'vấn đề của Helman.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Tôi đang nghĩ'
		R
		'về việc buôn bán.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Thương mại?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Helman có'
		R
		'tài nguyên khoáng sản.'
		\L_06b03:
		ZH 1:
		'Tôi muốn trao đổi bằng'
		R
		'thứ đó để lấy nguồn thực'
		R
		'phẩm dồi dào của Leazas.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Ta hiểu rồi...'
		\L_06b03:
		ZH 1:
		'Vì vậy,'
		\L_06b03:
		ZH 1:
		'Chúng ta có thể giao dịch'
		R
		'10 tấn thực phẩm của chúng'
		\L_06b03:
		ZH 1:
		'ta cho 10 tấn sắt của'
		R
		'mày và 10 tấn vàng của mày,'
