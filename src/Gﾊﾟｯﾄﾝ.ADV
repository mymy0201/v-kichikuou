	!VAR0516 : 423!
	\L_06a32:
	!VAR0516 : 434!
	\L_06aa2:
	\L_06a16:
	ZM 32:
	ZH 1:
	'Thành Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng Patton. Lelyukov'
	R
	'đang ngồi trước mặt chàng.'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'Thật tình... Bất ngờ quá...'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Lão thần cũng vậy, Điện hạ'
	R
	'Patton.'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'Này, đừng gọi tôi'
	R
	'là hoàng tử nữa.'
	\L_06b03:
	ZH 1:
	'Giờ tôi chỉ là thủ'
	R
	'lĩnh quân nổi dậy thôi.'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Không... Với lão thần,'
	R
	'người vẫn là Điện hạ.'
	\L_06b03:
	ZH 1:
	'Được ngồi cùng người thế này'
	R
	'đã là vinh hạnh tột bậc...'
	\L_06b03:
	ZH 1:
	'Patton「Thôi mà... Thật'
	R
	'tình, ngượng lắm.」'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Ha ha... Người đã thay đổi'
	R
	'rồi, Điện hạ Patton.'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'... Vậy sao?'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Vâng. Phong thái nam'
	R
	'nhi hơn hẳn trước kia.'
	\L_06b03:
	ZH 1:
	'Hẳn người đã chịu nhiều gian'
	R
	'khổ...'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'Không...'
	\L_06b03:
	ZH 1:
	'Đâu đến mức ấy. Mà sao'
	R
	'Tướng quân Lelyukov lại'
	R
	'ở trong quân Leazas?'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Bởi vì...'
	\L_06b03:
	\L_06af6:
	\L_06a6a:
	ZH 1:
	'Không thể nói'
	R
	'chuyện Amiran...'
	\L_06b03:
	ZH 1:
	'Chỉ khiến Điện hạ phải'
	R
	'lo lắng không đâu...'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'Tướng Lelyukov?'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Vì lão thần khâm phục khí'
	R
	'phách của vua Leazas.'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'... Thật sao?'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Vâng, thưa Điện hạ.'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'............'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Điện hạ...'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'Có chuyện gì?'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Helman... Xin gửi gắm'
	\L_06b03:
	ZH 1:
	'nơi Điện hạ...'
	R
	'Thời của Thoma'
	\L_06b03:
	ZH 1:
	'và lão thần đã qua.'
	R
	'Giờ là thời của lớp'
	R
	'trẻ như Điện hạ.'
	\L_06b03:
	ZH 1:
	'Xin hãy đem hạnh'
	R
	'phúc đến cho người'
	R
	'dân đang chịu khổ...'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'Tôi hiểu...'
	\L_06b03:
	ZH 1:
	'Tôi sẽ cố hết sức. Nhưng'
	R
	'Tướng quân Lelyukov này...'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Vâng?'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'Đừng nói những'
	R
	'lời buồn bã thế.'
	\L_06b03:
	ZH 1:
	'Xin ông cứ ở bên thúc'
	R
	'giục đám hậu đậu như'
	R
	'chúng tôi mãi nhé.'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'... Lão thần không dám nhận'
	R
	'lời ấy, Điện hạ...'
	\L_06b03:
	\L_06af6:
	\L_069de:
	ZH 1:
	'Ha ha. Được, vậy nhờ ông'
	R
	'luyện tập cùng tôi nhé. Ra'
	R
	'ngoài thôi.'
	\L_06b03:
	\L_06af6:
	\L_06a4e:
	ZH 1:
	'Vâng, thưa Điện hạ.'
	\L_06b03:
	\L_06af6:
	\L_06a16:
	ZH 1:
	'Patton và Lelyukov'
	R
	'vừa chuyện trò vui'
	R
	'vẻ vừa rời phòng.'
	\L_06b03:
	\L_06af6:
	!VAR0516 : 0!
