		\L_06aa2:
		\L_06a16:
		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến'
		R
		'Ngươi đã gọi à?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Ồ, mày đây rồi.'
		R
		'Ta đã chờ đợi. Hãy bắt đầu'
		R
		'ngay với nó. nó là gì...?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Mhm, vậy ra chuyện là...'
		\L_06b03:
		ZH 1:
		'Ta cứ nghĩ về'
		R
		'điều này nhiều đến nỗi nó'
		R
		'khiến ta mất ngủ cả đêm.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'...??'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Vấn đề là...'
		\L_06b03:
		ZH 1:
		'Mày đã hỏi Hanty điều'
		R
		'gì về màu tóc của nàng chưa?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'............'
		\L_06b03:
		ZH 1:
		'Hả? Điều đó làm'
		R
		'phiền cậu đến mức khiến'
		R
		'cậu không thể ngủ được?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Vâng, đúng vậy. Đó là'
		R
		'những gì xảy ra khi ta đang'
		R
		'tự hỏi về một cái gì đó.'
		\L_06b03:
		ZH 1:
		'Vì vậy, hãy cho ta'
		R
		'biết về nó ngay bây giờ.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Vâng... Về mái'
		R
		'tóc của nàng...'
		\L_06b03:
		ZH 1:
		'... Tôi chưa bao'
		R
		'giờ hỏi về chuyện đó...'
		\L_06b03:
		ZH 1:
		'Cậu đã hỏi rất nhiều Về'
		R
		'Hanty, Vua Của Leazas. Cậu'
		R
		'có quan tâm đến nàng không?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Ta quan tâm đến tất'
		R
		'cả những cô gái dễ thương.'
		\L_06b03:
		ZH 1:
		'Nàng là người phụ'
		R
		'nữ của anh phải không?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Nếu tôi'
		R
		'nói nàng thì sao?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Gahahahaha! .'
		R
		'Thế thì tất nhiên là ta phải'
		R
		'cướp nàng khỏi tay anh rồi.'
		\L_06b03:
		ZH 1:
		'Bây giờ ta'
		R
		'sẽ hỏi mày một cách hòa'
		R
		'bình. Đưa nàng cho ta.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Rõ ràng là tôi'
		R
		'không thể sống sót nếu'
		R
		'không có nàng. Vậy...'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Chờ đã... Anh'
		R
		'phải là hoàng đế.'
		\L_06b03:
		ZH 1:
		'Chỉ cần thuê'
		R
		'10, có thể 100 người'
		R
		'giúp việc và mày tốt.'
		\L_06b03:
		ZH 1:
		'vì vậy, hãy'
		R
		'đưa nàng cho ta.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Không, người giúp việc sẽ'
		R
		'không làm việc... Tôi, ừ...'
		\L_06b03:
		ZH 1:
		'tôi cũng cần'
		R
		'một người có thể huấn'
		R
		'luyện cùng... Và, ừ...'
		\L_06b03:
		ZH 1:
		'Những thứ khác...'
		\L_06b03:
		ZH 1:
		'Vâng.'
		\L_06b03:
		ZH 1:
		'Ngoài ra, nàng còn'
		R
		'là một cô nàng tomboy.'
		\L_06b03:
		ZH 1:
		'Tôi nghĩ một cô gái'
		R
		'duyên dáng hơn sẽ phù'
		R
		'hợp hơn với cậu. Vâng.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Bất cứ Điều gì, Ta'
		R
		'nhận được nó. Nàng là của'
		R
		'mày, mày nên nói như vậy.'
		\L_06b03:
		ZH 1:
		'Đừng hoảng sợ'
		R
		'quá nhiều về nó.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Không, nàng chỉ...'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Đừng lo lắng về điều đó.'
		\L_06b03:
		ZH 1:
		'Ta cảm thấy thật'
		R
		'tệ khi phải cướp nàng'
		R
		'khỏi anh lúc này...'
		\L_06b03:
		ZH 1:
		'Chà, Không thể giúp được'
		R
		'gì nếu chỉ một cô gái thoát'
		R
		'khỏi sự nắm bắt của ta.'
		\L_06b03:
		ZH 1:
		'Gahahahaha! haha.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'............'
