	\L_06aa2:
	\L_06a4e:
	ZH 1:
	'... Chắc sẽ có cách thôi.'
	R
	'Liên minh cũng đâu bất lợi'
	R
	'cho họ. Họ sẽ không đưa'
	\L_06b03:
	ZH 1:
	'yêu sách quá đáng đâu.'
	\L_06b03:
	\L_06af6:
	\L_06ab0:
