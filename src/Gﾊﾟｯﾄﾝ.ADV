		\L_06aa2:
		\L_06a16:
		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến Patton'
		R
		'đã ở trước Rance, người'
		R
		'đang bồn chồn không ngừng.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Nó Là Gì, Vua Của Leazas?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Chà... Ta đã tự'
		R
		'hỏi cô gái đó luôn ở bên mày'
		R
		'ở đâu... cô gái Nào...? À...'
		\L_06b03:
		\L_06af6:
		\L_06a6a:
		ZH 1:
		'Nghĩ lại thì,'
		\L_06b03:
		ZH 1:
		'Freak đã đề cập'
		R
		'đến việc Vua Leazas có quan'
		R
		'điểm đặc biệt với phụ nữ...'
		\L_06b03:
		ZH 1:
		'cậu đã nhận được Kalar'
		R
		'đó luôn ở bên cậu Ở đâu?'
		\L_06b03:
		ZH 1:
		'Ta chưa từng thấy ai'
		R
		'có mái tóc đen trước đây.'
		\L_06b03:
		\L_06af6:
		\L_06a6a:
		ZH 1:
		'Uh oh... Tôi'
		R
		'đoán hắn đang nhìn nàng'
		R
		'như một người phụ nữ...'
		\L_06b03:
		ZH 1:
		'Điều này rất phức tạp...'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Cậu đang nói'
		R
		'về Hanty phải không?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Đó có phải tên'
		R
		'nàng không? Ta thích nó.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'............'
		\L_06b03:
		ZH 1:
		'Nàng đã ở bên tôi'
		R
		'miễn là tôi có thể nhớ.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'???'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Tôi đoán'
		R
		'là mẹ tôi đã nhờ bà làm'
		R
		'người giám hộ cho tôi.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Nàng là người giám'
		R
		'hộ cho hoàng gia... Nàng'
		R
		'có mạnh mẽ như vậy không?'
		\L_06b03:
		ZH 1:
		'Hầu hết các chiến binh'
		R
		'phép thuật đều khá yếu...'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Nàng là một thế'
		R
		'giới mà chúng ta thậm chí'
		R
		'không thể tưởng tượng được,'
		\L_06b03:
		ZH 1:
		'và nàng biết ý'
		R
		'nghĩa của thời gian...'
		\L_06b03:
		ZH 1:
		'Nàng vượt xa mức'
		R
		'độ của một con người.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Một Kalar'
		R
		'sống lâu nhưng già đi từ'
		R
		'từ... Và cũng mạnh mẽ...'
		\L_06b03:
		ZH 1:
		'vì vậy, điều'
		R
		'đó có nghĩa... Nàng'
		R
		'bao nhiêu tuổi?'
		\L_06b03:
		ZH 1:
		'Nếu nàng ở cùng thời'
		R
		'gian với mẹ của mày, thì...'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Trong bức chân'
		R
		'dung của bà với mẹ tôi, bà'
		R
		'trông giống hệt bây giờ...'
		\L_06b03:
		ZH 1:
		'Ngoài ra... Nàng nói rằng'
		R
		'nàng đã là cậu với Freak'
		R
		'trong một thời gian dài...'
		\L_06b03:
		ZH 1:
		'Quái dị là... Để'
		R
		'xem nào... Tôi nghĩ'
		R
		'là hơn 700... Và...'
		\L_06b03:
		ZH 1:
		'khi anh gặp Hanty,'
		R
		'tôi nghe nói nàng đã trông'
		R
		'giống như một người lớn...'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'... Điều đó có'
		R
		'nghĩa là... Nàng thực sự có'
		R
		'thể lớn tuổi hơn ông già...'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'............'
		\L_06b03:
		ZH 1:
		'Vâng... Nếu cậu có đủ can'
		R
		'đảm để hỏi nàng, có lẽ cậu'
		R
		'có thể thử làm điều đó...'
		\L_06b03:
		ZH 1:
		'Tuy nhiên, tôi'
		R
		'không muốn thế.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Cái gì, mày sợ?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Tôi sợ hãi.'
		\L_06b03:
		ZH 1:
		'Không thể giải thích được'
		R
		'người phụ nữ mà cậu quen'
		\L_06b03:
		ZH 1:
		'biết từ khi còn mặc tã'
		R
		'lại đáng sợ đến mức nào...'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Đáng Sợ Hơn Maris?'
		R
		'Maris đôi khi khá đáng sợ.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Hả...?'
		\L_06b03:
		\L_06af6:
		\L_06ab0:
		!VAR0516 : 6!
		\L_06aa2:
		\L_06a4e:
		ZH 1:
		'............'
		\L_06b03:
		\L_06af6:
		\L_06a16:
		ZH 1:
		'Maris làm như'
		R
		'không nghe thấy cuộc trò'
		R
		'chuyện của họ, nhưng...'
		\L_06b03:
		\L_06af6:
		\L_06ab0:
		!VAR0516 : 423!
		\L_06aa2:
		\L_06a4e:
		ZH 1:
		'Ah...'
		\L_06b03:
		ZH 1:
		'Ah, tôi vừa'
		R
		'nhớ ra một số công việc'
		R
		'tôi cần phải giải quyết!'
		\L_06b03:
		ZH 1:
		'Hẹn gặp lại,'
		R
		'Vua của Leazas!'
		\L_06b03:
		\L_06af6:
		\L_06ab0:
		!VAR0516 : 6!
		\L_06aa2:
		\L_06a16:
		ZH 1:
		'Patton vội vã bỏ đi.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Cái quái'
		R
		'gì Vậy...? Em không nghĩ'
		R
		'hắn kỳ quặc sao, Maris?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Tôi không biết.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'... Ta hơi sợ...'
