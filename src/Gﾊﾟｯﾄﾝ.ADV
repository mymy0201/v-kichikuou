		\L_06af6:
		!VAR0516 : 6!
		\L_06aa2:
		\L_06a4e:
		ZH 1:
		'đó là một trò đùa?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Ngươi cũng Vậy, Maris...?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Nó không khác mấy'
