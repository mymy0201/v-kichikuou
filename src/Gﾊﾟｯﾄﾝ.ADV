		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến Patton'
		R
		'đứng trước ngai vàng theo'
		R
		'lệnh triệu tập của Rance.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Ồ, mày đây rồi. Đây,'
		R
		'mày cũng ăn chút đi.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Đây là cái gì...?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Anpan. Nó tốt. Ta đang có'
		R
		'tâm trạng tốt nên ta sẽ cho'
		R
		'mày một cái. Chỉ một thôi.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'À, cảm ơn...'
		\L_06b03:
		ZH 1:
		'Nhân tiện...'
		R
		'tôi cho rằng cậu gọi cho tôi'
		R
		'vì một số công việc thực tế?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Vâng, ta đã làm.'
		\L_06b03:
		ZH 1:
		'Ngay cả khi mày là'
		R
		'con ngoài giá thú, mày vẫn'
		R
		'là hoàng tử, phải không?'
		\L_06b03:
		ZH 1:
		'vì vậy, ta cho'
		R
		'rằng Mày biết điều gì đó về'
		R
		'Sức mạnh quân sự Của Helman.'
		\L_06b03:
		ZH 1:
		'Lực lượng của họ'
		R
		'trông như thế nào?'
		\L_06b03:
		\L_06af6:
		\L_06a6a:
		ZH 1:
		'Đó không phải là chủ đề mà'
		R
		'tôi mong đợi khi ăn anpan...'
		R
		'Thôi, sao cũng được.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Được rồi... Ờ...'
		\L_06b03:
		ZH 1:
		'Helman chắc'
		R
		'chắn đã trải qua rất'
		R
		'nhiều thời kỳ suy tàn.'
		\L_06b03:
		ZH 1:
		'lực lượng của Họ'
		R
		'có lẽ là một nửa so'
		R
		'với vài năm trước.'
		\L_06b03:
		ZH 1:
		'Tuy nhiên, xét về'
		R
		'sức mạnh và số lượng,'
		R
		'họ vẫn ở trên Leazas.'
		\L_06b03:
		ZH 1:
		'Cậu nên sử dụng tất'
		R
		'cả sức mạnh cậu có.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Ừm...'
		\L_06b03:
		ZH 1:
		'vì vậy, nếu điều'
		R
		'đó xảy ra, mày không'
		R
		'thể tham gia cùng ta,'
		\L_06b03:
		ZH 1:
		'Mày định lấy Lại'
		R
		'Helman như thế nào?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'............'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'... Hừm...'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Tôi chưa'
		R
		'nghĩ tới điều đó...'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Gahahahaha!'
		\L_06b03:
		ZH 1:
		'mày có dự định xông'
		R
		'vào đội quân nhỏ bé đó mà'
		R
		'không có chiến lược không?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Đó là cách'
		R
		'tôi làm mọi việc...'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'... Không thể tin'
		R
		'được... Ngay cả ta cũng'
		R
		'không liều lĩnh đến thế.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Ừ, tôi'
		R
		'cũng học được điều đó từ'
		R
		'Hanty và Freak rất nhiều.'
		\L_06b03:
		ZH 1:
		'có lẽ cậu'
		R
		'nên suy nghĩ về cách cậu'
		R
		'làm mọi thứ nhiều hơn.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'............ cậu'
		R
		'có thể đúng... vâng,'
		R
		'bất cứ điều gì.'
		\L_06b03:
		ZH 1:
		'Ta đã học được'
		R
		'những gì ta muốn. Rời đi.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Chắc chắn rồi.'
		\L_06b03:
		\L_06af6:
		\L_06a86:
		ZH 1:
		'Patton rời khỏi'
		R
		'phòng ngai vàng.'
