		\L_06ada:
		!VAR0516 : 1!
		\L_06a32:
		!VAR0516 : 423!
		\L_06aa2:
		\L_06a16:
		ZM 32:
		ZH 1:
		'Thành Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến. Patton'
		R
		'được triệu đến, đứng'
		R
		'trước ngai vàng.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Ồ, đến rồi à. Đây,'
		R
		'ngươi cũng ăn đi.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Đây là cái gì...?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Bánh đậu đỏ. Ngon lắm.'
		R
		'Ta đang vui nên cho'
		R
		'ngươi một cái thôi.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Ừ, cảm ơn...'
		\L_06b03:
		ZH 1:
		'Mà cậu gọi tôi chắc có việc'
		R
		'gì chứ?'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Ờ đúng.'
		\L_06b03:
		ZH 1:
		'Dù là con vợ lẽ, ngươi'
		R
		'cũng từng là hoàng tử.'
		\L_06b03:
		ZH 1:
		'Ta nghĩ ngươi hẳn biết đôi'
		R
		'chút về quân lực Helman.'
		\L_06b03:
		ZH 1:
		'Ngươi đánh giá'
		R
		'chúng thế nào?'
		\L_06b03:
		\L_06af6:
		\L_06a6a:
		ZH 1:
		'Đâu phải chuyện để bàn lúc'
		R
		'ăn bánh đậu đỏ... Thôi, cũng'
		R
		'được.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Ừ...'
		\L_06b03:
		ZH 1:
		'Helman giờ đã mục nát,'
		\L_06b03:
		ZH 1:
		'sức mạnh chắc chỉ bằng'
		R
		'nửa mấy năm trước.'
		\L_06b03:
		ZH 1:
		'Nhưng riêng sức mạnh và quân'
		R
		'số thì vẫn hơn hẳn Leazas.'
		\L_06b03:
		ZH 1:
		'Tôi nghĩ nên dốc'
		R
		'toàn lực đối phó.'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Hừm... Thế ngươi'
		\L_06b03:
		ZH 1:
		'định làm sao'
		R
		'giành lại Helman,'
		\L_06b03:
		ZH 1:
		'nếu không thể thành'
		R
		'thuộc hạ của ta?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'............'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'... Nhồm nhoàm...'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Tôi chưa'
		R
		'nghĩ tới điều đó...'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Gahahahaha!'
		\L_06b03:
		ZH 1:
		'Định đem nhúm quân'
		R
		'ấy xông lên mà chẳng'
		R
		'có kế sách gì sao?'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'... Đó là cách'
		R
		'tôi làm mọi việc...'
		\L_06b03:
		\L_06af6:
		\L_069de:
		ZH 1:
		'Khó tin thật... Đến ta cũng'
		R
		'chẳng liều lĩnh tới mức ấy.'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Ừ, Hanty và Freak cũng'
		R
		'suốt ngày nói tôi như thế.'
		\L_06b03:
		ZH 1:
		'Rance「Xem ra phải nghĩ kỹ'
		R
		'cách dùng ngươi mới được.」'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Patton「...Có lẽ vậy...」'
		\L_06b03:
		ZH 1:
		'Rance「Thôi được. Ta'
		R
		'hiểu rồi. Lui đi.」'
		\L_06b03:
		\L_06af6:
		\L_06a4e:
		ZH 1:
		'Ừ.'
		\L_06b03:
		\L_06af6:
		\L_06a86:
		ZH 1:
		'Patton rời khỏi'
		R
		'trước ngai vàng.'
		\L_06b03:
		\L_06af6:
