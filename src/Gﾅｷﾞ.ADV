	\L_07d89:
	ZM 32:
	ZH 1:
	'Zeth'
	R
	ZM 24:
	ZH 1:
	R
	'Tháp Nagi -'
	R
	'Tầng Cao Nhất （bùm!）'
	\L_07e76:
	\L_07e69:
	\L_07dc1:
	ZH 1:
	'.........'
	\L_07e76:
	\L_07e69:
	\L_07d89:
	ZH 1:
	'Ragarl đấm vào má Nagi.'
	R
	'Máu rỉ ra từ khóe miệng cô.'
	\L_07e76:
	\L_07e69:
	\L_07d51:
	ZH 1:
	'Đồ ngốc, cậu có'
	R
	'quá nhiều sơ hở! Con gái'
	R
	'của Masou rất mạnh mẽ...'
	\L_07e76:
	ZH 1:
	'Tập trung hơn, nâng'
	R
	'cao sức mạnh của cậu.'
	\L_07e76:
	\L_07e69:
	\L_07dc1:
	ZH 1:
	'Vâng, tôi xin lỗi.'
	\L_07e76:
	\L_07e69:
	\L_07d51:
	ZH 1:
	'Hừm, làm lại đi.'
	R
	'Ngay từ đầu, Nagi.'
	\L_07e76:
	\L_07e69:
	!VAR0156 : 101!
	{VAR0128 \ 0:
		\L_07d89:
		ZH 1:
		'（cốc cốc）'
		\L_07e76:
		\L_07e69:
		\L_07e23:
		!VAR0516 : 478!
		\L_07e15:
		\L_07dc1:
		ZH 1:
		'Lãnh chúa Nagi,'
		R
		'ông Ragarl, có lệnh'
		R
		'từ lãnh chúa Chizuko.'
		\L_07e76:
		ZH 1:
		'Dẫn đầu đơn'
		R
		'vị chiến đấu với Leazas'
		R
		'ngay lập tức, nàng nói...'
		\L_07e76:
		\L_07e69:
		\L_07d51:
		ZH 1:
		'Im lặng.'
		\L_07e76:
		\L_07e69:
		\L_07dc1:
		ZH 1:
		'Đúng, nhưng...'
		\L_07e76:
		\L_07e69:
		\L_07d51:
		ZH 1:
		'Tôi nói im lặng.'
		\L_07e76:
		\L_07e69:
		\L_07d89:
		ZH 1:
		'Ragarl giơ'
		R
		'cánh tay trái lên.'
		\L_07e76:
		ZH 1:
		'Chiếc găng tay chứa đầy'
		R
		'ma thuật của anh ta bay'
		\L_07e76:
		ZH 1:
		'ra và ghim quần áo của'
		R
		'pháp sư đưa tin vào tường.'
		\L_07e76:
		\L_07e69:
		\L_07dc1:
		ZH 1:
		'Agh... M-Mr. Ragarl...!'
		\L_07e76:
		\L_07e69:
		\L_07d51:
		ZH 1:
		'Lần sau tôi sẽ giết anh,'
		R
		'đừng nói thêm lời nào nữa.'
		\L_07e76:
		ZH 1:
		'Tôi sẽ không'
		R
		'cho phép việc tập luyện'
		R
		'của Nagi bị gián đoạn.'
		\L_07e76:
		\L_07e69:
		\L_07dc1:
		ZH 1:
		'... Chào...'
		\L_07e76:
		\L_07e69:
		\L_07d51:
		ZH 1:
		'Bây giờ, đừng'
		R
		'phân tâm nữa, Nagi.'
		R
		'Bắt đầu lại từ đầu.'
		\L_07e76:
		\L_07e69:
		\L_07e23:
		!VAR0516 : 45!
		\L_07e15:
	}
	\L_07dc1:
	ZH 1:
	'... Vâng, thưa Chủ nhân.'
	\L_07e76:
	\L_07e69:
	\L_07d89:
	ZH 1:
	'Họ chăm chú tiếp'
	R
	'tục việc đào tạo...'
