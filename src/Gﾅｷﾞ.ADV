	ZH 1:
	'Nagi xuất hiện.'
	\L_07e76:
	\L_07e69:
	!VAR0516 : 45!
	\L_07e15:
	\L_07dc1:
	ZH 1:
	'Cậu có mệnh'
	R
	'lệnh nào cho tôi'
	R
	'không, Vua của Leazas?'
	\L_07e76:
	\L_07e69:
	\L_07d51:
	ZH 1:
	'Vâng. Tuy nhiên,'
	R
	'ta không biết liệu chúng có'
	R
	'khá đơn đặt hàng hay không.'
	\L_07e76:
