*L_07869:
	!VAR0154 : 17!
	{(VAR0336 = 7) + (VAR0102 = 0) * (VAR0541 \ 0):
		!VAR0516 : 1040!
		\L_07e4d:
		!VAR0516 : 468!
		\L_07da5:
		\L_07d89:
		ZM 32:
		ZH 1:
		'Zeth'
		R
		ZM 24:
		ZH 1:
		R
		'Tháp Nagi - Tầng Cao Nhất'
		R
		'Ragarl đang lơ đãng nhìn ra'
		R
		'ngoài cửa sổ khu tập luyện.'
		\L_07e76:
		ZH 1:
		'Nagi đang đợi'
		R
		'phía sau anh.'
		\L_07e76:
		\L_07e69:
		!VAR0516 : 45!
		\L_07e15:
		\L_07dc1:
		ZH 1:
		'Chủ nhân, tôi'
		R
		'có thể bắt đầu buổi huấn'
		R
		'luyện hôm nay được không?'
		\L_07e76:
		\L_07e69:
		\L_07d51:
		ZH 1:
		'Aah, Nagi...'
		R
		'Vâng... Nếu cậu muốn.'
		\L_07e76:
		\L_07e69:
		\L_07dc1:
		ZH 1:
		'Ý cậu là gì nếu tôi muốn?'
		\L_07e76:
		\L_07e69:
		\L_07d51:
		ZH 1:
		'Cậu có thể làm'
		R
		'theo ý mình muốn.'
		\L_07e76:
		ZH 1:
		'Cậu tham gia khóa'
		R
		'đào tạo nào và có nên thực'
		R
		'hiện việc đó hay không...'
		\L_07e76:
		\L_07e69:
		\L_07dc1:
		ZH 1:
		'... Phải. Sau đó tôi sẽ'
		R
		'thực hiện ba hiệp từ Menu B.'
		\L_07e76:
		\L_07e69:
		\L_07d51:
		ZH 1:
		'Không... Đợi đã, Nagi.'
		R
		'Hôm nay chúng ta sẽ biểu'
		R
		'diễn nghệ thuật tình dục.'
		\L_07e76:
		\L_07e69:
		\L_07dc1:
		ZH 1:
		'Có.'
		\L_07e76:
		\L_07e69:
		\L_07d89:
		ZH 1:
		'Nagi ngay lập tức'
		R
		'cởi bỏ bộ giáp của mình.'
		\L_07e76:
		ZH 1:
		'Những hình xăm'
		R
		'và viên đá ma thuật trang'
		R
		'trí trên cơ thể cô lộ ra.'
		\L_07e76:
		ZH 1:
		'Nghệ thuật tình dục là một'
		R
		'nghi lễ sử dụng giao hợp để'
		R
		'trao đổi sức mạnh ma thuật.'
		\L_07e76:
		\L_07e69:
		\L_07d51:
		ZH 1:
		'Hãy đến đây.'
		\L_07e76:
		\L_07e69:
		\L_07dc1:
		ZH 1:
		'Vâng, thưa Thầy...'
		\L_07e76:
		\L_07e69:
		\L_07d89:
		ZH 1:
		'Ragarl cởi áo'
		R
		'choàng và Nagi lặng'
		R
		'lẽ đến gần anh ta...'
		\L_07e76:
		\L_07e69:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
