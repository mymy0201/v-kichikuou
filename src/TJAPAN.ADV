		\L_0341b:
		\L_0340e:
		\L_032f6:
		ZH 1:
		'Kẻ nào?'
		\L_0341b:
		\L_0340e:
		!VAR0516 : 421!
		\L_033ba:
		\L_0339e:
		ZH 1:
		'Gekkou xuất hiện'
		R
		'trước Barres, chẳng'
		R
		'gây tiếng động.'
		\L_0341b:
		\L_0340e:
		\L_032f6:
		ZH 1:
		'Ngươi...!'
		\L_0341b:
		\L_0340e:
		\L_0339e:
		ZH 1:
		'Gekkou lặng lẽ di'
		R
		'chuyển đến phía sau Barres.'
		\L_0341b:
		\L_0340e:
		\L_032f6:
		ZH 1:
		'Ư... hả?'
		\L_0341b:
		\L_0340e:
		\L_0332e:
		ZH 1:
		'Barres bật ra tiếng như hơi'
