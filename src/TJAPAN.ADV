*L_02c04:
	!VAR0154 : 5!
	{VAR0102 = 0:
		\L_0340e:
		!VAR0516 : 6!
		\L_033ba:
		\L_03366:
		ZH 1:
		'Dừng ở đó. Chúng'
		R
		'tôi đã bao vây rồi.'
		\L_0341b:
		\L_0340e:
		\L_032f6:
		ZH 1:
		'Hả...'
		\L_0341b:
		\L_0340e:
		\L_0332e:
		ZH 1:
		'Shinobu chợt hoàn'
		R
		'hồn, nhìn quanh.'
		\L_0341b:
		ZH 1:
		'Nàng nhăn mặt cay'
		R
		'đắng, trừng mắt nhìn'
		R
		'Maris phía trước.'
		\L_0341b:
		\L_0340e:
		\L_03366:
		ZH 1:
		'Dù đã được huấn'
		R
		'luyện đặc biệt,'
		\L_0341b:
		ZH 1:
		'cô cũng chẳng làm gì nổi'
		R
		'chừng này Cận vệ Hoàng gia.'
		\L_0341b:
		ZH 1:
		'Ngoài sân cũng đã canh phòng'
		R
		'tương tự. Hãy đầu hàng đi.'
		\L_0341b:
		\L_0340e:
		\L_0332e:
		ZH 1:
		'Hàng chục mũi vũ khí'
		R
		'của Cận vệ Hoàng gia'
		R
		'chĩa thẳng vào Shinobu.'
		\L_0341b:
		@L_02ddd:
	}
	\L_0340e:
	!VAR0516 : 7!
	\L_033ba:
	\L_03366:
	ZH 1:
	'Hết đường chạy rồi!'
	R
	'Ngoan ngoãn đầu hàng đi!'
	\L_0341b:
	\L_0340e:
	\L_032f6:
	ZH 1:
	'Cái gì!?'
	\L_0341b:
	\L_0340e:
	\L_0332e:
	ZH 1:
	'Shinobu chợt hoàn hồn,'
	R
	'đảo mắt nhìn quanh.'
	\L_0341b:
	ZH 1:
	'Hơn chục lính Cận'
	R
	'vệ Hoàng gia Leazas'
	R
	'đang vây lấy nàng.'
	\L_0341b:
	\L_0340e:
	\L_03366:
	ZH 1:
	'Dù trông như cô bé,'
	R
	'tôi biết cô là nữ ninja'
	R
	'đã qua huấn luyện.'
	\L_0341b:
	ZH 1:
	'Tôi sẽ chẳng lơ là đâu. Tốt'
	R
	'hơn hết hãy đầu hàng đi.'
	\L_0341b:
	\L_0340e:
	\L_0332e:
	ZH 1:
	'Shinobu nhìn chằm chằm'
	R
	'Leila đang chĩa mũi'
	R
	'kiếm thẳng vào mình.'
	\L_0341b:
*L_02ddd:
	\L_0340e:
	\L_03358:
	\L_033c8:
	\L_0332e:
	ZH 1:
	'Bầu không khí lặng ngắt khác'
	R
	'thường, căng như dây đàn.'
	\L_0341b:
	ZH 1:
	'Một tiếng đàn ông thét'
	R
	'lên phá tan im lặng.'
	\L_0341b:
	\L_0340e:
	\L_032f6:
	ZH 1:
	'Shinobu!'
	\L_0341b:
	\L_0340e:
	\L_0332e:
	ZH 1:
	'Cửa sổ vỡ tung.'
	R
	'Mảnh kính lấp lánh'
	R
	'văng khắp hành lang.'
	\L_0341b:
	\L_0340e:
	!VAR0516 : 421!
	\L_0334a:
	\L_0332e:
	ZH 1:
	'Người đàn ông lao qua'
	R
	'cửa sổ, đáp xuống đám'
	R
	'kính không tiếng động.'
	\L_0341b:
	\L_0340e:
	!VAR0516 : 422!
	\L_033ba:
	\L_03366:
	ZH 1:
	'... Gekkou.'
	\L_0341b:
	!VAR0154 : 5!
	{VAR0102 = 0:
		\L_0340e:
		!VAR0516 : 6!
		\L_033ba:
		\L_03366:
		ZH 1:
		'Còn làm gì thế,'
		R
		'mau bắt hắn lại!'
		\L_0341b:
		\L_0340e:
		\L_0332e:
		ZH 1:
		'Maris ra lệnh cho lính canh,'
		\L_0341b:
		ZH 1:
		'nhưng ánh mắt kỳ dị của'
		R
		'Gekkou khiến họ sững lại,'
		R
		'không nhúc nhích nổi.'
		\L_0341b:
	}
	\L_0340e:
	!VAR0516 : 7!
	\L_033ba:
	\L_03366:
	ZH 1:
	'M-Mọi người,'
	R
	'mau bắt hắn lại!'
	\L_0341b:
	\L_0340e:
	\L_0332e:
	ZH 1:
	'Leila ra lệnh,'
	\L_0341b:
	ZH 1:
	'nhưng ngay cả nàng'
	R
	'cũng chùn bước'
	\L_0341b:
	ZH 1:
	'trước ánh mắt kỳ'
	R
	'dị của Gekkou.'
	\L_0341b:
	\L_0340e:
	!VAR0516 : 422!
	\L_033ba:
	\L_032f6:
	ZH 1:
	'Sẵn sàng rồi chứ?'
	\L_0341b:
	\L_0340e:
	\L_03366:
	ZH 1:
	'...Ừ. Em biết.'
	\L_0341b:
	\L_0340e:
	\L_0332e:
	ZH 1:
	'Nghe Shinobu đáp, Gekkou'
	R
	'khẽ cười có vẻ hài lòng.'
	\L_0341b:
	\L_0340e:
	\L_032f6:
	ZH 1:
	'Dù thế nào, chúng'
	R
	'ta cũng ở bên nhau.'
	\L_0341b:
	\L_0340e:
	\L_0332e:
	ZH 1:
	'Lời nói của Gekkou khiến'
	R
	'Shinobu mỉm cười đáp lại.'
	\L_0341b:
	ZH 1:
	'Rồi mỗi người rút từ ngực'
	R
	'áo ra một vật giống ống trụ.'
	\L_0341b:
	\L_0340e:
	\L_03358:
	\L_033c8:
	!VAR0154 : 5!
	{VAR0102 = 0:
		!VAR0516 : 6!
		\L_033ba:
		\L_03366:
		ZH 1:
		'Cái gì...?'
		\L_0341b:
		ZH 1:
		'Mọi người, nằm rạp xuống!'
		\L_0341b:
		\L_0340e:
		\L_033c8:
		\L_0332e:
		ZH 1:
		'Nghe Maris hô,'
		R
		'mọi người sửng sốt'
		\L_0341b:
		ZH 1:
		'nhưng vẫn vội làm theo.'
		\L_0341b:
		ZH 1:
		'Ngay khoảnh khắc ấy.'
		\L_0341b:
		ZH 1:
		'ĐOÀÀÀÀNG!'
		\L_0341b:
		ZH 1:
		'Tiếng nổ rền vang,'
		\L_0341b:
		ZH 1:
		'tưởng chừng làm rung'
		R
		'chuyển cả tòa thành.'
		\L_0341b:
		ZH 1:
		'Đá vỡ, tro tàn và'
		R
		'máu thịt hai người'
		\L_0341b:
		ZH 1:
		'trút xuống Maris cùng'
		R
		'đám cận vệ đang nằm rạp.'
		\L_0341b:
		\L_0340e:
		!VAR0516 : 6!
		\L_033ba:
		\L_03366:
		ZH 1:
		'Chuyện ninja tự kết liễu'
		R
		'khi nhiệm vụ thất bại...'
		\L_0341b:
		ZH 1:
		'hóa ra là thật...'
		\L_0341b:
		\L_0340e:
		\L_0332e:
		ZH 1:
		'Maris vốn luôn điềm'
		R
		'tĩnh cũng tái mặt,'
		R
		'lau máu bắn lên mình.'
		\L_0341b:
		@L_03268:
	}
	!VAR0516 : 7!
	\L_033ba:
	\L_03366:
	ZH 1:
	'Đó là... Mọi người,'
	R
	'nằm rạp xuống!'
	\L_0341b:
	\L_0340e:
	\L_033c8:
	\L_0332e:
	ZH 1:
	'Nghe Leila hô,'
	R
	'mọi người sửng sốt'
	\L_0341b:
	ZH 1:
	'nhưng vẫn vội làm theo.'
	\L_0341b:
	ZH 1:
	'Ngay khoảnh khắc ấy.'
	\L_0341b:
	ZH 1:
	'ĐOÀÀÀÀNG!'
	\L_0341b:
	ZH 1:
	'Tiếng nổ rền vang,'
	\L_0341b:
	ZH 1:
	'tưởng chừng làm rung'
	R
	'chuyển cả tòa thành.'
	\L_0341b:
	ZH 1:
	'Đá vỡ, tro tàn và'
	R
	'máu thịt hai người'
	\L_0341b:
	ZH 1:
	'trút xuống Leila cùng'
	R
	'đám cận vệ đang nằm rạp.'
	\L_0341b:
	\L_0340e:
	!VAR0516 : 7!
	\L_033ba:
	\L_03382:
	ZH 1:
	'Chuyện ninja tự kết liễu'
	R
	'khi nhiệm vụ thất bại...'
	\L_0341b:
	ZH 1:
	'hóa ra là thật...'
	\L_0341b:
	\L_0340e:
	\L_0332e:
	ZH 1:
	'Khói tan, Leila chỉ lặng'
	R
	'nhìn chỗ hai người vừa đứng.'
	\L_0341b:
