	\L_033f2:
	\L_0332e:
	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	'Trước tường thành.'
	R
	'Bên bức tường đồ sộ,'
	\L_0341b:
	ZH 1:
	'một cái bóng đọng'
	R
	'lại như vũng tối.'
	\L_0341b:
	ZH 1:
	'Bóng khẽ lay động.'
	R
	'Thoắt sau, đã biến mất.'
	\L_0341b:
	ZH 1:
	'Bức tường sừng sững ấy'
	R
	'chẳng thể cản người này.'
	\L_0341b:
	ZH 1:
	'Cái bóng lướt trong thành.'
	R
	'Đó là ninja JAPAN, Gekkou.'
	\L_0341b:
	\L_0340e:
	!VAR0516 : 421!
	\L_0334a:
	\L_032f6:
	ZH 1:
	'Giờ thì...'
	\L_0341b:
	\L_0340e:
	Y 4, 2:
	{VAR0000 = 1:
		@L_00a2b:
	}
	\L_0332e:
	ZH 1:
	'Gekkou lướt qua lâu đài.'
	R
	'Bỗng hắn khựng lại.'
	\L_0341b:
	\L_0340e:
	Y 4, 3:
	!VAR0690 : VAR0000!
	\L_032f6:
	{VAR0690 = 1:
		ZH 1:
		'Có vẻ đây là nơi quản lý'
		R
		'quân phí... Vừa hay.'
		\L_0341b:
		\L_0340e:
		\L_0332e:
		ZH 1:
		'Gekkou dễ dàng mở hết lớp'
		R
		'khóa này đến lớp khóa khác.'
		\L_0341b:
		\L_0340e:
		\L_032f6:
		ZH 1:
		'Để xem... Lấy một nửa vậy.'
		\L_0341b:
		\L_0340e:
		\L_03358:
		\L_0332e:
		ZH 1:
		'Lấy đi 50% quân phí Leazas,'
		R
		'hắn lại biến mất như một cái'
		R
		'bóng.'
		\L_0341b:
		!VAR0519 : VAR0519 / 2!
	}
	{VAR0690 = 2:
		ZH 1:
		'Có vẻ đây là nơi quản lý'
		R
		'quân phí... Vừa hay.'
		\L_0341b:
		\L_0340e:
		\L_0332e:
		ZH 1:
		'Gekkou dễ dàng mở hết lớp'
		R
		'khóa này đến lớp khóa khác.'
		\L_0341b:
		\L_0340e:
		\L_032f6:
		ZH 1:
		'Để xem... Lấy một phần tư là'
		R
		'đủ.'
		\L_0341b:
		\L_0340e:
		\L_03358:
		\L_0332e:
		ZH 1:
		'Lấy đi 25% quân phí Leazas,'
