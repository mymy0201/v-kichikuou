	}
	{VAR0690 = 3:
		ZH 1:
		'Nào... Chỗ này được đấy.'
		\L_0341b:
		\L_0340e:
		\L_0332e:
		ZH 1:
		'Gekkou đặt xuống sàn chiếc'
		R
		'xô chẳng biết đã'
		\L_0341b:
		ZH 1:
		'đeo sau lưng từ bao giờ. Hắn'
		R
		'đổ hết ra'
		\L_0341b:
		ZH 1:
		'hành lang. Mùi hôi nồng nặc'
		R
		'lập tức lan khắp nơi.'
		\L_0341b:
		\L_0340e:
		\L_032f6:
		ZH 1:
		'Nhân dịp này, cứ trồng cây'
		R
		'con ở hành lang đi. Ha ha'
		R
		'ha!'
		\L_0341b:
		\L_0340e:
		\L_03358:
		\L_0332e:
		ZH 1:
		'Rải phân khắp hành lang'
		R
		'thành Leazas, Gekkou lại'
		R
		'biến mất như một cái bóng.'
		\L_0341b:
	}
