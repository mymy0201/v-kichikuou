	\L_06d4a:
	\L_06cf6:
	ZH 1:
	'A... Vâng.'
	\L_06dab:
	\L_06d9e:
	\L_06d58:
	!VAR0516 : 54!
	\L_06d4a:
	\L_06cf6:
	ZH 1:
	'Anh Kentarou...'
	\L_06dab:
	\L_06d9e:
	\L_06c86:
	ZH 1:
	'Ta sẽ trả hắn về'
