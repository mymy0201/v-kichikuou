	\L_06d58:
	!VAR0516 : 55!
	\L_06d4a:
	\L_06cf6:
	ZH 1:
	'Tôi xin phép...'
	\L_06dab:
	\L_06d9e:
	\L_06c86:
	ZH 1:
	'Ừ, ừ.'
	\L_06dab:
	\L_06d9e:
	\L_06d58:
	\L_06d2e:
	ZH 1:
	'Miki kéo tay Kentarou, rời'
