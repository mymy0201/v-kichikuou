	!VAR0154 : 18!
	{VAR0102 \ 0:
		!VAR0516 : 1046!
		\L_038f2:
		!VAR0516 : 423!
		\L_0384a:
		\L_037f6:
		ZH 1:
		'... Cuối cùng... cũng đến'
		R
		'ngày này...'
		\L_0391b:
		\L_0390e:
		\L_0382e:
		ZH 1:
		'Patton từ từ hạ'
		R
		'mình xuống ngai vàng.'
		\L_0391b:
		\L_0390e:
		!VAR0516 : 424!
		\L_038ba:
		\L_03866:
		ZH 1:
		'Xin chúc mừng, Patton.'
		\L_0391b:
		\L_0390e:
		\L_0382e:
		ZH 1:
		'Hanty đang'
		R
		'đứng cạnh Patton.'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Ừ...'
		\L_0391b:
		\L_0390e:
		\L_038c8:
		!VAR0516 : 426!
		\L_038ba:
		\L_03866:
		ZH 1:
		'Nhưng gian nan mới bắt đầu.'
		\L_0391b:
		ZH 1:
		'Bao năm chính sự rối loạn,'
		R
		'rồi chiến tranh, mất'
		\L_0391b:
		ZH 1:
		'mùa... Tái thiết sẽ lâu đấy.'
		\L_0391b:
		ZH 1:
		'Đã lấy lại nước, nhưng còn'
		\L_0391b:
		ZH 1:
		'phải theo vua Leazas đánh'
		R
		'trận. Chuyện ấy cũng'
		\L_0391b:
		ZH 1:
		'tốn tiền...'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Ừ. Freak nói đúng, từ giờ'
		R
		'mới quan trọng. Còn chuyện'
		\L_0391b:
		ZH 1:
		'tiền...'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Cái gì?'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Ông cũng nghe rồi chứ? Kho'
		R
		'vàng Lang ấy.'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Vâng...'
		\L_0391b:
		\L_0390e:
		\L_038c8:
		!VAR0516 : 424!
		\L_038ba:
		\L_03866:
		ZH 1:
		'Cậu có dự định sử dụng chúng không?'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Vâng, tôi.'
		\L_0391b:
		\L_0390e:
		\L_0382e:
		ZH 1:
		'Kho vàng Lang là một triệu'
		R
		'tấn vàng thỏi Helman tích'
		R
		'trữ qua nhiều năm.'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Nếu chúng ta sử dụng chúng,'
		\L_0391b:
		ZH 1:
		'việc khôi'
		R
		'phục lại đất nước này cũng'
		R
		'không phải là không thể.'
		\L_0391b:
		ZH 1:
		'liên minh Với'
		R
		'Leazas có nghĩa'
		\L_0391b:
		ZH 1:
		'là chúng ta cũng có thể'
		R
		'nhập khẩu thực phẩm từ họ...'
		\L_0391b:
		\L_0390e:
		\L_038c8:
		!VAR0516 : 425!
		\L_038ba:
		\L_03866:
		ZH 1:
		'Này.'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Này, Hugh. Vàng ở'
		R
		'chỗ tôi nói phải không?'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Có phải cậu... có'
		R
		'lẽ đã nhớ nhầm chăng?'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Hả?? không có vàng hay'
		R
		'bất cứ thứ gì ở bất cứ đâu.'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Không thể nào!!'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Đó là sự thật.'
		\L_0391b:
		ZH 1:
		'Tôi đã tìm thấy cánh cửa và'
		R
		'lối đi ẩn như cậu nói, nhưng'
		R
		'bên trong chẳng có gì cả.'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Điều đó không thể!!'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Tôi đã bảo là'
		R
		'không có gì mà... Cậu chắc'
		R
		'là mình không nhớ nhầm chứ?'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Chỉ hoàng tộc biết căn phòng'
		R
		'bí mật ở'
		\L_0391b:
		ZH 1:
		'tầng hầm thứ hai mươi của'
		R
		'lâu đài.'
		\L_0391b:
		\L_0390e:
		\L_038c8:
		!VAR0516 : 424!
		\L_038ba:
		\L_03866:
		ZH 1:
		'Ngược lại,'
		\L_0391b:
		ZH 1:
		'điều đó có nghĩa là mọi người trong'
		R
		'gia đình hoàng gia đều biết về nó.'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'À...!!'
		\L_0391b:
		ZH 1:
		'Pamela... Mẹ kế của'
		R
		'tôi có nói với Stessel...?'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Không phải không có khả'
		R
		'năng...'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Chết tiệt!! Đó không phải'
		R
		'vàng riêng'
		\L_0391b:
		ZH 1:
		'hoàng tộc! Là của dân!'
		\L_0391b:
		ZH 1:
		'Tên ẻo lả, trắng bệch đeo'
		R
		'kính ấy!!'
		\L_0391b:
		\L_0390e:
		\L_038c8:
		!VAR0516 : 1!
		\L_038ba:
		\L_03866:
		ZH 1:
		'Hô... Vàng hả...? Và 1.000.000 tấn nữa.'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Trời...!!'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Kêu thế là thất lễ đấy.'
		\L_0391b:
		ZH 1:
		'Người đâu!'
		\L_0391b:
		ZH 1:
		'Tên Stessel ẻo lả đeo kính'
		R
		'đã ôm vàng bỏ trốn!'
		\L_0391b:
		ZH 1:
		'Đuổi theo!!'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Chờ đã! Nó thuộc Về'
		R
		'Helman! Cậu đang có kế'
		R
		'hoạch làm gì với nó?!'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Những gì'
		R
		'của ngươi là của ta. Vì'
		R
		'vậy, đó là vàng của ta.'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Tại sao vậy?!!'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Vậy thì hãy làm điều'
		R
		'này. Nó thuộc về người'
		R
		'tìm thấy nó đầu tiên.'
		\L_0391b:
		ZH 1:
		'Điều đó sẽ tốt thôi.'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Cái gì...?'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Này, thôi nào. Chúng'
		R
		'ta là đồng minh phải không?'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Kh...'
		\L_0391b:
		ZH 1:
		'Đ... Được rồi.'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Được rồi,'
		R
		'quyết định vậy đi.'
		\L_0391b:
		\L_0390e:
		\L_03812:
		ZH 1:
		'Chết tiệt... Cái'
		R
		'đó thuộc về đất nước'
		R
		'của tôi... Chúa ơi...'
		\L_0391b:
		\L_0390e:
		\L_03858:
		!VAR0516 : 471!
		\L_0384a:
		\L_037f6:
		ZH 1:
		'Xin thứ lỗi đã ngắt lời.'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Này, cái gì vậy?'
		\L_0391b:
		\L_0390e:
		\L_037f6:
		ZH 1:
		'Bẩm, có tin xấu.'
		\L_0391b:
		ZH 1:
		'Các thành phía tây'
		\L_0391b:
		ZH 1:
		'Helman, quanh Laurengrad,'
		R
		'không'
		\L_0391b:
		ZH 1:
		'chịu thần phục nước'
		\L_0391b:
		ZH 1:
		'ta, đã nổi dậy. Chủ yếu là'
		R
		'dân binh, chắc dễ trấn áp,'
		\L_0391b:
		ZH 1:
		'nhưng...'
		\L_0391b:
		\L_0390e:
		\L_03866:
		ZH 1:
		'Hừm, đồ ngu... Đoán là'
		R
		'họ không cần mạng sống rồi.'
		\L_0391b:
		ZH 1:
		'Helman không còn nữa.'
		R
		'Lựa chọn duy nhất của họ là'
		R
		'làm việc dưới quyền của ta.'
		\L_0391b:
		\L_0390e:
		\L_03858:
		!VAR0516 : 423!
		\L_0384a:
		\L_037f6:
		ZH 1:
		'............'
		\L_0391b:
		\L_0390e:
		!VAR0516 : 0!
