	'dàng đối với ta.'
	\L_0391b:
	\L_0390e:
	\L_037f6:
	ZH 1:
	'Có lẽ...'
	\L_0391b:
	ZH 1:
	'Nhưng...'
	\L_0391b:
	ZH 1:
	'Tôi sẽ không dễ'
