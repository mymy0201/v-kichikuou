	\L_021b3:
	ZM 32:
	ZH 1:
	'Zeth - Làng Xanh'
	R
	ZM 24:
	ZH 1:
	'Kite lại tới ngôi làng vắng,'
	R
	'chẳng rõ có ai sinh sống.'
	\L_022a0:
	\L_02293:
	!VAR0516 : 57!
	\L_0223f:
	\L_021eb:
	ZH 1:
	'Hu...'
	\L_022a0:
	ZH 1:
	'hu hu... Hức... hức...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Sao thế, Calorie...?'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'À...'
	\L_022a0:
	ZH 1:
	'Hức... Anh Kite...!!'
	\L_022a0:
	\L_02293:
	\L_021b3:
	ZH 1:
	'Thấy Kite, Calorie chạy tới,'
	R
	'lao vào nép bên anh.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Calorie: Lyla đã...! Kite:'
	R
	'Em bệnh nặng nhất, lúc tỉnh'
	R
	'lúc mê ấy... Làm sao?'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Uu... Aaaah...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'... Em ấy đã mất rồi sao...?'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calorie vừa'
	R
	'khóc vừa gật đầu.'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Em ấy ra đi thanh thản chứ?'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calorie lắc đầu.'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Vậy thì...'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Tự tử...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Cái gì...?'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Lyla tự sát rồi...'
	\L_022a0:
	ZH 1:
	'Vừa nãy... Em ấy nhớ'
	R
	'lại lúc mắc bệnh,'
	\L_022a0:
	ZH 1:
	'cha mẹ ruột nhìn mình như'
	R
	'mầm bệnh...'
	\L_022a0:
	ZH 1:
	'Người yêu xô mình như thứ'
	R
	'bẩn thỉu...'
	\L_022a0:
	ZH 1:
	'Nhớ lại chuyện ấy, em ấy'
	R
	'khóc, gào thét như điên,'
	\L_022a0:
	ZH 1:
	'rồi lao xuống vách đá...!!'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'............'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Hức... Hức... Nếu còn ở'
	R
	'đây... biết đâu một ngày...'
	\L_022a0:
	ZH 1:
	'sẽ có chuyện tốt'
	R
	'xảy đến mà...'
	\L_022a0:
	ZH 1:
	'Tại sao...?'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calorie cứ thế khóc'
	R
	'mãi trong lòng Kite.'
	\L_022a0:
	\L_02293:
	\L_02197:
	ZH 1:
	'Lũ người... Các em ấy... chị'
	R
	'gái tôi...'
	\L_022a0:
	ZH 1:
	'đâu muốn mắc bệnh!'
	\L_022a0:
	ZH 1:
	'Sao có thể đày'
	R
	'đọa những cô gái'
	\L_022a0:
	ZH 1:
	'yếu đuối đến thế này?'
	\L_022a0:
	ZH 1:
	'Không tha được...'
	\L_022a0:
	ZH 1:
	'Chúng tin chỉ mình'
	R
	'chúng là độc tôn,'
	\L_022a0:
	ZH 1:
	'phô hết vẻ kiêu ngạo ấy, chỉ'
	R
	'cần bản thân được yên ổn.'
	\L_022a0:
	ZH 1:
	'Hành hạ kẻ yếu rồi tin rằng'
	\L_022a0:
	ZH 1:
	'cảm giác hơn người'
	R
	'ấy là chính đáng...'
	\L_022a0:
	ZH 1:
	'Chính chúng mới điên, mới'
	R
	'đáng chết.'
	\L_022a0:
	ZH 1:
	'Ta sẽ cho chúng'
	R
	'biết điều đó.'
	\L_022a0:
	ZH 1:
	'Phải... Ta đã nghĩ'
	R
	'thế từ trước khi ngài'
	R
	'Kayblis ra lệnh...'
	\L_022a0:
	ZH 1:
	'tao sẽ cho chúng mày nếm nỗi'
	R
	'nhục bị khinh miệt...'
	\L_022a0:
	ZH 1:
	'đến đau đớn!'
	\L_022a0:
	\L_02293:
	\L_021b3:
	ZH 1:
	'Kite ôm chặt Calorie'
	R
	'bé nhỏ đang run rẩy'
	R
	'trong lòng mình.'
	\L_022a0:
	\L_02293:
