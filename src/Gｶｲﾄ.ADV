	\L_0223f:
	\L_021eb:
	ZH 1:
	'Ờ...'
	\L_022a0:
	ZH 1:
	'Uu... Uuuu...'
	R
	'À... Hick... Chào...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Có gì sai, Calo...?'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'À...'
	\L_022a0:
	ZH 1:
	'Uu... Diều...!!'
	\L_022a0:
	\L_02293:
	\L_021b3:
	ZH 1:
