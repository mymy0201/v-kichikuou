	'như thế nào ấy hả?'
	\L_0a846:
	\L_0a839:
	\L_0a721:
	ZH 1:
	'Đúng.'
	\L_0a846:
	\L_0a839:
	\L_0a791:
	ZH 1:
	'Ví dụ như sao?'
	\L_0a846:
	\L_0a839:
	\L_0a721:
	ZH 1:
	'Màn hình có sáng quá không?'
	\L_0a846:
	ZH 1:
	'Màn hình có ngả đỏ'
