	{VAR0003 = 2:
		!VAR0003 : 3!
		!VAR0516 : 372!
		\L_0a7e5:
		\L_0a791:
		ZH 1:
		'Yo. Lại tới đấy à?'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Gì, ngươi ở đây à.'
		R
		'Ta tưởng ngươi chết'
		R
		'dọc đường rồi chứ.'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Đừng lo cho tôi nhiều'
		R
		'thế. Ngại lắm đấy.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Ta có lo đâu.'
		\L_0a846:
		ZH 1:
		'Mà này, đã tìm được người'
		R
		'đàn bà tuyệt đỉnh chưa?'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Gì, ngài tới vì cái'
		R
		'đó à. Để tôi giới'
		R
		'thiệu. Đây là bé Shino.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Ờ.'
		\L_0a846:
		\L_0a839:
		\L_0a7f3:
		!VAR0516 : 373!
		\L_0a7e5:
		\L_0a791:
		ZH 1:
		'Mà này, Vua Rance. Gửi chỗ'
		R
		'tôi một cô gái được không?'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Khoan đã. Để ta nói'
		R
		'chuyện với cô ấy.'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Như ngày xưa'
		\L_0a846:
		ZH 1:
		'Julia của Leazas tu luyện'
		R
		'dưới Hanny King, học được'
		R
		'tuyệt chiêu “Hanny Flash”...'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Bịa đặt.'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Cho luyện tập'
		R
		'dưới trướng ta,'
		\L_0a846:
		ZH 1:
		'sẽ học được tuyệt chiêu'
		R
		'“Ném axit” lừng danh'
		R
		'của ngài Chapuchapu.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Nghe người ta nói đi.'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Và cô gái'
		R
		'đó cũng sẽ có được bộ'
		R
		'đồ bơi của trường. Hừ.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Ê, phiền quá! Đừng có bắt'
		R
		'chuyện với bản đại gia!'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Ồ, đã đến lúc đó rồi sao?'
		\L_0a846:
		ZH 1:
		'Hiện tại có một trường'
		R
		'nữ sinh gần đó sắp tan'
		\L_0a846:
		ZH 1:
		'học nên cậu có thể'
		R
		'thứ lỗi cho tôi không.'
		\L_0a846:
		\L_0a839:
		\L_0a7f3:
		\L_0a721:
		ZH 1:
		'......Có ngày ta giết.'
		\L_0a846:
		\L_0a839:
		\L_0a759:
		ZH 1:
		'Rance chuyển sang chỗ'
		R
		'một nhân viên khác.'
		\L_0a846:
		\L_0a839:
	}
	{VAR0003 = 1:
		!VAR0003 : 2!
		!VAR0516 : 372!
		\L_0a7e5:
		\L_0a791:
		ZH 1:
		'Ồ. Lại đến nghe'
		R
		'ta thuyết pháp à?'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Thuyết pháp cái'
		R
		'gì. Đồ biến thái.'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Đột ngột thế này,'
		R
		'nhưng ta sẽ lên đường.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Đột ngột thật.'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Tôi đi du lịch nhiều'
		R
		'nước để tìm kiếm cô gái'
		\L_0a846:
		ZH 1:
		'lý tưởng nhất trong'
		R
		'bộ đồ bơi học sinh.'
		\L_0a846:
		ZH 1:
		'Đợi tôi nhé. Hừ.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Có ai cản đâu.'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Vậy, vĩnh biệt. Vút.'
		\L_0a846:
		\L_0a839:
		\L_0a7f3:
		\L_0a721:
		ZH 1:
		'............ Bản đại gia'
		R
		'cũng đi chỗ khác vậy.'
		\L_0a846:
		\L_0a839:
	}
	{VAR0003 = 0:
		!VAR0003 : 1!
		\L_0a759:
		ZH 1:
		'Rance bước tới cạnh'
		R
		'một con vật kỳ lạ.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Gì đây, chỗ này là gì?'
		\L_0a846:
		\L_0a839:
		!VAR0516 : 372!
		\L_0a7e5:
		\L_0a791:
		ZH 1:
		'Tên tôi là Yuuta Ishigusa.'
		\L_0a846:
		ZH 1:
		'Một con quái vật kiểu'
		R
		'tanuki thường thấy,'
		\L_0a846:
		ZH 1:
		'hơi thích đồ bơi trường'
		R
		'học một chút thôi.'
		\L_0a846:
		ZH 1:
		'Hừ.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'..................'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Ây da~, gần đây nhờ'
		R
		'một trò chơi nọ mà'
		R
		'tôi mê cả hakama nữa~.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'..................'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Mỹ nữ chính thống'
		R
		'mặc hakama. Kư~☆'
		R
		'Đam mê trào dâng!!'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'........................'
		R
		'....Về thôi.'
		\L_0a846:
		\L_0a839:
		\L_0a783:
		\L_0a791:
		ZH 1:
		'Lòng đàn ông chao đảo giữa'
		\L_0a846:
		ZH 1:
		'hakama và đồ bơi,'
		R
		'như thạch mùa đông.'
		\L_0a846:
		ZH 1:
		'Cứng rắn lắm đấy. Hừ.'
