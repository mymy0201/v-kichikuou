	{VAR0690 = 2:
		!VAR0516 : 368!
		\L_0a7e5:
		\L_0a791:
		ZH 1:
		'Chào~.'
		\L_0a846:
		ZH 1:
		'Tôi là Tori đây~,'
		\L_0a846:
		ZH 1:
		'người phẫu thuật ruột'
		R
		'thừa mất thời gian'
		R
		'gấp 4 lần người ta~.'
		\L_0a846:
		ZH 1:
		'Lẽ ra Katsumi-sensei phát'
		R
		'hành trước Kichikuou,'
		\L_0a846:
		ZH 1:
		'nhưng tôi hậu đậu'
		R
		'nên không kịp~.'
		\L_0a846:
		ZH 1:
		'Xin lỗi ạ.'
		\L_0a846:
		ZH 1:
		'Rốt cuộc,'
		\L_0a846:
		ZH 1:
		'tôi lại nằm viện lâu'
		R
		'gấp 4 lần người ta.'
		\L_0a846:
		ZH 1:
		'Còn bị viêm phúc mạc nữa,'
		\L_0a846:
		ZH 1:
		'hình như bụng tích đầy mủ'
		R
		'hay thứ nước gì chẳng rõ...'
		\L_0a846:
		ZH 1:
		'Thêm vào đó,'
		\L_0a846:
		ZH 1:
		'vết mổ cũng bị rạch to'
		\L_0a846:
		ZH 1:
		'gấp đôi người ta~.'
		\L_0a846:
		ZH 1:
		'Hu hu~.'
		\L_0a846:
		ZH 1:
		'Cho đến khoảng 5 ngày'
		R
		'trước khi ra viện,'
		\L_0a846:
		ZH 1:
		'vết mổ ở bụng còn cắm ống,'
		R
		'mủ cứ thế ri rỉ chảy ra.'
		\L_0a846:
		ZH 1:
		'Giờ sức khỏe ổn rồi, nhưng'
		R
		'thể lực vốn đã ít, sau'
		R
		'khi ra viện còn giảm mạnh.'
		\L_0a846:
		ZH 1:
		'Thành ra không làm'
		R
		'việc lâu được nữa.'
		\L_0a846:
		ZH 1:
		'Lúc viết mấy dòng'
		R
		'này đã khá hơn nhiều,'
		R
		'nhưng vết mổ vẫn đau.'
		\L_0a846:
		ZH 1:
		'Lại có kẻ thản nhiên'
		R
		'đấm vào bụng tôi...'
		\L_0a846:
		ZH 1:
		'Thế nên,'
		\L_0a846:
		ZH 1:
		'Kichikuou xong là tôi bắt'
		R
		'tay ngay vào Katsumi-sensei,'
		\L_0a846:
		ZH 1:
		'cố gắng sớm nhất có thể'
		R
		'để đến tay mọi người...'
		\L_0a846:
		ZH 1:
		'Xin mọi người để dành ít'
		R
		'tiền tiêu vặt mà chờ nhé.'
		\L_0a846:
		ZH 1:
		'Trên đây là mục bào'
		R
		'chữa của con mập~.'
		\L_0a846:
		ZH 1:
		'Hẹn gặp lại ở'
		R
		'đâu đó. Ưm hừm.'
		\L_0a846:
		\L_0a839:
		\L_0a7f3:
	}
	{VAR0690 = 3:
		\L_0a721:
		ZH 1:
		'Ờ, con mập.'
		\L_0a846:
		\L_0a839:
		!VAR0516 : 368!
		\L_0a7e5:
		\L_0a791:
		ZH 1:
		'Chào~. Vua Siêu Vũ Khí.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Vua Siêu Vũ Khí?'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Dạ phải.'
		\L_0a846:
		ZH 1:
		'Vì ngài, tôi đã cài từ'
		R
		'điển gõ chữ “ha” thành'
		R
		'“siêu vũ khí” đấy.'
		\L_0a846:
		ZH 1:
		'Chứng tỏ ngài dùng siêu vũ'
		R
		'khí liên tục cỡ nào chứ.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Gahahahaha.'
		\L_0a846:
		ZH 1:
		'Nhưng siêu vũ khí của bản'
		R
		'đại gia chỉ phản ứng với mỹ'
		R
		'nữ hoặc thiếu nữ xinh đẹp.'
		\L_0a846:
		ZH 1:
		'Cô thì chịu thôi.'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Vâng~ vâng~... Hẳn'
		R
		'là thế rồi ạ. Có phản'
		R
		'ứng thì tôi cũng khổ.'
		\L_0a846:
		ZH 1:
		'Nhắc mới nhớ, có người'
		R
		'chơi cứ để ý ngoại hình'
		R
		'nhân viên (toàn nữ).'
		\L_0a846:
		ZH 1:
		'cái đó là sao nhỉ?'
		\L_0a846:
		ZH 1:
		'Đâu phải cứ xinh đẹp là'
		R
		'làm ra sản phẩm tốt...'
		\L_0a846:
		ZH 1:
		'Ôi, buồn ghê.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Kẻ xấu xí lắm nỗi khổ thật.'
		\L_0a846:
		ZH 1:
		'Bản đại gia thì chưa'
		R
