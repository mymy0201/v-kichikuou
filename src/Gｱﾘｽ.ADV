	\L_0a839:
	\L_0a791:
	ZH 1:
	'Ai?'
	\L_0a846:
	\L_0a839:
	\L_0a721:
	ZH 1:
	'Chưa xếp hạng,'
	\L_0a846:
	ZH 1:
	'nhưng những người đang'
