		!VAR0516 : 368!
		\L_0a7e5:
		\L_0a791:
		ZH 1:
		'Dạ~... Không cãi được~~.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Cô làm gì ở đây?'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Dạ~~... Tôi đang dốc cả mạng'
		R
		'viết những câu văn khiến'
		R
		'đầu dương vật ướt nhẹp~.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Đã mập lại còn thô tục,'
		R
		'đàn bà gì mà hỏng!!'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'A~... Không cãi được~~.'
		\L_0a846:
		\L_0a839:
		\L_0a721:
		ZH 1:
		'Hừ. Sợ lây cái mập,'
		R
		'ta về cho nhanh.'
		\L_0a846:
		\L_0a839:
		\L_0a791:
		ZH 1:
		'Lại đến nhé~. Tarirarira~n.'
