	!VAR0516 : 470!
	\L_05363:
	\L_0529f:
	ZH 1:
	'Ngươi là Pluepet à?'
	\L_053c4:
	\L_053b7:
	\L_05347:
	ZH 1:
	'Vâng, vâng. Kính chào các'
