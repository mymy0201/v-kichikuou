	'phải trả lời người'
	R
	'ta cho đàng hoàng...'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'Ừm, cũng phải nhỉ...'
	\L_075ce:
	ZH 1:
	'Nhưng mà...'
