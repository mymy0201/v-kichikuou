	\L_075c1:
	\L_074a9:
	ZH 1:
	'Ơ...'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'......Meo~~~... Biết rồi!!'
	\L_075ce:
	ZH 1:
	'Chị Leila thích...'
