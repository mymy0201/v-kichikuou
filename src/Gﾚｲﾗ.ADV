	'có ngày mình......'
	\L_075ce:
	\L_075c1:
	\L_07551:
	ZH 1:
	'Xin phép.'
	\L_075ce:
	ZH 1:
	'Có người bước vào lều.'
	\L_075ce:
	\L_075c1:
	\L_0757b:
