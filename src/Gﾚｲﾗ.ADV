	'vẫn không hài lòng, Rance'
	R
	'khỏa thân nằm trên giường.'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'............'
	\L_075ce:
	\L_075c1:
	\L_07551:
	ZH 1:
	'Bên cạnh anh,'
	R
	'Leila đang mặc quần áo,'
	R
	'trông có vẻ hơi khó chịu.'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'Chạy đua...'
	\L_075ce:
	\L_075c1:
	\L_074a9:
	ZH 1:
	'Gì vậy?'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'... Hãy nhớ'
	R
	'giữ lời hứa nhé.'
	\L_075ce:
	\L_075c1:
	\L_074a9:
	ZH 1:
	'Hứa...'
	\L_075ce:
	ZH 1:
	'Aah, về các cô'
	R
	'gái Vệ binh Hoàng gia...'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'Đừng chạm vào chúng.'
	\L_075ce:
	\L_075c1:
	\L_074a9:
	ZH 1:
	'Được rồi, hiểu rồi,'
	R
	'hiểu rồi. Để đó cho ta.'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'... Làm ơn.'
	\L_075ce:
	\L_075c1:
	\L_0757b:
	\L_07551:
	ZH 1:
	'Leila lặng lẽ'
