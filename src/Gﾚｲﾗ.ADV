	R
	'tuyến HQ Ừm, ừm, Leila.'
	\L_075ce:
	\L_075c1:
	\L_074a9:
	ZH 1:
	'Chuyện gì vậy, Julia?'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'Em... em nhận'
