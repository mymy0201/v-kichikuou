	ZH 1:
	'Vâng.'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'Tôi... muốn cố gắng.'
	\L_075ce:
	ZH 1:
	'Với tư cách đội trưởng'
