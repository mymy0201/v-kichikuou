	'xuống ngay tại chỗ.'
	\L_06bc3:
	\L_06bb6:
	\L_06a9e:
	ZH 1:
	'...Haa.'
	\L_06bc3:
	\L_06bb6:
	\L_06b0e:
	ZH 1:
	'Giờ tôi đưa mẹ con cháu'
	R
