	R
	'Sill đang ngồi đọc sách.'
	\L_09789:
	\L_0977c:
	\L_096d4:
	ZH 1:
	'Phù...'
	\L_09789:
	\L_0977c:
	\L_0969c:
	ZH 1:
	'Khẽ thở ra một tiếng mơ'
