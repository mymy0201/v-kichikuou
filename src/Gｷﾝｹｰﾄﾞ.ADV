	ZM 32:
	ZH 1:
	'Thành Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng yết kiến. Rance triệu'
	R
	'kiến Kinkaid.'
	\L_01131:
	\L_01124:
	!VAR0516 : 406!
	\L_010d0:
	Y 4, 2:
	{VAR0000 = 1:
		\L_0107c:
		ZH 1:
		'Được diện kiến tân vương'
		R
		'Leazas, Bệ hạ Rance, kẻ'
		R
		'hèn này vinh hạnh vô cùng.'
		\L_01131:
		\L_01124:
		\L_01044:
		ZH 1:
		'Kinkaid quỳ gối trước'
		R
		'Rance, cúi đầu thật sâu.'
		\L_01131:
		\L_01124:
		\L_0100c:
		ZH 1:
		'Ừ. Thôi, đừng cứng nhắc thế.'
		\L_01131:
		\L_01124:
		\L_0107c:
		ZH 1:
		'Ôi, lời vàng ngọc ấy'
		R
		'thần nào dám nhận...!'
		\L_01131:
		\L_01124:
		\L_01044:
		ZH 1:
		'Lần này Kinkaid lại'
		R
		'ngẩng phắt lên, mắt'
		R
		'mở to tỏ vẻ cảm động.'
		\L_01131:
		\L_01124:
		\L_0107c:
		ZH 1:
		'Chỉ được Bệ hạ sai khiến đã'
		R
		'là phúc phận lớn lao, vậy mà'
		R
		'Bệ hạ còn ban lời vàng ngọc!'
		\L_01131:
		ZH 1:
		'Được nghe giọng ngọc, chiêm'
		R
		'ngưỡng dung nhan Bệ hạ'
		\L_01131:
		ZH 1:
		'thôi cũng đủ khiến thần lên'
		R
		'tận mây xanh...!'
		\L_01131:
		\L_01124:
		\L_0100c:
		ZH 1:
		'N-này, khoan, Kinkaid. Đừng'
		R
		'nói thứ thổ ngữ quái gở'
		R
		'ấy. Ta chẳng hiểu gì cả.'
		\L_01131:
		\L_01124:
		\L_0107c:
		ZH 1:
		'Dạ... Vậy thưa Bệ hạ'
		R
		'Rance... Bệ hạ cho'
		R
		'gọi thần có việc gì ạ?'
		\L_01131:
		\L_01124:
		\L_0100c:
		ZH 1:
		'Hừm... Quên rồi.'
		R
		'Chẳng có gì, lui đi.'
		\L_01131:
		\L_01124:
		\L_01098:
		ZH 1:
		'Chậc, nịnh chẳng bõ công...'
		\L_01131:
		\L_01124:
		\L_0100c:
		ZH 1:
		'...Ngươi vừa nghĩ gì đấy?'
		\L_01131:
		\L_01124:
		\L_0107c:
		ZH 1:
		'K-Không, chẳng có gì ạ!'
		\L_01131:
		\L_01124:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR0000 = 2:
		\L_0107c:
		ZH 1:
		'Bệ hạ Rance, nếu không quá'
		R
		'đường đột, hôm nay thần có'
		R
		'chút quà muốn dâng Bệ hạ...'
		\L_01131:
		\L_01124:
		\L_0100c:
		ZH 1:
		'Hửm, gì thế? Đồ vớ vẩn'
		R
		'thì ta nổi giận đấy.'
		\L_01131:
		\L_01124:
		\L_0107c:
		ZH 1:
		'Dạ, là thứ vô cùng'
		R
		'quý hiếm. Chắc chắn'
		R
		'Bệ hạ sẽ vừa lòng...'
		\L_01131:
		ZH 1:
		'Loại quả ngon tên là củ cải'
		R
		'muối, thuộc hạ thần mới hái'
		R
		'được trên núi hôm trước.'
		\L_01131:
		ZH 1:
		'Xin Bệ hạ thưởng thức...'
		\L_01131:
		\L_01124:
		\L_0100c:
		ZH 1:
		'Ta ghét củ cải muối.'
		\L_01131:
		\L_01124:
		\L_0107c:
		ZH 1:
		'À không, vâng, Bệ hạ nói'
		R
		'chí phải. Thứ đồ bỏ đi này'
		\L_01131:
		ZH 1:
		'vứt quách cho rồi. Vèo.'
		\L_01131:
		ZH 1:
		'Để chuộc tội dâng'
		R
		'đồ bỏ đi, Bệ hạ có'
		R
		'muốn vật gì không ạ?'
		\L_01131:
		ZH 1:
		'Nếu có, thần xin lo liệu...'
		\L_01131:
		\L_01124:
		\L_0100c:
		ZH 1:
		'Để xem nào... Cơm tempura.'
		R
		'Ta thèm cơm tempura.'
		\L_01131:
		\L_01124:
		\L_0107c:
		ZH 1:
		'Dạ, thần xin dọn ngay cơm'
		R
		'tempura tôm hảo hạng cỡ'
		R
		'đại, độc nhất thiên hạ...!'
		\L_01131:
		\L_01124:
		\L_0100c:
		ZH 1:
		'Không phải. Bản đại gia'
		R
		'thích tempura lớp bột'
		R
		'thật dày cơ. Thôi, lui đi.'
		\L_01131:
		\L_01124:
		\L_0107c:
		ZH 1:
		'...Hầy...'
		\L_01131:
		ZH 1:
		'Vậy là thần đã nhiều'
		R
		'chuyện... Xin Bệ hạ thứ'
		R
		'lỗi, thần xin cáo lui.'
		\L_01131:
		\L_01124:
		\L_01044:
		ZH 1:
		'Kinkaid lủi thủi rút lui.'
		\L_01131:
		\L_01124:
		\L_010de:
		\L_0100c:
		ZH 1:
		'Hừ, nịnh còn non tay lắm.'
		\L_01131:
		\L_01124:
