	\L_02223:
	ZM 32:
	ZH 1:
	'Tàn tích chiến'
	\L_02310:
	ZM 24:
	ZH 1:
	'trường Rolex, vị tướng đáng'
	R
	'thương không phát huy được'
	R
	'thực'
	\L_02310:
	ZH 1:
	'lực vì say rượu, nằm'
	\L_02310:
	ZH 1:
	'gục giữa vũng máu lớn. Chàng'
	R
	'đã chết.'
	\L_02310:
	\L_02303:
	!VAR0156 : 51!
