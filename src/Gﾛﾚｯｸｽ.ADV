		\L_02303:
		\L_02293:
		ZH 1:
		'Katyusha trừng mắt nhìn thi'
		R
		'thể Rolex.'
		\L_02310:
		\L_02303:
		\L_021eb:
		ZH 1:
		'Mọi chuyện sẽ kết thúc'
		R
		'nếu cậu chết. Người đàn ông'
		R
		'ngu ngốc... đó là nhàm chán.'
		\L_02310:
		ZH 1:
		'Tạm Biệt, Rolex.'
		\L_02310:
		\L_02303:
		\L_0224d:
		\L_02223:
		ZH 1:
		'Katyusha chộp lấy'
		R
		'chiếc vali chứa đầy vàng,'
		R
		'bạc và quần áo rồi bỏ đi.'
		\L_02310:
		\L_02303:
	}
