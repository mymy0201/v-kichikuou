	\L_06619:
	\L_06563:
	!VAR0516 : 1!
	\L_06555:
	\L_06501:
	ZH 1:
	'Gahahahaha!, lại'
	R
	'làm thêm một con búp'
	R
	'bê đất sét nữa à?'
	\L_06626:
	\L_06619:
