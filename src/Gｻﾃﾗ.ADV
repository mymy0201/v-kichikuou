	\L_06501:
	ZH 1:
	'Ôi!?'
	\L_06626:
	\L_06619:
	\L_065a9:
	ZH 1:
	'Caesar bế Rance'
	R
	'lên cổ như thể anh'
	R
	'ta là một con mèo.'
	\L_06626:
	\L_06619:
	\L_06501:
	ZH 1:
	'H-Này!'
	\L_06626:
	\L_06619:
