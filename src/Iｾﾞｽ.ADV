	MM 8, VAR0200 + VAR0158 - 1:
	\L_07704:
	ZM 32:
	ZH 1:
	'Zeth - Hổ Phách'
	R
	ZM 24:
	ZH 1:
	R
	'Di sản của Kabachahn'
	\L_077f1:
	\L_077e4:
	!VAR0516 : 458!
	\L_07720:
	\L_076cc:
	ZH 1:
	'Ôi trời, chiến tranh'
	R
	'thật là phiền toái. Điều'
	R
	'này đã trở nên rắc rối.'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Trong căn phòng'
	R
	'trong ngôi nhà cổ kính của'
	R
	'mình, một ông già thở dài.'
	\L_077f1:
	\L_077e4:
	!VAR0516 : 254!
	\L_07790:
	\L_0773c:
	ZH 1:
	'（Futaba) Ông ơi,'
	R
	'chiến tranh là gì vậy?'
	\L_077f1:
	ZH 1:
	'（Moe) Đó có phải'
	R
	'là vấn đề không…?'
	\L_077f1:
	\L_077e4:
	\L_076cc:
	ZH 1:
	'Này, Futaba,'
	R
	'Moe. Tôi đang làm việc'
	R
	'quan trọng, hãy đi đi.'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'（Futaba) Không. Thôi'
	R
	'nào, chiến tranh là gì?'
	\L_077f1:
	ZH 1:
	'（Moe) Tôi'
	R
	'không thích khi ngươi gặp'
	R
	'rắc rối... Waaah... Aah...'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Hai đứa trẻ trông nhỏ'
	R
	'hơn và khác hẳn con người'
	R
	'một chút đi theo ông già.'
	\L_077f1:
	ZH 1:
	'Họ là homunculi,'
	R
	'con người thực vật.'
	\L_077f1:
	ZH 1:
	'Việc ông có thể nuôi'
	R
	'dưỡng những sinh vật nhân'
	\L_077f1:
	ZH 1:
	'tạo phức tạp chứng tỏ ông'
	R
	'già là một pháp sư vĩ đại.'
	\L_077f1:
	\L_077e4:
	\L_0779e:
	!VAR0516 : 457!
	\L_07790:
	\L_0773c:
	ZH 1:
	'Sẽ ổn thôi...'
	R
	'Đừng khóc, Moe.'
	\L_077f1:
	ZH 1:
	'Không có gì'
	R
	'phải lo cả, Kabachahn.'
	\L_077f1:
	ZH 1:
	'Suy cho cùng'
	R
	'thì lý do chúng ta ở đây là'
	R
	'để chuẩn bị cho cuộc chiến.'
	\L_077f1:
	\L_077e4:
	\L_076cc:
	ZH 1:
	'Ừm, à, vâng...'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Bốn vị tướng đã'
	R
	'tập trung ở đó.'
	\L_077f1:
	ZH 1:
	'Họ là những pháp sư'
	R
	'mạnh mẽ lãnh đạo bốn đội'
	R
	'quân ma thuật của Zeth...'
	\L_077f1:
	\L_077e4:
	\L_0772e:
	\L_0779e:
	!VAR0516 : 458!
	\L_07720:
	\L_07704:
	ZH 1:
	'Tướng quân của đội'
	R
	'quân tia chớp, Kabachahn.'
	\L_077f1:
	ZH 1:
	'Một người'
	R
	'mà ngay cả Gandhi, Vua của'
	R
	'Zeth, cũng phải ngưỡng mộ.'
	\L_077f1:
	\L_077e4:
	!VAR0516 : 457!
	\L_07790:
	\L_07704:
	ZH 1:
	'Tướng quân của'
	R
	'Băng quân, Uspira Shintou.'
	\L_077f1:
	ZH 1:
	'Cô trước đây là một'
	R
	'nhà nghiên cứu quân đội.'
	\L_077f1:
	ZH 1:
	'Người yêu của cô chết'
	R
	'trong một tai nạn nghiên'
	R
	'cứu và cô lao vào chiến đấu.'
	\L_077f1:
	ZH 1:
	'Sự huấn luyện đầy'
	R
	'nhiệt huyết của cô đã khiến'
	R
	'cô trở thành một vị tướng.'
	\L_077f1:
	\L_077e4:
	\L_0772e:
	!VAR0516 : 459!
	\L_07720:
	\L_07704:
	ZH 1:
	'Tướng quân nhẹ, Alex.'
	\L_077f1:
	ZH 1:
	'Nếu lòng căm thù đàn'
	R
	'ông và bản tính hiền lành'
	R
	'của Chizuko không cản trở,'
	\L_077f1:
	ZH 1:
	'anh ta thậm chí còn có'
	R
	'tài lãnh đạo Tứ chúa tể.'
	\L_077f1:
	\L_077e4:
	\L_0779e:
	!VAR0516 : 456!
	\L_07790:
	\L_07704:
	ZH 1:
	'Tướng quân của'
	R
	'Hỏa quân, Saias.'
	\L_077f1:
	ZH 1:
	'Anh ta đã leo lên'
	R
	'từ một người lính đến vị'
	\L_077f1:
	ZH 1:
	'trí hiện tại chỉ trong'
	R
	'một năm chỉ bằng kỹ năng.'
	\L_077f1:
	\L_077e4:
	\L_0772e:
	!VAR0516 : 458!
	\L_07720:
	\L_076cc:
	ZH 1:
	'Nhưng đây là một'
	R
	'điều khá nghiêm trọng xảy'
	R
	'ra khi Nhà vua đi vắng...'
	\L_077f1:
	ZH 1:
	'Ông ấy cũng đang'
	R
	'gặp rắc rối. Sự vắng mặt của'
	R
	'hắn là một mối phiền toái.'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Kabachahn hít một'
	R
	'hơi thật sâu nữa.'
	\L_077f1:
	ZH 1:
	'Lần này không phải là'
	R
	'một tiếng thở dài mà là một'
	R
	'hơi thở thô bạo qua mũi anh.'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'Tuy nhiên, hắn'
	R
	'là một chàng trai'
	R
	'tốt và nam tính...'
	\L_077f1:
	ZH 1:
	'Ngươi nói cho hắn biết'
	R
	'suy nghĩ của hắn vào lần'
	R
	'tới khi hắn quay lại nhé?'
	\L_077f1:
	ZH 1:
	'Nếu ông than vãn'
	R
	'với hắn thì có thể hắn sẽ'
	R
	'lắng nghe đấy, ông già ạ.'
	\L_077f1:
	\L_077e4:
	\L_076cc:
	ZH 1:
	'Đừng ngu ngốc nữa,'
	R
	'Saias. Các chư hầu chính'
	R
	'đã cố gắng làm điều đó.'
	\L_077f1:
	ZH 1:
	'Hắn không phải là người sẽ'
	R
	'lắng nghe lời than vãn của'
	R
	'những người có đặc quyền...'
	\L_077f1:
	ZH 1:
	'Thật lãng phí thời gian.'
	\L_077f1:
	\L_077e4:
	\L_0779e:
	!VAR0516 : 459!
	\L_07790:
	\L_0773c:
	ZH 1:
	'Đúng vậy, Bệ hạ là người có'
	R
	'nhiệm vụ giúp đỡ những người'
	R
	'yếu thế trên đường phố.'
	\L_077f1:
	ZH 1:
	'Thế không'
	R
	'tốt sao? Đó không phải là'
	R
	'điều dễ dàng thực hiện...'
	\L_077f1:
	ZH 1:
	'Chúng ta có một'
	R
	'vị vua tuyệt vời. Chúng'
	R
	'ta nên tôn trọng hắn.'
	\L_077f1:
	\L_077e4:
	\L_076cc:
	ZH 1:
	'Nếu hắn luôn'
	R
	'đi xa và không nghĩ đến'
	R
	'những người hắn sẽ ra đi,'
	\L_077f1:
	ZH 1:
	'tôi muốn hắn'
	R
	'chọn người kế nhiệm.'
	\L_077f1:
	ZH 1:
	'Thế à, cậu bé?'
	R
	'Ngươi nghĩ gì về điều đó?'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'S-Sao bây giờ em'
	R
	'lại hỏi anh điều đó...?'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Chủ đề đột nhiên được'
	R
	'đưa ra khiến Alex bối rối.'
	\L_077f1:
	ZH 1:
	'Ba người còn lại'
	R
	'mỉm cười và nhìn anh.'
	\L_077f1:
	\L_077e4:
	\L_0772e:
	!VAR0516 : 254!
	\L_07720:
	\L_076cc:
	ZH 1:
	'（Futaba） Aaah,'
	R
	'hắn đang đỏ mặt kìa!'
	\L_077f1:
	\L_077e4:
	\L_0772e:
	!VAR0516 : 458!
	\L_07720:
	\L_076cc:
	ZH 1:
	'Chàng trai, hãy'
	R
	'sớm kết hôn với Miss Magic'
	R
	'và trở thành Vua của Zeth.'
	\L_077f1:
	ZH 1:
	'Tôi sẽ hỗ trợ ngươi.'
	\L_077f1:
	\L_077e4:
	\L_0772e:
	!VAR0516 : 254!
	\L_07720:
	\L_076cc:
	ZH 1:
	'（Moe) Tôi cũng vậy!'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'Futaba, Moe...'
	R
	'Ngay cả hai người cũng'
	R
	'dính vào chuyện này à?'
	\L_077f1:
	\L_077e4:
	\L_0772e:
	!VAR0516 : 456!
	\L_07720:
	\L_076cc:
	ZH 1:
	'Ừ, thế thì tốt.'
	\L_077f1:
	ZH 1:
	'Nếu ngươi là Vua của Zeth,'
	\L_077f1:
	ZH 1:
	'chúng tôi cũng'
	R
	'sẽ không bị Lãnh chúa'
	R
	'Chizuko cản trở nữa.'
	\L_077f1:
	ZH 1:
	'Thế còn việc tổ'
	R
	'chức đám cưới khi nhà'
	R
	'vua đi vắng thì sao?'
	\L_077f1:
	ZH 1:
	'Ngay cả khi sau'
	R
	'này ngươi phải nhận được'
	R
	'sự chấp thuận của ông ấy,'
	\L_077f1:
	ZH 1:
	'Nhà vua cuối'
	R
	'cùng sẽ không phàn nàn'
	R
	'miễn là Magic vui vẻ.'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'Tôi không thể làm điều đó…'
	\L_077f1:
	ZH 1:
	'Tôi sẽ nhận được'
	R
	'sự chấp thuận của Nhà'
	R
	'vua một cách đúng đắn.'
	\L_077f1:
	ZH 1:
	'Vậy thì tôi sẽ cưới'
	R
	'Magic một cách đàng hoàng…'
	\L_077f1:
	ZH 1:
	'Tôi đã thề với nàng'
	R
	'rằng tôi sẽ cưới nàng.'
	\L_077f1:
	ZH 1:
	'Tôi sẽ không'
	R
	'phá vỡ lời hứa đó.'
	\L_077f1:
	\L_077e4:
	\L_0772e:
	!VAR0516 : 458!
	\L_07720:
	\L_076cc:
	ZH 1:
	'Em ơi, em yêu... Con'
	R
	'ngoan quá đấy, cậu bé.'
	\L_077f1:
	\L_077e4:
	\L_0772e:
	!VAR0516 : 457!
	\L_07720:
	\L_076cc:
	ZH 1:
	'Nếu ngươi không dùng vũ'
	R
	'lực, điều gì sẽ xảy ra nếu'
	R
	'Vua Gandhi không chấp thuận?'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'Ờ... Nhưng tôi...'
	\L_077f1:
	\L_077e4:
	\L_076cc:
	ZH 1:
	'Nhưng tôi tin tưởng'
	R
	'ngươi sẽ làm được điều đó.'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'Uspira... Cảm ơn ngươi.'
	\L_077f1:
	\L_077e4:
	\L_0772e:
	!VAR0516 : 456!
	\L_07720:
	\L_076cc:
	ZH 1:
	'Bây giờ, hãy bắt'
	R
	'đầu cuộc họp chiến lược.'
	\L_077f1:
	ZH 1:
	'Ngươi cũng sẽ phải'
	R
	'giành được một hoặc hai'
	\L_077f1:
	ZH 1:
	'chiến thắng trước Leazas'
	R
	'nếu muốn được chấp thuận.'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'Được rồi...!'
	\L_077f1:
	\L_077e4:
