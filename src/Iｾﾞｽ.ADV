	ZM 32:
	ZH 1:
	'Zeth'
	R
	ZM 24:
	ZH 1:
	R
	'Pháo đài'
	R
	'của Adam Phần lớn pháo đài'
	R
	'bằng đá kiên cố đã sụp đổ.'
	\L_077f1:
	ZH 1:
	'Những mũi tên'
	R
	'lửa phóng vào nó đốt cháy'
	R
	'những vật dụng bên trong.'
	\L_077f1:
	ZH 1:
	'Saias ngồi bên trong pháo'
	R
	'đài đang cháy, bị thương.'
	\L_077f1:
	\L_077e4:
	!VAR0516 : 456!
	\L_07720:
	\L_076cc:
	ZH 1:
	'Có lẽ đây là'
	R
	'kết thúc đối với tôi...'
	\L_077f1:
	ZH 1:
	'Hah... Có lẽ tôi'
	R
	'đã sử dụng quá nhiều'
	R
	'may mắn vào phụ nữ.'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Saias cười từ khóe'
	R
	'miệng và lấy ra một chiếc'
	R
	'hộp nhỏ từ dưới áo choàng.'
	\L_077f1:
	\L_077e4:
	\L_076cc:
	ZH 1:
	'Uspira...'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Anh mở nắp...'
	\L_077f1:
	ZH 1:
	'Bên trong,'
	\L_077f1:
	ZH 1:
	'một chiếc nhẫn'
	R
	'được trang trí bằng đá màu'
	R
	'xanh nhạt tỏa sáng với ánh'
	\L_077f1:
	ZH 1:
	'lửa Có lẽ nó'
	R
	'sẽ kết thúc nếu tôi không'
	R
	'đưa cái này cho ngươi...'
	\L_077f1:
	ZH 1:
	'Tôi thậm chí còn chưa'
	R
	'bao giờ nói với ngươi...'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Saias bị nhấn'
	R
	'chìm trong ngọn lửa...'
	\L_077f1:
	\L_077e4:
