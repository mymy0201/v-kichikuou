	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	'Phòng yết kiến. Bệ hạ,'
	R
	'thần bẩm việc được chứ?'
	\L_077f1:
	\L_077e4:
	!VAR0154 : 2!
	{VAR0102 \ 0:
		\L_07704:
		ZH 1:
		'Rance đang để Sill'
		R
		'ngoáy tai cho mình.'
		\L_077f1:
		\L_077e4:
		\L_076cc:
		ZH 1:
		'Ừm... Đợi chút. Sill, sang'
		R
		'phải nữa... Đúng, chỗ ấy...'
		\L_077f1:
		\L_077e4:
		\L_0779e:
		!VAR0516 : 2!
		\L_07790:
		\L_0773c:
		ZH 1:
		'Chủ nhân Rance, em lấy được'
		R
		'một mẩu to lắm này.'
		\L_077f1:
		\L_077e4:
		\L_076cc:
		ZH 1:
		'Cho ta xem.'
		\L_077f1:
		\L_077e4:
		\L_0773c:
		ZH 1:
		'Ơ, à, vâng...'
		\L_077f1:
		\L_077e4:
		\L_076cc:
		ZH 1:
		'Ồ, ồ. Đ-Đây là...'
		\L_077f1:
		\L_077e4:
		\L_0779e:
		!VAR0516 : 5!
		\L_07790:
		\L_0773c:
		ZH 1:
		'Thật là... Chàng'
		R
		'yêu, bỏ mặc nô lệ đi!'
		R
		'Nghe Maris nói nào!'
		\L_077f1:
		\L_077e4:
		\L_076cc:
		ZH 1:
		'Ồn quá. Biết rồi, biết rồi.'
		R
		'Maris, việc gì, nói đi.'
		\L_077f1:
		\L_077e4:
		\L_0779e:
		!VAR0516 : 6!
		\L_07790:
	}
	{VAR0102 = 0:
		\L_076cc:
		ZH 1:
		'Việc gì... Tin tốt'
		R
		'à? Thế thì ta nghe.'
		\L_077f1:
		\L_077e4:
	}
	\L_0773c:
	ZH 1:
	'Bẩm,'
	\L_077f1:
	ZH 1:
	'Zeth vừa tuyên'
	\L_077f1:
	ZH 1:
	'bố đầu hàng vô điều kiện'
	R
	'trước nước ta.'
	\L_077f1:
	\L_077e4:
	\L_076cc:
	ZH 1:
	'Ồ, tốt quá.'
	\L_077f1:
	ZH 1:
	'Nước ấy chống cự dai thật...'
	\L_077f1:
	ZH 1:
	'Nhưng Tứ Đại Lãnh'
	R
	'Chúa bại rồi thì hết'
	R
	'cách chống chọi nhỉ...'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'Xin chúc mừng, Bệ hạ.'
	\L_077f1:
	\L_077e4:
	\L_0779e:
	!VAR0516 : 5!
	\L_07790:
	\L_0773c:
	ZH 1:
	'Chàng yêu làm được rồi!'
	\L_077f1:
	\L_077e4:
	!VAR0154 : 2!
	{VAR0102 \ 0:
		\L_0779e:
		!VAR0516 : 2!
		\L_07790:
		\L_0773c:
		ZH 1:
		'Chủ nhân Rance, ừm...'
		R
		'Em xin chúc mừng ngài.'
		\L_077f1:
		\L_077e4:
	}
	\L_076cc:
	ZH 1:
	'Ừ. Lại tiến thêm một bước'
	R
	'tới tham vọng của ta.'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Chinh phục'
	R
	'Vương quốc Zeth.'
