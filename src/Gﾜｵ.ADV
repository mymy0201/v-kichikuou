*L_01094:
	!VAR0516 : 381!
	\L_016a0:
	!VAR0516 : 394!
	\L_01710:
	\L_01668:
	ZH 1:
	'Công việc của tôi'
	R
	'là lập trình viên.'
	\L_01771:
	ZH 1:
	'Hầu hết phần nhập'
	R
	'liệu khi chơi game'
	\L_01771:
	ZH 1:
	'đều do tay tôi làm.'
	\L_01771:
	ZH 1:
	'Mục số liệu thống kê đủ loại'
	R
	'là tôi thích nên làm thêm,'
	\L_01771:
	ZH 1:
	'nhưng làm giữa chừng'
	R
	'thì ngán. (Dở dang)'
	\L_01771:
	ZH 1:
	'Nhắc mới nhớ, phim mở'
	R
	'đầu vẫn chưa xong đâu.'
	\L_01771:
	ZH 1:
	'Phải rồi, phần mở đầu'
	R
	'cũng là việc của tôi.'
	\L_01771:
	ZH 1:
	'Đoạn chạy lúc khởi'
	R
	'động là phần dẫn truyện'
	R
	'giải thích bối cảnh.'
	\L_01771:
	ZH 1:
	'Còn phim mở đầu thực sự được'
	R
	'chèn giữa chương đạo tặc'
	R
	'và chương quân phản loạn,'
	\L_01771:
	ZH 1:
	'thành bố cục hai phần.'
	R
	'Phần mở đầu chạy theo'
	R
	'sở thích của tôi quá đà,'
	\L_01771:
	ZH 1:
	'thấy có lỗi với'
	R
	'đội viết kịch bản'
	\L_01771:
	ZH 1:
	'nên tôi mới làm vậy.'
	R
	'Né khéo đấy chứ?'
	\L_01771:
	ZH 1:
	'Hừ hừ...'
	\L_01771:
	\L_01764:
	\L_0171e:
