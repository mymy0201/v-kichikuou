	{VAR0426 = 4:
		!VAR0426 : 5!
		\L_037e7:
		ZH 1:
		'Ta đến gặp Maria đây.'
		R
		'Phòng bệnh ở đâu?'
		\L_0390c:
		\L_038ff:
		\L_03857:
		ZH 1:
		'Ha~ về cô Maria thì~,'
		R
		'Bệ hạ~, cái này ạ~.'
		\L_0390c:
		\L_038ff:
		\L_0381f:
		ZH 1:
		'Aya đưa cho Rance một'
		R
		'lá thư. Rance「Gì đây?」'
		\L_0390c:
		\L_038ff:
		\L_03857:
		ZH 1:
		'Là thư cô Maria'
		R
		'gửi Bệ hạ ạ~.'
		\L_0390c:
		ZH 1:
		'Cô Maria bảo~ giờ chưa'
		R
		'muốn gặp Bệ hạ~...'
		\L_0390c:
		\L_038ff:
		\L_0381f:
		ZH 1:
		'Rance xoạt một tiếng'
		R
		'xé phong bì, bắt đầu'
		R
		'đọc lá thư bên trong.'
		\L_0390c:
		ZH 1:
		'［Xin lỗi anh, Rance.'
		\L_0390c:
		ZH 1:
		'Tôi đã làm hỏng viện'
		R
		'nghiên cứu anh cất'
		R
		'công xây cho tôi.'
		\L_0390c:
		ZH 1:
		'Lại còn làm nhiều nhà'
		R
		'nghiên cứu bị thương.'
		\L_0390c:
		ZH 1:
		'...Xin lỗi. Cho tôi thêm'
		R
		'chút thời gian......'
		R
		'Maria］ Rance「Ừm...'
		\L_0390c:
		ZH 1:
		'nghĩa là sao? Cho'
		R
		'thêm thời gian...」'
		\L_0390c:
		ZH 1:
		'Aya「Bệ hạ~, dù sao'
		R
		'thì bây giờ xin cứ'
		R
		'để cô ấy yên ạ~...'
		\L_0390c:
		ZH 1:
		'Đó là mong muốn'
		R
		'của bệnh nhân~.」'
		\L_0390c:
		\L_038ff:
		\L_037e7:
		ZH 1:
		'......Được rồi... Cô ấy vẫn'
		R
		'khỏe đấy chứ? Aya「Vâng~.'
		\L_0390c:
		ZH 1:
		'Ăn tuy ít nhưng vẫn'
		R
		'ăn uống đầy đủ ạ~.」'
		R
		'Rance「Vậy là được.'
		\L_0390c:
		ZH 1:
		'Phần còn lại giao'
		R
		'cho em.」 Aya「Dạ~'
		R
		'em sẽ cố hết sức~.」'
		\L_0390c:
		\L_038ff:
		\L_0381f:
		ZH 1:
		'Rance rời khỏi Bệnh'
		R
		'viện Thiên Tài.'
		\L_0390c:
		\L_038ff:
