	\L_057e7:
	!VAR0516 : 42!
	\L_05723:
	!VAR0516 : 71!
	\L_05793:
	\L_056cf:
	ZH 1:
	'Ừm...'
	\L_057f4:
	\L_057e7:
	\L_0573f:
	ZH 1:
	'Hãy trở về đất nước'
