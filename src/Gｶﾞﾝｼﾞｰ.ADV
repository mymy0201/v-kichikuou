	{VAR0690 = 1:
		\L_056cf:
		ZH 1:
		'Này, lão Gandhi. Ngươi'
		R
		'là vua Zeth phải không?'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Không, bệ hạ Rance. Chuyện'
		R
		'ta từng làm vua Zeth đã là'
		R
		'quá khứ xa xôi.'
		\L_057f4:
		ZH 1:
		'Giờ ta là bề tôi trung thành'
		R
		'của ngài...'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Aah, sao cũng được....'
		\L_057f4:
		ZH 1:
		'Vậy điều đó có'
		R
		'nghĩa là ngươi là một pháp'
		R
		'sư siêu mạnh phải không?'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Vâng.'
		\L_057f4:
		ZH 1:
		'Không khiêm tốn mà nói, ma'
		R
		'lực của ta'
		\L_057f4:
		ZH 1:
		'thuộc hàng cao nhất Zeth.'
		\L_057f4:
		ZH 1:
		'So với người Leazas...'
		R
		'không, với người ngoài Zeth'
		R
		'nói chung,'
		\L_057f4:
		ZH 1:
		'chênh lệch hẳn là rất lớn.'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Hừm... Lão cơ bắp như ngươi'
		R
		'mà là pháp sư à...'
		\L_057f4:
		ZH 1:
		'Chẳng hợp chút nào.'
		\L_057f4:
		ZH 1:
		'Ta thấy bị ngươi đấm chắc'
		R
		'còn đau hơn.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Wahahahaha! Thật ra ta cũng'
		R
		'luôn nghĩ thế. Nhất là'
		\L_057f4:
		ZH 1:
		'trên chiến trường, dùng ma'
		R
		'pháp có vẻ không quang minh'
		R
		'chính đại...'
		\L_057f4:
		ZH 1:
		'Nên ta cố dùng kiếm khi có'
		R
		'thể. Wahahaha!'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Thôi, cứ dùng ma pháp mà'
		R
		'đánh.'
		\L_057f4:
		ZH 1:
		'Đừng giữ sức. Đây là lệnh'
		R
		'của ta.'
		\L_057f4:
