	{VAR0690 = 1:
		\L_0573f:
		ZH 1:
		'Thưa Bệ hạ Rance...'
		R
		'Thật mừng vì hôm nay'
		R
		'ngài vẫn mạnh khỏe.'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Ồn quá, đừng cố dùng'
		R
		'từ khó. Ta không thích'
		R
		'kiểu hình thức ấy.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Vâng...'
		\L_057f4:
		ZH 1:
		'Vậy ta xin đổi cách nói.'
		\L_057f4:
		ZH 1:
		'Ngài gọi ta có việc gì?'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Cái đó. Ta đang'
		R
		'thắc mắc về cái đó.'
		\L_057f4:
		\L_057e7:
		\L_05707:
		ZH 1:
		'Rance lấy mũi chân chỉ'
		R
		'vai Gandhi đang quỳ.'
		R
		'Con chim ấy là gì?'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'À, loài chim này gọi là Mach'
		R
		'Piyo... Tên nó là Yashichi.'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Mach Piyo?'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Ta cũng không hiểu rõ'
		R
		'tập tính của loài này...'
		\L_057f4:
		ZH 1:
		'Một hôm trên đường du hành,'
		\L_057f4:
		ZH 1:
		'đang ăn ngoài trời'
		R
		'thì có thứ bay tới.'
		\L_057f4:
		ZH 1:
		'Tưởng ruồi, ta gắp bằng'
		R
		'đũa, hóa ra là Yashichi.'
		\L_057f4:
		ZH 1:
		'(Yashichi) Piyooo!'
		\L_057f4:
		ZH 1:
		'Từ đó nó cứ quấn lấy ta,'
		R
		'bay quanh vai thế này.'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'...Nó đang đậu đấy thôi.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Không, đó là tàn ảnh.'
		\L_057f4:
		ZH 1:
		'Mach Piyo mà dừng'
		R
		'lại thì sẽ chết, nên'
		\L_057f4:
		ZH 1:
		'nó luôn bay với'
		R
		'tốc độ cao...'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'...Hiểu rồi. Đủ rồi. Lui đi.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Vâng.'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'À, còn một điều nữa.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Vâng, ngài muốn hỏi gì?'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Con chim đó ăn được không?'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Chuyện đó thì...'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'............'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'............'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Được rồi, lui đi.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Vâng.'
		\L_057f4:
		\L_057e7:
		\L_057a1:
		\L_05707:
		ZH 1:
		'Gandhi kính cẩn cúi chào'
		R
		'rồi rời phòng yết kiến.'
		\L_057f4:
		\L_057e7:
		\L_056eb:
		ZH 1:
		'Hừ... Để ý cái thứ kỳ'
		R
		'quặc ấy, làm ta phí'
		R
		'thời gian vô nghĩa...'
		\L_057f4:
		\L_057e7:
