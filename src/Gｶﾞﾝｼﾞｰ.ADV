	'lão già thô kệch.'
	\L_057f4:
	ZH 1:
	'Hai cô gái ấy thì nhận.'
	\L_057f4:
	\L_057e7:
	\L_057a1:
	!VAR0516 : 71!
	\L_05793:
	\L_0573f:
	ZH 1:
