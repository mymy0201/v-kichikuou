	\L_057e7:
	\L_057a1:
	!VAR0516 : 72!
	\L_05793:
	\L_0573f:
	ZH 1:
	'Vâng, Ngươi đã làm tốt công việc...'
	\L_057f4:
	\L_057e7:
	\L_056cf:
	ZH 1:
