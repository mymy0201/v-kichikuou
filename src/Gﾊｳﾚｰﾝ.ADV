	\L_04c84:
	\L_04bdc:
	ZH 1:
	'............'
	\L_04c91:
	\L_04c84:
	\L_04b6c:
	ZH 1:
	'Haurein...'
	\L_04c91:
	\L_04c84:
	\L_04ba4:
	ZH 1:
	'Barres chậm rãi'
	R
	'rút kiếm khỏi vỏ.'
	\L_04c91:
	\L_04c84:
	\L_04bdc:
	ZH 1:
	'...!'
	\L_04c91:
	\L_04c84:
	\L_04b6c:
	ZH 1:
	'Đây là chút tình'
	R
	'cuối cùng...'
	\L_04c91:
	ZH 1:
	'Hãy chết dưới lưỡi'
	R
	'kiếm của ta...'
	\L_04c91:
	ZH 1:
	'Dưới lưỡi kiếm của cha con!'
	\L_04c91:
	\L_04c84:
	\L_04ba4:
	ZH 1:
	'Barres giơ kiếm lên,'
	R
	'hướng về Haurein.'
