	\L_026e8:
	\L_02694:
	ZH 1:
	'... Xin lỗi...'
	\L_02749:
	\L_0273c:
	\L_02624:
	ZH 1:
	'Ồ, cô đến'
	R
	'rồi. Nhanh qua đi.'
	\L_02749:
	\L_0273c:
	\L_02694:
	ZH 1:
	'... ngài Rance... Nếu tôi'
	R
	'có thể hỏi điều gì đó...'
	\L_02749:
	\L_0273c:
	\L_02624:
	ZH 1:
	'Cái gì?'
	\L_02749:
	\L_0273c:
	\L_02694:
	ZH 1:
	'Tại sao ngài lại'
	R
	'cởi quần áo?'
	\L_02749:
	ZH 1:
	'Tôi ra mất'
	R
	'rồi... vì nghe nói đây'
	R
	'là cuộc họp chiến lược...'
	\L_02749:
	\L_0273c:
	\L_02624:
	ZH 1:
	'Chà, cuộc'
	R
	'họp chiến lược... Cô'
	R
	'có thể gọi nó là...'
	\L_02749:
	ZH 1:
	'Một cuộc gặp gỡ'
	R
	'chiến lược tình yêu.'
	\L_02749:
	\L_0273c:
	\L_02694:
	ZH 1:
	'Điều đó có nghĩa'
	R
	'là ngài lại sử dụng tôi'
	R
	'làm đồ chơi của ngài.'
	\L_02749:
	\L_0273c:
	\L_02624:
	ZH 1:
	'Điều đó không đúng.'
	\L_02749:
	ZH 1:
	'Ít nhất khi ta'
	R
	'quan hệ tình dục với một cô'
	R
	'gái, ta làm cho nàng thích.'
	\L_02749:
	\L_0273c:
	\L_02694:
	ZH 1:
	'Tôi không'
	R
	'biết về điều đó.'
	\L_02749:
	ZH 1:
	'Như tôi'
	R
	'đã nói trước đây,'
	\L_02749:
	ZH 1:
	'hãy nói với'
	R
	'ai đó chỉ có thể làm điều đó'
	R
	'khi gặp những việc như vậy.'
	\L_02749:
	ZH 1:
	'Xin lỗi.'
	\L_02749:
	\L_0273c:
	\L_0265c:
	ZH 1:
	'Cream chuẩn bị'
	R
	'rời khỏi phòng.'
	\L_02749:
	\L_0273c:
	\L_02624:
	ZH 1:
	'Ta hiểu rồi...'
	\L_02749:
	ZH 1:
	'Vậy là cô sẽ không'
	R
	'tham gia vào cuộc họp chiến'
	R
	'lược tình yêu của ta...'
	\L_02749:
	ZH 1:
	'Trong trường hợp đó,'
	\L_02749:
	ZH 1:
	'có lẽ ta nên sử dụng'
	R
	'ai đó khác ngoài cô trong'
	R
	'trận chiến tiếp theo...'
	\L_02749:
	\L_0273c:
	\L_02694:
	ZH 1:
	'Hả...?'
	\L_02749:
	\L_0273c:
	\L_0265c:
	ZH 1:
	'Cream dừng bước.'
	\L_02749:
	\L_0273c:
	\L_02624:
	ZH 1:
	'Được rồi...'
	\L_02749:
	ZH 1:
	'ta sẽ làm điều đó.'
	R
	'Bây giờ, ta nên gọi ai tới'
	R
	'cuộc họp chiến lược đây...?'
	\L_02749:
	\L_0273c:
	\L_02694:
	ZH 1:
	'P-Xin hãy đợi đã!'
	\L_02749:
	\L_0273c:
	\L_02624:
	ZH 1:
	'Nó là gì?'
	\L_02749:
	\L_0273c:
	\L_02694:
	ZH 1:
	'Cậu em không'
	R
	'thể làm điều đó! Tôi...'
	R
	'tôi muốn chiến đấu...'
	\L_02749:
	\L_0273c:
	\L_02624:
	ZH 1:
	'Vậy hãy tổ'
	R
	'chức một cuộc họp'
	R
	'chiến lược. Được rồi?'
	\L_02749:
	\L_0273c:
	\L_02694:
	ZH 1:
	'............'
