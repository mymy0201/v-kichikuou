	'............'
	\L_045c8:
	\L_045bb:
	\L_044a3:
	ZH 1:
	'... Thiếp xin lỗi...'
	\L_045c8:
	\L_045bb:
	\L_04513:
	ZH 1:
	'............'
	\L_045c8:
	\L_045bb:
	\L_044a3:
	ZH 1:
	'...Chàng yêu, thiếp xin'
	R
	'lỗi... Thiếp không làm thế'
	R
	'nữa đâu.'
	\L_045c8:
	\L_045bb:
	\L_04513:
	ZH 1:
	'............'
	\L_045c8:
	\L_045bb:
	\L_044a3:
	ZH 1:
	'... Vì vậy hãy'
	R
	'tha thứ cho thiếp...'
	\L_045c8:
	\L_045bb:
	\L_04513:
	ZH 1:
	'Nàng đang xin'
	R
	'lỗi nhầm người rồi.'
	\L_045c8:
	\L_045bb:
	\L_044a3:
	ZH 1:
	'... Nhưng...'
	\L_045c8:
	\L_045bb:
