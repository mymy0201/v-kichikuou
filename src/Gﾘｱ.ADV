	'............'
	\L_045c8:
	\L_045bb:
	\L_044db:
	ZH 1:
	'Lia đến bên Rance đang ngồi'
	R
	'ngả ngớn trên ngai vàng.'
	\L_045c8:
	\L_045bb:
	\L_04513:
	ZH 1:
	'............'
	\L_045c8:
	\L_045bb:
	\L_044a3:
