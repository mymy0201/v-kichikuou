	!VAR0690 : VAR0000!
	{VAR0690 = 1:
		\L_04225:
		ZH 1:
		'Ta thắc mắc từ lâu rồi...'
		\L_0434a:
		\L_0433d:
		\L_04295:
		ZH 1:
		'Vâng, chuyện gì ạ?'
		\L_0434a:
		\L_0433d:
		\L_04225:
		ZH 1:
		'Quần áo kiểu đó'
		R
		'ngươi mua ở đâu thế?'
		\L_0434a:
		\L_0433d:
		\L_04295:
		ZH 1:
		'À... ngài hỏi về'
		R
		'quần áo của tôi sao?'
		\L_0434a:
		\L_0433d:
		\L_04225:
		ZH 1:
		'Ừ, đúng thế.'
		\L_0434a:
