		R
		'lên bộ trang phục này...'
		\L_0434a:
		ZH 1:
		'Đúng không?'
		\L_0434a:
		\L_0433d:
		\L_04225:
		ZH 1:
		'Không.'
		\L_0434a:
		ZH 1:
		'Ta chỉ thắc mắc'
		R
		'tiệm chuyên may'
		\L_0434a:
		ZH 1:
		'loại đồ đó có kiếm ra tiền'
		\L_0434a:
		ZH 1:
		'không.'
		\L_0434a:
		\L_0433d:
		\L_04295:
		ZH 1:
		'Vậy là... đặt may'
		R
		'bộ đồ giống tôi, học'
		R
		'thành thạo bước nhảy'
		\L_0434a:
		ZH 1:
		'lướt, rồi nắm tay tôi'
		R
		'dạo phố thì sao...'
		\L_0434a:
		\L_0433d:
		\L_04225:
		ZH 1:
		'Ta không nắm tay đàn ông.'
		\L_0434a:
		\L_0433d:
		\L_04295:
		ZH 1:
		'À... tiếc thật.'
		\L_0434a:
		\L_0433d:
		\L_042cd:
		ZH 1:
		'Đại vương Mars cúi'
		R
		'gục đầu, có vẻ tiếc'
		R
		'nuối từ tận đáy lòng.'
		\L_0434a:
		\L_0433d:
		\L_04225:
		ZH 1:
		'Thế, cái tiệm may đó...'
		\L_0434a:
		\L_0433d:
		\L_04295:
		ZH 1:
		'Tôi không nói đâu...'
		\L_0434a:
		\L_0433d:
		\L_04225:
		ZH 1:
		'Gì?'
		\L_0434a:
		\L_0433d:
		\L_04295:
		ZH 1:
		'Nếu Vua Leazas chịu khoác bộ'
		R
		'đồ giống tôi thì tôi sẽ nói.'
		\L_0434a:
		ZH 1:
		'La la~~~.'
		\L_0434a:
		\L_0433d:
		\L_042f7:
		\L_042cd:
		ZH 1:
		'Đại vương Mars nhảy'
		R
		'chân sáo lướt đi'
		R
		'khỏi trước ngai vàng.'
		\L_0434a:
		\L_0433d:
	}
	{VAR0690 = 2:
