	R
	'ta sắp làm này làm nọ,'
	\L_0363a:
	ZH 1:
	'nên nó sẽ nhăn nhúm,'
	R
	'ướt nhẹp ngay thôi......'
	\L_0363a:
	ZH 1:
	'Hử......'
	\L_0363a:
	\L_0362d:
	\L_035bd:
	ZH 1:
	'Suzume đã biến'
	R
	'mất từ lúc nào.'
	\L_0363a:
	\L_0362d:
	\L_03515:
	ZH 1:
	'Suzume?'
	\L_0363a:
	ZH 1:
	'............'
