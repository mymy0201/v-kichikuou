	\L_041fd:
	\L_041f0:
	\L_04148:
	ZH 1:
	'Huhu...'
	\L_041fd:
	\L_041f0:
	\L_040d8:
	ZH 1:
	'Ngoài ra, Kanayo, Lilim.'
	\L_041fd:
	\L_041f0:
