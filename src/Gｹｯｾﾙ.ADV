	\L_04148:
	ZH 1:
	'Hiiiiiii!!'
	\L_041fd:
	ZH 1:
	'Hngaaaaaaaa!!'
	\L_041fd:
	\L_041f0:
	\L_040d8:
	ZH 1:
	'Im lặng!!'
