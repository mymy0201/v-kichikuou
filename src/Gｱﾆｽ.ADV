	!VAR0516 : 61!
	\L_033d0:
	\L_0337c:
	ZH 1:
	'Hiểu không? Tìm những cuốn'
	R
	'sách trong danh sách này'
	R
	'và mang chúng đến cho tôi.'
	\L_03431:
	ZH 1:
	'Nhận càng nhiều bản'
	R
	'in đầu tiên càng tốt.'
	\L_03431:
	\L_03424:
	\L_0330c:
	ZH 1:
	'Vâng, hiểu rồi.'
	\L_03431:
	ZH 1:
	'Em sẽ mang đến'
	R
	'cho ngài hoàng tử đầu tiên'
	R
	'của những cuốn sách này!'
	\L_03431:
