	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng Của Rona （gõ gõ）'
	\L_036b3:
	\L_036a6:
	\L_0358e:
	ZH 1:
	'Xin phép, cô Rona. Thấy cô'
	R
	'chuẩn bị khá lâu,'
	\L_036b3:
	ZH 1:
	'tôi đến giúp.'
	\L_036b3:
	\L_036a6:
	\L_035c6:
	ZH 1:
	'Wendy bước vào phòng.'
	\L_036b3:
	\L_036a6:
	\L_0358e:
	ZH 1:
	'Hả...?'
	\L_036b3:
	ZH 1:
	'Cô Rona...'
	\L_036b3:
	ZH 1:
	'Cô Rona?'
	\L_036b3:
	\L_036a6:
	\L_035f0:
	\L_035c6:
	ZH 1:
	'Trong phòng'
	R
	'hoặc trong lâu đài, Rona'
	R
	'đều không được tìm thấy.'
