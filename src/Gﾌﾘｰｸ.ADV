	R
	'thay quần áo nên thiếp...'
	\L_036b3:
	ZH 1:
	'ra rồi giúp cậu.'
	\L_036b3:
	\L_036a6:
	\L_035c6:
	ZH 1:
	'Wendy bước vào phòng.'
	\L_036b3:
	\L_036a6:
	\L_0358e:
	ZH 1:
	'Hả...?'
	\L_036b3:
	ZH 1:
	'Cô Rona...'
	\L_036b3:
	ZH 1:
	'Cô Rona?'
