	R
	'nay Asuka lại học phép triệu'
	R
	'hồi ảo thú trong phòng Mill.'
	\L_02826:
	\L_02819:
	\L_02771:
	ZH 1:
	'Ôi~...'
	\L_02826:
	\L_02819:
	\L_02701:
	ZH 1:
	'Giỏi lắm, Asuka.'
	R
	'Chỉ còn chút nữa thôi.'
	\L_02826:
	\L_02819:
	\L_02771:
	ZH 1:
	'Thật ạ?'
	\L_02826:
	\L_02819:
	\L_02701:
	ZH 1:
	'Ừ, thật đấy. Cố thêm nào.'
	\L_02826:
	\L_02819:
	\L_02771:
