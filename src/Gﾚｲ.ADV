	\L_02e4c:
	\L_02d88:
	ZM 32:
	ZH 1:
	X 8:
	R
	ZM 24:
	ZH 1:
	R
	'Bầu Trời Phía Trên'
	R
	'Một người đang lơ lửng.'
	\L_02e75:
	ZH 1:
	'Đúng hơn, có thể chính xác'
	R
	'hơn khi nói rằng một sinh'
	R
	'vật hình người đang lơ lửng.'
	\L_02e75:
	\L_02e68:
	!VAR0516 : 445!
	\L_02da4:
	\L_02d50:
	ZH 1:
	'............'
	\L_02e75:
	\L_02e68:
	\L_02d88:
	ZH 1:
	'Đó là quỷ Lôi,'
	\L_02e75:
	ZH 1:
	'một người đàn ông không thể'
	R
	'chạm vào người khác do cơ'
	R
	'thể anh ta liên tục xả điện.'
	\L_02e75:
	ZH 1:
	'Lei nhìn xuống thành phố'
	R
	'sau trận chiến và nhẹ nhàng'
	R
	'đeo găng tay cách điện vào.'
	\L_02e75:
	ZH 1:
	'Đó là một'
	R
	'phong tục mà hắn có khi'
	R
	'một trận chiến kết thúc.'
	\L_02e75:
	\L_02e68:
	\L_02d50:
	ZH 1:
	'Hừm...'
	\L_02e75:
	\L_02e68:
	\L_02d88:
	ZH 1:
	'Một nỗi đau như'
	R
	'trái tim anh bị một cái gai'
	R
	'nhỏ đâm xuyên qua người Lei.'
	\L_02e75:
	ZH 1:
	'Hắn luôn cảm thấy như'
	R
	'vậy sau một trận chiến.'
	\L_02e75:
	ZH 1:
	'Kể từ khi anh gặp'
	R
	'một người phụ nữ nào đó.'
	\L_02e75:
	ZH 1:
	'Trước đó, chiến'
	R
	'đấu chỉ là một trò'
	R
	'chơi đối với Lei...'
	\L_02e75:
	ZH 1:
	'Anh từng coi việc đánh'
	R
	'nhau là chuyện đương nhiên'
	\L_02e75:
	ZH 1:
	'và không hề hối hận'
	R
	'về việc mình đã đánh nhau.'
	\L_02e75:
	ZH 1:
	'cuộc sống.'
	\L_02e75:
	\L_02e68:
	\L_02d50:
	ZH 1:
	'Đức Maria...'
	\L_02e75:
	\L_02e68:
	\L_02d88:
	ZH 1:
	'Con vật thì thầm,'
	R
	'rồi rời khỏi thành phố.'
	\L_02e75:
	\L_02e68:
