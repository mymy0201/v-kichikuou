	!VAR0516 : 496!
	\L_02e14:
	\L_02df8:
	ZH 1:
	'Một người đàn ông có'
	R
	'vẻ là dân làng xoa hai tay'
	R
	'vào nhau khi đến gần Rance.'
	\L_02e75:
	\L_02e68:
	\L_02dc0:
	ZH 1:
	'Tôi có một số thông'
	R
	'tin muốn bán cho cậu...'
	\L_02e75:
	\L_02e68:
	\L_02d50:
	ZH 1:
	'Ngươi đã nói gì?'
	\L_02e75:
	\L_02e68:
	\L_02dc0:
	ZH 1:
	'Hii... Làm ơn'
	R
	'đừng đe dọa tôi...'
	\L_02e75:
	ZH 1:
	'Đó không'
	R
	'phải là thông tin gây'
	R
	'bất lợi cho cậu đâu...'
	\L_02e75:
	ZH 1:
	'Nó nói về một con quỷ...'
	\L_02e75:
	\L_02e68:
	\L_02d50:
	ZH 1:
	'Ngươi nói là'
	R
	'một con quỷ à?'
	\L_02e75:
	\L_02e68:
	\L_02dc0:
	ZH 1:
	'Y-Vâng.'
	\L_02e75:
	ZH 1:
	'Có một bà già nhỏ bé tên'
	R
	'Là Mary sống trong một cabin'
	R
	'ở ngoại ô thành phố này.'
	\L_02e75:
	ZH 1:
	'Cách đây không lâu, tôi'
	R
	'thấy một người đàn ông phóng'
