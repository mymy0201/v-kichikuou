	\L_0601b:
	PF0 VAR0056:
	\L_05fc7:
	ZH 1:
	'Đây?'
	\L_060ec:
	\L_060df:
	\L_05fff:
	ZH 1:
	'Rance đang đứng trước'
	R
	'một cánh cửa có thiết'
	\L_060ec:
	ZH 1:
	'kế bí ẩn trên đó mà'
	R
	'một cấp dưới đã tìm thấy.'
	\L_060ec:
	ZH 1:
	'Cánh cửa được'
	R
	'thiết kế trông giống như'
	R
	'một phần của bức tường.'
	\L_060ec:
	ZH 1:
	'Nó không có'
	R
	'núm hoặc tay cầm.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Được rồi.'
	\L_060ec:
	\L_060df:
	\L_05fff:
	ZH 1:
	'Rance đi qua cửa.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Tối om...'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'... Ai ở đó?'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Hả??'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'Có ai ở đây không?'
	\L_060ec:
	\L_060df:
	\L_05fff:
	ZH 1:
	'Nhìn kỹ,'
	R
	'có một chút ánh sáng'
	R
	'xuyên qua căn phòng.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Có ai đó ở đó không!?'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'Đó là điều tôi'
	R
	'muốn hỏi. Ngươi là ai?'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Được rồi, ta'
	R
	'sẽ thử qua đó.'
	\L_060ec:
	\L_060df:
	\L_05fff:
	ZH 1:
	'Rance bước tới'
	R
	'chỗ có ánh sáng.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Ờ...'
	\L_060ec:
	\L_060df:
	\L_05fff:
	ZH 1:
	'Rance đến chỗ có ánh sáng.'
	\L_060ec:
	ZH 1:
	'Tuy không quá chói, ánh sáng'
	R
	'vẫn làm mắt hắn nhức lên sau'
	R
	'lúc ở trong bóng tối.'
	\L_060ec:
	\L_060df:
	!VAR0516 : 23!
	\L_0608b:
	\L_06037:
	ZH 1:
	'Ồ... Ngươi không'
	R
	'phải là Descoco. Tôi biết'
	R
	'giọng nói của ngươi khác...'
	\L_060ec:
	\L_060df:
	\L_05fff:
	ZH 1:
	'Có một cô'
	R
	'gái xinh đẹp đang ngồi'
	R
	'trên chiếc giường tròn.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Đừng đánh đồng ta với thứ'
	R
	'ấy. Ta là Rance đại nhân.'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'............'
	\L_060ec:
	ZH 1:
	'Ngươi có'
	R
	'phải là vị vua mới sẽ'
	R
	'gây rối với tôi không?'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Gây rối với?'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'Descoco đã làm'
	R
	'điều đó rất nhiều.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Giống như vẽ lên'
	R
	'mặt khi ngươi đang ngủ'
	R
	'và những thứ tương tự?'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'Không. Hừm.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Nhưng sao một cô bé lại ở'
	R
	'chỗ này?'
	\L_060ec:
	ZH 1:
	'Nhóc là con gái Descoco à?'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'Khiếp! Đừng nói thế! Tôi thà'
	R
	'chết còn hơn! Tôi là Thánh'
	\L_060ec:
	ZH 1:
	'Nữ Quái Vật Housesnurse, một'
	R
	'nữ Quái Vật có thể điều'
	R
	'khiển đất đai.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Thánh Nữ Quái Vật...'
	\L_060ec:
	ZH 1:
	'Vậy nhóc không phải người...'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'Không.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'...Ra thế. Nhưng sao Thánh'
	R
	'Nữ Quái Vật lại ở nơi này?'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'Lúc tôi lang thang, vị vua'
	R
	'đầu tiên của Shangri-La'
	\L_060ec:
	ZH 1:
	'bắt được tôi. Khi ấy hắn còn'
	R
	'chưa'
	\L_060ec:
	ZH 1:
	'phải vua. Hắn ép tôi tạo nên'
	R
	'đất'
	\L_060ec:
	ZH 1:
	'nước này rồi quản lý đường'
	R
	'sa mạc.'
	\L_060ec:
	ZH 1:
	'Nhờ tôi mà nơi đây bất khả'
	R
	'xâm phạm.'
	\L_060ec:
	ZH 1:
	'Nhưng Descoco thất bại'
	\L_060ec:
	ZH 1:
	'rồi nhỉ. Anh tới đây tức là'
	R
	'hắn bị giết?'
	\L_060ec:
	ZH 1:
	'Tôi chỉ bảo vệ bên ngoài, kẻ'
	R
	'thù đã vào trong'
	\L_060ec:
	ZH 1:
	'thì mặc kệ.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Nhưng Thánh Nữ Quái Vật có'
	R
	'sức mạnh ghê gớm mà?'
	\L_060ec:
	ZH 1:
	'Nhóc không trốn được sao?'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'Chú nhìn đi đâu đấy?'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Đừng gọi chú. Ta còn trẻ.'
	R
	'Phải gọi Rance đại nhân.'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'... Vậy thì,'
	R
	'Rance... Nhìn này.'
	\L_060ec:
	\L_060df:
	\L_0606f:
	ZH 1:
	'Housesnurse duỗi đôi chân'
	R
	'đang khoanh ra.'
	\L_060ec:
	ZH 1:
	'Cổ chân nhỏ đeo chiếc cùm'
	R
	'phát sáng xanh lục.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Đó là gì?'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'Xích Phong Ấn. Vật dùng để'
	R
	'trói tôi ở đây.'
	\L_060ec:
	ZH 1:
	'Còn đeo nó thì tôi không'
	R
	'trốn khỏi nơi này được.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Vậy nếu ta thả nhóc đi'
	R
	'thì...'
	\L_060ec:
	\L_060df:
	\L_06037:
	ZH 1:
	'Đường sa mạc sẽ biến mất.'
	\L_060ec:
	ZH 1:
	'Chính tôi tạo thần chú chỉ'
	R
	'cách đi giữa sa mạc.'
	\L_060ec:
	ZH 1:
	'Người niệm chú,'
	\L_060ec:
	ZH 1:
	'tôi cho mượn sức mở đường'
