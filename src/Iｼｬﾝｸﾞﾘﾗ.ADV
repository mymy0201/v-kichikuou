	'mọi thế giới có thể sẽ'
	R
	'có mặt trong bữa tiệc.'
	\L_060ec:
	\L_060df:
	\L_05fc7:
	ZH 1:
	'Hô... Phụ nữ'
	R
	'và thức ăn hả...?'
	\L_060ec:
	\L_060df:
	\L_06099:
	!VAR0516 : 6!
