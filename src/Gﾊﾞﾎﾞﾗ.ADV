		\L_02c85:
		\L_02ba5:
		ZH 1:
		'Shinoda nâng'
		R
		'quả bóng của mình có một tấm'
		R
		'bìa Mà Sayori đã tạo ra trên'
		\L_02c92:
		ZH 1:
		'bầu trời và đứng'
		R
		'lên trên một trong những'
		R
		'những người lính ngất xỉu.'
		\L_02c92:
		\L_02c85:
		\L_02b6d:
		ZH 1:
		'Vậy nếu nó'
		R
		'lớn thì sao?!! Vậy nếu'
		R
		'nó phá hoại thì sao?!!'
		\L_02c92:
		ZH 1:
		'Chúng tôi'
		R
		'đã có bộ não của tôi và'
		R
		'cậu người đàn ông tốt!!'
		\L_02c92:
		\L_02c85:
		\L_02bdd:
		ZH 1:
		'Nhưng Tướng quân Shinoda!!'
		R
		'Chúng ta sẽ chiến đấu với'
		R
		'thứ đó như thế nào...?'
		\L_02c92:
		\L_02c85:
		\L_02b6d:
		ZH 1:
		'Nếu chúng'
		R
		'ta không thể đẩy lùi anh ta,'
		R
		'chúng ta nên kéo anh ta ra.'
		\L_02c92:
		\L_02c85:
		\L_02bdd:
		ZH 1:
		'Hả? chúng tôi sẽ'
		R
		'làm cho một cạm bẫy!!'
		\L_02c92:
		\L_02c85:
		\L_02bdd:
		ZH 1:
		'A... Một cái bẫy...'
		R
		'Uh... Cậu muốn chúng tôi'
		R
		'đào một cái hố dưới đất??'
		\L_02c92:
		\L_02c85:
		\L_02b6d:
		ZH 1:
		'Đúng vậy.'
		\L_02c92:
		\L_02c85:
		\L_02bdd:
		ZH 1:
		'Nhưng... Làm'
		R
		'sao chúng ta có thể tạo ra'
		R
		'một cái lỗ lớn như vậy...?'
		\L_02c92:
		\L_02c85:
		\L_02b6d:
		ZH 1:
		'Chúng tôi đã có nhiều'
		R
		'người này... Hãy xem...'
		\L_02c92:
		ZH 1:
		'Nếu chúng tôi nhận'
		R
		'được nhiều sự hỗ trợ hơn,'
		\L_02c92:
		ZH 1:
		'có lẽ việc này sẽ'
