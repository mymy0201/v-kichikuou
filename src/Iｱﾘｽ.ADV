*L_0024e:
	IM VAR0202, VAR0203:
	{VAR0000 \ 0:
		@L_0024e:
	}
	ZH 1:
	$L_007e3$
	'Tiến trình trò chơi'
	$
	$L_0081b$
	'Về đơn vị'
	$
	$L_00894$
	'Về Ninja'
	$
	$L_006d1$
	'Giai đoạn quân Rance'
	$
	$L_0059b$
	'Về trận chiến'
	$
	$L_00513$
	'Lệnh chiến đấu'
	$
	$L_00484$
	'Chi tiết trận đánh'
	$
	$L_003c2$
	'Chỉ số tướng lĩnh'
	$
	$L_00383$
	'Lưu và tải game'
	$
	$L_00344$
	'Về kho báu'
	$
	$L_00305$
	'Lệnh Harem và Nói chuyện'
	$
	$L_00300$
	'Trở lại'
	$
	]
*L_00300:
	@L_0007f:
*L_00305:
	ZH 1:
	'Các sự kiện có thể kích hoạt qua lệnh Harem và'
	R
	'Nói chuyện. Thu thuế từ một thành phố cũng có thể'
	R
	'gây ra các sự kiện đặc biệt tại thành phố đó.'
	\L_018fb:
	ZH 1:
	'Tôi thực sự khuyên bạn không nên xem hướng dẫn'
	R
	'trong lần chơi đầu tiên và hãy chấp nhận thất bại.'
	R
	'Thất bại cũng là một phần của trò chơi.'
	\L_018fb:
	@L_0024e:
*L_00344:
	ZH 1:
	'Kho báu có thể mua từ Pluepet, cướp từ thành phố'
	R
	'hoặc tìm thấy trong mê cung. Khi chọn “Kho báu”'
	R
	'trên menu chính, danh sách sẽ được hiển thị.'
	\L_018fb:
	ZH 1:
	'Một số kho báu có thể trang bị. Nếu muốn trang bị,'
	R
	'hãy chọn món đồ đó, sau đó chọn nhân vật mà bạn'
	R
	'muốn trang bị cho họ.'
	\L_018fb:
	@L_0024e:
*L_00383:
	ZH 1:
	'Trò chơi sẽ tự động lưu vào đầu mỗi lượt vào ô tự'
	R
	'động lưu (auto-save). Dữ liệu tải lại cũng sẽ ghi'
	R
	'đè lên ô tự động lưu này.'
	\L_018fb:
	ZH 1:
	'Bạn cũng có thể lưu thủ công. Dù bạn lưu vào bất'
	R
	'kỳ thời điểm nào trong lượt, khi tải lại, bạn vẫn'
	R
	'sẽ quay về đầu lượt chơi đó.'
	\L_018fb:
	@L_0024e:
*L_003c2:
	ZH 1:
	'HP: Lượng máu hiện tại của tướng. (về 0 sẽ tử trận)'
	R
	'Tấn công/Phòng thủ: Năng lực chiến đấu của tướng.'
	\L_018fb:
	ZH 1:
	'Khả năng chiến lược, Tỉ lệ thành công:'
	R
	'Tướng có tỉ lệ cao nhất (dù là phe địch hay phe ta)'
	R
	'sẽ nhận được cơ hội thi triển chiến lược.'
	\L_018fb:
	ZH 1:
	'Nếu thi triển chiến lược thành công, bạn sẽ giành'
	R
	'được lợi thế cực lớn trong trận chiến.'
	\L_018fb:
	ZH 1:
	'Năng lực chỉ huy theo địa hình:'
	R
	'Chỉ số cộng thêm cho tướng và binh sĩ tùy thuộc'
	R
	'vào loại chiến trường diễn ra trận đánh.'
	\L_018fb:
	ZH 1:
	'Mỗi tướng đều có ưu và nhược điểm riêng biệt, vì'
	R
	'vậy bạn nên chú ý những điều này và sử dụng từng vị'
	R
	'tướng vào đúng thời điểm thích hợp.'
	\L_018fb:
	ZH 1:
	'Binh chủng:'
	R
	'Tất cả các tướng đều dẫn dắt một binh chủng riêng'
	R
	'với sức tấn công và phòng thủ đặc thù.'
	\L_018fb:
	ZH 1:
	'Tuyệt kỹ đặc biệt:'
	R
	'Một số tướng có kỹ năng đặc biệt dùng được sau khi'
	R
	'chờ một lượt. Chúng mang lại nhiều hiệu ứng đa dạng.'
	\L_018fb:
	@L_0024e:
*L_00484:
	ZH 1:
	'Khi tấn công, một con số biểu thị lượng quân tham'
	R
	'chiến sẽ bay vào mục tiêu, rồi biến thành số quân'
	R
	'địch bị tiêu diệt.'
	\L_018fb:
	ZH 1:
	'Ví dụ: Nếu số 1000 bay đến quân địch rồi chuyển'
	R
	'thành 200, nghĩa là 1000 quân đã tấn công và tiêu'
	R
	'diệt được 200 kẻ địch.'
	\L_018fb:
	ZH 1:
	'Tùy tình huống, tướng có thể trực tiếp tấn công hoặc'
	R
	'bị tấn công. Không giống binh lính chỉ đánh một'
	R
	'lần, tướng có thể tấn công rất nhiều lần.'
	\L_018fb:
	ZH 1:
	'Tuy nhiên, nếu tướng tử trận, toàn bộ đội quân đó'
	R
	'sẽ bị xóa sổ hoàn toàn bất kể số lượng binh sĩ còn'
	R
	'lại là bao nhiêu.'
	\L_018fb:
	ZH 1:
	'Tướng có thể tấn công và bị tấn công khi số quân'
	R
	'của họ ít hơn quy mô của chiến trường.'
	\L_018fb:
	@L_0024e:
*L_00513:
	ZH 1:
	'Khi đến lượt nhân vật, nếu họ có thể tấn công, hãy'
	R
	'nhấp chuột trái vào kẻ địch bạn muốn tấn công.'
	\L_018fb:
	ZH 1:
	'Nếu bạn nhấp chuột phải, một menu sẽ hiện ra với'
	R
	'các mệnh lệnh sau:'
	\L_018fb:
	ZH 1:
	'Phòng thủ: Tăng nhẹ phòng thủ trong lượt đó.'
	R
	'Chờ: Tích tụ tuyệt kỹ đặc biệt cho nhân vật.'
	R
	'Rút lui: Toàn quân rút chạy, tính là thất bại.'
	\L_018fb:
	ZH 1:
	'Tự động đánh: Tiếp tục tấn công kẻ địch phía trước.'
	R
	'Tự động thủ: Đơn vị sẽ liên tục phòng thủ.'
	R
	'Thông tin: Hiển thị thông tin đơn vị được nhấp.'
	\L_018fb:
	ZH 1:
	'Nếu một đơn vị sử dụng đòn đánh tầm xa hoặc phép,'
	R
	'bạn cũng có thể chọn đánh trực diện trong menu'
	R
	'chuột phải.'
	\L_018fb:
	@L_0024e:
*L_0059b:
	ZH 1:
	'Bạn có thể ra trận với tối đa 4 đơn vị quân.'
	R
	'Nếu rút lui hoặc bị tiêu diệt hết, bạn sẽ thua.'
	R
	'Nếu ở phe công, hết lượt đánh cũng tính là thua.'
	\L_018fb:
	ZH 1:
	'Số lượt giao chiến:'
	R
	'Bạn nhận được số lượt ngẫu nhiên (khoảng 4 lượt).'
	R
	'Trận đánh sẽ kết thúc khi hết số lượt này.'
	\L_018fb:
	ZH 1:
	'Tuy nhiên, một số trận chiến đặc biệt có thể không'
	R
	'bị giới hạn số lượt.'
	\L_018fb:
	ZH 1:
	'Quy mô chiến trường (Battle Area):'
	R
	'Kích thước trận địa, chỉ áp dụng khi bạn đánh trong'
	R
	'thành phố hoặc mê cung thay vì đồng bằng.'
	\L_018fb:
	ZH 1:
	'Quy mô này giới hạn số quân có thể đánh cùng lúc.'
	R
	'Ví dụ đơn vị 2000 quân chỉ đánh được 500 quân nếu'
	R
	'quy mô là 500.'
	\L_018fb:
	ZH 1:
	'Hiệu ứng phòng thủ:'
	R
	'Nếu bạn phe thủ và chọn đánh trong thành phố, bạn'
	R
	'sẽ nhận được lợi thế dựa trên phòng thủ của thành.'
	\L_018fb:
	ZH 1:
	'Thứ tự hành động:'
	R
	'Thông thường, đơn vị có ít binh lính hơn sẽ được'
	R
	'ưu tiên hành động trước.'
	\L_018fb:
	ZH 1:
	'Tiền tuyến và Hậu phương:'
	R
	'Hai đơn vị đầu tiên ra trận sẽ đứng ở tiền tuyến,'
	R
	'hai đơn vị còn lại sẽ ở hậu phương.'
	\L_018fb:
	ZH 1:
	'Chỉ đơn vị tiền tuyến mới có thể đánh trực diện.'
	R
	'Đơn vị hậu phương chỉ đánh tầm xa. Các đơn vị'
	R
	'không thể đổi hàng trong trận đánh.'
	\L_018fb:
	ZH 1:
	'Chiến binh: Chỉ có thể tấn công ở hàng tiền tuyến.'
	R
	'Cung thủ: Có thể tấn công ở cả hai hàng.'
	R
	'Pháp sư: Có thể tấn công ở cả hai hàng.'
	\L_018fb:
	ZH 1:
	'Toàn diệt đơn vị:'
	R
	'Khi HP của tướng giảm về 0, toàn bộ đơn vị của'
	R
	'tướng đó sẽ bị tiêu diệt hoàn toàn.'
	\L_018fb:
	@L_0024e:
*L_006d1:
	ZH 1:
	'Bạn có thể thực hiện tất cả các hành động sau một'
	R
	'lần trong mỗi Giai đoạn Đội quân Rance.'
	\L_018fb:
	ZH 1:
	'Lệnh Tướng lĩnh:'
	R
	'Bổ sung lượng lớn binh lính cho một đơn vị hoặc'
	R
	'tăng số quân tối đa của đơn vị đó.'
	\L_018fb:
	ZH 1:
	'Lệnh Tướng lĩnh:'
	R
	'Ngoài việc thực hiện một trong hai hành động trên,'
	R
	'bạn cũng có thể nói chuyện với cấp dưới.'
	\L_018fb:
	ZH 1:
	'Lệnh Harem:'
	R
	'Gọi một cô gái từ hậu cung của Rance để mây mưa.'
	\L_018fb:
	ZH 1:
	'Lệnh Thương nhân:'
	R
	'Gọi thương nhân Pluepet đến để mua sắm vật phẩm.'
	\L_018fb:
	ZH 1:
	'Chiến tranh:'
	R
	'Tấn công một lãnh thổ được kết nối với lãnh thổ'
	R
	'của bạn bằng một con đường.'
	\L_018fb:
	ZH 1:
	'Bạn có thể tấn công bao nhiêu lần tùy thích cho đến'
	R
	'khi chiếm được lãnh thổ đó hoặc đã dùng hết quân.'
	\L_018fb:
	ZH 1:
	'Lệnh Lãnh thổ:'
	R
	'Lựa chọn ở các lãnh thổ (dù bạn đã kiểm soát hay'
	R
	'chưa). Bạn có thể làm một trong các việc sau:'
	\L_018fb:
	ZH 1:
	'Địa điểm đặc biệt: Đến nơi độc nhất của khu vực.'
	R
	'Thu thuế tạm thời: Thu tiền trong lãnh thổ bạn.'
	R
	'Củng cố phòng thủ: Tăng độ phòng thủ lãnh thổ.'
	\L_018fb:
	ZH 1:
	'Lệnh Mê cung:'
	R
	'Khám phá mê cung và các công trình đặc biệt được'
	R
	'kết nối với lãnh thổ của bạn.'
	\L_018fb:
	@L_0024e:
*L_007e3:
	ZH 1:
	'Trò chơi này xoay quanh việc vào vai Rance trong'
	R
	'cuộc chinh phạt nhằm thâu tóm toàn bộ thế giới.'
	\L_018fb:
	ZH 1:
	'Mỗi lượt tương ứng một tuần trong game. Mỗi lượt'
	R
	'gồm các giai đoạn theo thứ tự sau:'
	R
	'Giai đoạn quân Rance > Giai đoạn địch > Hết lượt'
	\L_018fb:
	@L_0024e:
*L_0081b:
	ZH 1:
	'Một đơn vị gồm một tướng và binh lính dưới quyền.'
	R
	'Số quân tối đa của đơn vị dựa trên năng lực chỉ huy'
	R
	'của vị tướng đó.'
	\L_018fb:
	ZH 1:
	'Vào đầu mỗi lượt, nếu đơn vị có ít quân hơn mức'
	R
	'tối đa, đơn vị đó sẽ tự động hồi một phần binh lực.'
	\L_018fb:
	ZH 1:
	'Bạn cũng có thể hồi phục số lượng lớn quân bằng'
	R
	'cách chọn Bổ sung quân trong màn hình Tướng lĩnh,'
	R
	'nhưng cách này sẽ tốn tiền.'
	\L_018fb:
	ZH 1:
	'Mỗi đơn vị chỉ có thể tham chiến một lần mỗi lượt.'
	R
	'Nếu hành động trong giai đoạn quân Rance, đơn vị đó'
	R
	'sẽ không thể hành động trong giai đoạn phe địch.'
	\L_018fb:
	@L_0024e:
*L_00894:
	ZH 1:
	'Khác với đơn vị quân, ninja cũng chỉ hành động một'
	R
	'lần mỗi lượt. Họ có thể do thám tin tức kẻ thù và'
	R
	'phá hoại các quốc gia địch.'
	\L_018fb:
	ZH 1:
	'Tuy nhiên họ cũng có thể bị bắt giữ, và khi đó bạn'
	R
	'sẽ mất họ vĩnh viễn.'
	\L_018fb:
	ZH 1:
	'Dù vậy, bạn luôn có thể do thám an toàn bằng ninja'
	R
	'khi quân địch đang tiến công bạn.'
	\L_018fb:
	@L_0024e:
*L_008e2:
	ZH 1:
	'Đội ngũ phát triển Kichikuou Rance'
	\L_018fb:
	ZH 1:
	'Cấu trúc kịch bản／Tác giả gốc'
	R
	'　　　　　　　TADA'
	\L_018fb:
	ZH 1:
	'Kịch bản'
	R
	'　　　　　　　Tori'
	R
	'　　　　　　　Fumya'
	\L_018fb:
	ZH 1:
	'Kịch bản'
	R
	'　　　　　　　Moomin'
	\L_018fb:
	ZH 1:
	'Thiết kế trò chơi'
	R
	'　　　　　　　TADA'
	\L_018fb:
	ZH 1:
	'Lập trình trò chơi'
	R
	'　　　　　　　WAO'
	R
	'　　　　　　　TADA'
	\L_018fb:
	ZH 1:
	'Thiết kế màn hình'
	R
	'　　　　　　　Purin'
	\L_018fb:
	ZH 1:
	'Họa sĩ chính'
	R
	'　　　　　　　Masato Mutsumi'
	R
	'　　　　　　　MIN'
