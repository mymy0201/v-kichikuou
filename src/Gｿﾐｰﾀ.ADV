		\L_0265f:
		\L_02652:
		\L_025aa:
		ZH 1:
		'Hiểu...'
		\L_0265f:
		ZH 1:
		'Tôi tin rằng trao'
		R
		'tình yêu cho những người'
		R
		'đáng thương là một trong'
		\L_0265f:
		ZH 1:
