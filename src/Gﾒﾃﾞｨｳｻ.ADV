	\L_029d7:
	\L_029ca:
	\L_02922:
	ZH 1:
	'Vâng, vâng, tôi biết.'
	\L_029d7:
	\L_029ca:
	\L_028b2:
	ZH 1:
	'Làm sao cậu có thể thực'
