	'phần lạnh nhạt.'
	\L_07e59:
	\L_07e4c:
	\L_07dc0:
	ZH 1:
	'Rốt cuộc,'
	\L_07e59:
	ZH 1:
	'dù là kẻ lên ngôi bằng thực'
