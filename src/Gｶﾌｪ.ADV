	'biết là không thể...'
	\L_07e59:
	\L_07e4c:
	\L_07d34:
	ZH 1:
	'Cô tên Lady phải không.'
	\L_07e59:
	\L_07e4c:
	\L_07da4:
	ZH 1:
	'Vâng.'
	\L_07e59:
	\L_07e4c:
	\L_07d34:
	ZH 1:
	'Lệnh của quốc'
