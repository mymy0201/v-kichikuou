	'gái bán hoa à?'
	\L_07e59:
	\L_07e4c:
	\L_07da4:
	ZH 1:
	'Vâng.'
	\L_07e59:
	\L_07e4c:
	\L_07d34:
	ZH 1:
	'Hừmmm... Nhưng mà,'
