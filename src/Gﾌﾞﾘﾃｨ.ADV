		\L_024ff:
		\L_024b9:
		!VAR0516 : 34!
		\L_024ab:
		\L_02457:
		ZH 1:
		'Không...'
		\L_0250c:
		ZH 1:
		'Anh bị thương cũng vì cố cứu'
