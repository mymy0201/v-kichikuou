	\L_024d1:
	\L_024b5:
	ZM 32:
	ZH 1:
	'Helman'
	R
	ZM 24:
	ZH 1:
	R
	'Thành phố quy hoạch Sudori'
	R
	'17 Aristoles đang đọc sách'
	R
	'một mình trong phòng thì...'
	\L_025a2:
	\L_02595:
	\L_024ed:
	ZH 1:
	'Thưa...'
	\L_025a2:
	ZH 1:
	'Tướng quân Aristoles...'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Giọng nói đó...'
	\L_025a2:
	\L_02595:
	!VAR0516 : 433!
	\L_02541:
	\L_024ed:
	ZH 1:
	'Hehehehe...'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Convert... Ta tưởng ngươi'
	R
	'đào ngũ rồi. Đi đâu vậy?'
	\L_025a2:
	\L_02595:
	\L_024ed:
	ZH 1:
	'Heheheh... Thực ra,'
	R
	'tôi muốn nói về chuyện đó...'
	\L_025a2:
	\L_02595:
	\L_02525:
	ZH 1:
	'Convert xoa tay, liên tục'
	R
	'khom lưng chào Aristoles.'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Cái gì?'
	\L_025a2:
	\L_02595:
	\L_024ed:
	ZH 1:
	'Xin ngài ghé tai cho tôi'
	R
	'bẩm.'
	\L_025a2:
	\L_02595:
	\L_02525:
	ZH 1:
	'Convert đến chỗ'
	R
	'Aristoles, nhìn quanh để xác'
	R
	'nhận không có ai xung quanh,'
	\L_025a2:
	ZH 1:
	'sau đó thì thầm vào tai anh.'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'... Điều đó có đúng không?'
	\L_025a2:
	\L_02595:
	\L_024ed:
	ZH 1:
	'Dạ thật.'
	\L_025a2:
	ZH 1:
	'Vua Leazas nói nếu ngài gia'
	R
	'nhập quân Leazas'
	\L_025a2:
	ZH 1:
	'thì sẽ giao Sheila cho ngài.'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Nhưng... tôi...'
	\L_025a2:
	\L_02595:
	\L_024ed:
	ZH 1:
	'Ngài chắc chứ? Vậy tôi phải'
	R
	'mau về bẩm'
	\L_025a2:
	ZH 1:
	'rằng Tướng quân không cần'
	R
	'Sheila...'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Khoan... Đợi đã!'
	\L_025a2:
	\L_02595:
	\L_024ed:
	ZH 1:
	'Cái gì?'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Vua Leazas'
	R
	'nói... Hắn sẽ...'
	\L_025a2:
	\L_02595:
	\L_024ed:
	ZH 1:
	'Haah...'
	\L_025a2:
	ZH 1:
	'Tôi bắt đầu'
	R
	'mất kiên nhẫn rồi.'
	\L_025a2:
	ZH 1:
	'Chỉ cần nói'
	R
	'những gì cậu muốn cho'
	R
	'Hoàng hậu Sheila...'
	\L_025a2:
	ZH 1:
	'Nếu cậu không'
	R
	'đi thì mặc định Sheila'
	R
	'sẽ là của Vua Rance...'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Đừng nói thế...!'
	\L_025a2:
	\L_02595:
	\L_024ed:
	ZH 1:
	'Ngài quyết thế nào?'
	\L_025a2:
	ZH 1:
	'Tôi tưởng ngài sẽ vui nên'
	R
	'mới vội đến đây...'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'............'
	\L_025a2:
	\L_02595:
	\L_024b5:
	ZH 1:
	'Aristoles chìm vào im'
	R
	'lặng và nhắm mắt lại.'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'............'
	\L_025a2:
	ZH 1:
	'Được rồi... Tôi sẽ đi...'
	\L_025a2:
	\L_02595:
	\L_024ed:
	ZH 1:
	'Đã quyết thì càng'
	\L_025a2:
	ZH 1:
	'sớm càng tốt. Lên đường'
	\L_025a2:
	ZH 1:
	'thôi.'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'... Phải...'
	\L_025a2:
	\L_02595:
	\L_02499:
	ZH 1:
	'Patton...'
	\L_025a2:
	ZH 1:
	'Xin lỗi, tha cho tôi... Tôi'
	R
	'không thể rời xa Bệ hạ'
	R
	'Sheila...'
	\L_025a2:
	ZH 1:
	'Xin lỗi...'
	\L_025a2:
	\L_02595:
	\L_024df:
	\L_0254f:
	\L_024b5:
	ZH 1:
	'Lực lượng'
	R
	'của Aristoles rời Quân'
	R
	'đội Patton vào đêm đó.'
	\L_025a2:
	\L_02595:
