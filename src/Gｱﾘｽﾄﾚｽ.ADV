	ZM 32:
	ZH 1:
	'Lâu đài Leazas -'
	R
	ZM 24:
	ZH 1:
	R
	'Sân trong Rance thong thả'
	R
	'bước đi.'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Khá chắc'
	R
	'chắn là người giúp việc đã'
	R
	'nói rằng hắn ở quanh đây.'
	\L_025a2:
	\L_02595:
	\L_024b5:
	ZH 1:
	'Rance đang'
	R
	'tìm Kiếm Aristoles.'
	\L_025a2:
	\L_02595:
	\L_02525:
	ZH 1:
	'... Vâng... ...'
	\L_025a2:
	ZH 1:
	'Hì hì...'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Ừm?'
	\L_025a2:
	\L_02595:
	\L_024b5:
	ZH 1:
	'Có tiếng người vọng từ trước'
	R
	'luống hoa.'
	\L_025a2:
	\L_02595:
	\L_024df:
