	\L_00f8c:
	!VAR0516 : 499!
	\L_00f38:
	\L_00ee4:
	ZH 1:
	'Được diện kiến ngài thật'
	R
	'vinh hạnh vô cùng, gya,'
	R
	'thưa Quốc vương Rance.'
	\L_00f99:
	\L_00f8c:
	\L_00f46:
