	\L_00f8c:
	\L_00f46:
	!VAR0516 : 255!
	\L_00f38:
	\L_00ee4:
	ZH 1:
	'Em đi kèm với anh trai, gya.'
	\L_00f99:
	ZH 1:
	'Em ghét đánh nhau, nhưng'
