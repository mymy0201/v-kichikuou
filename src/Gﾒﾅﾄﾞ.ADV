	ZH 1:
	R
	'Phòng yết kiến Menad'
	R
	'trông có vẻ sảng khoái.'
	\L_05d85:
	\L_05d78:
	\L_05c60:
	ZH 1:
	'Em trông ổn.'
	\L_05d85:
	\L_05d78:
	\L_05cd0:
	ZH 1:
	'Em rất khỏe.'
	\L_05d85:
	\L_05d78:
	\L_05c98:
	ZH 1:
	'Menad cười toe toét.'
	\L_05d85:
	\L_05d78:
	\L_05cd0:
	ZH 1:
	'Ngài Rance,'
	R
	'cách đây không lâu có'
