	\L_0470a:
	\L_04646:
	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng yết kiến'
	\L_04733:
	\L_04726:
	!VAR0516 : 1!
	\L_04662:
	!VAR0516 : 25!
	\L_046d2:
	\L_04646:
	ZH 1:
	'Rance đang làm một vẻ'
	R
	'mặt trang trọng khác thường.'
	\L_04733:
	\L_04726:
	\L_0467e:
	ZH 1:
	'King Rance...'
	R
	'Có vẻ như những giấc'
	R
	'mơ đó là có thật...'
	\L_04733:
	\L_04726:
	\L_04646:
	ZH 1:
	'Rance không trả lời.'
	\L_04733:
	\L_04726:
	\L_0467e:
	ZH 1:
	'Chúng ta,'
	R
	'nhân loại, đã hứng chịu'
	R
	'cơn thịnh nộ của Chúa...'
	\L_04733:
	\L_04726:
	\L_04646:
	ZH 1:
	'Lời nói của Kou'
	R
	'không đến nỗi khó chịu'
	R
	'mà chấp nhận sự vô ích.'
	\L_04733:
	\L_04726:
	\L_0460e:
	ZH 1:
	'... Hmph, ta'
	R
	'sẽ không thua đâu.'
	\L_04733:
	\L_04726:
	\L_0467e:
	ZH 1:
	'Hả... Vua Rance?'
	\L_04733:
	\L_04726:
	\L_0460e:
	ZH 1:
	'Ta đã nói rằng ta sẽ'
	R
	'không thua một con cá voi.'
	\L_04733:
	ZH 1:
	'Có Chúa hay'
	R
	'không, ta đã chinh phục'
	R
	'được cả thế giới này.'
	\L_04733:
	ZH 1:
	'Và nếu ta có thể'
	R
	'làm được điều đó! Một'
	R
	'con cá voi sẽ làm gì?!'
	\L_04733:
	\L_04726:
	\L_04646:
	ZH 1:
	'Rance giận dữ đứng dậy.'
	\L_04733:
	\L_04726:
	\L_0460e:
	ZH 1:
	'Em ơi! Em'
	R
	'đã có giấc mơ đó kể từ'
	R
	'khi chuyện này bắt đầu?!'
	\L_04733:
	\L_04726:
	\L_04646:
	ZH 1:
	'Kou lùi lại'
	R
	'một chút, bị choáng ngợp'
	R
	'bởi cường độ của Rance.'
	\L_04733:
	\L_04726:
	\L_0467e:
	ZH 1:
	'Vâng... Chúa'
	R
	'ơi... Rudrasaum đang'
	R
	'mỉm cười hạnh phúc.'
	\L_04733:
	ZH 1:
	'Giống như đang'
	R
	'tận hưởng những gì đang'
	R
	'xảy ra với thế giới vậy…'
	\L_04733:
	\L_04726:
	\L_0460e:
	ZH 1:
	'Kh, thích không? Thật'
	R
	'là một kẻ đáng ghét...'
	\L_04733:
	\L_04726:
	\L_04646:
	ZH 1:
	'Rance ngồi xuống. Rồi'
	R
	'anh nghĩ về điều gì đó.'
	\L_04733:
	\L_04726:
	\L_0460e:
	ZH 1:
	'Lựa chọn duy nhất'
	R
	'của chúng ta là giết nó.'
	\L_04733:
	\L_04726:
	\L_0467e:
	ZH 1:
	'Nhưng Vua Rance!'
	R
	'Chủ nhân sẽ thách thức vị'
	R
	'thần đã tạo ra thế giới.'
	\L_04733:
	\L_04726:
	\L_0460e:
	ZH 1:
	'Không sao đâu. Nó'
	R
	'đang cản đường ta.'
	\L_04733:
	ZH 1:
	'Điều đó có'
	R
	'nghĩa là tất cả những gì'
	R
	'ta có thể làm là giết nó.'
	\L_04733:
	ZH 1:
	'Ta sẽ nghiền nát bất cứ ai'
	R
	'cản đường ta, bất kể là ai.'
	\L_04733:
	\L_04726:
	\L_04646:
	ZH 1:
	'Rance nhìn lên.'
	\L_04733:
	\L_04726:
	\L_0460e:
	ZH 1:
	'Này, Kou. Em có'
	R
	'biết cá voi ở đâu không?'
	\L_04733:
	ZH 1:
	'Ta không phải'
	R
	'là loại người có thể chờ'
	R
	'đợi điều đó đến với mình.'
	\L_04733:
	ZH 1:
	'Ta sẽ đi giết nó!'
	\L_04733:
	\L_04726:
	\L_0467e:
	ZH 1:
	'U-Ừm... Vua Rance...'
	\L_04733:
	\L_04726:
	\L_0460e:
	ZH 1:
	'Hừm, không có gì'
	R
	'phải lo cả! Không thể'
	R
	'nào ta lại thua được!'
	\L_04733:
	\L_04726:
	\L_0467e:
	ZH 1:
	'Không, không phải'
	R
	'vậy... Thậm chí Kou còn'
	R
	'không biết nó ở đâu...'
	\L_04733:
	\L_04726:
	\L_0460e:
	ZH 1:
	'Cái-Cái gì?'
	\L_04733:
	ZH 1:
	'... Đồ hèn'
	R
	'nhát, chạy trốn!'
	\L_04733:
	{VAR0492 > 1:
		\L_04726:
		\L_04646:
		ZH 1:
		'Đột nhiên, Rance'
		R
		'nảy ra một ý tưởng.'
		\L_04733:
		\L_04726:
		\L_0462a:
		ZH 1:
		'Đợi đã... Nơi có Chúa...'
		\L_04733:
		\L_04726:
		\L_0460e:
		ZH 1:
		'Ồ vâng, Hồ Raga! Hắn'
		R
		'và nhóm của hắn đã đến đó!'
		\L_04733:
		ZH 1:
		'Nếu ta nhớ không lầm'
		R
		'thì có một cánh cửa dẫn đến'
		R
		'Chúa ở trong Di tích cổ...'
		\L_04733:
		ZH 1:
		'Ừ, thế đấy! Đó'
		R
		'hẳn là cách đến Rudrasaum!'
		\L_04733:
		\L_04726:
		\L_04646:
		ZH 1:
		'Rance đứng thẳng lên.'
		\L_04733:
		ZH 1:
		'Anh ta vẫy chiếc áo choàng'
		R
		'của mình và đi về phía'
		R
		'lối ra của phòng tiếp kiến.'
		\L_04733:
		\L_04726:
		\L_0467e:
		ZH 1:
		'Vua Rance,'
		R
		'ngài đi đâu thế...?'
		\L_04733:
		\L_04726:
		\L_0460e:
		ZH 1:
		'Chúng ta cần'
		R
		'một số bức tượng vàng để mở'
		R
		'cánh cửa trong khu tàn tích!'
		\L_04733:
		ZH 1:
		'Ta sẽ thu'
		R
		'thập chúng nhanh chóng!'
		\L_04733:
		ZH 1:
		'Chuẩn bị chết'
		R
		'đi, Rudrasaum! Gahahahaha!'
		\L_04733:
	}
	\L_04726:
