	{VAR0690 = 2:
		!VAR0516 : 0!
		%#M.ADV:
		!VAR0516 : 1046!
		\L_012a6:
		!VAR0516 : 1!
		\L_011fe:
		!VAR0516 : 425!
		\L_0126e:
		\L_011e2:
		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến Ngươi'
		R
		'gọi là Vua của Leazas?'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Vâng, Các Hiệp'
		R
		'sĩ Leazas dường như'
		R
		'đang tự hỏi về ngươi.'
		\L_012cf:
		ZH 1:
		'họ nghĩ rằng'
		R
		'lời nói và hành vi của ngươi'
		R
		'không phải là rất hiệp sĩ.'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Hoooh... Ngạc nhiên'
		R
		'là họ thấy điều đó.'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Người Lạ nổi bật.'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Tôi nghĩ điều tương tự'
		R
		'cũng có thể xảy ra với ngài.'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Cái gì!?'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Tôi muốn sống'
		R
		'theo cách của ngài.'
		\L_012cf:
		ZH 1:
		'Đừng xúc phạm, nhưng'
		R
		'ngài không bị ràng buộc'
		R
		'bởi bất cứ điều gì...'
		\L_012cf:
		ZH 1:
		'Dù thế nào đi nữa,'
		R
		'ngài trông có vẻ tự do.'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Hừm. Đoán vậy.'
		\L_012cf:
		ZH 1:
		'Tuy nhiên, điều đó chỉ'
		R
		'có thể thực hiện được nếu'
		R
		'ngươi có tài năng như ta.'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Tôi không phải là'
		R
		'kẻ sẽ mạo hiểm mạng sống của'
		R
		'mình vì lòng trung thành...'
		\L_012cf:
		ZH 1:
		'Không phù hợp để'
		R
		'trở thành một thứ ngu'
		R
		'ngốc như một hiệp sĩ.'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 6!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Xin Lỗi để'
		R
		'làm gián đoạn, nhưng...'
		\L_012cf:
		ZH 1:
		'Cách tôi nhìn'
		R
		'thấy Nó, Hubert,'
		\L_012cf:
		ZH 1:
		'Có vẻ Như Patton'
		R
		'Không có hiệp sĩ nào'
		R
		'đáng tin cậy hơn cậu.'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 425!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Việc tôi trở thành hiệp'
		R
		'sĩ chẳng liên quan gì cả.'
		\L_012cf:
		ZH 1:
		'chúng tôi chỉ'
		R
		'là những người cậu cũ đã ở'
		R
		'bên nhau một thời gian dài.'
		\L_012cf:
		ZH 1:
		'Tôi không coi anh ta'
		R
		'là chúa tể của mình,'
		\L_012cf:
		ZH 1:
		'và anh ta cũng không coi'
		R
		'tôi là thần dân trung thành.'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 6!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Tôi nghĩ tình'
		R
		'cậu vượt xa mối quan hệ'
		R
		'giữa chúa tể và thần dân.'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 425!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Cắt nó đi, nếu cậu muốn.'
		\L_012cf:
		ZH 1:
		'Đây không phải là'
		R
		'điều tôi có thể diễn đạt'
		R
		'bằng lời, cậu biết không?'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 6!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Huhu... Cậu nói đúng.'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Maris... Cô đã yêu'
		R
		'anh chàng này chưa?'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Ồ, tất nhiên là không'
		R
		'rồi, thưa Bệ hạ... Hohohoh.'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 425!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Gahahahaha!'
		\L_012cf:
		ZH 1:
		'Tôi không'
		R
		'cảm thấy tệ khi có một cô'
		R
		'gái hấp dẫn phải lòng tôi.'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Dừng lại.'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Được rồi, được rồi.'
		\L_012cf:
		\L_012c2:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
