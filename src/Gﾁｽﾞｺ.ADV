	{VAR0336 = 7:
		!VAR0516 : 52!
		\L_0629e:
		\L_0624a:
		ZH 1:
		'Cuối cùng đã'
		R
		'đến lúc xuất kích chưa,'
		R
		'Lãnh chúa Chizuko?!'
		\L_062ff:
		\L_062f2:
		\L_061da:
		ZH 1:
		'Ôi, Annis! Tại sao cậu'
		R
		'lại đi vào từ cửa sổ?!'
		\L_062ff:
		\L_062f2:
		\L_06212:
		ZH 1:
		'Annis nhảy vào từ'
		R
		'cửa sổ tầng trên cùng.'
		\L_062ff:
		\L_062f2:
		\L_0624a:
		ZH 1:
		'À, có một vết rò'
		R
		'rỉ trên mái nhà và...'
		\L_062ff:
		ZH 1:
		'Đợi đã, quan'
		R
		'trọng hơn là chúng ta đang'
		R
		'triển khai, phải không!?'
		\L_062ff:
		ZH 1:
		'Tôi sẽ cố gắng'
		R
		'hết sức! Tôi sẽ quay lại'
		R
		'với 200 đầu lính Leazas!'
		\L_062ff:
		\L_062f2:
		\L_061da:
		ZH 1:
		'Không cần đâu, ghê quá.'
		\L_062ff:
		\L_062f2:
		\L_0624a:
		ZH 1:
		'Aah, tôi háo hức quá.'
		R
		'Xin hãy xem, Ngài Chizuko.'
		\L_062ff:
		ZH 1:
		'Tôi ngu ngốc'
		R
		'nhưng tôi mạnh mẽ nên'
		R
		'lần này tôi sẽ có ích.'
		\L_062ff:
		ZH 1:
		'Nếu đầu quá lớn để'
		R
		'làm chiến lợi phẩm, có'
		R
		'thể là tai hoặc mũi...'
		\L_062ff:
		ZH 1:
		'Điều gì sẽ tốt, Chúa'
		R
		'Chizuko? Có lẽ là ngón tay?'
		\L_062ff:
		ZH 1:
		'Ngoài ra, tôi'
		R
		'có thể chi 200 VÀNG cho'
		R
		'đồ ăn nhẹ, phải không?'
		\L_062ff:
		ZH 1:
		'Tôi có nên lấy'
		R
		'một quả chuối không?'
		\L_062ff:
		ZH 1:
		'Tôi có nên pha trà cho'
		R
		'căng tin của mình không...?!'
		\L_062ff:
		\L_062f2:
		\L_061da:
		ZH 1:
		'Im đi. Cậu ở lại để'
		R
		'trông chừng tòa tháp, Annis.'
		\L_062ff:
		\L_062f2:
		\L_0624a:
		ZH 1:
		'Huuuuuuuuuh!? Nhưng'
		R
		'Ngài Chizuko...!'
		\L_062ff:
		\L_062f2:
		\L_061da:
		ZH 1:
		'Thật ngu'
		R
		'ngốc khi quá phấn khích,'
		R
		'thật thiếu văn minh...'
		\L_062ff:
		ZH 1:
		'Tôi là một chỉ huy'
		R
		'tuyệt vời, cậu biết đấy.'
		\L_062ff:
		ZH 1:
		'Chúng tôi sẽ không'
		R
		'triển khai như không có gì.'
		\L_062ff:
		ZH 1:
		'Dù sao đi nữa,'
		\L_062ff:
		ZH 1:
		'tôi không biết cậu'
		R
		'đang nghĩ gì khi chiến đấu'
		R
		'mà lại tấn công đồng minh.'
		\L_062ff:
		\L_062f2:
		\L_0624a:
		ZH 1:
		'À, ừm, tôi thực sự'
		R
		'đang cố gắng làm tốt...'
		\L_062ff:
		\L_062f2:
		\L_061da:
		ZH 1:
		'Và bằng cách nào'
		R
		'đó điều đó khiến cậu tiêu'
		R
		'diệt các đơn vị đồng minh!'
		\L_062ff:
		ZH 1:
		'Hãy thay đổi lối'
		R
		'suy nghĩ đó, hãy để Papaya'
		R
		'đốt cháy nó trong cậu nhé!'
		\L_062ff:
		\L_062f2:
		\L_0624a:
		ZH 1:
		'X-Xin lỗi.'
		\L_062ff:
		\L_062f2:
		\L_061da:
		ZH 1:
		'Chà...'
		\L_062ff:
		ZH 1:
		'Nếu cậu thực sự muốn tấn'
		R
		'công Leazas đến vậy thì đừng'
		R
		'làm học trò của tôi nữa.'
		\L_062ff:
		ZH 1:
		'Chỉ cần là một'
		R
		'người lính hạng ba.'
		\L_062ff:
		\L_062f2:
		\L_0624a:
		ZH 1:
		'Haah... Tôi'
		R
		'bị sa thải à...?'
		\L_062ff:
		\L_062f2:
		\L_061da:
		ZH 1:
		'À... Có lẽ vậy. Nếu'
		R
		'là cậu thì đó sẽ là một'
		R
		'sự giải thoát cho tôi.'
		\L_062ff:
		\L_062f2:
		\L_0624a:
		ZH 1:
		'Xin đừng bỏ'
		R
		'rơi tôi, Ngài Chizukooo.'
		\L_062ff:
		\L_062f2:
		\L_06212:
		ZH 1:
		'Annis làm một bộ'
		R
		'mặt thực sự đáng thương.'
		\L_062ff:
		ZH 1:
		'Chizuko cảm thấy'
		R
		'mình vượt trội và'
		R
		'mỉm cười hài lòng.'
		\L_062ff:
		\L_062f2:
		\L_061da:
		ZH 1:
		'Heheh...'
		\L_062ff:
		ZH 1:
		'Tôi chắc chắn một kẻ'
		R
		'hư hỏng hoàn toàn như'
		\L_062ff:
		ZH 1:
		'anh cũng sẽ gây ra'
		R
		'vấn đề cho quân đội...'
		\L_062ff:
		ZH 1:
		'Đây là thời điểm'
		R
		'chính trị quan trọng'
		R
		'nên hãy đợi ở đây.'
		\L_062ff:
		ZH 1:
		'Danh tiếng của tôi'
		R
		'sẽ giảm sút nếu tôi để một'
		R
		'tên ngốc không bị kiểm soát.'
		\L_062ff:
		\L_062f2:
		\L_0624a:
		ZH 1:
		'Ah... Cảm ơn cậu rất'
		R
		'nhiều, tôi sẽ ở lại đây!'
		\L_062ff:
		\L_062f2:
		\L_061f6:
		ZH 1:
		'Nàng là một'
		R
		'tên ngốc nhưng lại được ban'
		R
		'cho rất nhiều sức mạnh...'
		\L_062ff:
		ZH 1:
		'Nếu cần, nàng'
		R
		'có thể được sử dụng làm'
		R
		'nguyên liệu cho Flash,'
		\L_062ff:
		ZH 1:
		'vì vậy tôi nên'
		R
		'giữ nàng bên mình.'
		\L_062ff:
		\L_062f2:
		\L_061da:
		ZH 1:
		'Huhuhu, huhuhuhu...'
		\L_062ff:
		\L_062f2:
		\L_0624a:
		ZH 1:
		'Ahaha, ahahahaha.'
		R
		'Ahahahahahahah aha.'
		R
		'Vui quá, ngài Chizuko.'
		\L_062ff:
		\L_062f2:
		\L_061da:
		ZH 1:
		'Cậu không cần phải cười!'
		\L_062ff:
		ZH 1:
		'Nếu cậu có'
		R
		'thời gian để cười thì hãy'
		R
		'làm công việc của mình!'
		\L_062ff:
		ZH 1:
		'Cậu định đứng'
		R
		'đây bao lâu nữa?!!'
		\L_062ff:
		\L_062f2:
		\L_0624a:
		ZH 1:
		'Được rồi!'
		\L_062ff:
		\L_062f2:
	}
