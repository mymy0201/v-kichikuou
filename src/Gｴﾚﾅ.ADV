	'Có một giọng nói ngọt'
	R
	'ngào không phù hợp sau khi'
	R
	'trận chiến đi qua thị trấn.'
	\L_03719:
	ZH 1:
	'Cô gái bán hoa'
	R
	'lại đi bán hoa.'
	\L_03719:
	\L_0370c:
	!VAR0516 : 99!
	\L_03648:
	\L_035f4:
	ZH 1:
	'Hoa rất duyên dáng.'
	\L_03719:
	ZH 1:
	'Sau giờ làm việc mệt mỏi,'
	R
	'cậu thử ngắm một vài bông'
	R
	'hoa để xoa dịu tâm hồn nhé?'
	\L_03719:
	ZH 1:
	'Cậu có cần'
	R
	'hoa không...? Anh lính,'
	R
	'anh có cần hoa không?'
	\L_03719:
	\L_0370c:
	!VAR0516 : 260!
	\L_036b8:
	\L_03664:
	ZH 1:
	'Hoa...? Không,'
	R
	'tôi không biết.'
	\L_03719:
	\L_0370c:
	\L_036c6:
	\L_035f4:
	ZH 1:
	'Tôi hiểu rồi...'
	\L_03719:
	\L_0370c:
	\L_03656:
	\L_035f4:
	ZH 1:
	'Tôi sẽ mua một ít.'
	\L_03719:
	\L_0370c:
	!VAR0516 : 99!
	\L_036b8:
	\L_03664:
	ZH 1:
	'À, kyah...!'
	\L_03719:
	\L_0370c:
	\L_0362c:
	ZH 1:
	'Đột nhiên,'
	\L_03719:
	ZH 1:
	'có cánh tay nào đó'
	R
	'vươn ra từ phía sau'
	\L_03719:
	ZH 1:
	'cô gái và giật lấy những'
	R
	'bông hoa trong giỏ của cô.'
	\L_03719:
	\L_0370c:
	!VAR0516 : 1!
	\L_03648:
	\L_03664:
	ZH 1:
	'Thưa ngài...!'
	\L_03719:
	\L_0370c:
	\L_035f4:
	ZH 1:
	'Hôm nay mười lăm'
	R
	'bó...? Vì vậy, 30 VÀNG.'
	\L_03719:
	\L_0370c:
	\L_03664:
	ZH 1:
	'Vâng, ừm, như mọi khi,'
	R
	'cảm ơn cậu. Ồ vâng, đây...'
	\L_03719:
	\L_0370c:
	\L_0362c:
	ZH 1:
	'Cô gái lấy một bông'
	R
	'hoa cài trên tóc mình và dán'
	R
	'nó vào cổ áo giáp của Rance.'
	\L_03719:
	\L_0370c:
	\L_03664:
	ZH 1:
	'Đ-Có thể'
	R
	'không nhiều, nhưng đó'
	R
	'là lời cảm ơn của tôi...'
	\L_03719:
	ZH 1:
	'Cảm xúc của'
	R
	'tôi. Vâng, xin lỗi...'
	\L_03719:
	\L_0370c:
	\L_036c6:
	\L_035f4:
	ZH 1:
	'À, lại à? Này...'
	\L_03719:
	\L_0370c:
	\L_0362c:
	ZH 1:
	'Cô gái đỏ mặt'
	R
	'và chạy khỏi khu vực'
	R
	'đó sau khi nói xong.'
	\L_03719:
	\L_0370c:
	\L_03656:
	\L_0362c:
	ZM 32:
	ZH 1:
	'Ngõ Sau'
	\L_03719:
	ZM 24:
	\L_0370c:
	!VAR0516 : 99!
	\L_03648:
	\L_035f4:
	ZH 1:
	'Ha ha, ha ha, ha ha...'
	\L_03719:
	\L_0370c:
	\L_0362c:
	ZH 1:
	'Cô gái dừng lại'
	R
	'và chống tay vào tường.'
	\L_03719:
	ZH 1:
	'Cô kiềm chế bộ'
	R
	'ngực đang phập phồng'
	R
	'lên xuống của mình.'
	\L_03719:
	\L_0370c:
	Y 4, 3:
	!VAR0690 : VAR0000!
	{VAR0690 = 1:
		\L_03610:
		ZH 1:
		'Tôi gặp lại nhà vua...'
		R
		'Tôi nên làm gì đây? Tim'
		R
		'tôi đang đập thình thịch...'
		\L_03719:
		ZH 1:
		'Tôi yêu Đức Vua... Nhưng'
		R
		'tình yêu của tôi sẽ không'
		R
		'bao giờ được đáp ứng...'
		\L_03719:
		ZH 1:
		'Không thể nào...'
		\L_03719:
		ZH 1:
		'Tôi nên làm'
		R
		'gì đây, thưa ngài?'
		\L_03719:
		\L_0370c:
		!VAR0516 : 0!
		%#M.ADV:
		SS VAR0515:
		%0:
	}
	{VAR0690 = 2:
		\L_03610:
		ZH 1:
		'Hôm nay cậu lại'
		R
		'tử tế với tôi nữa...'
		\L_03719:
		ZH 1:
		'Tại sao...? Tại sao'
		R
		'cậu lại tốt bụng như vậy...?'
		\L_03719:
		ZH 1:
		'Ngay cả mẹ'
		R
		'kế hay chị kế cũng'
		R
		'không tử tế với tôi...'
		\L_03719:
		ZH 1:
		'Nhưng thật đau lòng'
		R
		'khi ngài tử tế, thưa ngài...'
		\L_03719:
		\L_0370c:
		!VAR0516 : 0!
		%#M.ADV:
		SS VAR0515:
		%0:
	}
	{VAR0690 = 3:
		\L_03610:
		ZH 1:
		'Anh yêu em... Anh'
		R
		'không thể không yêu em...'
		\L_03719:
		ZH 1:
		'Nhưng ngay cả sau những'
		R
		'cuộc gặp gỡ định mệnh đó,'
		\L_03719:
		ZH 1:
		'tình yêu này vẫn'
		R
		'không được đáp lại…'
		\L_03719:
		ZH 1:
		'Aah... Không'
		R
		'sao đâu, vì hôm nay'
		R
		'anh đã được gặp em...'
		\L_03719:
		ZH 1:
		'Anh phải được gặp em'
		R
		'và tặng hoa cho em...'
		\L_03719:
		ZH 1:
		'Chỉ thế thôi cũng đủ'
		R
		'khiến tôi hạnh phúc rồi...'
		\L_03719:
		\L_0370c:
