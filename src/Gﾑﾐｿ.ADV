		'gian hàng hơi kỳ lạ ở góc'
		R
		'phòng.'
		\L_00f6b:
		\L_00f5e:
		\L_00e46:
		ZH 1:
		'... Sao trên bàn làm việc'
		R
		'lại có xì dầu với nước sốt'
		R
		'ponzu?'
		\L_00f6b:
