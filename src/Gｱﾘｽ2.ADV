	\L_05b27:
	\L_05a7f:
	ZH 1:
	'Gâu gâu!'
	\L_05b34:
	\L_05b27:
	\L_05a47:
	ZH 1:
	'Portie đổi tay phải'
	R
	'thành tay trái.'
	\L_05b34:
	\L_05b27:
	\L_05a0f:
	ZH 1:
	'Quay ba vòng rồi'
	R
	'sủa một tiếng!'
