	\L_05b27:
	\L_05a7f:
	ZH 1:
	'Vui quá!'
	\L_05b34:
	\L_05b27:
	\L_05a0f:
	ZH 1:
	'N-này, sao tự'
	R
	'nhiên lại làm thế?'
	\L_05b34:
	\L_05b27:
	\L_05a7f:
	ZH 1:
	'Vì Bệ hạ vừa khen Portie mà!'
	\L_05b34:
	\L_05b27:
	\L_05a0f:
	ZH 1:
	'Hả?'
	\L_05b34:
	\L_05b27:
	\L_05a7f:
	ZH 1:
	'Được khen chứng tỏ'
	R
	'Portie ngoan, đúng không?'
