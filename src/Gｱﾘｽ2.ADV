	\L_05b27:
	\L_05a0f:
	ZH 1:
	'Ừ. Không cần ngươi nhắc.'
	\L_05b34:
	\L_05b27:
	\L_05a47:
	ZH 1:
	'Rance ngồi phịch xuống'
