	ZH 1:
	'............ đó là ai...?'
	\L_03c7e:
	\L_03c71:
	\L_03c01:
	ZH 1:
	'Stessel trả'
	R
	'lời, một số cạnh nhỏ'
	R
	'trong lời nói của mình.'
	\L_03c7e:
	\L_03c71:
	\L_03c01:
	ZH 1:
	'Là tôi đây.'
	R
	'Stessel. Tôi đang mở cửa.'
	\L_03c7e:
	\L_03c71:
	\L_03be5:
	ZH 1:
	'Pamela...'
	\L_03c7e:
	\L_03c71:
	\L_03b59:
	ZH 1:
	'Mẹ...?'
	\L_03c7e:
	\L_03c71:
	\L_03c01:
	ZH 1:
	'Stessel buộc Môi'
	R
	'Sheila trở lại vòi nước của'
	R
	'mình và lắc đầu lên xuống,'
	\L_03c7e:
	ZH 1:
	'thúc giục nàng'
	R
	'tiếp tục không có lời.'
	\L_03c7e:
	ZH 1:
	'Sheila âm thầm vâng lời,'
	\L_03c7e:
	ZH 1:
	'nhét đôi môi ngọt'
	R
	'ngào của mình bằng vòi nước'
	R
	'bọt của Stessel một lần nữa.'
	\L_03c7e:
	\L_03c71:
	\L_03bc9:
	ZH 1:
	'Được rồi, tiếp tục đi.'
	\L_03c7e:
	\L_03c71:
	\L_03c01:
	ZH 1:
	'Stessel phủ'
	R
	'Sheila bằng các tờ'
