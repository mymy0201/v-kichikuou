		ZH 1:
		'Satella.'
		\L_0377e:
		\L_03771:
		\L_03659:
		ZH 1:
		'Silky!!'
		\L_0377e:
		\L_03771:
		\L_03691:
		ZH 1:
		'Satella chạy ào tới Silky'
		R
