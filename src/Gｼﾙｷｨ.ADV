		\L_0377e:
		\L_03771:
		\L_03659:
		ZH 1:
		'Silky, sao lại...'
		\L_0377e:
		\L_03771:
		\L_036c9:
		ZH 1:
		'Nhiều chuyện lắm... A!'
		\L_0377e:
		\L_03771:
		\L_03701:
		ZH 1:
		'Bước được một hai bước,'
		R
		'Silky loạng choạng.'
		\L_0377e:
		\L_03771:
		\L_03659:
		ZH 1:
		'Silky!!'
		\L_0377e:
		\L_03771:
		\L_03691:
		ZH 1:
		'Satella vội đỡ lấy.'
		\L_0377e:
		ZH 1:
		'Silky, còn nhỏ hơn cả'
		R
		'Satella vốn đã nhỏ nhắn,'
		R
		'ngã gọn vào lòng cô.'
		\L_0377e:
		ZH 1:
		'Satella「Sao thế?'
		R
		'Bị kẻ nào đánh...」'
		\L_0377e:
		\L_03771:
		\L_03701:
		ZH 1:
		'Satella cảm nhận được sức'
		R
