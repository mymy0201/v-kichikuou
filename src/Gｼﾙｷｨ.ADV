		\L_0377e:
		\L_03771:
		\L_03659:
		ZH 1:
		'Silky...'
		\L_0377e:
		\L_03771:
		\L_036c9:
		ZH 1:
		'Phư phư... Cô'
		R
		'nhận ra rồi à...?'
