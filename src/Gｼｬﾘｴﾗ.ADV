	ZH 1:
	'Rance đang'
	R
	'nằm và Shariela đang bám'
	R
	'chặt vào bên cạnh anh.'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Khò... khò...'
	\L_02215:
	\L_02208:
	\L_02128:
	ZH 1:
	'Rance ngáy to,'
	R
	'cơ thể và tâm hồn anh'
	R
	'hoàn toàn sảng khoái.'
	\L_02215:
	ZH 1:
	'Shariela quan'
	R
	'sát anh thật kỹ.'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Ngài Rance...'
	\L_02215:
	\L_02208:
	\L_02198:
	ZH 1:
	'Shariela nhẹ nhàng'
	R
	'chọc vào má Rance.'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Guh... Zzzzzz...'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Huhu...'
	\L_02215:
	\L_02208:
	\L_02198:
	ZH 1:
	'Shariela cười vui vẻ'
