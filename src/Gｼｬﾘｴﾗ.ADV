	\L_021b4:
	\L_020f0:
	ZH 1:
	'Ngươi có ở'
	R
	'đây không, Shariela?'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Vâng!'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Được rồi, đến đây.'
	\L_02215:
	\L_02208:
	\L_02128:
	ZH 1:
	'Rance vỗ nhẹ vào giường.'
	\L_02215:
	ZH 1:
	'Shariela lao tới Rance.'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'À...'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Ồ, đó.'
	\L_02215:
	\L_02208:
	\L_02198:
	ZH 1:
	'（bụp）'
	\L_02215:
	ZH 1:
	'Shariela ngã vào'
	R
	'ngực Rance do cách tiếp'
	R
	'cận điên cuồng của nàng.'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'À... tôi xin lỗi!'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Ngươi có muốn làm điều'
	R
	'đó với ta đến mức đó không?'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Vâng!'
	\L_02215:
	\L_02208:
	\L_02198:
	ZH 1:
	'Shariela mỉm'
	R
	'cười hồn nhiên.'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Bởi vì...'
	\L_02215:
	ZH 1:
	'Cậu đã cứu tôi, Vua Rance.'
	\L_02215:
	ZH 1:
	'Khi cậu không gọi cho tôi,'
	\L_02215:
	ZH 1:
	'tôi tự hỏi liệu'
	R
	'tôi có thể trở lại thành'
	R
	'búp bê lần nữa không...'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Nghĩ nhiều'
	R
	'quá đấy đồ ngốc.'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Nhưng...'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Đừng nghĩ về bất cứ'
	R
	'điều gì như vậy vào lúc này.'
	\L_02215:
	\L_02208:
	\L_02128:
	ZH 1:
	'Rance nắm chặt quần áo của'
	R
	'Shariela một cách thô bạo.'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'À...'
	\L_02215:
	\L_02208:
