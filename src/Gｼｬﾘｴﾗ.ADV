	'Gugaaahaaahaha!haha!...'
	R
	'Gugaaahaaahaha!haha!...'
	\L_02215:
	\L_02208:
	\L_02128:
	ZH 1:
	'Rance ngáy to,'
	R
	'cơ thể và tâm hồn anh'
	R
	'hoàn toàn sảng khoái.'
	\L_02215:
	ZH 1:
	'Shariela quan'
	R
	'sát anh thật kỹ.'
	\L_02215:
