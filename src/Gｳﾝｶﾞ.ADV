	\L_01179:
	!VAR0516 : 12!
	\L_011e9:
	\L_01125:
	ZH 1:
	'Haah... Có'
	R
	'vẻ như ngươi đã quen với'
	R
	'cơ thể của ta ở đây rồi.'
	PF0 VAR0056:
	\L_0124a:
	\L_0123d:
	\L_011cd:
	ZH 1:
	'Sayori mệt chết đi được.'
	R
	'Rance chạy ngón tay từ mông'
	R
	'đến âm hộ nhỏ giọt của cô.'
	\L_0124a:
	\L_0123d:
	\L_01195:
	ZH 1:
	'............'
	\L_0124a:
	\L_0123d:
	\L_011cd:
	ZH 1:
	'Sayori che nó lại để'
	R
	'cố thoát khỏi tầm mắt'
	\L_0124a:
	ZH 1:
	'của Rance và bắt đầu từ'
	R
	'từ mặc lại quần áo của mình.'
	\L_0124a:
	\L_0123d:
	\L_01195:
	ZH 1:
	'............'
	\L_0124a:
	\L_0123d:
	\L_011f7:
	\L_011cd:
	ZH 1:
	'Nói xong,'
	R
	'Sayori chạy ra khỏi phòng'
	R
	'như thể đang trốn chạy.'
	\L_0124a:
	\L_0123d:
	\L_01125:
	ZH 1:
	'Nàng bị sao vậy...?'
