	'ngon hơn cho cậu.'
	\L_01dcf:
	\L_01dc2:
	\L_01caa:
	ZH 1:
	'Thực sự!?'
	\L_01dcf:
	\L_01dc2:
	\L_01d1a:
	ZH 1:
	'Vâng. Đổi lại, cậu phải lắng'
