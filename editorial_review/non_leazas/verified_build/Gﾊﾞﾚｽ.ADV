	!VAR0516 : 1!
	\L_00d85:
	!VAR0516 : 402!
	\L_00df5:
	\L_00da1:
	ZH 1:
	'Bệ hạ Rance cho gọi lão thần?'
	\L_00e56:
	\L_00e49:
	\L_00dd9:
	ZH 1:
	'Barres đến trước ngai vàng.'
	\L_00e56:
	\L_00e49:
	Y 4, 3:
	{VAR0000 = 1:
		\L_00d31:
		ZH 1:
		'Ừ, đúng thế. Bé Barres.'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'B-Bé Barres??'
		\L_00e56:
		\L_00e49:
		\L_00d31:
		ZH 1:
		'Ta cũng chẳng có gì để nói với'
		R
		'ngươi. Ra đằng kia trồng cây'
		R
		'chuối đi.'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'Dạ?'
		\L_00e56:
		\L_00e49:
		\L_00d31:
		ZH 1:
		'Ta bảo trồng cây chuối. Hay'
		R
		'ngươi không chịu nghe lệnh nhà'
		R
		'vua...?'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'Trồng cây chuối à? Sở trường của'
		R
		'lão thần đấy. Hự...'
		\L_00e56:
		\L_00e49:
		\L_00dd9:
		ZH 1:
		'Barres trồng cây chuối trước mặt'
		R
		'Rance.'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'Hẳn là việc này có dụng ý gì đó?'
		\L_00e56:
		\L_00e49:
		\L_00d31:
		ZH 1:
		'............'
		\L_00e56:
		\L_00e49:
		\L_00d4d:
		ZH 1:
		'Ta định chọc quê nếu lão không'
		R
		'làm được, vậy mà...'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'Bệ hạ Rance?'
		\L_00e56:
		\L_00e49:
		\L_00d31:
		ZH 1:
		'Đủ rồi.'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'Dạ, vâng...'
		\L_00e56:
		\L_00e49:
		\L_00dd9:
		ZH 1:
		'Barres thôi trồng cây chuối.'
		\L_00e56:
		\L_00e49:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR0000 = 2:
		\L_00da1:
		ZH 1:
		'Giờ xin bàn việc chính...'
		\L_00e56:
		\L_00e49:
		\L_00d31:
		ZH 1:
		'Hả??'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'Việc mà Bệ hạ...'
		\L_00e56:
		\L_00e49:
		\L_00d31:
		ZH 1:
		'Ngươi nói gì vậy?'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'Dạ? Sao cơ?? Chẳng phải Bệ hạ'
		R
		'cho gọi lão thần sao?'
		\L_00e56:
		\L_00e49:
		\L_00d31:
		ZH 1:
		'Ai rảnh mà gọi một lão già đến'
		R
		'chứ? Barres...'
		\L_00e56:
		ZH 1:
		'Ngươi bắt đầu lẩm cẩm rồi đấy.'
		R
		'Hay là tai nghe ra tiếng ảo rồi?'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'Chưa đâu! Lão thần vẫn...'
		\L_00e56:
		\L_00e49:
		\L_00d31:
		ZH 1:
		'Kệ ngươi. Khuất mắt ta đi. Mắt'
		R
		'ta chỉ để ngắm gái đẹp thôi.'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'Ờ... Vâng... Lão thần xin lui...'
		\L_00e56:
		\L_00e49:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR0000 = 3:
		\L_00da1:
		ZH 1:
		'Bệ hạ gọi thật đúng lúc. Lão'
		R
		'thần cũng có chuyện muốn thưa...'
		\L_00e56:
		ZH 1:
		'Xin mạn phép, Bệ hạ Rance, cách'
		R
		'hành xử của Bệ hạ chưa xứng với'
		R
		'một vị vua.'
		\L_00e56:
		ZH 1:
		'Với thần dân, mọi hành vi của'
		R
		'nhà vua đều là khuôn mẫu.'
		\L_00e56:
		ZH 1:
		'Xin Bệ hạ giữ phong thái quân'
		R
		'vương hơn...'
		\L_00e56:
		ZH 1:
		'Và xin đừng ngủ khi lão thần'
		R
		'đang nói! Bệ hạ Rance!'
		\L_00e56:
		\L_00e49:
		\L_00d31:
		ZH 1:
		'Khò khò.'
		\L_00e56:
		\L_00e49:
		\L_00da1:
		ZH 1:
		'Ôi... Cả Nữ hoàng Lia lẫn Bệ hạ'
		R
		'Rance đều như vậy... Tại sao...?'
		\L_00e56:
		\L_00e49:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
