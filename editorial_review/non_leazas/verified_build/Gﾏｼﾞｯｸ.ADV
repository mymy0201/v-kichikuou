	R
	'trước không?Nó có đau không?'
	\L_07dc3:
	\L_07db6:
	\L_07d0e:
	ZH 1:
	'...Hả...?'
	\L_07dc3:
	\L_07db6:
	\L_07c9e:
	ZH 1:
