*L_03e16:
		ZH 1:
		'rèm cửa tiếp tục lên xung quanh'
		R
		'cầu thang được lắp đặt trong'
		R
		'phòng,'
		\L_0631e:
		ZH 1:
		'ở trên cùng là một tấm đệm làm'
		R
		'bằng vải chất lượng cao.'
		\L_0631e:
		ZH 1:
		'Hơn hết, lạnh hơn băng, đẹp hơn'
		R
		'hoa, Camilla ngồi khỏa thân.'
		\L_0631e:
		ZH 1:
		'Các chàng trai tụ tập quanh'
		R
		'cô.Họ là những nạn nhân của cô'
		R
		'đã bị cô mê hoặc đến mức không'
		\L_0631e:
		ZH 1:
		'thể thoát ra được.'
		\L_0631e:
		ZH 1:
		'Cậu Bé Tóc Bạc 「Aah... Cô'
		R
		'Camilla... Tóc của bạn rất'
		R
		'đẹp...」'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc vàng'
		R
		'「Ms.Camilla... Hôm nay tôi hát'
		R
		'cho bạn nghe nhé?」'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc hồng 「Aah... Cô'
		R
		'Camilla... Cô Camilla...」'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc xanh 「...À...」'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc nâu 「...Ừm...」'
		\L_0631e:
		ZH 1:
		'Không Giống như những cậu bé'
		R
		'khác, những cậu bé tóc xanh và'
		R
		'nâu không chắc phải làm gì.'
		\L_0631e:
		ZH 1:
		'Họ chưa quen với hậu cung này.'
		\L_0631e:
		ZH 1:
		'Nhưng vì lý do đó mà cơ thể của'
		R
		'chúng phản ứng nhiều hơn những'
		R
		'con khác,'
		\L_0631e:
		ZH 1:
		'và những cự vật còn non nớt của'
		R
		'chúng cứng đờ một cách đau đớn.'
		\L_0631e:
		ZH 1:
		'Camila 「............」'
		\L_0631e:
		ZH 1:
		'Camilla từ từ duỗi chân về phía'
		R
		'chàng trai tóc xanh.'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc xanh 「À...!!」'
		\L_0631e:
		ZH 1:
		'Chân của Camilla tóm lấy cự vật'
		R
		'cứng ngắc của cậu bé và từ từ di'
		R
		'chuyển lên xuống chỉ một lần.'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc xanh'
		R
		'「Aaaaaaaaah...!!」'
		\L_0631e:
		ZH 1:
		'điều đó một mình khiến cậu bé'
		R
		'tóc xanh đạt cực khoái trên đỉnh'
		R
		'Chân Camilla.'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc xanh 「À...'
		R
		'tôi...」'
		\L_0631e:
		ZH 1:
		'Camila 「............」'
		\L_0631e:
		ZH 1:
		'） ptssh）'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc xanh 「A...'
		R
		'Aaaahn!」'
		\L_0631e:
		ZH 1:
		'Camilla tát vào má cậu bé.Ngay'
		R
		'cả khi gục xuống sàn,'
		\L_0631e:
		ZH 1:
		'anh ấy vẫn lên đỉnh chỉ sau cú'
		R
		'chạm của Camilla.'
		\L_0631e:
		ZH 1:
		'Camilla 「...Làm sạch đi...」'
		\L_0631e:
		ZH 1:
		'cô ấy đưa chân bẩn của mình ra'
		R
		'cho cậu bé tóc nâu.'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc nâu 「Huh...?」'
		\L_0631e:
		ZH 1:
		'Anh nhìn Camilla với đôi mắt ướt'
		R
		'đến mức mờ đi.'
		\L_0631e:
		ZH 1:
		'Nhưng đôi mắt của Camilla rất'
		R
		'kiên quyết và cô không hề có ý'
		R
		'định lắng nghe hy vọng của cậu'
		\L_0631e:
		ZH 1:
		'bé.'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc nâu 「C-Cảm ơn'
		R
		'cậu... Tôi rất vui khi được chạm'
		R
		'vào chân cậu...」'
		\L_0631e:
		ZH 1:
		'cậu bé tóc nâu run rẩy trong khi'
		R
		'nhẹ nhàng chạm Vào Chân Camilla.'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc nâu 「A... Ahn!」'
		\L_0631e:
		ZH 1:
		'cơ thể cậu bé tóc nâu run rẩy.'
		\L_0631e:
		ZH 1:
		'Chỉ cần từ đầu ngón tay chạm Vào'
		R
		'Chân Camilla,'
		\L_0631e:
		ZH 1:
		'anh ấy đã lên đến đỉnh điểm với'
		R
		'niềm vui lạ thường.'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc nâu 「À... Ahn...」'
		\L_0631e:
		ZH 1:
		'cậu bé tóc nâu run rẩy vì thích'
		R
		'Thú khi Bị Camilla đánh,'
		\L_0631e:
		ZH 1:
		'và tinh dịch của Cậu làm bẩn'
		R
		'khuôn mặt của cậu bé tóc xanh'
		R
		'nằm trên sàn nhà.'
		\L_0631e:
		ZH 1:
		'Camilla 「...Heh... Heheh...」'
		\L_0631e:
		ZH 1:
		'Camilla cười tinh tế khi nhìn'
		R
		'thấy nó.'
		\L_0631e:
		ZH 1:
		'Camilla 「...Các chàng trai'
		R
		'ngoan... Bây giờ, nữa... Không'
		R
		'để tôi chán...」'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc vàng 「...Vâng,'
		R
		'thưa cô Camilla... Nếu là vì cô,'
		R
		'tôi sẽ làm bất cứ điều gì...」'
		\L_0631e:
		ZH 1:
		'Chàng trai tóc hồng 「Tôi cũng'
		R
		'vậy...」'
		\L_0631e:
		ZH 1:
		'Tôi thậm chí sẽ quan hệ tình dục'
		R
		'với một người phụ nữ bẩn thỉu'
		R
		'khác nếu tôi phải làm vậy...」'
		\L_0631e:
		ZH 1:
		'Cậu Bé Tóc Bạc 「tôi đã tự cắt'
		R
		'tay mình...」'
		\L_0631e:
		ZH 1:
		'Nếu Cô Camilla cũng muốn tôi,'
		R
		'tôi sẽ cười khi làm điều đó...」'
		\L_0631e:
		ZH 1:
		'Camilla 「...Heh... Hahah...」'
		\L_0631e:
		ZH 1:
		'tiếng nói mê hoặc của các chàng'
		R
		'trai tiếp tục lần lượt, không'
		R
		'ngừng như nước từ suối,'
		\L_0631e:
