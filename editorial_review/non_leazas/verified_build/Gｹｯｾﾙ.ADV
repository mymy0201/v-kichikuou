	'ta không hiểu chuyện gì đã xảy'
	\L_04753:
	ZH 1:
	'ra và sụp đổ.'
	\L_04753:
	\L_04746:
	\L_0469e:
	ZH 1:
	'Hiiiiiii!!'
	\L_04753:
	ZH 1:
	'Hngaaaaaaaa!!'
	\L_04753:
	\L_04746:
	\L_0462e:
	ZH 1:
	'Im lặng!!'
	\L_04753:
	\L_04746:
	\L_0469e:
	ZH 1:
	'Gyah...!!'
	\L_04753:
	ZH 1:
	'Hừ...!!'
	\L_04753:
	ZH 1:
	'Geheh...'
	\L_04753:
	\L_04746:
	\L_04700:
	\L_04666:
	ZH 1:
	'Tiếng hét của Kesselring khiến'
