	\L_06ed4:
	!VAR0516 : 426!
	\L_06ec6:
	\L_06e72:
	ZH 1:
	'đó là chính xác.'
	\L_06f27:
	ZH 1:
	'Tôi tin rằng cơ hội duy nhất của'
