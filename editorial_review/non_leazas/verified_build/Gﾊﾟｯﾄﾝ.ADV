		\L_06f1a:
		\L_06ed4:
		!VAR0516 : 423!
		\L_06ec6:
		\L_06e72:
		ZH 1:
		'Ah...'
		\L_06f27:
		ZH 1:
		'Ah, tôi vừa nhớ ra một số công'
