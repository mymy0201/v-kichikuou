		\L_06f1a:
		\L_06e72:
		ZH 1:
		'Hả...?'
		\L_06f27:
		\L_06f1a:
		\L_06ed4:
		!VAR0516 : 6!
		\L_06ec6:
		\L_06e72:
		ZH 1:
