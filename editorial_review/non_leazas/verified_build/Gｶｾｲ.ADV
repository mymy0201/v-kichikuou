	!VAR0690 : VAR0000!
	{VAR0690 = 1:
		\L_042c7:
		ZH 1:
		'Vì vậy, tôi đã tự hỏi về một cái'
		R
		'gì đó trong một thời gian...'
		\L_043ec:
		\L_043df:
		\L_04337:
		ZH 1:
		'Vâng, nó là gì?'
		\L_043ec:
		\L_043df:
		\L_042c7:
		ZH 1:
		'Bạn mua quần áo như vậy Ở đâu?'
		\L_043ec:
		\L_043df:
		\L_04337:
		ZH 1:
		'Aah... Bạn đang thắc mắc về quần'
		R
		'áo của tôi à?'
		\L_043ec:
		\L_043df:
		\L_042c7:
		ZH 1:
		'Vâng, đúng vậy.'
		\L_043ec:
		\L_043df:
		\L_04337:
		ZH 1:
		'Của tôi...'
		\L_043ec:
		ZH 1:
		'vì vậy, bạn hiểu ý thức thời'
		R
		'trang của tôi và muốn tự mình'
		R
		'mặc những bộ quần áo này,'
		\L_043ec:
		ZH 1:
		'có đúng không?'
		\L_043ec:
		\L_043df:
		\L_042c7:
		ZH 1:
		'Không.'
		\L_043ec:
		ZH 1:
		'Tôi chỉ đang tự hỏi liệu một thợ'
		R
		'may chỉ may quần áo như thế có'
		R
		'thực sự làm được không?'
		\L_043ec:
		ZH 1:
		'tiền.'
		\L_043ec:
		\L_043df:
		\L_04337:
		ZH 1:
		'Sau đó, bạn có nghĩa là bạn muốn'
		R
		'để có được quần áo của tôi đặt'
		R
		'hàng thực hiện,'
		\L_043ec:
		ZH 1:
		'làm chủ trượt bỏ qua,'
		\L_043ec:
		ZH 1:
		'và đi bộ qua thị trấn nắm tay'
		R
		'nhau?'
		\L_043ec:
		\L_043df:
		\L_042c7:
		ZH 1:
		'Tôi không nắm tay đàn ông.'
		\L_043ec:
		\L_043df:
		\L_04337:
		ZH 1:
		'Aah... Tệ quá.'
		\L_043ec:
		\L_043df:
		\L_0436f:
		ZH 1:
		'Mars Đại Đế có vẻ thực sự thất'
		R
		'vọng và chán nản gục đầu xuống.'
		\L_043ec:
		\L_043df:
		\L_042c7:
		ZH 1:
		'Vậy, nó là thợ may gì?'
		\L_043ec:
		\L_043df:
		\L_04337:
		ZH 1:
		'Tôi sẽ không nói cho bạn biết...'
		\L_043ec:
		\L_043df:
		\L_042c7:
		ZH 1:
		'Cái gì?'
		\L_043ec:
		\L_043df:
		\L_04337:
		ZH 1:
		'Tôi sẽ nói cho bạn biết nếu bạn'
		R
		'mặc quần áo giống tôi.'
		\L_043ec:
		ZH 1:
		'Lala～～～.'
		\L_043ec:
		\L_043df:
		\L_04399:
		\L_0436f:
		ZH 1:
		'Mars Đại đế trượt khỏi ngai'
		R
		'vàng.'
		\L_043ec:
		\L_043df:
	}
