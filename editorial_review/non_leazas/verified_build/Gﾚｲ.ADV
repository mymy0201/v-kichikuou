	\L_02e4e:
	\L_02d8a:
	ZM 32:
	ZH 1:
	X 8:
	R
	ZM 24:
	ZH 1:
	R
	'Bầu Trời Phía Trên'
	\L_02e77:
	ZH 1:
	'Một người đang lơ lửng.Đúng hơn,'
	\L_02e77:
	ZH 1:
	'có thể chính xác hơn khi nói'
	R
	'rằng một sinh vật hình người'
	R
	'đang lơ lửng.'
	\L_02e77:
	\L_02e6a:
	!VAR0516 : 445!
	\L_02da6:
	\L_02d52:
	ZH 1:
	'............'
	\L_02e77:
	\L_02e6a:
	\L_02d8a:
	ZH 1:
	'Đó là quỷ Lôi,'
	\L_02e77:
	ZH 1:
	'một người đàn ông không thể chạm'
	R
	'vào người khác do cơ thể anh ta'
	R
	'liên tục xả điện.'
	\L_02e77:
	ZH 1:
	'Lei nhìn xuống thành phố sau'
	R
	'trận chiến và nhẹ nhàng đeo găng'
	R
	'tay cách điện vào.'
	\L_02e77:
	ZH 1:
	'Đó là một phong tục mà anh ấy có'
	R
	'khi một trận chiến kết thúc.'
	\L_02e77:
	\L_02e6a:
	\L_02d52:
	ZH 1:
	'Hừm...'
	\L_02e77:
	\L_02e6a:
	\L_02d8a:
	ZH 1:
	'Một nỗi đau như trái tim anh bị'
	R
	'một cái gai nhỏ đâm xuyên qua'
	R
	'người Lei.'
	\L_02e77:
	ZH 1:
	'Anh ấy luôn cảm thấy như vậy sau'
	R
	'một trận chiến.'
	\L_02e77:
	ZH 1:
	'Kể từ khi anh gặp một người phụ'
	R
	'nữ nào đó.Trước đó,'
	\L_02e77:
	ZH 1:
	'chiến đấu chỉ là một trò chơi'
	R
	'đối với Lei...'
	\L_02e77:
	ZH 1:
	'Anh từng coi việc đánh nhau là'
	R
	'chuyện đương nhiên và không hề'
	R
	'hối hận về việc mình đã đánh'
	\L_02e77:
	ZH 1:
	'nhau.'
	\L_02e77:
	ZH 1:
	'cuộc sống.'
	\L_02e77:
	\L_02e6a:
	\L_02d52:
	ZH 1:
	'Đức Maria...'
	\L_02e77:
	\L_02e6a:
	\L_02d8a:
	ZH 1:
	'Con vật thì thầm, rồi rời khỏi'
	R
	'thành phố.'
	\L_02e77:
	\L_02e6a:
	!VAR0516 : 0!
