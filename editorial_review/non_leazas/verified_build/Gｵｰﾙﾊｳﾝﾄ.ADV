	ZH 1:
	'（Bà nội） ............'
	\L_010c0:
	ZH 1:
	'（Bà Nội） Grampa... Grampa...'
	\L_010c0:
	ZH 1:
	'Ơ...'
	\L_010c0:
	ZH 1:
	'（Bà Nội） Grampa... Đó là những'
