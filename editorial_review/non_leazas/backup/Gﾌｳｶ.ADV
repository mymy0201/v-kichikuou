	'tôi ngay từ đầu.'
	\L_054da:
	\L_054cd:
	\L_053ed:
	ZH 1:
	'Rance cảm thấy hơi miễn cưỡng,'
	R
	'nhưng vẫn tiếp tục bước lên đền'
	R
	'thờ.'
