	\L_054cd:
	\L_05425:
	ZH 1:
	'...'
	\L_054da:
	\L_054cd:
	\L_053ed:
	ZH 1:
	'Fuuka tiếp tục cúi đầu và im'
	R
	'lặng.'
	\L_054da:
	\L_054cd:
	\L_053b5:
	ZH 1:
	'Ch.'
	\L_054da:
	\L_054cd:
	\L_05417:
	\L_053ed:
	ZH 1:
	'Rance buông Tay Fuuka và rời'
	R
	'khỏi đền thờ với một hương vị'
	R
	'xấu trong miệng.'
	\L_054da:
	\L_054cd:
	\L_05425:
	ZH 1:
	'Vua Rance...'
	\L_054da:
	\L_054cd:
	\L_053ed:
