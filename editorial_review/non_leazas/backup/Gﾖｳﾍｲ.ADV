	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng khán giả'
	\L_00b07:
	\L_00afa:
	\L_00a52:
	ZH 1:
	'Yoooooo.'
	\L_00b07:
	\L_00afa:
	\L_00a8a:
	ZH 1:
	'Louis đến trước Rance khi anh ấy'
	R
	'đang đọc truyện tranh về ngai'
	R
	'vàng.'
	\L_00b07:
	\L_00afa:
	\L_009e2:
	ZH 1:
	'Trời ạ, anh thật kinh tởm.'
	\L_00b07:
	\L_00afa:
	\L_00a52:
	ZH 1:
	'Công việc của tôi đã xong rồi,'
	R
	'King.Tôi sẽ đi.'
	\L_00b07:
	\L_00afa:
	\L_009e2:
	ZH 1:
	'Ra ngoài ngay.'
	\L_00b07:
	\L_00afa:
	\L_00a52:
	ZH 1:
	'Chắc chắn, chắc chắn. Gọi lại'
	R
	'cho tôi lần sau khi bạn muốn'
	R
	'tôi.'
	\L_00b07:
	ZH 1:
	'Tôi rất thích làm việc cho bạn.'
	\L_00b07:
	ZH 1:
	'vì vậy, hẹn gặp lại. Giữ sức'
	R
	'khỏe.'
	\L_00b07:
	\L_00afa:
	\L_00ab4:
	\L_00a8a:
	ZH 1:
	'Louis rời đi.'
	\L_00b07:
	\L_00afa:
	\L_009e2:
	ZH 1:
	'Này, Maris.'
	\L_00b07:
	\L_00afa:
	!VAR0516 : 6!
	\L_00aa6:
	\L_00a52:
	ZH 1:
	'Vâng?'
	\L_00b07:
	\L_00afa:
	\L_009e2:
	ZH 1:
	'Hãy chắc chắn rằng phòng của anh'
	R
	'ấy đã được khử trùng.Anh ấy bẩn'
	R
	'thỉu.'
	\L_00b07:
	\L_00afa:
	\L_00a52:
	ZH 1:
	'Vâng, hiểu rồi.'
	\L_00b07:
	\L_00afa:
