	\L_03053:
	\L_02fab:
	ZH 1:
	'...Cái gì đó...'
	\L_03060:
	\L_03053:
	\L_02f3b:
	ZH 1:
	'...Buồn cười...'
	\L_03060:
	\L_03053:
