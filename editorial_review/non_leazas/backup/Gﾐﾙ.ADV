	R
	'trường.'
	\L_03060:
	\L_03053:
	\L_02fab:
	ZH 1:
	'Ờ...'
	\L_03060:
	\L_03053:
	\L_02f3b:
	ZH 1:
	'Giờ thì đi thôi.'
	\L_03060:
	\L_03053:
	\L_02fab:
	ZH 1:
	'............'
	\L_03060:
	ZH 1:
	'Được rồi...'
