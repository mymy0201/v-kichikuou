		!VAR0516 : 2!
		\L_07790:
		\L_0773c:
		ZH 1:
		'À, Master Rance, tôi đã lấy được'
		R
		'rất nhiều thứ.'
		\L_077f1:
		\L_077e4:
		\L_076cc:
		ZH 1:
		'Cho tôi xem.'
		\L_077f1:
		\L_077e4:
		\L_0773c:
		ZH 1:
		'Ờ, à, được rồi...'
		\L_077f1:
		\L_077e4:
		\L_076cc:
		ZH 1:
		'Ồ, ồ.Đ-Đây là...'
		\L_077f1:
		\L_077e4:
		\L_0779e:
		!VAR0516 : 5!
		\L_07790:
		\L_0773c:
		ZH 1:
		'Trời ơi... Trời ơi!Em yêu, đủ'
		R
		'với nô lệ rồi!Hãy nghe Maris'
		R
		'nói...!'
		\L_077f1:
		\L_077e4:
		\L_076cc:
		ZH 1:
		'Agh, im đi.Được rồi, có chuyện'
		R
		'gì thế, Maris?Nói cho tôi.'
		\L_077f1:
		\L_077e4:
		\L_0779e:
		!VAR0516 : 6!
		\L_07790:
	}
	{VAR0102 = 0:
		\L_076cc:
		ZH 1:
		'Cái gì...?Có chuyện gì vui để'
		R
