	ZM 32:
	ZH 1:
	'Zeth'
	R
	ZM 24:
	ZH 1:
	R
	'Làng Xanh Kite'
	R
	'quay trở lại ngôi làng'
	R
	'bị con người bỏ rơi.'
	\L_022a0:
	\L_02293:
	!VAR0516 : 57!
	\L_0223f:
	\L_021eb:
	ZH 1:
	'Hu...'
	\L_022a0:
	ZH 1:
	'hu hu... Hức... hức...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Sao thế, Calorie...?'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'À...'
	\L_022a0:
	ZH 1:
	'Uu... Kite...!!'
	\L_022a0:
	\L_02293:
	\L_021b3:
	ZH 1:
	'Thấy Kite, Calorie chạy tới,'
	R
	'lao vào nép bên anh.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'（Calorie） Lyla đã...!'
	R
	'（Kite） Em bị nặng nhất'
	R
	'ấy... làm sao?'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Uu... Aaaah...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'... Nàng đã'
	R
	'qua đời rồi sao...?'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calorie vừa'
	R
	'khóc vừa gật đầu.'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Nàng có ra'
	R
	'đi thanh thản không?'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calorie lắc đầu.'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Vậy thì...'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Tự tử...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Cái gì...?'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Cô ấy tự sát rồi...'
	\L_022a0:
	ZH 1:
	'Vừa nãy... Cô nhớ lúc mắc'
	R
	'bệnh,'
	\L_022a0:
	ZH 1:
	'cha mẹ ruột nhìn mình như'
	R
	'mầm bệnh...'
	\L_022a0:
	ZH 1:
	'Người yêu xô mình như thứ'
	R
	'bẩn thỉu...'
	\L_022a0:
	ZH 1:
	'Nhớ lại chuyện ấy, cô khóc'
	R
	'thét như điên'
	\L_022a0:
	ZH 1:
	'rồi lao xuống vách đá...!!'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'............'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Uu... Uuu... Và em đã nói'
	R
	'với nàng nếu nàng ở lại...'
	\L_022a0:
	ZH 1:
	'Cuối cùng một cái'
	R
	'gì đó tốt sẽ xảy ra...'
	\L_022a0:
	ZH 1:
	'Tại sao...?'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calorie tiếp tục'
	R
	'khóc trong ngực Kite.'
	\L_022a0:
	\L_02293:
	\L_02197:
	ZH 1:
	'Lũ người... Các em ấy... chị'
	R
	'gái tôi...'
	\L_022a0:
	ZH 1:
	'đâu muốn mắc bệnh!'
	\L_022a0:
	ZH 1:
	'Sao dám đày đọa những cô gái'
	R
	'yếu'
	\L_022a0:
	ZH 1:
	'đuối thế này?'
	\L_022a0:
	ZH 1:
	'Không tha được...'
	\L_022a0:
	ZH 1:
	'Chúng tự cho mình là độc'
	R
	'tôn, ngang'
	\L_022a0:
	ZH 1:
	'nhiên kiêu ngạo, chỉ cần'
	R
	'mình yên ổn.'
	\L_022a0:
	ZH 1:
	'Hành hạ kẻ yếu rồi tưởng cảm'
	R
	'giác'
	\L_022a0:
	ZH 1:
	'hơn người ấy là chính'
	R
	'đáng...'
	\L_022a0:
	ZH 1:
	'Chính chúng mới điên, mới'
	R
	'đáng chết.'
	\L_022a0:
	ZH 1:
	'Tôi sẽ cho chúng biết.'
	\L_022a0:
	ZH 1:
	'Tôi đã nghĩ vậy từ trước'
	R
	'lệnh Kayblis... Lũ người,'
	\L_022a0:
	ZH 1:
	'tao sẽ cho chúng mày nếm nỗi'
	R
	'nhục bị khinh miệt...'
	\L_022a0:
	ZH 1:
	'đến đau đớn!'
	\L_022a0:
	\L_02293:
	\L_021b3:
	ZH 1:
	'Kite ôm lấy cơ thể'
	R
	'nhỏ bé của Calorie trong khi'
	R
	'cô run rẩy dựa vào ngực anh.'
