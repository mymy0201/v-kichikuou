	%#M.ADV:
	PF0 VAR0056:
	!VAR0516 : 1002!
	\L_03611:
	!VAR0516 : 1!
	\L_03569:
	!VAR0516 : 37!
	\L_035d9:
	\L_03515:
	ZH 1:
	'Chuyện đó thế nào?'
	\L_0363a:
	ZH 1:
	'Tình dục'
	R
	'có trở nên thú vị hơn một'
	R
	'chút đối với Suzume không?'
	\L_0363a:
	\L_0362d:
	\L_0354d:
	ZH 1:
	'Rance ngã người'
	R
	'xuống giường và'
	\L_0363a:
	ZH 1:
	'Suzume nằm dưới tấm'
	R
	'trải giường bên cạnh anh.'
	\L_0363a:
	\L_0362d:
	\L_03585:
	ZH 1:
	'Tôi không biết...'
	\L_0363a:
	ZH 1:
	'Nhưng...'
	\L_0363a:
	ZH 1:
	'Tôi không thích làm điều'
	R
	'đó với ngài, thưa Bệ hạ...'
	\L_0363a:
	\L_0362d:
	\L_03515:
	ZH 1:
	'Ta hiểu rồi.'
	R
	'Vậy thì ta muốn Suzume'
	R
	'biểu cảm hơn một chút.'
	\L_0363a:
	\L_0362d:
	\L_03585:
	ZH 1:
	'... Tôi sẽ cố gắng.'
	\L_0363a:
	ZH 1:
	'Ah, đừng ném khăn'
	R
	'giấy của chàng vào đó...'
	\L_0363a:
	\L_0362d:
	\L_035bd:
	ZH 1:
	'Suzume nói'
	R
	'khi nhìn Rance ném'
	R
	'khăn giấy xuống sàn.'
	\L_0363a:
