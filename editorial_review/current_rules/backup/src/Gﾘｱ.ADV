	'Chết tiệt!!'
	\L_045c8:
	\L_045bb:
	\L_0454b:
	ZH 1:
	'Lia nhảy vào phòng.'
	\L_045c8:
	\L_045bb:
	\L_044a3:
	ZH 1:
	'Được rồi, nàng ở đây.'
	\L_045c8:
	\L_045bb:
	\L_04513:
	ZH 1:
	'Thiếp rất hạnh phúc.'
	R
	'Thiếp đã chờ đợi mãi mãi.'
	\L_045c8:
	\L_045bb:
	\L_044a3:
	ZH 1:
	'Tuyệt vời.'
	\L_045c8:
	\L_045bb:
	\L_04513:
