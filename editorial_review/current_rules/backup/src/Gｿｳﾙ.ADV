	\L_04044:
	\L_04037:
	\L_03f8f:
	ZH 1:
	'Em sẽ đi chơi với đại ca.'
	\L_04044:
	\L_04037:
	\L_03f1f:
	ZH 1:
	'Cái gì!?'
	\L_04044:
	\L_04037:
	\L_03ff1:
	!VAR0516 : 472!
	\L_03fe3:
	\L_03f8f:
	ZH 1:
	'Tôi xin lỗi,'
