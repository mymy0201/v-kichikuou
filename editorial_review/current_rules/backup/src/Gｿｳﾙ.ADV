	\L_04037:
	\L_03f8f:
	ZH 1:
	'............'
	\L_04044:
	ZH 1:
	'.........'
	\L_04044:
	\L_04037:
	\L_03f1f:
	ZH 1:
	'Có chuyện gì vậy?'
	\L_04044:
	\L_04037:
	\L_03f8f:
	ZH 1:
	'Có rất nhiều phần'
	R
	'em không thể đọc được...'
	\L_04044:
	\L_04037:
	\L_03f1f:
	ZH 1:
	'Vậy thì ta có thể...'
	\L_04044:
	\L_04037:
