	\L_04c84:
	\L_04bdc:
	ZH 1:
	'Cái gì...?'
	\L_04c91:
	\L_04c84:
	\L_04b6c:
	ZH 1:
	'Cô không thừa nhận'
	R
	'ta là Vua, phải không?'
