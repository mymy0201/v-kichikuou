	\L_0498b:
	!VAR0516 : 6!
	\L_049fb:
	\L_0496f:
	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng yết'
	R
	'kiến Vua Rance.Lực lượng'
	R
	'của Redeye đang đến gần.'
	\L_04a5c:
	ZH 1:
	'Nếu họ đi qua'
	R
	'dãy núi, lũ quái vật'
	R
	'sẽ đến được Leazas...'
	\L_04a5c:
	\L_04a4f:
	\L_04937:
	ZH 1:
	'............ chúng'
	R
	'tôi không có một'
	R
	'phút để lãng phí.'
	\L_04a5c:
	\L_04a4f:
	\L_04937:
	ZH 1:
	'Tôi biết điều đó.'
	\L_04a5c:
	\L_04a4f:
	\L_049a7:
	ZH 1:
	'Xin hãy đưa ra'
	R
	'quyết định, Vua Rance.'
	\L_04a5c:
	\L_04a4f:
	\L_04937:
	ZH 1:
	'Tôi biết.Tôi sẽ'
	R
	'chặn chúng lại.'
	\L_04a5c:
	\L_04a4f:
	\L_049a7:
	ZH 1:
	'Không phải vậy.'
	\L_04a5c:
	ZH 1:
	'Ra lệnh cho cô gái'
	R
	'tên Rona bị ám sát để kết'
	R
	'thúc Cuộc đời Của Redeye...'
	\L_04a5c:
	\L_04a4f:
	\L_04937:
	ZH 1:
	'Bạn đang bảo tôi'
	R
	'ám sát một cô gái?'
	\L_04a5c:
	\L_04a4f:
	\L_049a7:
	ZH 1:
	'Vâng... Đó là lựa chọn'
	R
	'duy nhất chúng tôi còn lại.'
	\L_04a5c:
	ZH 1:
	'không có đủ thời gian'
	R
	'trước khi Lực Lượng Của'
	R
	'Redeye đi qua dãy núi...'
	\L_04a5c:
	ZH 1:
	'Một ninja có'
	R
	'thể ám sát Rona.'
	\L_04a5c:
	\L_04a4f:
	\L_04937:
	ZH 1:
	'Hmmmmmmmm.'
	\L_04a5c:
	\L_04a4f:
	\L_049a7:
	ZH 1:
	'Vua Rance... Xin hãy'
	R
	'quyết định cử ai đi.'
	\L_04a5c:
	\L_04a4f:
