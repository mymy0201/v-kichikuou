*L_00422:
	\L_04937:
	ZH 1:
	'Việc ám sát'
	R
	'một cô gái là đi ngược'
	R
	'lại chính sách của tôi.'
	\L_04a5c:
	\L_04a4f:
	\L_049a7:
	ZH 1:
	'Vua Rance... Đây'
	R
	'không phải lúc để...'
	\L_04a5c:
	\L_04a4f:
	\L_04937:
	ZH 1:
	'Yên lặng. Tôi'
	R
	'sẽ đánh Bại Redeye'
	R
	'thông qua sức mạnh.'
	\L_04a5c:
	\L_04a4f:
	\L_049a7:
	ZH 1:
	'............'
	\L_04a5c:
	\L_04a4f:
	\L_04937:
	ZH 1:
	'Dù sao thì tôi đã'
	R
	'nói là tôi sẽ không làm,'
	R
	'tức là tôi sẽ không làm.'
	\L_04a5c:
	\L_04a4f:
	\L_049a7:
	ZH 1:
	'...Hiểu rồi... Vậy'
	R
	'thì tôi sẽ tuân theo'
	R
	'mong muốn của bạn.'
	\L_04a5c:
	\L_04a4f:
	\L_04937:
	ZH 1:
	'Vâng.'
	\L_04a5c:
	\L_04a4f:
