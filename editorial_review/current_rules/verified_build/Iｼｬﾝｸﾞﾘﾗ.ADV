	!VAR0328 : 7!
	\L_0674c:
	ZH 1:
	'Chuỗi này được'
	R
	'tháo ra như thế nào?'
	\L_06871:
	\L_06864:
	\L_067bc:
	ZH 1:
	'Con người'
	R
	'chỉ cần nắm lấy còng và'
	R
	'nói “Ra đi,” nhưng...'
	\L_06871:
	ZH 1:
	'Rance, cậu thực sự...?'
	\L_06871:
	\L_06864:
	\L_0674c:
	ZH 1:
	'Thôi đi.'
	\L_06871:
	\L_06864:
	\L_06784:
	ZH 1:
	'Rance nắm'
	R
	'lấy còng trên chân của'
	R
	'Housesnurse và nói nhanh.'
	\L_06871:
	\L_06864:
	\L_06784:
	ZH 1:
	'（pahkin）'
	\L_06871:
	\L_06864:
	\L_067bc:
	ZH 1:
	'À...'
	\L_06871:
	\L_06864:
	\L_067f4:
	ZH 1:
	'Chiếc cùm biến mất'
	R
	'khỏi chân của Housesnurse.'
	\L_06871:
	\L_06864:
	\L_0674c:
	ZH 1:
	'Ở đó, bạn'
	R
	'được tự do.Bỏ trốn.'
	\L_06871:
	\L_06864:
	\L_067bc:
	ZH 1:
	'Bạn có chắc'
	R
	'không?Không có tôi, bạn'
	R
	'sẽ không thể quay lại đây.'
	\L_06871:
	\L_06864:
	\L_0674c:
	ZH 1:
	'Không sao đâu.'
	\L_06871:
	\L_06864:
	\L_067bc:
	ZH 1:
	'...Sau khi con người lợi'
	R
	'dụng tôi trong một thời gian'
	R
	'dài, tôi trở nên ghét họ.'
	\L_06871:
	ZH 1:
	'Vì vậy, tôi sẽ'
	R
	'không cảm ơn bạn.'
	\L_06871:
	\L_06864:
	\L_0674c:
	ZH 1:
	'Chắc chắn rồi.'
	\L_06871:
	\L_06864:
	\L_067bc:
	ZH 1:
	'............'
	\L_06871:
	ZH 1:
	'Không có tôi,'
	\L_06871:
	ZH 1:
	'nơi này sẽ trở thành'
	R
	'một sa mạc bình thường.Bạn'
	R
	'cũng sẽ bị lạc ở đây...'
	\L_06871:
	ZH 1:
	'Nhưng chỉ'
	R
	'trong một ngày thôi,'
	\L_06871:
	ZH 1:
	'tôi sẽ tiếp'
	R
	'tục đi trên những'
	R
	'con đường sa mạc...'
	\L_06871:
	ZH 1:
	'Hãy đi đến nơi bạn thích.'
	\L_06871:
	ZH 1:
	'Hẹn gặp lại.'
	\L_06871:
	\L_06864:
	\L_0674c:
	ZH 1:
	'Ừ, hãy bảo'
	R
	'trọng bản thân nhé.'
	\L_06871:
	\L_06864:
	\L_0681e:
	SS VAR0515:
	\L_067f4:
	ZH 1:
	'Y tá bỏ chạy.'
	\L_06871:
	ZH 1:
	'Sau khi cô ấy khuất dạng,'
	R
	'Rance cũng rời khỏi phòng'
	R
	'và quay trở lại sa mạc.'
	\L_06871:
	\L_06864:
	\L_067ae:
	\L_06784:
	ZH 1:
	'Rance rời Shangri-La.'
	\L_06871:
	ZH 1:
	'Con đường'
	R
	'tới Shangri-La đã bị phong'
	R
	'tỏa hoàn toàn.Nó trở thành'
	\L_06871:
	ZH 1:
	'một thị trấn ma ngoài'
	R
	'tầm với của bất kỳ ai.'
	\L_06871:
