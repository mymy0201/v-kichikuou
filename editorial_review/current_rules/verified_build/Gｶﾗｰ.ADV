	!VAR0516 : 1!
	\L_074d2:
	!VAR0516 : 95!
	\L_07542:
	\L_074ee:
	ZH 1:
	'Rance!'
	\L_075a3:
	\L_07596:
	\L_0747e:
	ZH 1:
	'Này, Arios.Họ có'
	R
	'thả bạn ra không?'
	\L_075a3:
	\L_07596:
	\L_074ee:
	ZH 1:
	'Vâng... Tôi'
	R
	'bị sốc. Rance... Anh'
	R
	'không thể tin được...'
	\L_075a3:
	\L_07596:
	\L_0747e:
	ZH 1:
	'Gahahahaha!.Đ ó là sự'
	R
	'thật.Tôi thật tuyệt vời.'
	\L_075a3:
	ZH 1:
	'Chà, bây giờ bạn'
	R
	'định làm gì khi rảnh rỗi?'
	\L_075a3:
	\L_07596:
	\L_074ee:
	ZH 1:
	'Tôi đang lên kế'
	R
	'hoạch thực hiện một'
	R
	'cuộc phiêu lưu khác.'
	\L_075a3:
	ZH 1:
	'Một hành trình rèn'
	R
	'luyện bản thân để sẵn'
	\L_075a3:
	ZH 1:
	'sàng khi thức tỉnh'
	R
	'với tư cách Anh hùng.'
	\L_075a3:
	\L_07596:
	\L_0747e:
	ZH 1:
	'Tôi hiểu rồi.Chà,'
	R
	'hãy đến vui chơi ở'
	R
	'Leazas nếu bạn muốn.'
	\L_075a3:
	\L_07596:
	\L_074ee:
	ZH 1:
	'Cảm ơn Bạn.'
	R
	'Cho đến lần sau...'
	\L_075a3:
	ZH 1:
	'do đó, người Bạn rance'
	R
	'đã thực hiện trong cabin'
	R
	'tiết kiệm, Arios Theoman,'
	\L_075a3:
	ZH 1:
	'để lại một cuộc phiêu lưu.'
	\L_075a3:
