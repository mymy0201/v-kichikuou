	PF0 VAR0056:
	\L_074b6:
	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng yết kiến Haah...'
	R
	'Đã lâu rồi chưa về nhà.'
	\L_075a3:
	\L_07596:
	\L_074ee:
	ZH 1:
	'Bạn đã Ở Đâu, Em'
	R
	'Yêu? Geez... Tôi đã lo lắng.'
	\L_075a3:
	\L_07596:
	\L_0747e:
	ZH 1:
	'Gahahahaha!,'
	\L_075a3:
	ZH 1:
	'không có gì phải lo'
	R
	'lắng cả.Tôi vừa dành chút'
	R
	'thời gian với bọn kalar.'
	\L_075a3:
	ZH 1:
	'Vì Vậy, Maris.'
	R
	'Như tôi đã giải thích. Tôi'
	R
	'để lại sự sắp xếp cho bạn.'
	\L_075a3:
	\L_07596:
	\L_07550:
	!VAR0516 : 6!
	\L_07542:
	\L_074ee:
	ZH 1:
	'Hiểu.'
	\L_075a3:
	ZH 1:
	'Tôi sẽ bố trí lính canh'
	R
	'từ Đất Nước của chúng tôi'
	\L_075a3:
	ZH 1:
	'Tại Rừng Kalar để ngăn'
	R
	'chặn bất kỳ kẻ xâm phạm nào.'
	\L_075a3:
	ZH 1:
	'chúng tôi'
	R
	'cũng sẽ đàn áp việc bán'
	R
	'tinh thể bất hợp pháp.'
	\L_075a3:
	\L_07596:
	\L_0747e:
	ZH 1:
	'Được rồi, tốt. tuy nhiên,'
	R
	'Một người bí ẩn như vậy...'
	\L_075a3:
	ZH 1:
	'Tôi không'
	R
	'thể tin rằng anh ấy đã'
	R
	'kết bạn với kalars...'
	\L_075a3:
	\L_07596:
	\L_0747e:
	ZH 1:
	'Ngoài ra...'
	R
	'Họ đã đưa cho tôi cô gái'
	R
	'này.Hãy chăm sóc cô ấy.'
	\L_075a3:
	\L_07596:
	\L_07550:
	!VAR0516 : 46!
	\L_07542:
	\L_074ee:
	ZH 1:
	'Tên tôi là Somita.Tôi'
	R
	'sẽ cố gắng chiến đấu mà'
	R
	'không kéo mọi người xuống.'
	\L_075a3:
	ZH 1:
	'Tôi rất mong được'
	R
	'làm việc với bạn.'
	\L_075a3:
	\L_07596:
	\L_07550:
	!VAR0516 : 6!
	\L_07542:
	\L_074ee:
	ZH 1:
	'Ồ... Kalar này là ai?'
	\L_075a3:
	\L_07596:
	\L_0747e:
	ZH 1:
	'Cô ấy đến từ lực lượng'
	R
	'phòng vệ của đất nước kalar.'
	\L_075a3:
	ZH 1:
	'Nữ Hoàng Pastel'
	R
	'đã gửi cô ấy và nói rằng'
	R
	'chúng ta nên sử dụng cô ấy.'
	\L_075a3:
	\L_07596:
	\L_07550:
	!VAR0516 : 46!
	\L_07542:
	\L_074ee:
	ZH 1:
	'Tôi sẽ cố gắng'
	R
	'hết sức để không làm ô'
	R
	'danh Nữ hoàng Pastel.'
	\L_075a3:
	\L_07596:
	\L_0747e:
	ZH 1:
	'Ừm.Thái độ tốt.'
	\L_075a3:
	\L_07596:
	\L_074b6:
	ZH 1:
	'Somita Kalar'
	R
	'gia nhập Rance.'
