	\L_02f90:
	\L_02ee8:
	ZH 1:
	'............'
	\L_02f9d:
	\L_02f90:
	\L_02f20:
	ZH 1:
	'Mokomoko nhìn chằm'
	R
	'chằm vào mặt Rance.'
	\L_02f9d:
	\L_02f90:
	\L_02e78:
	ZH 1:
	'............'
	\L_02f9d:
	\L_02f90:
	\L_02eb0:
	ZH 1:
	'Rance nhìn chằm'
	R
	'chằm vào Mokomoko.'
	\L_02f9d:
	ZH 1:
	'Họ im lặng'
	R
	'nhìn nhau một lúc.'
	\L_02f9d:
	\L_02f90:
	\L_02ee8:
	ZH 1:
	'... Tôi không hấp dẫn sao?'
	\L_02f9d:
	\L_02f90:
	\L_02e78:
	ZH 1:
	'Cái gì?'
	\L_02f9d:
	\L_02f90:
	\L_02ee8:
	ZH 1:
	'Tôi nghe nói anh đưa'
	R
	'tất cả những cô gái dễ'
	\L_02f9d:
	ZH 1:
	'thương mà anh thấy'
	R
	'vào dàn harem của mình,'
	\L_02f9d:
	ZH 1:
	'nên...'
	\L_02f9d:
	\L_02f90:
	\L_02f20:
	ZH 1:
	'Mokomoko lại'
	R
	'nhìn vào mặt Rance.'
