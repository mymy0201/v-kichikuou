	\L_02f90:
	\L_02e78:
	ZH 1:
	'Uh, tên ngươi'
	R
	'là Momoko phải không?'
	\L_02f9d:
	\L_02f90:
	\L_02ee8:
	ZH 1:
	'Mokomoko.'
	\L_02f9d:
	\L_02f90:
	\L_02e78:
	ZH 1:
	'Ồ vâng, Mokomoko. Đi'
