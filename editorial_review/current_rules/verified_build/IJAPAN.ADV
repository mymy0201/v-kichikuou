	\L_0879c:
	\L_086bc:
	ZH 1:
	'Ngược lại'
	R
	'với Nobunaga ngây ngất,'
	R
	'Kou tiếp tục cau mày.'
	\L_087a9:
	\L_0879c:
	\L_086f4:
	ZH 1:
	'Cha...'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Ừm, cái gì'
	R
	'vậy?Bạn muốn một món'
	R
	'quà lưu niệm từ lục địa?'
	\L_087a9:
	\L_0879c:
	\L_086f4:
	ZH 1:
	'Cha ơi, xin'
	R
	'hãy dừng lại đi...'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Lời phàn nàn của Kou'
	R
	'yếu ớt và bộc phát.Biểu cảm'
	\L_087a9:
	ZH 1:
	'của Nobunaga hoàn toàn'
	R
	'chuyển sang nghiêm túc.'
	\L_087a9:
	\L_0879c:
	\L_086f4:
	ZH 1:
	'Chiến tranh làm cho nhân'
	R
	'dân đau khổ.Có vô số trẻ mồ'
	R
	'côi xung quanh lâu đài...'
	\L_087a9:
	ZH 1:
	'Chúng ta chưa có'
	R
	'đủ sao?Đất nước này có'
	R
	'rất nhiều thứ riêng...'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'...Ừm.'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Nobunaga giả vờ'
	R
	'không nhìn thấy đôi'
	R
	'mắt cầu xin của Kou,'
	\L_087a9:
	ZH 1:
	'như thể anh không thể'
	R
	'chịu nổi khi nhìn vào chúng.'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Được rồi.Lần'
	R
	'này tôi sẽ cố gắng không'
	R
	'để chiến tranh kéo dài.'
	\L_087a9:
	\L_0879c:
	\L_086f4:
	ZH 1:
	'Cha... Có vẻ như cha'
	R
	'sẽ không ngừng chiến đấu.'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Kou cúi đầu'
	R
	'và cúi xuống sàn.Trong'
	R
	'khi cô lặng lẽ khóc,'
	\L_087a9:
	ZH 1:
	'Nobunaga nói'
	R
	'với cô từ phía sau.'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Bạn ơi,'
	\L_087a9:
	ZH 1:
	'tôi phải bảo vệ đất'
	R
	'nước này.Đối với tất cả'
	\L_087a9:
	ZH 1:
	'những người đã'
	R
	'chết trong các cuộc chiến'
	R
	'trước đây của chúng tôi.'
	\L_087a9:
	ZH 1:
	'Chúng ta không thể'
	R
	'để người nước ngoài'
	R
	'trên lục địa có được'
	\L_087a9:
	ZH 1:
	'những ngọn núi và'
	R
	'dòng sông này.Những cánh'
	R
	'đồng và ngôi làng này...'
	\L_087a9:
	ZH 1:
	'Tôi không bảo bạn phải'
	R
	'hiểu.Tất cả những gì bạn'
	\L_087a9:
	ZH 1:
	'cần làm là cầu nguyện'
	R
	'cho sự an toàn của tôi.'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Nobunaga để lại cho Kou'
	R
	'những lời đó và đứng dậy.'
	\L_087a9:
	\L_0879c:
	\L_086f4:
	ZH 1:
	'Thưa cha, cha'
	R
	'đi đâu vậy...?'
	\L_087a9:
	{VAR0326 \ 1:
		\L_0879c:
		\L_08684:
		ZH 1:
		'Tôi sẽ chuẩn'
		R
		'bị cho chiến tranh.'
		\L_087a9:
		\L_0879c:
		\L_086f4:
		ZH 1:
		'...Con hy vọng sự an'
		R
		'toàn của cha, thưa Cha.'
		\L_087a9:
		\L_0879c:
		\L_08684:
		ZH 1:
		'Ừm.'
		\L_087a9:
	}
	{VAR0326 = 1:
		\L_0879c:
		\L_08684:
		ZH 1:
		'Tôi nên kiểm tra'
		R
		'cô gái đó trước khi'
		R
		'chiến tranh bắt đầu.'
		\L_087a9:
		\L_0879c:
		\L_086bc:
		ZH 1:
		'Kou cứng người'
		R
		'vì sốc.Nobunaga mở cánh'
		R
		'cửa trượt trong phòng.'
		\L_087a9:
		\L_0879c:
		\L_086e6:
		\L_08756:
		\L_086bc:
		ZH 1:
		'Anh ta đi qua'
		R
		'một số cửa trượt để đến'
		R
		'một căn phòng nhất định.'
		\L_087a9:
		ZH 1:
		'Đó là một căn phòng'
		R
		'trống rỗng đến kinh ngạc.'
		\L_087a9:
		ZH 1:
		'Đơn sơ như nhà tù,'
		\L_087a9:
		ZH 1:
		'nhưng chỉ có một'
		R
		'lối vào và lối ra.Ngoài'
		R
		'cánh cửa Nobunaga mở ra,'
		\L_087a9:
		ZH 1:
		'thậm chí còn'
		R
		'không có cửa sổ.'
		\L_087a9:
		ZH 1:
		'Ở một góc phòng là'
		R
		'thứ mà Nobunaga tìm đến.'
		\L_087a9:
		\L_0879c:
		!VAR0516 : 417!
		\L_086d8:
		!VAR0516 : 30!
		\L_08748:
		\L_08684:
		ZH 1:
		'Tôi mong đợi không kém'
		R
		'nữ kiếm sĩ giỏi nhất của'
		\L_087a9:
		ZH 1:
		'Leazas.Việc mang'
		R
		'thai đứa con của tôi vẫn'
		R
		'chưa khiến bạn phát điên.'
		\L_087a9:
		\L_0879c:
		\L_086f4:
		ZH 1:
		'...'
		\L_087a9:
		\L_0879c:
		\L_086bc:
		ZH 1:
		'Đó là Leila,'
		\L_087a9:
		ZH 1:
		'giờ đã hoàn toàn khác.Cái'
		R
		'bụng khó coi của cô phình ra'
		R
		'và khuôn mặt trông hốc hác.'
		\L_087a9:
		\L_0879c:
		\L_08684:
		ZH 1:
		'Bạn đang'
		R
		'buồn về điều gì vậy?Đó là'
		R
		'nơi vợ sinh con cho chồng.'
		\L_087a9:
		\L_0879c:
		\L_086bc:
		ZH 1:
		'Nobunaga cười toe'
		R
		'toét.Khi anh làm vậy,'
		\L_087a9:
		ZH 1:
		'cái bụng căng'
		R
		'phồng của Leila cử'
		R
		'động một cách kỳ lạ.'
		\L_087a9:
		\L_0879c:
		\L_086f4:
		ZH 1:
		'...!'
		\L_087a9:
		\L_0879c:
		\L_08684:
		ZH 1:
		'Ôi,'
		\L_087a9:
		ZH 1:
		'một đứa trẻ khá năng'
		R
		'động.Tôi chắc rằng bây giờ'
		\L_087a9:
		ZH 1:
		'bạn đã quen với nó'
		R
		'rồi.Trước đây nó khá tệ.'
		\L_087a9:
		ZH 1:
		'Lúc đầu, bạn đã cố gắng'
		R
		'tự sát bằng cách cắn đứt'
		R
		'lưỡi hoặc đập đầu vào cột.'
		\L_087a9:
		\L_0879c:
		\L_086bc:
		ZH 1:
		'Nếu nhìn kỹ, bạn có'
		R
		'thể thấy một số vết sẹo'
		R
		'nhẹ trên trán của Leila.'
		\L_087a9:
		\L_0879c:
		\L_086f4:
		ZH 1:
		'...'
		\L_087a9:
		\L_0879c:
		\L_08684:
		ZH 1:
		'Bây giờ tôi đã cắt lưỡi'
		R
		'của bạn và lính canh sẽ ngăn'
		\L_087a9:
		ZH 1:
		'cản bạn nếu bạn cố đập'
		R
		'đầu vào bất cứ thứ gì.'
		\L_087a9:
		ZH 1:
		'Em không cần phải'
		R
		'lo lắng gì cả, cứ nuôi con'
		R
		'của anh trong bụng em đi.'
		\L_087a9:
		ZH 1:
		'Đừng mổ bụng'
		R
		'cho đến lúc đó.'
		\L_087a9:
		ZH 1:
		'Haahahahahah!'
		\L_087a9:
		\L_0879c:
		\L_086bc:
		ZH 1:
		'Leila trừng mắt'
		R
		'nhìn Nobunaga trong'
		R
		'khi anh ta cười lớn.'
		\L_087a9:
		\L_0879c:
		\L_08710:
		ZH 1:
		'Tôi đã trở thành'
		R
		'vợ của người đàn ông này cho'
		R
		'Leazas.Nhưng đối với anh,'
		\L_087a9:
		ZH 1:
		'phụ nữ chỉ là nơi'
		R
		'gieo hạt giống của anh...'
		\L_087a9:
		ZH 1:
		'Người đàn ông này...'
		\L_087a9:
		ZH 1:
		'Không, anh ta thậm'
		R
		'chí còn không phải là con'
		R
		'người.Anh ta là một con quỷ!'
		\L_087a9:
		ZH 1:
		'Tôi đã bị cưỡng hiếp...'
		\L_087a9:
		ZH 1:
		'Thậm chí không phải thế,'
		R
		'chỉ là cấy vào bên trong,'
		R
		'và trong vòng một tuần,'
		\L_087a9:
		ZH 1:
		'bụng tôi sưng lên!'
		\L_087a9:
		ZH 1:
		'Và mỗi khi đứa trẻ này'
		R
		'di chuyển trong tôi, cơn đau'
		R
		'lại chạy khắp cơ thể tôi...'
		\L_087a9:
		ZH 1:
		'Bên trong tôi là'
		R
		'gì vậy?Cái gì đang ăn'
		R
		'mòn cơ thể tôi vậy?!'
		\L_087a9:
		ZH 1:
		'Tôi sợ hãi và đã nhiều'
		R
		'lần nghĩ đến việc tự sát,'
		\L_087a9:
		ZH 1:
		'nhưng mọi nỗ lực của'
		R
		'tôi đều bị dừng lại...'
		\L_087a9:
		\L_0879c:
		\L_086bc:
		ZH 1:
		'Leila trừng'
		R
		'mắt nhìn Nobunaga, nhưng'
		R
		'sau đó chán nản cúi đầu.'
		\L_087a9:
		\L_0879c:
		\L_08684:
		ZH 1:
		'Leila?...Hm,'
		R
		'mất ý thức rồi.'
		\L_087a9:
		ZH 1:
		'Hãy sinh con'
		R
		'cho tôi.Tôi sẽ để bạn'
		R
		'sống cho đến lúc đó.'
		\L_087a9:
		\L_0879c:
		\L_086bc:
		ZH 1:
		'Nobunaga cười'
		R
		'vào bụng Leila.Bụng cô lại'
		R
		'quằn quại một cách kỳ lạ.'
		\L_087a9:
	}
	\L_0879c:
	\L_086e6:
	\L_08756:
	\L_0878e:
