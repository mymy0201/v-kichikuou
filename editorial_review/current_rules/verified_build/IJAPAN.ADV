	!VAR0516 : 1005!
	\L_08780:
	SS 13:
	\L_086bc:
	ZM 32:
	ZH 1:
	'NHẬT BẢN'
	R
	ZM 24:
	ZH 1:
	R
	'Nagasaki Nagasaki.Là'
	R
	'thành phố duy nhất ở NHẬT'
	\L_087a9:
	ZH 1:
	'BẢN nối liền với lục địa'
	R
	'nên nơi đây luôn nhộn nhịp.'
	\L_087a9:
	ZH 1:
	'Nhưng lúc này,'
	\L_087a9:
	ZH 1:
	'thành phố đang bao'
	R
	'phủ trong một sự im'
	\L_087a9:
	ZH 1:
	'lặng khác thường.Không'
	R
	'có ai ở trên đường phố.'
	\L_087a9:
	ZH 1:
	'Không có gì thắc mắc'
	R
	'tại sao.Trong vài giờ nữa,'
	\L_087a9:
	ZH 1:
	'thành phố sẽ'
	R
	'trở thành chiến trường.'
	\L_087a9:
	ZH 1:
	'Bộ chỉ huy quân sự NHẬT'
	R
	'BẢN.Hai vị tướng túc trực để'
	\L_087a9:
	ZH 1:
	'bảo vệ Nagasaki khỏi'
	R
	'cuộc tấn công của Leazas.'
	\L_087a9:
	\L_0879c:
	!VAR0516 : 420!
	\L_086d8:
	\L_08684:
	ZH 1:
	'Những kẻ ngu ngốc'
	R
	'đến từ lục địa...'
	\L_087a9:
	ZH 1:
	'Họ không được'
	R
	'phép biết vị trí của mình'
	R
	'nếu họ tấn công chúng ta.'
	\L_087a9:
	\L_0879c:
	!VAR0516 : 24!
	\L_08748:
	\L_086f4:
	ZH 1:
	'Katsuie, đừng mất'
	R
	'cảnh giác.Theo cảnh báo thì'
	R
	'họ đã đi qua cầu Tenma rồi.'
	\L_087a9:
	ZH 1:
	'Chỉ còn là vấn đề'
	R
	'thời gian cho đến khi'
	R
	'chúng xuất hiện ở đây.'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Người khiển trách'
	R
	'Katsuie là một người phụ nữ'
	R
	'mang theo một cây cung lớn.'
	\L_087a9:
	ZH 1:
	'Ở NHẬT BẢN, việc phụ nữ'
	R
	'sử dụng vũ khí để chiến đấu'
	R
	'là điều hết sức bất thường.'
	\L_087a9:
	ZH 1:
	'Nhưng vị tướng'
	R
	'này, Isoroku Yamamoto,'
	\L_087a9:
	ZH 1:
	'đã được trao quyền'
	R
	'kiểm soát quân đội mặc'
	R
	'dù thân phận là phụ nữ.'
	\L_087a9:
	ZH 1:
	'Ở NHẬT BẢN,'
	R
	'đó là một hiện tượng hiếm'
	R
	'hoi gần như một phép lạ.'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Hừm...'
	\L_087a9:
	ZH 1:
	'Chẳng có gì'
	R
	'phải sợ cả, Isoroku.Bạn'
	R
	'có nghĩ tôi, Katsuie,'
	\L_087a9:
	ZH 1:
	'sẽ tụt lại phía sau'
	R
	'những kẻ ngốc đó không?'
	\L_087a9:
	ZH 1:
	'Cậu có thể đứng lùi'
	R
	'lại và xem nếu muốn,'
	\L_087a9:
	ZH 1:
	'Isoroku.Chỗ của'
	R
	'phụ nữ là cầu nguyện cho'
	R
	'sự bình an của đàn ông.'
	\L_087a9:
	\L_0879c:
	\L_086f4:
	ZH 1:
	'Đừng đánh giá thấp tôi!'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Isoroku gạt tay'
	R
	'Katsuie mà anh đã đặt lên'
	R
	'vai cô ấy từ lúc nào đó.'
	\L_087a9:
	ZH 1:
	'Sau đó,'
	\L_087a9:
	ZH 1:
	'cô trừng mắt nhìn khuôn'
	R
	'mặt đồi trụy của Katsuie'
	R
	'với ánh mắt hung bạo.'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Vẫn bướng bỉnh'
	R
	'như ngày nào.Với ngoại'
	R
	'hình giống của bạn,'
	\L_087a9:
	ZH 1:
	'bạn sẽ có thể có'
	R
	'được một daimyo tử tế.'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Isoroku mặc quần áo tương'
	R
	'tự như của nam giới vì chúng'
	R
	'giúp di chuyển dễ dàng hơn,'
	\L_087a9:
	ZH 1:
	'nhưng nó'
	R
	'lại phản tác dụng vào'
	R
	'những lúc như thế này.'
	\L_087a9:
	ZH 1:
	'Cánh tay mảnh khảnh'
	R
	'và phần ngực lộ ra dưới'
	\L_087a9:
	ZH 1:
	'ánh nắng.Họ có một sự'
	R
	'tròn trịa đầy nữ tính.'
	\L_087a9:
	ZH 1:
	'Katsuie nhìn chằm'
	R
	'chằm vào những phần này'
	R
	'một cách thô lỗ khi nói.'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Bạn có cơ thể của'
	R
	'một công chúa, nhưng để'
	R
	'hồi sinh gia đình mình,'
	\L_087a9:
	ZH 1:
	'bạn phải cầm kiếm...'
	\L_087a9:
	ZH 1:
	'Hoặc cung.Khá gì đó.'
	\L_087a9:
	\L_0879c:
	\L_086f4:
	ZH 1:
	'Bạn có ý xúc'
	R
	'phạm tôi phải không?'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Tôi định khen ngợi bạn.Bạn'
	R
	'là một người ấn tượng,'
	R
	'không giống phụ nữ chút nào.'
	\L_087a9:
	ZH 1:
	'Lãnh chúa của chúng'
	R
	'tôi không chỉ đơn giản biến'
	R
	'bạn thành một vị tướng như'
	\L_087a9:
	ZH 1:
	'một trò đùa.Tôi cũng'
	R
	'thừa nhận kỹ năng của bạn.'
	\L_087a9:
	ZH 1:
	'Chỉ tiếc là bố bạn không'
	R
	'bằng một nửa con người bạn.'
	\L_087a9:
	ZH 1:
	'Nếu vậy thì gia'
	R
	'đình Yamamoto sẽ ổn'
	\L_087a9:
	ZH 1:
	'thôi.Bạn có thể đang'
	R
	'tận hưởng cuộc sống của một'
	R
	'người phụ nữ ngay bây giờ.'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Katsuie thậm chí còn không'
	R
	'thèm che giấu sự khinh bỉ'
	R
	'trong tiếng cười của mình.'
	\L_087a9:
	ZH 1:
	'Isoroku hạ người'
	R
	'xuống tư thế ngay lập tức.'
	\L_087a9:
	\L_0879c:
	\L_086f4:
	ZH 1:
	'Đừng xúc phạm tôi'
	R
	'nữa, nếu không tôi sẽ...!'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Ánh mắt của Isoroku có'
	R
	'thể sẽ khiến một người đàn'
	R
	'ông bình thường phải sợ hãi.'
	\L_087a9:
	ZH 1:
	'Nhưng Katsuie lại tỏ'
	R
	'ra như không có chuyện gì.'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Bạn sẽ làm gì?'
	\L_087a9:
	\L_0879c:
	\L_086f4:
	ZH 1:
	'Giết bạn!'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Isoroku rút thanh'
	R
	'katana ra khỏi vỏ ở hông.'
	\L_087a9:
	ZH 1:
	'Gahshiiiiin...'
	\L_087a9:
	ZH 1:
	'Thanh katana rơi'
	R
	'xuống đất.Isoroku đang quỳ,'
	R
	'hai tay chống xuống đất.'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Đánh ngươi bằng lưng'
	R
	'kiếm của ta.Có lẽ để'
	R
	'lại một vết bầm tím.'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Katsuie đã có lúc'
	R
	'rút thanh katana của mình'
	R
	'ra.Anh đang nhìn xuống cô.'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Vậy, Isoroku,'
	\L_087a9:
	ZH 1:
	'trở thành người phụ'
	R
	'nữ của tôi thì sao?Thậm'
	R
	'chí có thể đưa cậu đến'
	\L_087a9:
	ZH 1:
	'gần hơn với việc'
	R
	'khôi phục gia đình nếu tôi'
	R
	'hỏi lãnh chúa của chúng ta.'
	\L_087a9:
	ZH 1:
	'Ít nhất,'
	\L_087a9:
	ZH 1:
	'lựa chọn tốt hơn cho'
	R
	'bạn là cố gắng sử dụng'
	\L_087a9:
	ZH 1:
	'thanh katana mà bạn'
	R
	'thực sự không thể sử dụng.'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Isoroku cắn môi'
	R
	'và không trả lời.'
	\L_087a9:
	\L_0879c:
	\L_08710:
	ZH 1:
	'Tôi...'
	\L_087a9:
	\L_0879c:
	!VAR0516 : 418!
	\L_08748:
	\L_086f4:
	ZH 1:
	'Tướng quân Katsuie, Tướng'
	R
	'quân Isoroku!Họ đang đến!'
	\L_087a9:
	\L_0879c:
	\L_08684:
	ZH 1:
	'Họ đến rồi à?!Giết'
	R
	'tất cả những người'
	R
	'nước ngoài bẩn thỉu!'
	\L_087a9:
	\L_0879c:
	\L_08756:
	\L_086bc:
	ZH 1:
	'Katsuie tra thanh'
	R
	'katana của mình vào bao,'
	R
	'quay người và đi ra ngoài.'
	\L_087a9:
	\L_0879c:
	!VAR0516 : 24!
	\L_08748:
	\L_08684:
	ZH 1:
	'Isoroku... Nếu ngươi'
	R
	'muốn giết ta, hãy nhắm vào'
	R
	'lưng ta bằng cây cung đó.'
	\L_087a9:
	ZH 1:
	'Với kỹ năng bắn cung'
	R
	'của bạn, nó sẽ không gây'
	R
	'khó khăn gì phải không?'
	\L_087a9:
	ZH 1:
	'Tức là, nếu bạn'
	R
	'đủ can đảm và hèn hạ để bắn'
	R
	'sau lưng ai đó!Hahahahah!'
	\L_087a9:
	\L_0879c:
	\L_086e6:
	\L_086bc:
	ZH 1:
	'Isoroku nhìn chằm chằm'
	R
	'vào lưng Katsuie một cách'
	\L_087a9:
	ZH 1:
	'đầy căm ghét khi anh'
	R
	'ta cười lớn và bỏ đi.'
	\L_087a9:
	\L_0879c:
	\L_08710:
	ZH 1:
	'Bây giờ tôi chỉ nên'
	R
	'nghĩ về cuộc chiến thôi...'
	\L_087a9:
	\L_0879c:
	\L_086bc:
	ZH 1:
	'Isoroku lắc đầu mạnh'
	R
	'mẽ và đứng dậy.Cô nhặt'
	\L_087a9:
	ZH 1:
	'thanh katana bị rơi'
	R
	'và trả nó lại bên mình.'
	\L_087a9:
	\L_0879c:
	\L_08710:
	ZH 1:
	'Ngay lúc'
	R
	'này... Tất cả những gì tôi'
	R
	'có thể làm là chiến đấu...'
