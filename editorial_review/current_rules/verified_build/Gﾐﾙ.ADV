	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng yết kiến Rance'
	R
	'đang ăn kem với Mill.'
	\L_0344f:
	ZH 1:
	'Maris lấy nó cho Mill'
	R
	'vì cô ấy lo lắng cho em'
	R
	'gái Milli đang nằm viện.'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'Điều này tốt...'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'Ừ...'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'............'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'.........'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'Này, nói gì đó đi.'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'...Cái gì đó...'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'...Buồn cười...'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'...Rance...'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'Vâng, cái gì?'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'Em gái tôi'
	R
	'có khỏi bệnh không?...Tôi'
	R
	'muốn biết chắc chắn...'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'.........'
	\L_0344f:
	ZH 1:
	'Tôi sẽ không biết.Tôi'
	R
	'không phải là bác sĩ.'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'...Đúng vậy...'
	\L_0344f:
	ZH 1:
	'Nhưng tôi lo'
	R
	'lắng... tôi sợ hãi...'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'............'
	\L_0344f:
	ZH 1:
	'Được rồi!!'
	\L_0344f:
	\L_03442:
	\L_03362:
	ZH 1:
	'Rance mạnh mẽ đứng dậy.'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'Hả!?'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'Những lúc như thế'
	R
	'này, điều tốt nhất nên làm'
	R
	'là chơi đùa!!Đi thôi, Mill!!'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'W-Ở đâu?'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'Hồ bơi.Nếu bạn bơi'
	R
	'cho đến khi kiệt sức và'
	R
	'ngủ một giấc ngon lành,'
	\L_0344f:
	ZH 1:
	'bạn sẽ cảm'
	R
	'thấy dễ chịu hơn.'
	\L_0344f:
	ZH 1:
	'Đau khổ dành cho người'
	R
	'bệnh.Nếu chúng ta không thể'
	\L_0344f:
	ZH 1:
	'làm gì ngoài lo lắng'
	R
	'thì chúng ta nên chơi!!'
	\L_0344f:
	ZH 1:
	'Nào, đi thôi!'
	\L_0344f:
	\L_03442:
	\L_033d2:
	ZH 1:
	'Rance nắm tay'
	R
	'Mill và kéo cô ra cửa.'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'T-tôi không có đồ bơi!'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'Tôi sẽ mua'
	R
	'một cái cho bạn.'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'............'
	\L_0344f:
	ZH 1:
	'Đồ bơi chân cao?'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'Không, đồ'
	R
	'ngốc.Bạn là một đứa trẻ, bạn'
	R
	'đang mặc đồ bơi của trường.'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'Ờ...'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'Giờ thì đi thôi.'
	\L_0344f:
	\L_03442:
	\L_0339a:
	ZH 1:
	'............'
	\L_0344f:
	ZH 1:
	'Được rồi...'
	\L_0344f:
	ZH 1:
	'Cảm ơn Rance.'
	\L_0344f:
	\L_03442:
	\L_0332a:
	ZH 1:
	'Hừm.'
	\L_0344f:
	ZH 1:
	'Tôi chỉ ghét phải'
	R
	'nghe lời than vãn của bạn.'
