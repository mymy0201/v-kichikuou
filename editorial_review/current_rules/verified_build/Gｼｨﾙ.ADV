	'mặt xuống giường, bất động.'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'Bây giờ, hãy'
	R
	'mang nàng theo.'
	\L_0a51d:
	\L_0a510:
	\L_0a3f8:
	ZH 1:
	'Cái...'
	\L_0a51d:
	ZH 1:
	'Đợi đã, ngài'
