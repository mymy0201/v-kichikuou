	\L_0a510:
	\L_0a3f8:
	ZH 1:
	'............'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'............'
	\L_0a51d:
	\L_0a510:
	\L_0a4a0:
	ZH 1:
	'Sự im lặng'
	R
	'bao trùm căn phòng của'
	R
	'họ như một tấm chăn.'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'............'
	\L_0a51d:
	\L_0a510:
	\L_0a4a0:
	ZH 1:
	'Linh cắn móng'
	R
	'tay thật mạnh.'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'Hả...?'
	\L_0a51d:
	ZH 1:
	'Này!!'
	\L_0a51d:
	\L_0a510:
	\L_0a4a0:
	ZH 1:
	'Linh đứng dậy chạy ra cửa.'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'Thả em ra!!'
	\L_0a51d:
	\L_0a510:
	\L_0a4a0:
	ZH 1:
	'（Điều khoản）'
	\L_0a51d:
	ZH 1:
	'Soul dùng hết sức'
	R
	'lực đá vào cánh cửa.'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'Thả em ra!! Anh định nhốt'
	R
	'em ở nơi buồn bã này đến'
	R
	'bao giờ nữa?!! Thả em ra!!'
	\L_0a51d:
	ZH 1:
	'Hiện nay!!'
	\L_0a51d:
	\L_0a510:
	\L_0a3f8:
	ZH 1:
	'Dừng lại đi Linh'
	R
	'Hồn... Chân em sẽ đau đấy...'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'Cậu có thể tiếp tục ngồi'
	R
	'đó nếu muốn!! Em đã có nó!!'
	\L_0a51d:
	ZH 1:
	'Ờ...'
	\L_0a51d:
	ZH 1:
	'Em sẽ không ngồi'
	R
	'chờ chết ở đây đâu...!!'
	\L_0a51d:
	\L_0a510:
	\L_0a4a0:
	ZH 1:
	'Nước mắt đọng'
	R
	'nơi khóe mắt Soul.'
	\L_0a51d:
	\L_0a510:
	\L_0a3f8:
	ZH 1:
	'Chúng ta vẫn còn'
	R
	'có Chủ nhân Rance.'
	\L_0a51d:
	ZH 1:
	'Em chắc chắn chúng'
	R
	'em sẽ được an toàn'
	R
	'nhờ có chủ nhân...'
	\L_0a51d:
	ZH 1:
	'Chủ nhân sẽ'
	R
	'cứu chúng ta...'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'Làm thế nào? Đây là'
	R
	'nhà tù phải không? Cho dù'
	R
	'Rance có mạnh đến đâu...'
	\L_0a51d:
	ZH 1:
	'Làm sao đại ca biết'
	R
	'được chúng ta đang ở đây?!'
	\L_0a51d:
	\L_0a510:
	\L_0a3f8:
	ZH 1:
	'Đó là...'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'............'
	\L_0a51d:
	ZH 1:
	'Ờ...'
	\L_0a51d:
	ZH 1:
	'Không...'
	\L_0a51d:
	ZH 1:
	'Không... Bị ràng'
	R
	'buộc... Em muốn về nhà...'
	\L_0a51d:
	\L_0a510:
	\L_0a4a0:
	ZH 1:
	'Nước mắt bắt đầu chảy'
	R
	'dài trên khuôn mặt của Soul.'
	\L_0a51d:
	\L_0a510:
	\L_0a3f8:
	ZH 1:
	'Tâm hồn...'
	\L_0a51d:
	\L_0a510:
	\L_0a430:
	ZH 1:
	'Sill chạy đến chỗ'
	R
	'Soul và ôm cô thật chặt.'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'H-Hick... Waah...'
	\L_0a51d:
	\L_0a510:
	\L_0a4a0:
	ZH 1:
	'Tâm hồn nức nở'
	R
	'trong lồng ngực Sill.'
	\L_0a51d:
	ZH 1:
	'Sill vuốt tóc Soul.'
	\L_0a51d:
	\L_0a510:
	\L_0a414:
	ZH 1:
	'Chủ nhân Rance...'
	\L_0a51d:
	ZH 1:
	'Anh tin em... Em sẽ đến...'
	\L_0a51d:
	ZH 1:
	'Em ở đây...'
