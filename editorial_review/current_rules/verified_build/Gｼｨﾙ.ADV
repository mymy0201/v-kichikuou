	ZH 1:
	'............'
	\L_0a51d:
	\L_0a510:
	\L_0a484:
	ZH 1:
	'Em biết rồi...'
	\L_0a51d:
	\L_0a510:
	\L_0a3f8:
	ZH 1:
	'Bây giờ, nhanh'
	R
	'lên, nhanh lên.'
	\L_0a51d:
	\L_0a510:
	\L_0a430:
	ZH 1:
	'Rance ngồi phịch xuống'
	R
	'ghế và đẩy Sill nhanh lên.'
	\L_0a51d:
	\L_0a510:
	\L_0a468:
	ZH 1:
	'Đ-Được rồi...'
