	'vẻ với Bệ hạ... Được chứ?'
	\L_0a51d:
	\L_0a510:
	\L_0a3f8:
	ZH 1:
	'Linh hồn! Linh hồn!!'
	\L_0a51d:
	\L_0a510:
	\L_0a4ca:
