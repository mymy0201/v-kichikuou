	'lúc nào.Điều đó thật vui.'
	\L_04896:
	ZH 1:
	'（Momo） Vâng,'
	R
	'tôi cũng thấy vui.'
	\L_04896:
	ZH 1:
	'Hẹn gặp lại,'
	R
	'Rance.Chúc ngủ ngon, Sill.'
	\L_04896:
	ZH 1:
	'（Momo） Xin lỗi.'
	\L_04896:
	\L_04889:
	\L_04843:
	\L_04819:
	ZH 1:
	'Milli và Momo tán'
	R
	'tỉnh nhau khi họ rời'
	R
	'phòng ngủ của Rance.'
	\L_04896:
	\L_04889:
	\L_04771:
	ZH 1:
	'............'
	\L_04896:
	\L_04889:
	!VAR0516 : 2!
	\L_04835:
