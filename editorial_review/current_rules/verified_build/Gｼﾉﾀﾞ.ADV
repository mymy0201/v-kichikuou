	'biết đến nàng thôi.'
	\L_02563:
	\L_02556:
	\L_0243e:
	ZH 1:
	'Shinoda! Chiều mai!!'
	R
	'Nhớ đến lâu đài đấy!!'
	\L_02563:
	\L_02556:
