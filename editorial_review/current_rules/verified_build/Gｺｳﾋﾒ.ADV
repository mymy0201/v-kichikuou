	\L_054a2:
	\L_05495:
	!VAR0516 : 1!
	\L_053d1:
	!VAR0516 : 25!
	\L_05441:
	\L_053b5:
	ZH 1:
	'Rance đang làm một vẻ'
	R
	'mặt trang trọng khác thường.'
	\L_054a2:
	\L_05495:
	\L_053ed:
	ZH 1:
	'King Rance...'
	R
	'Có vẻ như những giấc'
	R
	'mơ đó là có thật...'
	\L_054a2:
	\L_05495:
	\L_053b5:
	ZH 1:
	'Rance không trả lời.'
	\L_054a2:
	\L_05495:
	\L_053ed:
	ZH 1:
	'Chúng ta,'
	R
	'nhân loại, đã hứng chịu'
	R
	'cơn thịnh nộ của Chúa...'
	\L_054a2:
	\L_05495:
	\L_053b5:
	ZH 1:
	'Lời nói của Kou'
	R
	'không đến nỗi khó chịu'
	R
	'mà chấp nhận sự vô ích.'
	\L_054a2:
	\L_05495:
	\L_0537d:
	ZH 1:
	'...Hmph, tôi sẽ'
	R
	'không thua đâu.'
	\L_054a2:
	\L_05495:
	\L_053ed:
	ZH 1:
	'Hả... Vua Rance?'
	\L_054a2:
	\L_05495:
	\L_0537d:
	ZH 1:
	'Tôi đã nói rằng tôi sẽ'
	R
	'không thua một con cá voi.'
	\L_054a2:
	ZH 1:
	'Có Chúa hay'
	R
	'không, tôi đã chinh phục'
	R
	'được cả thế giới này.'
	\L_054a2:
	ZH 1:
	'Và nếu tôi có'
	R
	'thể làm được điều đó!Một'
	R
	'con cá voi sẽ làm gì?!'
	\L_054a2:
	\L_05495:
	\L_053b5:
	ZH 1:
	'Rance giận dữ đứng dậy.'
	\L_054a2:
	\L_05495:
	\L_0537d:
	ZH 1:
	'Bạn ơi!Bạn đã có'
	R
	'giấc mơ đó kể từ khi'
	R
	'chuyện này bắt đầu?!'
	\L_054a2:
	\L_05495:
	\L_053b5:
	ZH 1:
	'Kou lùi lại'
	R
	'một chút, bị choáng ngợp'
	R
	'bởi cường độ của Rance.'
	\L_054a2:
	\L_05495:
	\L_053ed:
	ZH 1:
	'Vâng... Chúa'
	R
	'ơi... Rudrasaum đang'
	R
	'mỉm cười hạnh phúc.'
	\L_054a2:
	ZH 1:
	'Giống như đang'
	R
	'tận hưởng những gì đang'
	R
	'xảy ra với thế giới vậy…'
	\L_054a2:
	\L_05495:
	\L_0537d:
	ZH 1:
	'Kh, thích không?Thật'
	R
	'là một kẻ đáng ghét...'
	\L_054a2:
	\L_05495:
	\L_053b5:
	ZH 1:
	'Rance ngồi xuống.Rồi'
	R
	'anh nghĩ về điều gì đó.'
	\L_054a2:
	\L_05495:
	\L_0537d:
	ZH 1:
	'Lựa chọn duy nhất'
	R
	'của chúng ta là giết nó.'
	\L_054a2:
	\L_05495:
	\L_053ed:
	ZH 1:
	'Nhưng Vua'
	R
	'Rance!Bạn sẽ thách thức vị'
	R
	'thần đã tạo ra thế giới.'
	\L_054a2:
	\L_05495:
	\L_0537d:
	ZH 1:
	'Không sao đâu.Nó đang'
	R
	'cản đường tôi.Điều đó có'
	\L_054a2:
	ZH 1:
	'nghĩa là tất cả những gì'
	R
	'tôi có thể làm là giết nó.'
	\L_054a2:
	ZH 1:
	'Tôi sẽ nghiền nát'
	R
	'bất cứ ai cản đường'
	R
	'tôi, bất kể là ai.'
	\L_054a2:
	\L_05495:
	\L_053b5:
	ZH 1:
	'Rance nhìn lên.'
	\L_054a2:
	\L_05495:
	\L_0537d:
	ZH 1:
	'Này, Kou.Bạn có'
	R
	'biết cá voi ở đâu không?'
	\L_054a2:
	ZH 1:
	'Tôi không phải là'
	R
	'loại người có thể'
	\L_054a2:
	ZH 1:
	'chờ đợi điều đó đến'
	R
	'với mình.Tôi sẽ đi giết nó!'
	\L_054a2:
	\L_05495:
	\L_053ed:
	ZH 1:
	'U-Ừm... Vua Rance...'
	\L_054a2:
	\L_05495:
	\L_0537d:
	ZH 1:
	'Hừm, không có'
	R
	'gì phải lo cả!Không thể'
	R
	'nào tôi lại thua được!'
	\L_054a2:
	\L_05495:
	\L_053ed:
	ZH 1:
	'Không, không phải'
	R
	'vậy... Thậm chí tôi còn'
	R
	'không biết nó ở đâu...'
	\L_054a2:
	\L_05495:
	\L_0537d:
	ZH 1:
	'Cái-Cái gì?'
	\L_054a2:
	ZH 1:
	'...Đồ hèn nhát, chạy trốn!'
	\L_054a2:
	{VAR0492 > 1:
		\L_05495:
		\L_053b5:
		ZH 1:
		'Đột nhiên, Rance'
		R
		'nảy ra một ý tưởng.'
		\L_054a2:
		\L_05495:
		\L_05399:
		ZH 1:
		'Đợi đã... Nơi có Chúa...'
		\L_054a2:
		\L_05495:
		\L_0537d:
		ZH 1:
		'Ồ vâng, Hồ Raga!Anh ấy và'
		R
		'nhóm của anh ấy đã đến đó!'
		\L_054a2:
		ZH 1:
		'Nếu tôi nhớ không lầm'
		R
		'thì có một cánh cửa dẫn đến'
		R
		'Chúa ở trong Di tích cổ...'
		\L_054a2:
		ZH 1:
		'Ừ, thế đấy!Đó hẳn'
		R
		'là cách đến Rudrasaum!'
		\L_054a2:
		\L_05495:
		\L_053b5:
		ZH 1:
		'Rance đứng thẳng lên.Anh'
		R
		'ta vẫy chiếc áo choàng của'
		\L_054a2:
		ZH 1:
		'mình và đi về phía'
		R
		'lối ra của phòng tiếp kiến.'
		\L_054a2:
		\L_05495:
		\L_053ed:
		ZH 1:
		'Vua Rance,'
		R
		'ngài đi đâu thế...?'
		\L_054a2:
		\L_05495:
		\L_0537d:
		ZH 1:
		'Chúng ta cần một số'
		R
		'bức tượng vàng để mở'
		\L_054a2:
		ZH 1:
		'cánh cửa trong'
		R
		'khu tàn tích!Tôi sẽ thu'
		R
		'thập chúng nhanh chóng!'
		\L_054a2:
		ZH 1:
		'Chuẩn bị chết đi,'
		R
		'Rudrasaum!Gahahaha!'
		\L_054a2:
	}
