	{VAR0690 = 2:
		!VAR0516 : 0!
		%#M.ADV:
		!VAR0516 : 1046!
		\L_01354:
		!VAR0516 : 1!
		\L_012ac:
		!VAR0516 : 425!
		\L_0131c:
		\L_01290:
		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến Bạn'
		R
		'gọi là Vua của Leazas?'
		\L_0137d:
		\L_01370:
		\L_01258:
		ZH 1:
		'Vâng, Các Hiệp'
		R
		'sĩ Leazas dường như'
		R
		'đang tự hỏi về bạn.'
		\L_0137d:
		ZH 1:
		'họ nghĩ rằng'
		R
		'lời nói và hành vi của bạn'
		R
		'không phải là rất hiệp sĩ.'
		\L_0137d:
		\L_01370:
		\L_012c8:
		ZH 1:
		'Hoooh... Ngạc nhiên'
		R
		'là họ thấy điều đó.'
		\L_0137d:
		\L_01370:
		\L_01258:
		ZH 1:
		'Người Lạ nổi bật.'
		\L_0137d:
		\L_01370:
		\L_012c8:
		ZH 1:
		'Tôi nghĩ điều tương tự'
		R
		'cũng có thể xảy ra với bạn.'
		\L_0137d:
		\L_01370:
		\L_01258:
		ZH 1:
		'Cái gì!?'
		\L_0137d:
		\L_01370:
		\L_012c8:
		ZH 1:
		'Tôi muốn sống'
		R
		'theo cách của bạn.'
		\L_0137d:
		ZH 1:
		'Đừng xúc phạm, nhưng'
		R
		'bạn không bị ràng buộc'
		R
		'bởi bất cứ điều gì...'
		\L_0137d:
		ZH 1:
		'Dù thế nào đi nữa,'
		R
		'bạn trông có vẻ tự do.'
		\L_0137d:
		\L_01370:
		\L_01258:
		ZH 1:
		'Hừm.Đoán vậy.Tuy nhiên,'
		\L_0137d:
		ZH 1:
		'điều đó chỉ'
		R
		'có thể thực hiện được nếu'
		R
		'bạn có tài năng như tôi.'
		\L_0137d:
		\L_01370:
		\L_012c8:
		ZH 1:
		'Tôi không phải là'
		R
		'kẻ sẽ mạo hiểm mạng sống của'
		R
		'mình vì lòng trung thành...'
		\L_0137d:
		ZH 1:
		'Không phù hợp để'
		R
		'trở thành một thứ ngu'
		R
		'ngốc như một hiệp sĩ.'
		\L_0137d:
		\L_01370:
		\L_0132a:
		!VAR0516 : 6!
		\L_0131c:
		\L_012c8:
		ZH 1:
		'Xin Lỗi để'
		R
		'làm gián đoạn, nhưng...'
		\L_0137d:
		ZH 1:
		'Cách tôi nhìn'
		R
		'thấy Nó, Hubert,'
		\L_0137d:
		ZH 1:
		'Có vẻ Như Patton'
		R
		'Không có hiệp sĩ nào'
		R
		'đáng tin cậy hơn bạn.'
		\L_0137d:
		\L_01370:
		\L_0132a:
		!VAR0516 : 425!
		\L_0131c:
		\L_012c8:
		ZH 1:
		'Việc tôi trở thành hiệp'
		R
		'sĩ chẳng liên quan gì cả.'
		\L_0137d:
		ZH 1:
		'chúng tôi chỉ'
		R
		'là những người bạn cũ đã ở'
		R
		'bên nhau một thời gian dài.'
		\L_0137d:
		ZH 1:
		'Tôi không coi anh ta'
		R
		'là chúa tể của mình,'
		\L_0137d:
		ZH 1:
		'và anh ta cũng không coi'
		R
		'tôi là thần dân trung thành.'
		\L_0137d:
		\L_01370:
		\L_0132a:
		!VAR0516 : 6!
		\L_0131c:
		\L_012c8:
		ZH 1:
		'Tôi nghĩ tình'
		R
		'bạn vượt xa mối quan hệ'
		R
		'giữa chúa tể và thần dân.'
		\L_0137d:
		\L_01370:
		\L_0132a:
		!VAR0516 : 425!
		\L_0131c:
		\L_012c8:
		ZH 1:
		'Cắt nó đi,'
		\L_0137d:
		ZH 1:
		'nếu bạn muốn.Đây'
		R
		'không phải là điều tôi'
		R
		'có thể diễn đạt bằng lời,'
		\L_0137d:
		ZH 1:
		'bạn biết không?'
		\L_0137d:
		\L_01370:
		\L_0132a:
		!VAR0516 : 6!
		\L_0131c:
		\L_012c8:
		ZH 1:
		'Huhu... Bạn nói đúng.'
		\L_0137d:
		\L_01370:
		\L_01258:
		ZH 1:
		'Maris... Bạn đã yêu'
		R
		'anh chàng này chưa?'
		\L_0137d:
		\L_01370:
		\L_012c8:
		ZH 1:
		'Ồ, tất nhiên là không'
		R
		'rồi, thưa Vua... Hohohoh.'
		\L_0137d:
		\L_01370:
		\L_0132a:
		!VAR0516 : 425!
		\L_0131c:
		\L_012c8:
		ZH 1:
		'Hahahahahahaha.Tôi không'
		R
		'cảm thấy tệ khi có một cô'
		R
		'gái hấp dẫn phải lòng tôi.'
		\L_0137d:
		\L_01370:
		\L_01258:
		ZH 1:
		'Dừng lại.'
		\L_0137d:
		\L_01370:
		\L_012c8:
		ZH 1:
		'Được rồi, được rồi.'
		\L_0137d:
		\L_01370:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
