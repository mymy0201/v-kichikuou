		\L_07620:
		\L_07613:
		\L_0756b:
		ZH 1:
		'Đây là cái gì...?'
		\L_07620:
		\L_07613:
		\L_074fb:
		ZH 1:
		'Anpan.Nó tốt.Tôi đang có'
