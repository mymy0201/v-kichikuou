	\L_07613:
	\L_074fb:
	ZH 1:
	'Yên Tĩnh, Gramps.'
	\L_07620:
	\L_07613:
	\L_0756b:
	ZH 1:
	'Bạn đang'
	R
	'thực hiện điều này một cách'
	R
	'bình tĩnh một cách kỳ lạ.'
	\L_07620:
	ZH 1:
	'Điều đó không'
	R
	'giống như bạn.'
	\L_07620:
