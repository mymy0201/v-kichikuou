	ZM 24:
	ZH 1:
	R
	'Phòng ngủ của Rance Rance'
	R
	'cau mày trong khi tự nghĩ.'
	\L_018be:
	\L_018b1:
	\L_01799:
	ZH 1:
	'Được rồi.'
	\L_018be:
	\L_018b1:
	\L_017d1:
	ZH 1:
	'Anh ta đập đầu gối...'
	\L_018be:
	\L_018b1:
	\L_01799:
	ZH 1:
	'Ai đó, gọi Elisabeth đi.'
	\L_018be:
	\L_018b1:
	\L_017d1:
	ZH 1:
	'Rance đợi Elisabeth.'
	\L_018be:
	ZH 1:
	'Vậy thì...'
	\L_018be:
	ZH 1:
	'（cốc cốc）'
	\L_018be:
