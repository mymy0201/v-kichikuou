		'mệnh lệnh của cô ấy,'
		\L_038bd:
		ZH 1:
		'ngay khi điều đó xảy ra.'
		\L_038bd:
		ZH 1:
		'KABOOOOOOOOOOOOOOOOM!'
		\L_038bd:
		ZH 1:
		'Âm thanh đinh tai'
		R
		'nhức óc không chỉ làm'
		\L_038bd:
		ZH 1:
		'rung chuyển lâu đài mà'
		R
		'cả khu vực xung quanh.'
		\L_038bd:
		ZH 1:
		'Maris và những người'
		R
		'lính ẩn náu đã bị mưa đá,'
		\L_038bd:
		ZH 1:
		'tro tàn và máu thịt'
		R
		'của hai ninja trút xuống.'
		\L_038bd:
		\L_038b0:
		!VAR0516 : 6!
		\L_0385c:
		\L_03808:
		ZH 1:
		'Có vẻ như thực sự đúng'
		R
		'là các ninja sẽ tự kết'
		\L_038bd:
		ZH 1:
		'liễu đời mình nếu họ'
		R
		'thất bại trong nhiệm vụ...'
		\L_038bd:
		\L_038b0:
		\L_037d0:
		ZH 1:
		'Maris, bình'
		R
		'thường cực kỳ điềm tĩnh, tái'
		R
		'nhợt và lau máu trên người.'
		\L_038bd:
		@L_0370a:
	}
	!VAR0516 : 7!
	\L_0385c:
	\L_03808:
	ZH 1:
	'Đó là... Mọi'
	R
	'người, hãy ẩn nấp!'
	\L_038bd:
	\L_038b0:
	\L_0386a:
	\L_037d0:
	ZH 1:
	'Mọi người đều bị sốc'
	R
	'trước tiếng hét của Leila và'
	\L_038bd:
	ZH 1:
	'điên cuồng làm theo'
	R
	'mệnh lệnh của cô ấy,'
	\L_038bd:
	ZH 1:
	'ngay trước khi nó xảy ra.'
	\L_038bd:
	ZH 1:
	'KABOOOOOOOOOOOOOOOOM!'
	\L_038bd:
	ZH 1:
	'Âm thanh đinh tai'
	R
	'nhức óc không chỉ làm'
	\L_038bd:
	ZH 1:
	'rung chuyển lâu đài mà'
	R
	'cả khu vực xung quanh.'
	\L_038bd:
	ZH 1:
	'Leila và những người'
	R
	'lính ẩn nấp đã bị mưa đá,'
	\L_038bd:
	ZH 1:
	'tro bụi và máu thịt'
	R
	'của hai ninja trút xuống.'
	\L_038bd:
	\L_038b0:
	!VAR0516 : 7!
	\L_0385c:
	\L_03824:
	ZH 1:
	'Có vẻ như thực sự đúng'
	R
	'là các ninja sẽ tự kết'
	\L_038bd:
	ZH 1:
	'liễu đời mình nếu họ'
	R
	'thất bại trong nhiệm vụ...'
	\L_038bd:
