*L_02fd3:
	!VAR0154 : 5!
	{VAR0102 = 0:
		\L_038b0:
		!VAR0516 : 6!
		\L_0385c:
		\L_03808:
		ZH 1:
		'Đó là tất cả những'
		R
		'gì bạn có thể làm.Chúng'
		R
		'tôi đã bao vây bạn rồi.'
		\L_038bd:
		\L_038b0:
		\L_03798:
		ZH 1:
		'Ờ...'
		\L_038bd:
		\L_038b0:
		\L_037d0:
		ZH 1:
		'Shinobu nhanh chóng'
		R
		'tỉnh táo và kiểm tra xung'
		\L_038bd:
		ZH 1:
		'quanh.Cô cau có và trừng'
		R
		'mắt nhìn Maris trước mặt.'
		\L_038bd:
		\L_038b0:
		\L_03808:
		ZH 1:
		'Cho dù bạn có được'
		R
		'huấn luyện đặc biệt đến đâu,'
		\L_038bd:
		ZH 1:
		'bạn cũng không thể'
		R
		'làm gì được với nhiều'
		R
		'lính canh như thế này.'
		\L_038bd:
		ZH 1:
		'Chúng tôi cũng'
		R
		'đã có lính canh sẵn ở sân'
		R
		'rồi.Hãy từ bỏ và đầu hàng.'
		\L_038bd:
		\L_038b0:
		\L_037d0:
		ZH 1:
		'Hàng chục lính canh'
		R
		'đều chĩa vũ khí vào Shinobu.'
		\L_038bd:
		@L_031d8:
	}
	\L_038b0:
	!VAR0516 : 7!
	\L_0385c:
	\L_03808:
	ZH 1:
	'Bạn không thể'
	R
	'thoát khỏi!Đầu hàng'
	R
	'một cách hòa bình!'
	\L_038bd:
	\L_038b0:
	\L_03798:
	ZH 1:
	'Cái gì!?'
	\L_038bd:
	\L_038b0:
	\L_037d0:
	ZH 1:
	'Shinobu nhanh'
	R
	'chóng lấy lại bình tĩnh'
	R
	'và nhìn xung quanh.'
	\L_038bd:
	ZH 1:
	'Hàng chục vệ binh'
	R
	'hoàng gia của Leazas'
	R
	'đang vây quanh cô.'
	\L_038bd:
	\L_038b0:
	\L_03808:
	ZH 1:
	'Bạn có thể trông giống một'
	R
	'cô bé, nhưng tôi biết bạn là'
	R
	'một kunoichi đã qua đào tạo.'
	\L_038bd:
	ZH 1:
	'Tôi sẽ không'
	R
	'mất cảnh giác.Tốt'
	R
	'nhất là bạn nên từ bỏ.'
	\L_038bd:
	\L_038b0:
	\L_037d0:
	ZH 1:
	'Shinobu trừng mắt nhìn'
	R
	'Leila chĩa kiếm vào cô.'
	\L_038bd:
*L_031d8:
	\L_038b0:
	\L_037fa:
	\L_0386a:
	\L_037d0:
	ZH 1:
	'Một sự im lặng'
	R
	'kỳ lạ và sự căng thẳng'
	R
	'tột độ bao trùm khu vực.'
	\L_038bd:
	ZH 1:
	'Nó bị vỡ bởi tiếng'
	R
	'hét của một người đàn ông.'
	\L_038bd:
	\L_038b0:
	\L_03798:
	ZH 1:
	'Shinobu!'
	\L_038bd:
	\L_038b0:
	\L_037d0:
	ZH 1:
	'Một cửa sổ bị'
	R
	'vỡ.Những mảnh thủy tinh'
	R
	'vương vãi khắp sàn nhà.'
	\L_038bd:
	\L_038b0:
	!VAR0516 : 421!
	\L_037ec:
	\L_037d0:
	ZH 1:
	'Người đàn ông nhảy qua cửa'
	R
	'sổ đáp xuống các mảnh kính'
	R
	'mà không gây ra tiếng động.'
	\L_038bd:
	\L_038b0:
	!VAR0516 : 422!
	\L_0385c:
	\L_03808:
	ZH 1:
	'...Gekkou.'
	\L_038bd:
	!VAR0154 : 5!
	{VAR0102 = 0:
		\L_038b0:
		!VAR0516 : 6!
		\L_0385c:
		\L_03808:
		ZH 1:
		'Bạn đang làm'
		R
		'gì vậy?Bắt chúng!'
		\L_038bd:
		\L_038b0:
		\L_037d0:
		ZH 1:
		'Maris ra lệnh'
		R
		'cho lính canh,'
		\L_038bd:
		ZH 1:
		'nhưng ánh sáng kỳ'
		R
		'lạ trong mắt Gekkou khiến'
		R
		'họ không thể di chuyển.'
		\L_038bd:
	}
	\L_038b0:
	!VAR0516 : 7!
	\L_0385c:
	\L_03808:
	ZH 1:
	'E-Mọi người,'
	R
	'bắt chúng lại!'
	\L_038bd:
	\L_038b0:
	\L_037d0:
	ZH 1:
	'Leila ra lệnh,'
	\L_038bd:
	ZH 1:
	'nhưng tất cả mọi người'
	R
	'bao gồm cả cô đều chùn'
	\L_038bd:
	ZH 1:
	'bước trước ánh sáng'
	R
	'kỳ lạ trong mắt Gekkou.'
	\L_038bd:
	\L_038b0:
	!VAR0516 : 422!
	\L_0385c:
	\L_03798:
	ZH 1:
	'Bạn đã sẵn sàng chưa?'
	\L_038bd:
	\L_038b0:
	\L_03808:
	ZH 1:
	'...Ừ.Tôi biết.'
	\L_038bd:
	\L_038b0:
	\L_037d0:
	ZH 1:
	'Gekkou mỉm cười'
	R
	'hài lòng trước câu'
	R
	'trả lời của Shinobu.'
	\L_038bd:
	\L_038b0:
	\L_03798:
	ZH 1:
	'Chúng ta sẽ'
	R
	'luôn ở bên nhau.'
	\L_038bd:
	\L_038b0:
	\L_037d0:
	ZH 1:
	'Lời nói của Gekkou khiến'
	R
	'Shinobu mỉm cười đáp lại.'
	\L_038bd:
	ZH 1:
	'Cả hai đều rút thứ'
	R
	'gì đó có hình dạng giống'
	R
	'một cái ống ra khỏi túi.'
	\L_038bd:
	\L_038b0:
	\L_037fa:
	\L_0386a:
