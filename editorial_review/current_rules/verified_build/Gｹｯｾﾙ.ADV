	R
	ZM 24:
	ZH 1:
	R
	'Tháp Đu Đủ Chúa ơi...'
	\L_04ae1:
	\L_04ad4:
	\L_049f4:
	ZH 1:
	'Kesselring xuất'
	R
	'hiện ở một vị trí'
	R
	'không có gì xung quanh.'
	\L_04ae1:
	\L_04ad4:
	\L_049bc:
	ZH 1:
	'Bạn đã tốt nhất'
	R
	'Cho Tôi, Vua Của Leazas...'
	\L_04ae1:
	\L_04ad4:
	\L_04a1e:
	\L_049f4:
	ZH 1:
	'Kesselring lại biến'
	R
	'thành sương mù không'
	R
	'một tiếng động nữa.'
	\L_04ae1:
	ZH 1:
	'tòa tháp yên tĩnh như'
	R
	'thể không có gì ở đó.'
