		ZH 1:
		'（bùm!!）'
		\L_04ae1:
		\L_04ad4:
		\L_049bc:
		ZH 1:
		'...Nó ồn ào kinh khủng...'
		\L_04ae1:
		\L_04ad4:
		\L_04a2c:
		ZH 1:
		'Con người,'
		R
		'ông Kesselring.Họ đang'
