	\L_04a10:
	PF0 VAR0056:
	\L_049f4:
	ZM 32:
	ZH 1:
	'Bệnh bạch hầu'
	\L_04ae1:
	ZM 24:
	\L_04ad4:
	\L_049bc:
	ZH 1:
	'Đêm rồi sao những'
	R
	'người này còn thức?'
	\L_04ae1:
	\L_04ad4:
	\L_049f4:
	ZH 1:
	'Khi Kesselring hiện'
	R
	'thực hóa trên một mái nhà,'
	\L_04ae1:
	ZH 1:
	'anh ta nhìn'
	R
	'một số người đàn'
	R
	'ông say rượu, cười.'
	\L_04ae1:
	ZH 1:
	'họ đang chạm'
	R
	'vào con lừa của những cô'
	R
	'gái mà họ đang đi cùng,'
	\L_04ae1:
	ZH 1:
	'là thô tục và guffawing.'
	\L_04ae1:
	\L_04ad4:
	\L_049bc:
	ZH 1:
	'Những sinh vật ngu ngốc...'
	\L_04ae1:
	ZH 1:
	'Hành hạ kẻ yếu là cách'
	R
	'duy nhất họ biết để kiểm'
	\L_04ae1:
	ZH 1:
	'tra xem cuộc sống của'
	R
	'họ có ý nghĩa hay không...'
	\L_04ae1:
	\L_04ad4:
	\L_04a1e:
	\L_049f4:
	ZH 1:
	'Khi Kesselring biến'
	R
	'thành sương mù, những người'
	R
	'đàn ông cảm thấy đau đớn,'
	\L_04ae1:
	ZH 1:
	'đôi mắt của'
	R
	'họ trắng bệch, họ sủi'
	R
	'bọt ở miệng và sụp đổ.'
	\L_04ae1:
	\L_04ad4:
