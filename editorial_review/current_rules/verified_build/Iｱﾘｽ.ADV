	'cá nhân tôi rất quan tâm.」'
	\L_021d6:
	ZH 1:
	'Tori 「Ngoài ra,'
	\L_021d6:
	ZH 1:
	'không biết có bao nhiêu'
	R
	'người biết về điều này vì'
