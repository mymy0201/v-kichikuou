	\L_021d6:
	ZH 1:
	'trong bảng xếp hạng tạp'
	R
	'chí eroge trong nhiều năm.'
	\L_021d6:
	ZH 1:
	'Khó tìm được tổng doanh số'
	R
	'nhưng nó đã bán được khoảng'
	R
	'75.000 bản vào cuối năm 1997'
	\L_021d6:
	ZH 1:
	'và có lẽ tổng cộng'
	R
	'hơn 100.000 bản.Nó là phần'
	R
	'mềm miễn phí từ năm 2006.'
	\L_021d6:
	ZH 1:
	'Mặc dù các trò chơi'
	R
	'Rance trong tương lai đi'
	\L_021d6:
	ZH 1:
	'theo một con đường'
	R
	'khác với trò chơi này,'
	\L_021d6:
	ZH 1:
	'nhưng chúng đã bị ảnh'
	R
	'hưởng rất nhiều bởi nó và'
	\L_021d6:
	ZH 1:
	'thường xuyên giới thiệu'
	R
	'lại các nhân vật và sự kiện.'
	\L_021d6:
	ZH 1:
	'Một thông tin thú vị'
	R
	'khác về trò chơi này là'
	R
	'nó thực sự được sửa lỗi'
	\L_021d6:
	ZH 1:
	'và hiệu đính ở'
	R
	'mức tối thiểu do tính chất'
	R
	'ngẫu nhiên của trò chơi.'
	\L_021d6:
	ZH 1:
	'Tôi đã sửa một số lỗi'
	R
	'và sửa một số lỗi khác'
	\L_021d6:
	ZH 1:
	'vì bạn có thể làm'
	R
	'một số điều thú vị.Điều quan'
	R
	'trọng nhất là bây giờ tất cả'
	\L_021d6:
	ZH 1:
	'các mặt hàng đều làm'
	R
	'được những gì họ yêu cầu.'
	\L_021d6:
	@L_00094:
	]
