	MM 8, VAR0200 + VAR0158 - 1:
	\L_086d1:
	ZM 32:
	ZH 1:
	'Zeth - Hổ Phách'
	R
	ZM 24:
	ZH 1:
	R
	'Di sản của Kabachahn'
	\L_087be:
	\L_087b1:
	!VAR0516 : 458!
	\L_086ed:
	\L_08699:
	ZH 1:
	'Ôi trời, chiến tranh'
	R
	'thật là phiền toái. Điều'
	R
	'này đã trở nên rắc rối.'
	\L_087be:
	\L_087b1:
	\L_086d1:
	ZH 1:
	'Trong căn phòng'
	R
	'trong ngôi nhà cổ kính của'
	R
	'mình, một ông già thở dài.'
	\L_087be:
	\L_087b1:
	!VAR0516 : 254!
	\L_0875d:
	\L_08709:
	ZH 1:
	'（Futaba) Ông ơi,'
	R
	'chiến tranh là gì vậy?'
	\L_087be:
	ZH 1:
	'（Moe) Đó có phải'
	R
	'là vấn đề không…?'
	\L_087be:
	\L_087b1:
	\L_08699:
	ZH 1:
	'Này, Futaba,'
	R
	'Moe. Tôi đang làm việc'
	R
	'quan trọng, hãy đi đi.'
	\L_087be:
	\L_087b1:
	\L_08709:
	ZH 1:
	'（Futaba) Không. Thôi'
	R
	'nào, chiến tranh là gì?'
	\L_087be:
	ZH 1:
	'（Moe) Tôi không'
	R
	'thích khi bạn gặp rắc'
	R
	'rối... Waaah... Aah...'
	\L_087be:
	\L_087b1:
	\L_086d1:
	ZH 1:
	'Hai đứa trẻ trông nhỏ'
	R
	'hơn và khác hẳn con người'
	R
	'một chút đi theo ông già.'
	\L_087be:
	ZH 1:
	'Họ là homunculi,'
	R
	'con người thực vật.'
	\L_087be:
	ZH 1:
	'Việc ông có thể nuôi'
	R
	'dưỡng những sinh vật nhân'
	\L_087be:
	ZH 1:
	'tạo phức tạp chứng tỏ ông'
	R
	'già là một pháp sư vĩ đại.'
	\L_087be:
	\L_087b1:
	\L_0876b:
	!VAR0516 : 457!
	\L_0875d:
	\L_08709:
	ZH 1:
	'Sẽ ổn thôi...'
	R
	'Đừng khóc, Moe.'
	\L_087be:
	ZH 1:
	'Không có gì'
	R
	'phải lo cả, Kabachahn.'
	\L_087be:
	ZH 1:
	'Suy cho cùng'
	R
	'thì lý do chúng ta ở đây là'
	R
	'để chuẩn bị cho cuộc chiến.'
	\L_087be:
	\L_087b1:
	\L_08699:
	ZH 1:
	'Ừm, à, vâng...'
	\L_087be:
	\L_087b1:
	\L_086d1:
	ZH 1:
	'Bốn vị tướng đã'
	R
	'tập trung ở đó.'
	\L_087be:
	ZH 1:
	'Họ là những pháp sư'
	R
	'mạnh mẽ lãnh đạo bốn đội'
	R
	'quân ma thuật của Zeth...'
	\L_087be:
	\L_087b1:
	\L_086fb:
	\L_0876b:
	!VAR0516 : 458!
	\L_086ed:
	\L_086d1:
	ZH 1:
	'Tướng quân của đội'
	R
	'quân tia chớp, Kabachahn.'
	\L_087be:
	ZH 1:
	'Một người'
	R
	'mà ngay cả Gandhi, Vua của'
	R
	'Zeth, cũng phải ngưỡng mộ.'
	\L_087be:
	\L_087b1:
	!VAR0516 : 457!
	\L_0875d:
	\L_086d1:
	ZH 1:
	'Tướng quân của'
	R
	'Băng quân, Uspira Shintou.'
	\L_087be:
	ZH 1:
	'Cô trước đây là một'
	R
	'nhà nghiên cứu quân đội.'
	\L_087be:
	ZH 1:
	'Người yêu của cô chết'
	R
	'trong một tai nạn nghiên'
	R
	'cứu và cô lao vào chiến đấu.'
	\L_087be:
	ZH 1:
	'Sự huấn luyện đầy'
	R
	'nhiệt huyết của cô đã khiến'
	R
	'cô trở thành một vị tướng.'
	\L_087be:
	\L_087b1:
	\L_086fb:
	!VAR0516 : 459!
	\L_086ed:
	\L_086d1:
	ZH 1:
	'Tướng quân nhẹ, Alex.'
	\L_087be:
	ZH 1:
	'Nếu lòng căm thù đàn'
	R
	'ông và bản tính hiền lành'
	R
	'của Chizuko không cản trở,'
	\L_087be:
	ZH 1:
	'anh ta thậm chí còn có'
	R
	'tài lãnh đạo Tứ chúa tể.'
	\L_087be:
	\L_087b1:
	\L_0876b:
	!VAR0516 : 456!
	\L_0875d:
	\L_086d1:
	ZH 1:
	'Tướng quân của'
	R
	'Hỏa quân, Saias.'
	\L_087be:
	ZH 1:
	'Anh ta đã leo lên'
	R
	'từ một người lính đến vị'
	\L_087be:
	ZH 1:
	'trí hiện tại chỉ trong'
	R
	'một năm chỉ bằng kỹ năng.'
	\L_087be:
	\L_087b1:
	\L_086fb:
	!VAR0516 : 458!
	\L_086ed:
	\L_08699:
	ZH 1:
	'Nhưng đây là một'
	R
	'điều khá nghiêm trọng xảy'
	R
	'ra khi Nhà vua đi vắng...'
	\L_087be:
	ZH 1:
	'Ông ấy cũng đang gặp'
	R
	'rắc rối. Sự vắng mặt của anh'
	R
	'ấy là một mối phiền toái.'
	\L_087be:
	\L_087b1:
	\L_086d1:
	ZH 1:
	'Kabachahn hít một'
	R
	'hơi thật sâu nữa.'
	\L_087be:
	ZH 1:
	'Lần này không phải là'
	R
	'một tiếng thở dài mà là một'
	R
	'hơi thở thô bạo qua mũi anh.'
	\L_087be:
	\L_087b1:
	\L_08709:
	ZH 1:
	'Tuy nhiên, anh ấy'
	R
	'là một chàng trai'
	R
	'tốt và nam tính...'
	\L_087be:
	ZH 1:
	'Bạn nói cho anh ấy biết'
	R
	'suy nghĩ của anh ấy vào lần'
	R
	'tới khi anh ấy quay lại nhé?'
	\L_087be:
	ZH 1:
	'Nếu ông than vãn'
	R
	'với anh ấy thì có thể anh ấy'
	R
	'sẽ lắng nghe đấy, ông già ạ.'
	\L_087be:
	\L_087b1:
	\L_08699:
	ZH 1:
	'Đừng ngu ngốc nữa,'
	R
	'Saias. Các chư hầu chính'
	R
	'đã cố gắng làm điều đó.'
	\L_087be:
	ZH 1:
	'Anh ấy không phải là'
	R
	'người sẽ lắng nghe lời'
	\L_087be:
	ZH 1:
	'than vãn của những'
	R
	'người có đặc quyền...'
	\L_087be:
	ZH 1:
	'Thật lãng phí thời gian.'
	\L_087be:
	\L_087b1:
	\L_0876b:
	!VAR0516 : 459!
	\L_0875d:
	\L_08709:
	ZH 1:
	'Đúng vậy,'
	\L_087be:
	ZH 1:
	'Bệ hạ là người có'
	R
	'nhiệm vụ giúp đỡ những người'
	R
	'yếu thế trên đường phố.'
	\L_087be:
	ZH 1:
	'Thế không'
	R
	'tốt sao? Đó không phải là'
	R
	'điều dễ dàng thực hiện...'
	\L_087be:
	ZH 1:
	'Chúng ta có một'
	R
	'vị vua tuyệt vời. Chúng'
	R
	'ta nên tôn trọng anh ấy.'
	\L_087be:
	\L_087b1:
	\L_08699:
	ZH 1:
	'Nếu anh ấy'
	R
	'luôn đi xa và không nghĩ đến'
	R
	'những người anh ấy sẽ ra đi,'
	\L_087be:
	ZH 1:
	'tôi muốn anh ấy'
	R
	'chọn người kế nhiệm.'
	\L_087be:
	ZH 1:
	'Thế à, cậu bé? Bạn'
	R
	'nghĩ gì về điều đó?'
	\L_087be:
	\L_087b1:
	\L_08709:
	ZH 1:
	'S-Sao bây giờ em'
	R
	'lại hỏi anh điều đó...?'
	\L_087be:
	\L_087b1:
	\L_086d1:
	ZH 1:
	'Chủ đề đột nhiên được'
	R
	'đưa ra khiến Alex bối rối.'
	\L_087be:
	ZH 1:
	'Ba người còn lại'
	R
	'mỉm cười và nhìn anh.'
	\L_087be:
	\L_087b1:
	\L_086fb:
	!VAR0516 : 254!
	\L_086ed:
	\L_08699:
	ZH 1:
	'（Futaba） Aaah, anh'
	R
	'ấy đang đỏ mặt kìa!'
	\L_087be:
	\L_087b1:
	\L_086fb:
	!VAR0516 : 458!
	\L_086ed:
	\L_08699:
	ZH 1:
	'Chàng trai, hãy'
	R
	'sớm kết hôn với Miss Magic'
	R
	'và trở thành Vua của Zeth.'
	\L_087be:
	ZH 1:
	'Tôi sẽ hỗ trợ bạn.'
	\L_087be:
	\L_087b1:
	\L_086fb:
	!VAR0516 : 254!
	\L_086ed:
	\L_08699:
	ZH 1:
	'（Moe) Tôi cũng vậy!'
	\L_087be:
	\L_087b1:
	\L_08709:
	ZH 1:
	'Futaba, Moe...'
	R
	'Ngay cả hai người cũng'
	R
	'dính vào chuyện này à?'
	\L_087be:
	\L_087b1:
	\L_086fb:
	!VAR0516 : 456!
	\L_086ed:
	\L_08699:
	ZH 1:
	'Ừ, thế thì tốt.'
	\L_087be:
	ZH 1:
	'Nếu bạn là Vua của Zeth,'
	\L_087be:
	ZH 1:
	'chúng tôi cũng'
	R
	'sẽ không bị Lãnh chúa'
	R
	'Chizuko cản trở nữa.'
	\L_087be:
	ZH 1:
	'Thế còn việc tổ'
	R
	'chức đám cưới khi nhà'
	R
	'vua đi vắng thì sao?'
	\L_087be:
	ZH 1:
	'Ngay cả khi'
	R
	'sau này bạn phải nhận được'
	R
	'sự chấp thuận của ông ấy,'
	\L_087be:
	ZH 1:
	'Nhà vua cuối'
	R
	'cùng sẽ không phàn nàn'
	R
	'miễn là Magic vui vẻ.'
	\L_087be:
	\L_087b1:
	\L_08709:
	ZH 1:
	'Tôi không thể làm điều đó…'
	\L_087be:
	ZH 1:
	'Tôi sẽ nhận được'
	R
	'sự chấp thuận của Nhà'
	R
	'vua một cách đúng đắn.'
	\L_087be:
	ZH 1:
	'Vậy thì tôi sẽ cưới'
	R
	'Magic một cách đàng hoàng…'
	\L_087be:
	ZH 1:
	'Tôi đã thề với cô ấy'
	R
	'rằng tôi sẽ cưới cô ấy.'
	\L_087be:
	ZH 1:
	'Tôi sẽ không'
	R
	'phá vỡ lời hứa đó.'
	\L_087be:
	\L_087b1:
	\L_086fb:
	!VAR0516 : 458!
	\L_086ed:
	\L_08699:
	ZH 1:
	'Em ơi, em yêu... Con'
	R
	'ngoan quá đấy, cậu bé.'
	\L_087be:
	\L_087b1:
	\L_086fb:
	!VAR0516 : 457!
	\L_086ed:
	\L_08699:
	ZH 1:
	'Nếu bạn không dùng vũ'
	R
	'lực, điều gì sẽ xảy ra nếu'
	R
	'Vua Gandhi không chấp thuận?'
	\L_087be:
	\L_087b1:
	\L_08709:
	ZH 1:
	'Ờ... Nhưng tôi...'
	\L_087be:
	\L_087b1:
	\L_08699:
	ZH 1:
	'Nhưng tôi tin tưởng'
	R
	'bạn sẽ làm được điều đó.'
	\L_087be:
	\L_087b1:
	\L_08709:
	ZH 1:
	'Uspira... Cảm ơn bạn.'
	\L_087be:
	\L_087b1:
	\L_086fb:
	!VAR0516 : 456!
	\L_086ed:
	\L_08699:
	ZH 1:
	'Bây giờ, hãy bắt'
	R
	'đầu cuộc họp chiến lược.'
	\L_087be:
	ZH 1:
	'Bạn cũng sẽ phải giành'
	R
	'được một hoặc hai chiến'
	\L_087be:
	ZH 1:
	'thắng trước Leazas'
	R
	'nếu muốn được chấp thuận.'
	\L_087be:
	\L_087b1:
	\L_08709:
	ZH 1:
	'Được rồi...!'
	\L_087be:
	\L_087b1:
