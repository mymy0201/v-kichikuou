	ZH 1:
	'　　　Leazas Castle'
	R
	ZM 24:
	ZH 1:
	R
	'　　　　　　Hallway'
	\L_0193b:
	ZH 1:
	'Rance was trudging along.'
	R
	'He was going to see Rick.'
	\L_0193b:
	\L_0192e:
	\L_01816:
	ZH 1:
	'Hm...?'
	\L_0193b:
	\L_0192e:
