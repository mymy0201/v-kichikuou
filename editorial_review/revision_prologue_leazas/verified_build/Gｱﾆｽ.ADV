	'cho mọi người hơn!!'
	\L_03645:
	\L_03638:
	\L_03520:
	ZH 1:
	'Nhưng, Ngài Chizuko...'
	\L_03645:
	\L_03638:
	\L_03582:
	!VAR0516 : 1!
	\L_03574:
	\L_03520:
	ZH 1:
	'Đừng nói thế, Chizuko.Mặc dù...'
