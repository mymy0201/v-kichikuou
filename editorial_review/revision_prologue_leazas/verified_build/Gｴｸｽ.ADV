		\L_03589:
		!VAR0516 : 402!
		\L_035f9:
		\L_0356d:
		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến'
		\L_0365a:
		ZH 1:
		'Rance ngả người trên ngai vàng,'
		R
		'Barres đứng bên cạnh.'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Bệ hạ Rance. Việc xử tử tướng'
		R
		'quân Ex vừa hoàn tất.'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Ồ, vậy à?'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Nhưng thưa Bệ hạ... Lão thần'
		R
		'thấy như vậy hơi quá.'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Ý ngươi là sao?'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Dù là thủ lĩnh quân nổi loạn,'
		R
		'tướng quân Ex vẫn từng là đồng'
		R
		'đội... Cũng nên lưu chút tình...'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Ngươi lảm nhảm gì thế? Đó là lời'
		R
		'cảnh cáo. Ta chỉ cho chúng thấy'
		R
		'kết cục của kẻ chống ta.'
		\L_0365a:
		ZH 1:
		'Biết mình sẽ chịu kết cục đó thì'
		R
		'chẳng ai dám nổi loạn nữa.'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'............'
		\L_0365a:
		ZH 1:
		'Lão thần hiểu. Lão thần đã lỡ'
		R
		'lời... ... Xin lui.'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Tưởng ngươi khá hơn rồi chứ, đồ'
		R
		'ngốc.'
		\L_0365a:
		\L_0364d:
	}
