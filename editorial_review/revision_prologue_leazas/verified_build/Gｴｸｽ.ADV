	!VAR0156 : 3!
	{VAR0128 \ 0:
		!VAR0516 : 407!
		\L_035f9:
		\L_035a5:
		ZH 1:
		'Cậu có đây không, Ex?'
		\L_0365a:
		\L_0364d:
		\L_035dd:
		ZH 1:
		'Pegasus xông vào phòng Ex.'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Bọn chúng dai dẳng thật.'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Đúng vậy.'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Nhưng chưa có nghĩa là ta đã'
		R
		'thua. Chúng ta chiến đấu vì'
		R
		'Leazas. Cậu hiểu chứ, Ex?'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Tất nhiên.'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Ừ, tốt. Phải thế mới xứng tướng'
		R
		'Bạch Quân.'
		\L_0365a:
		ZH 1:
		'Nhưng rõ ràng tên Rance này'
		R
		'không phải người tầm thường.'
		\L_0365a:
		ZH 1:
		'Ta không ngờ trận này lại gian'
		R
		'nan đến thế.'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'............'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Có chuyện gì à?'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Không... Không có gì.'
		\L_0365a:
		\L_0364d:
		\L_03551:
		ZH 1:
		'Nếu nói tuy ghét con người Rance'
		R
		'nhưng lại phục tài cầm quân của'
		R
		'hắn, chắc ngài Pegasus sẽ giết'
		R
		'mình...'
		\L_0365a:
		\L_0364d:
		\L_0356d:
		ZH 1:
		'Ex thầm bật cười.'
		\L_0365a:
		\L_0364d:
		\L_03607:
	}
	!VAR0156 : 2!
	{VAR0128 \ 0:
		!VAR0516 : 10!
		\L_035f9:
		\L_035a5:
		ZH 1:
		'Xin phép, tướng quân Ex.'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'À, Haurein. Có việc gì?'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Tôi không có tin tốt để báo cáo.'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Không sao. Cứ nói tình hình đi.'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Rõ.'
		\L_0365a:
		ZH 1:
		'Gần đây, binh sĩ đào ngũ ngày'
		R
		'càng nhiều.'
		\L_0365a:
		ZH 1:
		'Chúng tôi đã siết kỷ luật và'
		R
		'giám sát, nhưng không mấy hiệu'
		R
		'quả.'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Như lũ chuột nhảy khỏi con tàu'
		R
		'sắp chìm xuống biển vậy.'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Tướng quân Ex. Ngài nói tàu sắp'
		R
		'chìm sao...'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Vì cô là phó tướng nên tôi mới'
		R
		'nói. Nói với ngài Pegasus thì'
		R
		'chắc ăn đấm rồi.'
		\L_0365a:
		ZH 1:
		'Tôi chỉ có trí óc thôi. Nếu phải'
		R
		'đọ sức mạnh thuần túy thì chẳng'
		R
		'làm được mấy...'
		\L_0365a:
		ZH 1:
		'Đào ngũ sao...?'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'Tôi rất xin lỗi. Giá mà tôi làm'
		R
		'được gì đó...'
		\L_0365a:
		\L_0364d:
		\L_03535:
		ZH 1:
		'Cô không cần xin lỗi.'
		\L_0365a:
		ZH 1:
		'Chúng ta đang chống lại chính'
		R
		'quê hương. Tình thế nguy ngập,'
		R
		'họ bỏ chạy cũng không thể trách.'
		\L_0365a:
		ZH 1:
		'Họ còn gia đình. Cứ để họ đi.'
		\L_0365a:
		ZH 1:
		'À, hãy nhân danh tôi bãi bỏ'
		R
		'những quy định siết chặt ấy.'
		\L_0365a:
		\L_0364d:
		\L_035a5:
		ZH 1:
		'... Tướng quân...'
		\L_0365a:
		\L_0364d:
		\L_03607:
	}
	\L_03551:
	ZH 1:
	'............'
	\L_0365a:
	ZH 1:
	'... Có lẽ chúng ta đã thua cuộc'
	R
	'chiến này rồi.'
	\L_0365a:
	ZH 1:
	'Hừm...'
	\L_0365a:
	ZH 1:
	'Xem ra mình đã đánh giá sai'
	R
	'hắn...'
	\L_0365a:
	ZH 1:
	'............'
	\L_0365a:
	ZH 1:
	'Vua Rance sao...?'
