	'khiến tôi muốn làm điều đó nhiều'
	R
	'hơn mà thôi.'
	\L_04489:
	\L_0447c:
	\L_0439c:
	ZH 1:
	'＜pù!!）'
	\L_04489:
	\L_0447c:
	\L_043d4:
	ZH 1:
	'Tôi thà chết còn hơn!!'
	\L_04489:
	\L_0447c:
	\L_0439c:
	ZH 1:
	'Shizuka đấm Rance mạnh nhất có'
	R
	'thể và rời khỏi phòng ngủ của'
	R
	'anh.'
	\L_04489:
	\L_0447c:
	\L_04436:
	\L_04364:
	ZH 1:
