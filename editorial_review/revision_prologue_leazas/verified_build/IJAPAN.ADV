	\L_075b5:
	!VAR0516 : 6!
	\L_075a7:
	\L_07553:
	ZH 1:
	'Tôi đã nghe nhiều rồi.Sẽ không'
	R
	'sai khi nói gia tộc Oda cai trị'
	R
	'NHẬT BẢN.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Katsuie cười tươi với'
	R
	'Maris.Rance cũng nhìn cô, tỏ ra'
	R
	'không quan tâm.'
