*L_03f3e:
	!VAR0516 : 0!
	%#M.ADV:
	!VAR0158 : 55!
	!VAR0045 : VAR0142!
	!VAR0046 : VAR0143!
	!VAR0516 : 1!
	%#M.ADV:
	!VAR0043 : VAR0045!
	!VAR0044 : VAR0046!
	!VAR0516 : 10!
	%#M.ADV:
	!VAR0516 : 1005!
	\L_075df:
	SS 13:
	\L_0751b:
	ZM 32:
	ZH 1:
	'NHẬT BẢN'
	R
	ZM 24:
	ZH 1:
	R
	'　　　　Nagasaki'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Nagasaki.Là thành phố duy nhất ở'
	R
	'NHẬT BẢN nối liền với lục địa'
	R
	'nên nơi đây luôn nhộn nhịp.'
	\L_07608:
	ZH 1:
	'Nhưng lúc này, thành phố đang'
	R
	'bao phủ trong một sự im lặng'
	R
	'khác thường.Không có ai ở trên'
	R
	'đường phố.'
	\L_07608:
	ZH 1:
	'Không có gì thắc mắc tại'
	R
	'sao.Trong vài giờ nữa, thành phố'
	R
	'sẽ trở thành chiến trường.'
	\L_07608:
	ZH 1:
	'Bộ chỉ huy quân sự NHẬT BẢN.Hai'
	R
	'vị tướng túc trực để bảo vệ'
	R
	'Nagasaki khỏi cuộc tấn công của'
	R
	'Leazas.'
	\L_07608:
	\L_075fb:
	!VAR0516 : 420!
	\L_07537:
	\L_074e3:
	ZH 1:
	'Những kẻ ngu ngốc đến từ lục'
	R
	'địa... Họ không được phép biết'
	R
	'vị trí của mình nếu họ tấn công'
	R
	'chúng ta.'
	\L_07608:
	\L_075fb:
	!VAR0516 : 24!
	\L_075a7:
	\L_07553:
	ZH 1:
	'Katsuie, đừng mất cảnh giác.Theo'
	R
	'cảnh báo thì họ đã đi qua cầu'
	R
	'Tenma rồi.'
	\L_07608:
	ZH 1:
	'Chỉ còn là vấn đề thời gian cho'
	R
	'đến khi chúng xuất hiện ở đây.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Người khiển trách Katsuie là một'
	R
	'người phụ nữ mang theo một cây'
	R
	'cung lớn.'
	\L_07608:
	ZH 1:
	'Ở NHẬT BẢN, việc phụ nữ sử dụng'
	R
	'vũ khí để chiến đấu là điều hết'
	R
	'sức bất thường.'
	\L_07608:
	ZH 1:
	'Nhưng vị tướng này, Isoroku'
	R
	'Yamamoto, đã được trao quyền'
	R
	'kiểm soát quân đội mặc dù thân'
	R
	'phận là phụ nữ.'
	\L_07608:
	ZH 1:
	'Ở NHẬT BẢN, đó là một hiện tượng'
	R
	'hiếm hoi gần như một phép lạ.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Hừm... Chẳng có gì phải sợ cả,'
	R
	'Isoroku.Bạn có nghĩ tôi,'
	R
	'Katsuie, sẽ tụt lại phía sau'
	R
	'những kẻ ngốc đó không?'
	\L_07608:
	ZH 1:
	'Cậu có thể đứng lùi lại và xem'
	R
	'nếu muốn, Isoroku.Chỗ của phụ nữ'
	R
	'là cầu nguyện cho sự bình an của'
	R
	'đàn ông.'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Đừng đánh giá thấp tôi!'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Isoroku gạt tay Katsuie mà anh'
	R
	'đã đặt lên vai cô ấy từ lúc nào'
	R
	'đó.'
	\L_07608:
	ZH 1:
	'Sau đó, cô trừng mắt nhìn khuôn'
	R
	'mặt đồi trụy của Katsuie với ánh'
	R
	'mắt hung bạo.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Vẫn bướng bỉnh như ngày nào.Với'
	R
	'ngoại hình giống của bạn, bạn sẽ'
	R
	'có thể có được một daimyo tử tế.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Isoroku mặc quần áo tương tự như'
	R
	'của nam giới vì chúng giúp di'
	R
	'chuyển dễ dàng hơn, nhưng nó lại'
	R
	'phản tác dụng vào những lúc như'
	R
	'thế này.'
	\L_07608:
	ZH 1:
	'Cánh tay mảnh khảnh và phần ngực'
	R
	'lộ ra dưới ánh nắng.Họ có một sự'
	R
	'tròn trịa đầy nữ tính.'
	\L_07608:
	ZH 1:
	'Katsuie nhìn chằm chằm vào những'
	R
	'phần này một cách thô lỗ khi'
	R
	'nói.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Bạn có cơ thể của một công chúa,'
	R
	'nhưng để hồi sinh gia đình mình,'
	R
	'bạn phải cầm kiếm... Hoặc'
	R
	'cung.Khá gì đó.'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Bạn có ý xúc phạm tôi phải'
	R
	'không?'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Tôi định khen ngợi bạn.Bạn là'
	R
	'một người ấn tượng, không giống'
	R
	'phụ nữ chút nào.'
	\L_07608:
	ZH 1:
	'Lãnh chúa của chúng tôi không'
	R
	'chỉ đơn giản biến bạn thành một'
	R
	'vị tướng như một trò đùa.Tôi'
	R
	'cũng thừa nhận kỹ năng của bạn.'
	\L_07608:
	ZH 1:
	'Chỉ tiếc là bố bạn không bằng'
	R
	'một nửa con người bạn.'
	\L_07608:
	ZH 1:
	'Nếu vậy thì gia đình Yamamoto sẽ'
	R
	'ổn thôi.Bạn có thể đang tận'
	R
	'hưởng cuộc sống của một người'
	R
	'phụ nữ ngay bây giờ.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Katsuie thậm chí còn không thèm'
	R
	'che giấu sự khinh bỉ trong tiếng'
	R
	'cười của mình.'
	\L_07608:
	ZH 1:
	'Isoroku hạ người xuống tư thế'
	R
	'ngay lập tức.'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Đừng xúc phạm tôi nữa, nếu không'
	R
	'tôi sẽ...!'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Ánh mắt của Isoroku có thể sẽ'
	R
	'khiến một người đàn ông bình'
	R
	'thường phải sợ hãi.'
	\L_07608:
	ZH 1:
	'Nhưng Katsuie lại tỏ ra như'
	R
	'không có chuyện gì.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Bạn sẽ làm gì?'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Giết bạn!'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Isoroku rút thanh katana ra khỏi'
	R
	'vỏ ở hông.'
	\L_07608:
	ZH 1:
	'Gahshiiiiin...'
	\L_07608:
	ZH 1:
	'Thanh katana rơi xuống'
	R
	'đất.Isoroku đang quỳ, hai tay'
	R
	'chống xuống đất.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Đánh ngươi bằng lưng kiếm của'
	R
	'ta.Có lẽ để lại một vết bầm tím.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Katsuie đã có lúc rút thanh'
	R
	'katana của mình ra.Anh đang nhìn'
	R
	'xuống cô.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Vậy, Isoroku, trở thành người'
	R
	'phụ nữ của tôi thì sao?Thậm chí'
	R
	'có thể đưa cậu đến gần hơn với'
	R
	'việc khôi phục gia đình nếu tôi'
	R
	'hỏi lãnh chúa của chúng ta.'
	\L_07608:
	ZH 1:
	'Ít nhất, lựa chọn tốt hơn cho'
	R
	'bạn là cố gắng sử dụng thanh'
	R
	'katana mà bạn thực sự không thể'
	R
	'sử dụng.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Isoroku cắn môi và không trả'
	R
	'lời.'
	\L_07608:
	\L_075fb:
	\L_0756f:
	ZH 1:
	'Tôi...'
	\L_07608:
	\L_075fb:
	!VAR0516 : 418!
	\L_075a7:
	\L_07553:
	ZH 1:
	'Tướng quân Katsuie, Tướng quân'
	R
	'Isoroku!Họ đang đến!'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Họ đến rồi à?!Giết tất cả những'
	R
	'người nước ngoài bẩn thỉu!'
	\L_07608:
	\L_075fb:
	\L_075b5:
	\L_0751b:
	ZH 1:
	'Katsuie tra thanh katana của'
	R
	'mình vào bao, quay người và đi'
	R
	'ra ngoài.'
	\L_07608:
	\L_075fb:
	!VAR0516 : 24!
	\L_075a7:
	\L_074e3:
	ZH 1:
	'Isoroku... Nếu ngươi muốn giết'
	R
	'ta, hãy nhắm vào lưng ta bằng'
	R
	'cây cung đó.'
	\L_07608:
	ZH 1:
	'Với kỹ năng bắn cung của bạn, nó'
	R
	'sẽ không gây khó khăn gì phải'
	R
	'không?'
	\L_07608:
	ZH 1:
	'Tức là, nếu bạn đủ can đảm và'
	R
	'hèn hạ để bắn sau lưng ai'
	R
	'đó!Hahahahah!'
	\L_07608:
	\L_075fb:
	\L_07545:
	\L_0751b:
	ZH 1:
	'Isoroku nhìn chằm chằm vào lưng'
	R
	'Katsuie một cách đầy căm ghét'
	R
	'khi anh ta cười lớn và bỏ đi.'
	\L_07608:
	\L_075fb:
	\L_0756f:
	ZH 1:
	'Bây giờ tôi chỉ nên nghĩ về cuộc'
	R
	'chiến thôi...'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Isoroku lắc đầu mạnh mẽ và đứng'
	R
	'dậy.Cô nhặt thanh katana bị rơi'
	R
	'và trả nó lại bên mình.'
	\L_07608:
	\L_075fb:
	\L_0756f:
	ZH 1:
	'Ngay lúc này... Tất cả những gì'
	R
	'tôi có thể làm là chiến đấu...'
	\L_07608:
	\L_075fb:
	\L_075b5:
	\L_075ed:
	SS VAR0515:
	%0:
*L_046c4:
	!VAR0516 : 0!
	%#M.ADV:
	!VAR0158 : 56!
	!VAR0045 : VAR0142!
	!VAR0046 : VAR0143!
	!VAR0516 : 1!
	%#M.ADV:
	!VAR0043 : VAR0045!
	!VAR0044 : VAR0046!
	!VAR0516 : 10!
	%#M.ADV:
	!VAR0516 : 1005!
	\L_075df:
	!VAR0516 : 417!
	\L_07537:
	!VAR0516 : 25!
	\L_075a7:
	SS 14:
	\L_0751b:
	ZM 32:
	ZH 1:
	'Ōsaka'
	R
	ZM 24:
	ZH 1:
	R
	'Lâu đài Osaka'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Thưa cha... Gần đây có sự hỗn'
	R
	'loạn xung quanh lâu đài.Mọi'
	R
	'người có vẻ khó chịu...'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Không rõ liệu Nobunaga có nghe'
	R
	'thấy Kou hay không.Anh ta chỉ'
	R
	'tiếp tục nhìn chằm chằm vào'
	R
	'những ngọn núi ở phía tây.'
	\L_07608:
	\L_075fb:
	\L_074ff:
	ZH 1:
	'...Họ đến rồi.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Miệng Nobunaga cong lên thành'
	R
	'một cái cau mày chán nản.'
	\L_07608:
	\L_075fb:
	!VAR0516 : 418!
	\L_075a7:
	\L_07553:
	ZH 1:
	'Thưa ngài!'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Một vị tướng xông vào qua cửa'
	R
	'trượt.Anh nhanh chóng quỳ một'
	R
	'chân lên tấm chiếu tatami.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Bạn đang la hét về điều gì vậy?'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'M-Tôi xin lỗi!Tôi đến để thông'
	R
	'báo cho bạn về một báo cáo từ'
	R
	'trạm giám sát!'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Được rồi.Vậy nó là gì?'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Những người lính của lục địa đã'
	R
	'đi qua ba ngọn núi.Họ đã gây'
	R
	'lãng phí cho một số ngôi làng'
	R
	'trên đường đi.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Hm... Bạn nghĩ chúng ta nên làm'
	R
	'gì?'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Vị tướng trả lời với vẻ bối rối'
	R
	'khi đột nhiên được yêu cầu trả'
	R
	'lời.'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Tôi tin rằng chúng ta nên gửi'
	R
	'quân đến để ngăn chặn chúng.'
	\L_07608:
	\L_075fb:
	!VAR0516 : 25!
	\L_075a7:
	\L_07553:
	ZH 1:
	'Thưa cha, xin hãy bảo vệ dân'
	R
	'làng.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Nobunaga nhắm mắt lại như đang'
	R
	'suy nghĩ một lúc.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Câu trả lời hay.'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Vậy thưa Cha, điều đó có nghĩa'
	R
	'là...'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Kou mỉm cười nhẹ.Nhưng đó chỉ là'
	R
	'cho đến khi cô nghe thấy điều'
	R
	'tiếp theo mà Nobunaga nói.'
	\L_07608:
	\L_075fb:
	!VAR0516 : 418!
	\L_075a7:
	\L_074e3:
	ZH 1:
	'Hãy nói với dân làng điều'
	R
	'này.Không thành vấn đề nếu bạn'
	R
	'sử dụng cuốc hoặc rìu, hãy làm'
	R
	'tất cả những gì có thể để giữ'
	R
	'chúng lại.'
	\L_07608:
	\L_075fb:
	!VAR0516 : 25!
	\L_075a7:
	\L_07553:
	ZH 1:
	'Thưa cha...!'
	\L_07608:
	\L_075fb:
	!VAR0516 : 418!
	\L_075a7:
	\L_07553:
	ZH 1:
	'Vâng, nhưng thưa ngài, chúng tôi'
	R
	'đang chiến đấu với những người'
	R
	'lính đã được huấn luyện.Rất có'
	R
	'thể họ sẽ chết một cái chết vô'
	R
	'nghĩa.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Không sao đâu.Hãy để binh lính'
	R
	'của chúng ta chuẩn bị cùng một'
	R
	'lúc.Chúng ta sẽ phục kích chúng'
	R
	'ở Osaka.'
	\L_07608:
	ZH 1:
	'Dân làng nên cho chúng ta đủ'
	R
	'thời gian để làm việc đó.'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Vâng, thưa ngài.'
	\L_07608:
	\L_075fb:
	\L_075b5:
	\L_0751b:
	ZH 1:
	'Tướng quân gật đầu một cái rồi'
	R
	'lập tức đứng dậy rời khỏi phòng.'
	\L_07608:
	\L_075fb:
	!VAR0516 : 25!
	\L_075a7:
	\L_07553:
	ZH 1:
	'Cha... Tại sao chúng ta lại đánh'
	R
	'nhau?'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Vì đất nước.Đối với người dân.'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Vậy hãy đầu hàng thôi.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Nobunaga nhìn Kou với vẻ sửng'
	R
	'sốt.'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Tôi không thể chịu đựng thêm bất'
	R
	'kỳ cuộc tàn sát không cần thiết'
	R
	'nào nữa.'
	\L_07608:
	ZH 1:
	'Vua của lục địa là con'
	R
	'người.Chắc chắn ông ấy sẽ không'
	R
	'tàn nhẫn đến vậy với một đất'
	R
	'nước đã đầu hàng ông ấy... Thưa'
	R
	'cha.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Nobunaga cay đắng lắc đầu.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Kou... Họ đã gây ra vô số tội ác'
	R
	'mà bạn không hề biết.'
	\L_07608:
	ZH 1:
	'Họ cướp bóc không thương tiếc'
	R
	'của những công dân nghèo của'
	R
	'chúng tôi.Họ bắt đàn ông của'
	R
	'chúng tôi làm nô lệ và hãm hiếp'
	R
	'phụ nữ của chúng tôi cho đến khi'
	R
	'họ phát điên.'
	\L_07608:
	ZH 1:
	'Trẻ em và người già không có mục'
	R
	'đích sử dụng nào khác thì bị chế'
	R
	'biến thành thức ăn cho gia'
	R
	'súc...'
	\L_07608:
	\L_075fb:
	\L_07553:
	ZH 1:
	'Tôi... tôi không thể tin được có'
	R
	'người lại làm như vậy.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Bạn không biết chuyện gì đã xảy'
	R
	'ra ở Nagasaki.'
	\L_07608:
	\L_075fb:
	\L_0751b:
	ZH 1:
	'Kou quay đi, như thể cô ấy không'
	R
	'thể chịu nổi khi nghe Nobunaga'
	R
	'nói.'
	\L_07608:
	\L_075fb:
	\L_074e3:
	ZH 1:
	'Chúng tôi sẽ không thua.'
	\L_07608:
	{VAR0325 = 3:
		\L_075fb:
		\L_07545:
		\L_075b5:
		\L_0751b:
		ZH 1:
		'Với câu nói dứt khoát đó,'
		R
		'Nobunaga mở cánh cửa trượt trong'
		R
		'phòng.Phòng của Leila ở phía bên'
		R
		'kia.'
		\L_07608:
		\L_075fb:
		!VAR0516 : 417!
		\L_07537:
		!VAR0516 : 30!
		\L_075a7:
		\L_074e3:
		ZH 1:
		'Leila.Có vẻ như quân đội quê'
		R
		'hương của bạn sẽ sớm đến đây.'
		\L_07608:
		ZH 1:
		'Họ thậm chí có thể đến đây để'
		R
		'cứu bạn.'
		\L_07608:
		\L_075fb:
		\L_0751b:
		ZH 1:
		'Nobunaga ngồi xổm xuống cạnh'
		R
		'Leila, nắm lấy hàm cô và hất mặt'
		R
		'cô về phía anh.'
		\L_07608:
		\L_075fb:
		\L_074e3:
		ZH 1:
		'Bạn không thể nói nếu không có'
		R
		'lưỡi.Đứa con quỷ của tôi đang'
		R
		'nằm trong bụng bạn.'
		\L_07608:
		ZH 1:
		'Bạn vẫn muốn trở về đất nước của'
		R
		'mình trong tình trạng đáng tiếc'
		R
		'đó phải không?'
		\L_07608:
		ZH 1:
		'Bạn có muốn những người từng'
		R
		'quen biết bạn thấy bạn thay đổi'
		R
		'hoàn toàn không?'
		\L_07608:
		\L_075fb:
		\L_0751b:
		ZH 1:
		'Leila trừng mắt nhìn Nobunaga'
		R
		'một cách đầy căm ghét.'
		\L_07608:
		\L_075fb:
		\L_074e3:
		ZH 1:
		'Hãy yên tâm, tôi sẽ bảo vệ'
		R
		'bạn.Tôi sẽ không trao bạn cho'
		R
		'bất cứ ai.'
		\L_07608:
		ZH 1:
		'Cho đến khi em sinh con cho'
		R
		'anh.Haahahah!'
		\L_07608:
		\L_075fb:
		\L_07545:
		\L_075b5:
		\L_0751b:
		ZH 1:
		'Khi Nobunaga rời khỏi phòng'
		R
		'Leila, anh bắt gặp ánh mắt cầu'
		R
		'xin của Kou.'
		\L_07608:
		\L_075fb:
		!VAR0516 : 417!
		\L_07537:
		!VAR0516 : 25!
		\L_075a7:
		\L_074e3:
		ZH 1:
		'Gì vậy, Kou?'
		\L_07608:
		\L_075fb:
		\L_07553:
		ZH 1:
		'Cha... Xin hãy giúp đỡ cô ấy.'
		\L_07608:
		ZH 1:
		'Nếu bạn trả lại cô ấy, Leazas'
		R
		'thậm chí có thể rút quân của họ.'
		\L_07608:
		\L_075fb:
		\L_074e3:
		ZH 1:
		'Kou... Thật không may, điều đó'
		R
		'không còn khả thi nữa.'
		\L_07608:
		ZH 1:
		'Tôi là một con quỷ.Bạn biết điều'
		R
		'gì sẽ xảy ra với những người phụ'
		R
		'nữ mà tôi đã mang thai, phải'
		R
		'không?'
		\L_07608:
		ZH 1:
		'Một số người đã bị con tôi ăn'
		R
		'ruột và giết chết.Nhiều người'
		R
		'cũng đã phát điên.'
		\L_07608:
		ZH 1:
		'Điều tương tự cũng xảy ra khi'
		R
		'bạn được sinh ra.Thật là một'
		R
		'phép lạ khi bạn thậm chí còn'
		R
		'thoát ra được.'
		\L_07608:
		ZH 1:
		'Tuy nhiên, Kou.Bạn có thể có thể'
		R
		'hy vọng vào thời điểm này.Bạn có'
		R
		'thể có được một em trai hoặc em'
		R
		'gái.'
		\L_07608:
		\L_075fb:
		\L_07553:
		ZH 1:
		'Cha...'
		\L_07608:
		\L_075fb:
		\L_0756f:
		ZH 1:
		'Tôi không cần anh chị em.Xin Cha'
		R
		'đừng tạo thêm người phải đau khổ'
		R
		'như con nữa.'
		\L_07608:
		\L_075fb:
		\L_0751b:
		ZH 1:
		'Kou đã nhiều lần nghĩ như vậy'
		R
		'nhưng chưa bao giờ dám nói ra.Cô'
		R
		'đổ sụp xuống sàn.'
		\L_07608:
		\L_075fb:
		\L_074e3:
		ZH 1:
		'Bạn?'
		\L_07608:
	}
