		\L_075fb:
		\L_0751b:
		ZH 1:
		'Nobunaga cười qua mũi.'
		\L_07608:
		\L_075fb:
		\L_074e3:
		ZH 1:
		'Tất nhiên.Hãy chiến đấu hết'
