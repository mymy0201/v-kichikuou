	\L_048fd:
	ZH 1:
	'Hah... Ưu...'
	\L_04a22:
	ZH 1:
	'...Haah.'
	\L_04a22:
	\L_04a15:
	\L_04935:
	ZH 1:
	'Kou tỉnh dậy.'
	\L_04a22:
	\L_04a15:
	\L_048fd:
	ZH 1:
	'...Tôi đổ mồ hôi quá.'
	\L_04a22:
	\L_04a15:
	\L_04935:
	ZH 1:
	'Cô ấy lau mồ hôi trên trán bằng'
	R
	'tay áo kimono.'
	\L_04a22:
	\L_04a15:
	\L_04919:
	ZH 1:
	'Lại là giấc mơ đó... Nó...'
	\L_04a22:
	ZH 1:
	'I...'
