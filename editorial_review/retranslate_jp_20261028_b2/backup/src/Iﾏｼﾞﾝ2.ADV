		\L_011ee:
		ZH 1:
		'Đáng sợ thật...'
		\L_01287:
		ZH 1:
		'Tính khí của vị Ma Vương này'
		R
		'khác hẳn những gì ta hình'
		R
		'dung'
		\L_01287:
		ZH 1:
		'qua di ngôn của ngài Gai...'
		\L_01287:
		\L_0127a:
	}
	\L_01234:
	!VAR0516 : 74!
	\L_01226:
	\L_011d2:
	ZH 1:
	'Chị ấy đáng sợ quá... Đúng'
	R
	'không, Lassie...?'
	\L_01287:
	ZH 1:
	'Lassie: Gâu...'
	\L_01287:
	\L_0127a:
	!VAR0156 : 133!
	{VAR0128 \ 0:
