		!VAR0516 : 452!
		\L_01226:
		\L_011ee:
		ZH 1:
		'Khiếp quá... Cầu trời đừng'
		R
		'vạ lây...'
		\L_01287:
		\L_0127a:
	}
	\L_01162:
	ZH 1:
	'Các ngươi...'
	\L_01287:
	ZH 1:
	'Giờ sẽ tiến sang Nhân Giới.'
	R
	'Biết mình phải làm gì rồi'
	R
	'chứ...?'
	\L_01287:
	\L_0127a:
	!VAR0516 : 35!
	\L_01226:
	\L_011d2:
	ZH 1:
	'Vâng, thưa ngài Little'
	R
	'Princess.'
	\L_01287:
	ZH 1:
	'Tiêu diệt vua Leazas... đúng'
	R
	'không ạ?'
	\L_01287:
	\L_0127a:
	\L_01162:
	ZH 1:
	'Đúng...'
	\L_01287:
	ZH 1:
	'Rồi lũ ngu'
	\L_01287:
	ZH 1:
	'chịu để kẻ ấy cai trị sẽ lại'
	R
	'sống'
	\L_01287:
	ZH 1:
	'khiếp sợ trước ta và Ma'
	R
	'Nhân, như thời Ma Vương'
	R
	'Gilles hai đời trước.'
	\L_01287:
	ZH 1:
	'Ta sẽ khôi phục thời đại'
	R
	'ấy...'
	\L_01287:
	ZH 1:
	'Hornet, chuẩn bị toàn quân'
	R
	'xuất kích.'
	\L_01287:
	\L_0127a:
	\L_011d2:
	ZH 1:
	'Vâng, thưa ngài Little'
	R
	'Princess...'
