	'một số đồ ngọt ngon cho em.'
	\L_06dab:
	\L_06d9e:
	\L_06cf6:
	ZH 1:
	'Đồ Ngọt...'
	R
	'Được rồi, đi thôi.'
	\L_06dab:
	\L_06d9e:
	\L_06cbe:
	ZH 1:
	'Miki mỉm cười với'
