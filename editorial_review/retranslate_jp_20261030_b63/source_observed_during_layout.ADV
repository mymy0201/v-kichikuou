	ZH 1:
	'(Vút)'
	\L_06dab:
	\L_06d9e:
	\L_06cf6:
	ZH 1:
	'Gì... Á!!'
	\L_06dab:
	\L_06d9e:
	\L_06ce8:
	!VAR0516 : 54!
	\L_06cda:
	\L_06c86:
	ZH 1:
	'Anh Kentarou!!'
	\L_06dab:
	\L_06d9e:
	\L_06cf6:
	ZH 1:
	'Anh không sao!'
	\L_06dab:
	ZH 1:
	'Haa!!'
