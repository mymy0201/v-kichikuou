	R
	'bạn.'
	\L_097e4:
	\L_097d7:
	\L_0972f:
	ZH 1:
	'N-Nhưng...'
	\L_097e4:
	\L_097d7:
	\L_096bf:
	ZH 1:
	'Ngồi đó đi.'
	\L_097e4:
	\L_097d7:
	\L_096f7:
	ZH 1:
	'Rance chỉ vào chiếc giường.'
	\L_097e4:
	\L_097d7:
	\L_0972f:
	ZH 1:
	'Được rồi...'
	\L_097e4:
	\L_097d7:
	\L_09767:
	ZH 1:
	'Sill vâng lời Rance và ngồi'
	R
	'thẳng trên giường.'
	\L_097e4:
	\L_097d7:
	\L_096bf:
	ZH 1:
	'Được rồi.'
	\L_097e4:
	\L_097d7:
	\L_096f7:
	ZH 1:
	'Rance tựa đầu vào đùi Sill.'
	\L_097e4:
	\L_097d7:
	\L_096bf:
	ZH 1:
	'Tai tôi ngứa.Cào chúng.'
	\L_097e4:
	\L_097d7:
	\L_0972f:
	ZH 1:
	'Được rồi... Hiểu rồi.'
	\L_097e4:
	\L_097d7:
