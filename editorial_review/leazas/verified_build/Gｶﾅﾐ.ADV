	\L_037d2:
	\L_037c5:
	\L_036ad:
	ZH 1:
	'Hôm nay hãy chỉ có hai chúng ta'
	R
	'thôi nhé?'
	\L_037d2:
	\L_037c5:
	\L_0371d:
	ZH 1:
