	'rồi thật khó chịu.'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'Ồ... tôi xin lỗi.'
	\L_075ce:
	\L_075c1:
	\L_074a9:
	ZH 1:
	'Đủ rồi.Biến đi.'
	\L_075ce:
	\L_075c1:
	\L_07519:
	ZH 1:
	'Tôi xin lỗi... Xin lỗi.'
	\L_075ce:
	\L_075c1:
	\L_0757b:
	\L_07551:
	ZH 1:
	'Leila rời khỏi phòng.'
	\L_075ce:
