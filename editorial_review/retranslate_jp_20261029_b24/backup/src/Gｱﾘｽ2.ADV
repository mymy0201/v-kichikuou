	\L_05ad3:
	\L_05a7f:
	ZH 1:
	'Y-Bệ hạ, chào'
	R
	'mừng. M-tên Tôi Là Cowly.'
	R
	'Tôi hy vọng chúng tôi...'
	\L_05b34:
	ZH 1:
	'hòa hợp với nhau...'
	\L_05b34:
	\L_05b27:
	\L_05a47:
	ZH 1:
