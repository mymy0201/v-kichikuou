	\L_05b34:
	\L_05b27:
	\L_05a2b:
	ZH 1:
	'Đúng như ta đoán,'
	R
	'lưỡi của nàng khá tuyệt...'
	\L_05b34:
	\L_05b27:
	\L_05a7f:
