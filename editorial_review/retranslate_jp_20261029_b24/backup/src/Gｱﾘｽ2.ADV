	\L_05b27:
	\L_05a7f:
	ZH 1:
	'... T-tôi xin lỗi.'
	\L_05b34:
	\L_05b27:
	\L_05a47:
	ZH 1:
	'Cowly dùng tay giữ cơ thể'
