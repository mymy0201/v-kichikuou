	'............'
	\L_027be:
	\L_027b1:
	\L_026fb:
	\L_026d1:
	ZH 1:
	'Kanami disappeared while'
	R
	'hugging him.'
	\L_027be:
	\L_027b1:
	\L_02709:
	ZH 1:
	'Kanami...'
	\L_027be:
	\L_027b1:
	\L_02741:
	ZH 1:
	'Code looked happy for a moment,'
	R
	'but his face soon changed to'
	R
	'that of an assassin.'
	\L_027be:
	ZH 1:
	'He held the dagger between his'
	R
	'teeth and descended into'
	R
	'Rance’s room.'
	\L_027be:
	\L_027b1:
	\L_0276b:
	\L_02741:
	ZH 1:
	'Two hours later...'
	\L_027be:
	ZH 1:
	'Rance’s corpse was found when'
	R
	'Maris came to check on him.'
	\L_027be:
	\L_027b1:
	PF1 VAR0056:
	\L_027d8:
	!VAR0516 : 0!
