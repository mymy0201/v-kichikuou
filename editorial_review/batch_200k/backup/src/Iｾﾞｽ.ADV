	'tất cả những thứ đó.'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'Còn pháp sư ít nhất LV30 thì'
	R
	'sao?'
	R
	{VAR0336 = 6:
		ZH 1:
		'Annis'
	}
	{VAR0336 = 7:
