		%#M.ADV:
		%0:
	}
	\L_077e4:
	\L_0773c:
	ZH 1:
	'Đó là cái gì...?'
	\L_077f1:
	\L_077e4:
	\L_0779e:
	\L_07704:
	ZH 1:
	R
	'.........'
	\L_077f1:
