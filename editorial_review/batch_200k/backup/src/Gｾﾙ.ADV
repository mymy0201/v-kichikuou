	'ready?'
	\L_070e6:
	\L_070d9:
	\L_06fc1:
	ZH 1:
	'Well... Um...'
	\L_070e6:
	\L_070d9:
	\L_07031:
	ZH 1:
	'That a no?'
	\L_070e6:
	\L_070d9:
	\L_06fc1:
	ZH 1:
	'I’m sorry...'
	R
	'This is a poor church...'
	\L_070e6:
	\L_070d9:
	\L_07031:
	ZH 1:
	'Doesn’t matter!'
	\L_070e6:
	ZH 1:
	'Hngaaaaaah!!'
	\L_070e6:
	ZH 1:
	'Indeeeeeed!!'
	\L_070e6:
	\L_070d9:
	\L_06ff9:
	ZH 1:
	'　　＜bang）'
	\L_070e6:
	ZH 1:
	'The men kicked over chairs and'
	R
	'spat on the floor, scaring'
