	'Cell.'
	\L_070e6:
	\L_070d9:
	\L_06fc1:
	ZH 1:
	'Ah...'
	\L_070e6:
	\L_070d9:
	\L_07031:
	ZH 1:
	'Get it? You borrowed money.'
