	R
	'you borrowed, don’t you know?'
	\L_070e6:
	\L_070d9:
	\L_06fc1:
	ZH 1:
	'That’s... true, but...'
	\L_070e6:
	\L_070d9:
	\L_07031:
	ZH 1:
