	ZH 1:
	'　　　Leazas Castle'
	R
	ZM 24:
	ZH 1:
	R
	'　　　　　Audience Room'
	\L_00e1a:
	ZH 1:
	'Lia ran up to Rance.'
	\L_00e1a:
	\L_00e0d:
	\L_00d65:
	ZH 1:
	'Darling, Darling.'
	R
	'I just rode through the sky on'
