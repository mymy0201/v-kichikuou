	ZH 1:
	'As fast as sound, I believe.'
	\L_00e1a:
	\L_00e0d:
	\L_00cf5:
	ZH 1:
	'I don’t get it.'
	\L_00e1a:
	\L_00e0d:
	\L_00d2d:
	ZH 1:
	'Meglass was flying around the'
	R
