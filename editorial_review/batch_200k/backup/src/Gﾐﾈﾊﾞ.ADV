	'just before she stepped inside.'
	\L_0391b:
	\L_0390e:
	\L_03866:
	ZH 1:
	'Welcome back...'
	R
	'What did Mr. Stessel call you'
	R
	'for?'
	\L_0391b:
	\L_0390e:
	\L_037f6:
	ZH 1:
	'He told me to fight hard.'
	\L_0391b:
	\L_0390e:
	\L_03866:
	ZH 1:
	'Is that all?'
	\L_0391b:
	\L_0390e:
	\L_037f6:
	ZH 1:
	'Yeah.'
	\L_0391b:
	\L_0390e:
	\L_03866:
	ZH 1:
	'...Mineva...'
	\L_0391b:
	\L_0390e:
	\L_037f6:
	ZH 1:
	'What?'
	\L_0391b:
	\L_0390e:
	\L_03866:
	ZH 1:
	'Um... Did you bring back'
