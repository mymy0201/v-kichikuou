	\L_075c5:
	\L_07571:
	ZH 1:
	'Này, Merim. Có muốn cùng'
	R
	'nhau thám hiểm ngục tối?'
	\L_076a4:
	\L_07697:
	!VAR0516 : 63!
	\L_07635:
	\L_075e1:
	ZH 1:
	'Vâng, xin'
