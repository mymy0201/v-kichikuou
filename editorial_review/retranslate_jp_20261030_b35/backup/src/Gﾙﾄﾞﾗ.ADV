	}
	\L_00dd1:
	!VAR0516 : 5!
	\L_00dc3:
	\L_00d6f:
	ZH 1:
	'Hả?? Sao sứ giả'
	R
	'của thần lại...'
	\L_00e24:
	\L_00e17:
	\L_00dd1:
	!VAR0516 : 6!
	\L_00dc3:
	\L_00d6f:
	ZH 1:
	'Ngài định thế'
	R
	'nào, Bệ hạ Rance?'
	\L_00e24:
	\L_00e17:
	\L_00cff:
	ZH 1:
	'......Hừ, suy cho cùng'
	R
	'cũng chỉ là lũ quái vật.'
	\L_00e24:
	ZH 1:
	'Ta sẽ quét sạch.'
	\L_00e24:
	ZH 1:
	'Bắt đầu nghênh chiến!'
	\L_00e24:
	\L_00e17:
	\L_00d6f:
	ZH 1:
	'Thần hiểu rồi.'
	\L_00e24:
	\L_00e17:
	\L_00dd1:
