	\L_0777c:
	\L_076b8:
	ZH 1:
	'Lâu đài Osaka bốc cháy.'
	\L_077a5:
	ZH 1:
	'Người chỉ huy'
	R
	'nổi tiếng là bất khả'
	R
	'chiến bại, Nobunaga,'
	\L_077a5:
	ZH 1:
	'đã bị quân'
	R
	'đội Leazas đánh bại.'
	\L_077a5:
	ZH 1:
	'Công dân NHẬT BẢN'
	R
	'cố gắng thoát khỏi'
	R
	'lâu đài đang cháy.'
	\L_077a5:
	ZH 1:
	'Mất đi chủ nhân,'
	\L_077a5:
	ZH 1:
	'họ mất đi nền'
	R
	'tảng tinh thần và không thể'
	R
	'làm gì khác ngoài hoảng sợ.'
	\L_077a5:
	ZH 1:
	'Trong lâu đài đổ nát,'
	R
	'ai đó đang chạy qua các'
	R
	'sảnh và lao qua ngọn lửa.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 1!
	\L_076d4:
	\L_07680:
	ZH 1:
	'Tên lính ngu nào đốt thành?'
	\L_077a5:
	ZH 1:
	'Ai ra lệnh thế hả! Tìm thấy'
	R
	'là'
	\L_077a5:
	ZH 1:
	'ta thiêu sống! May ra cho'
	R
	'chọn nướng muối hay sốt'
	\L_077a5:
	ZH 1:
	'teriyaki... Á, nóng! Chậm'
	R
	'nữa là chính ta cháy thui!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Tên hôi của ồn ào ấy chẳng'
	R
	'phải ai khác, chính là'
	R
	'Rance.'
	\L_077a5:
	{VAR0326 = 0:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ta cần tìm kho'
		R
		'báu của NHẬT BẢN và rời khỏi'
		R
		'đây nhanh chóng! Nhưng...'
		\L_077a5:
		ZH 1:
		'Tại sao lâu đài ở'
		R
		'đất nước này lại được'
		R
		'làm bằng gỗ và giấy!?'
		\L_077a5:
		ZH 1:
		'Toàn bộ sự việc là'
		R
		'một nguy cơ hỏa hoạn!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Lửa chắn đường Rance.'
		\L_077a5:
		ZH 1:
		'Từ sàn đến vách, khắp nơi'
		R
		'đều bốc cháy.'
		\L_077a5:
		\L_07798:
	}
	{VAR0326 \ 0:
		\L_07798:
		!VAR0516 : 418!
		\L_07744:
		\L_076f0:
		ZH 1:
		'Kẻ gian!'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ai hôi hả!?'
		\L_077a5:
		\L_07798:
		\L_07752:
		\L_076b8:
		ZH 1:
		'Một số vị tướng còn lại bảo'
		R
		'vệ lâu đài đến cuối'
		\L_077a5:
		ZH 1:
		'cùng đã bị tàn sát bởi thanh'
		R
		'kiếm của Rance.'
		\L_077a5:
		ZH 1:
		'Rance chạy qua hành lang và'
		R
		'lên cầu thang.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Cô Leila! Cô ở đâu, trả lời'
		R
		'ta đi!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance đến một căn'
		R
		'phòng sâu bất thường'
		R
		'bên trong lâu đài.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Đây...?'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance cắt xuyên qua'
		R
		'cánh cửa trượt rực lửa'
		R
		'chỉ bằng một cú xoay.'
		\L_077a5:
		\L_07798:
		!VAR0516 : 30!
		\L_07744:
		\L_07680:
		ZH 1:
		'Lê-...'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance nhìn thấy'
		R
		'Leila trong hình dạng'
		R
		'hoàn toàn thay đổi.'
		\L_077a5:
		ZH 1:
		'Hắn không nói nên lời.'
		\L_077a5:
		ZH 1:
		'Nước mắt dâng lên trong'
		R
		'mắt Leila. Không rõ họ đến'
		R
		'từ niềm vui hay nỗi buồn.'
		\L_077a5:
		ZH 1:
		'Cô không nói gì cả.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'... Sao cũng được, hãy'
		R
		'ra khỏi đây thôi, Leila!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance nắm lấy tay Leila.'
		\L_077a5:
		ZH 1:
		'Nó mảnh khảnh và yếu'
		R
		'ớt, hoàn toàn không giống'
		R
		'như khi nó từng cầm kiếm.'
		\L_077a5:
		ZH 1:
		'Tay cô yếu'
		R
		'ớt đẩy Rance ra.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Cái gì...? Leila,'
		R
		'ngươi có muốn ngồi đây'
		R
		'và bị thiêu chết không?!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Leila mỉm cười.'
		\L_077a5:
		ZH 1:
		'Đột nhiên, cô ôm cái bụng'
		R
		'phình ra một cách kỳ lạ của'
		R
		'mình và bắt đầu rùng mình.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Trời, cái quái gì thế...?'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Bụng của'
		R
		'Leila bắt đầu nhấp nhô bất'
		R
		'thường trước mắt Rance.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'À... À...!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Có thứ gì đó giống'
		R
		'như tiếng rên rỉ thoát'
		R
		'ra khỏi cổ họng Leila.'
		\L_077a5:
		ZH 1:
		'Leila nhìn'
		R
		'Rance với đôi mắt cầu xin'
		R
		'và đưa tay về phía hắn.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Leila!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance lao tới chỗ Leila.'
		\L_077a5:
		ZH 1:
		'Và sau đó.'
		\L_077a5:
		\L_07798:
		\L_07752:
		\L_076b8:
		ZH 1:
		'Bụng của Leila bị rách toạc.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Đ-Cái quái gì vậy?!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance nhanh'
		R
		'chóng vung kiếm vào thứ'
		R
		'đang lao về phía mình.'
		\L_077a5:
		ZH 1:
		'Hắn nhận được những'
		R
		'phản hồi thô thiển và ủy mị.'
		\L_077a5:
		ZH 1:
		'Thứ cẩu thả, khó'
		R
		'tả rơi xuống sàn.'
		\L_077a5:
		ZH 1:
		'Dù bị chia đôi nhưng'
		R
		'nó vẫn tiếp tục chuyển động.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Leila, cái quái gì thế...?'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance dừng lại giữa câu.'
		\L_077a5:
		ZH 1:
		'Leila không trả lời.'
		\L_077a5:
		ZH 1:
		'Cô ngủ lặng lẽ, gương mặt'
		R
		'bình thản đến lạ lùng so với'
		R
		'trạng thái u ám của cơ thể.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ch...'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance nhìn'
		R
		'chằm chằm vào phần thịt'
		R
		'đang quằn quại trên sàn.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Chết tiệt!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Rance đá nó'
		R
		'mạnh nhất có thể.'
		\L_077a5:
		ZH 1:
		'Khối thịt'
		R
		'đập vào tường và vỡ ra. Cuối'
		R
		'cùng nó cũng ngừng cử động.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'... Nobunagaaaaa!'
		\L_077a5:
		ZH 1:
		'Con quỷ chết tiệt này,'
		\L_077a5:
		ZH 1:
		'nếu tao biết'
		R
		'mày làm điều này thì tao sẽ'
		R
		'giết mày còn mạnh hơn nữa!'
		\L_077a5:
		ZH 1:
		'Chết tiệt, sao'
		R
		'mày dám làm điều này'
		R
		'với Leila của ta...!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'(Ian craaack...)'
		\L_077a5:
		ZH 1:
		'Một chùm tia đang'
		R
		'cháy kêu cọt kẹt như có thể'
		R
		'rơi xuống bất cứ lúc nào.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'... Hẹn gặp lại, Leila.'
		\L_077a5:
		\L_07798:
		\L_076e2:
		\L_076b8:
		ZH 1:
		'Rance để nguyên xác'
		R
		'cô và rời khỏi phòng.'
		\L_077a5:
		ZH 1:
		'Ngọn lửa cuồng'
		R
		'nộ đã thiêu rụi cơ'
		\L_077a5:
		ZH 1:
		'thể bi thảm của Leila để'
		R
		'không ai có thể nhìn vào nó.'
		\L_077a5:
		\L_07798:
		!VAR0516 : 1!
		\L_076d4:
	}
	\L_07680:
	ZH 1:
	'Ôi, chết tiệt... Có lẽ ta'
	R
	'phải rời khỏi đây sớm thôi.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Âm thanh'
	R
	'của cột và dầm sụp đổ vang'
	R
	'lên từ xung quanh lâu đài.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'... Hả?'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Ngay sau đó, Rance'
	R
	'nghe thấy một âm thanh khác'
	R
	'giữa tiếng gầm của ngọn lửa.'
	\L_077a5:
	ZH 1:
	'“... Công'
	R
	'chúa... là...” “Không...'
	\L_077a5:
	ZH 1:
	'Ngươi không'
	R
	'thể...” Giọng của'
	R
	'một người phụ nữ...'
	\L_077a5:
	ZH 1:
	'Có phải nó đến'
	R
	'từ phía trên không?'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Ngay trước'
	R
	'mặt hắn là một số cầu thang'
	R
