		\L_07798:
		\L_07680:
		ZH 1:
		'Ngươi không thể'
		R
		'nói nếu không có lưỡi.'
		\L_077a5:
		ZH 1:
		'Đứa con quỷ của ta'
		R
		'đang nằm trong bụng ngươi.'
		\L_077a5:
		ZH 1:
		'Ngươi vẫn muốn trở về'
