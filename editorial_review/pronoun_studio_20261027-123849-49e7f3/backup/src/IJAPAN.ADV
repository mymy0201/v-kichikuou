	\L_07744:
	\L_076b8:
	ZM 32:
	ZH 1:
	'Ōsaka'
	R
	ZM 24:
	ZH 1:
	R
	'Lâu đài Osaka Ta hiểu'
	R
	'rồi. Vậy là Leazas đã gây'
	R
	'chiến với một quốc gia khác.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Đúng vậy, thưa ngài.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Nobunaga gật'
	R
	'đầu hài lòng trước câu'
	R
	'trả lời của vị tướng.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Thời điểm đã đến.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 420!
	\L_07744:
	\L_076f0:
	ZH 1:
	'... Chúa công nói thời cơ'
	R
	'nào ạ?'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'（Toukichirou） Khẹc!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Con khỉ trên'
	R
	'vai Nobunaga rít lên.'
	\L_077a5:
	\L_07798:
	\L_0770c:
	ZH 1:
	'Con khỉ chết tiệt...'
	R
	'Lại trêu chọc ta nữa rồi...'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Dĩ nhiên Katsuie chẳng hiểu'
	R
	'tiếng'
	\L_077a5:
	ZH 1:
	'Toukichirou, nhưng điều ông'
	R
	'đoán không hề sai.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Chúng ta đang tấn công'
	R
	'lục địa. Katsuie, Isoroku,'
	R
	'chuẩn bị chiến tranh!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Katsuie và Isoroku'
	R
	'đồng loạt bày tỏ sự sốc.'
	\L_077a5:
	ZH 1:
	'Nhưng cuối cùng, một'
	R
	'nụ cười nở trên môi Katsuie.'
	\L_077a5:
	{VAR0326 \ 1:
		\L_07798:
		\L_076f0:
		ZH 1:
		'Đối thủ đầu tiên'
		R
		'của chúng ta sẽ là...'
		\L_077a5:
		ZH 1:
		'Leazas. Đất nước được'
		R
		'cai trị bởi vua Rance...'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Trông ngươi vui lắm,'
		R
		'Katsuie.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'Ha ha, Chúa công nhìn ra'
		R
		'ngay.'
		\L_077a5:
		ZH 1:
		'Mỗi lần nghe danh võ tướng'
		R
		'Leazas,'
		\L_077a5:
		ZH 1:
		'thần lại nóng lòng mong ngày'
		R
		'giao kiếm.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'（Toukichirou） Ồ ồ ồ ồ...'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Toukichirou lẩm'
		R
		'bẩm với vẻ ghê tởm.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'Ngài Nobunaga,'
		R
		'Toukichirou đã nói gì?'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Nó bảo'
		\L_077a5:
		ZH 1:
		'ngươi máu chiến. Ta cũng đôi'
		R
		'lúc ngán cái tính ham đánh'
		R
		'của ngươi.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'Ha ha ha, xin Chúa công thứ'
		R
		'lỗi.'
		\L_077a5:
		ZH 1:
		'Nhưng thần xin nhận đó là'
		R
		'lời khen.'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Nobunaga cười qua mũi.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Tất nhiên. Hãy chiến'
		R
		'đấu hết mình, Katsuie.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'Vâng, thưa ngài.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Được rồi, bây giờ'
		R
		'mọi người hãy chuẩn bị!'
		\L_077a5:
		ZH 1:
		'Ta sẽ không ngần ngại'
		R
		'trừng phạt ngươi nếu ngươi'
		R
		'mất quá nhiều thời gian!'
		\L_077a5:
	}
	{VAR0326 = 1:
		ZH 1:
		'Isoroku nhíu đôi lông'
		R
		'mày xinh đẹp của mình.'
		\L_077a5:
		\L_07798:
		!VAR0516 : 24!
		\L_07744:
		\L_076f0:
		ZH 1:
		'Xin mạo muội hỏi, Chúa công'
		R
		'định tấn công Leazas ạ?'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Đúng, Isoroku. Còn đánh ai'
		R
		'khác nữa?'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'Không...'
		\L_077a5:
		ZH 1:
		'Nhưng lẽ ra chúng ta phải'
		R
		'liên minh với Leazas. Để'
		R
		'chúng ta phá vỡ nó sẽ là...'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Không sao đâu.'
		\L_077a5:
		ZH 1:
		'Ngay từ đầu ta chưa'
		R
		'bao giờ có ý định làm'
		\L_077a5:
		ZH 1:
		'thân với những người'
		R
		'nước ngoài bẩn thỉu đó.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'Nhưng họ có con tin!'
		\L_077a5:
		\L_07798:
		!VAR0516 : 420!
		\L_07744:
		\L_07680:
		ZH 1:
		'Katsuie, ta nhớ đã gửi ba'
		R
		'người sang Leazas, đúng'
		R
		'không?'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'Có, với lý do đi du học.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Trong số ấy, có ai chết mà'
		R
		'khiến ta khó xử không?'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'Đâu có ạ.'
		\L_077a5:
		ZH 1:
		'Ai cũng sẵn sàng hiến mạng'
		R
		'vì Chúa công.'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Katsuie sau đó'
		R
		'nhìn quanh các chỉ huy khác'
		R
		'xếp hàng phía sau anh ta.'
		\L_077a5:
		\L_07798:
		\L_07752:
		\L_076b8:
		ZH 1:
		'Trong số đó,'
		\L_077a5:
		ZH 1:
		'có một người đàn ông đang'
		R
		'nghiến răng nghiến lợi như'
		R
		'đang chịu đựng điều gì đó.'
		\L_077a5:
		ZH 1:
		'Nobunaga nhận thấy điều này'
		R
		'và ra hiệu cho anh ta đến.'
		\L_077a5:
		\L_07798:
		!VAR0516 : 418!
		\L_07744:
		\L_07680:
		ZH 1:
		'Nếu ta nhớ không lầm...'
		R
		'Đúng vậy, ông là cha của'
		R
		'một trong những con tin...'
		\L_077a5:
		ZH 1:
		'Sẵn sàng hy sinh mạng'
		R
		'sống của con gái mình chưa?'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Sau một lúc do dự,'
		R
		'người chỉ huy mở miệng.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'...'
		\L_077a5:
		ZH 1:
		'Vì Chúa công,'
		\L_077a5:
		ZH 1:
		'con gái thần cũng sẽ vui'
		R
		'lòng bỏ mạng.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Mm, câu trả lời'
		R
		'đáng ngưỡng mộ. Ngươi có'
		R
		'thể trở về chỗ của mình.'
		\L_077a5:
		\L_07798:
		\L_07752:
		\L_07680:
		ZH 1:
		'Mọi người ơi! Bây giờ sẽ'
		R
		'không có bất kỳ vấn đề gì.'
		R
		'Chiến tranh.'
		\L_077a5:
		ZH 1:
		'Chuẩn bị cho chiến tranh!'
		\L_077a5:
	}
	\L_07798:
	\L_07680:
	ZH 1:
	'（Toukichirou） Ôi!'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Vâng, thưa ngài!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Tất cả họ cùng'
	R
	'cúi đầu chào Nobunaga'
	R
	'rồi bước ra ngoài.'
	\L_077a5:
	ZH 1:
	'Katsuie là người'
	R
	'đầu tiên ra ngoài.'
	\L_077a5:
	ZH 1:
	'Người cuối'
	R
	'cùng còn lại, vẫn có vẻ'
	R
	'chán nản, là Isoroku.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 24!
	\L_07744:
	\L_07680:
	ZH 1:
	'Nó là gì? Tại'
	R
	'sao ngươi không nhanh lên?'
	\L_077a5:
	ZH 1:
	'Nếu không,'
	R
	'sự phục hồi của gia tộc'
	R
	'Yamamoto sẽ còn rất xa vời.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Vâng... Chúa công.'
	\L_077a5:
	\L_07798:
	\L_07752:
	\L_076b8:
	ZH 1:
	'Isoroku rời khỏi phòng với'
	R
	'dáng đi do dự.'
	\L_077a5:
	ZH 1:
	'Cô đi ngang qua một cô gái'
	R
	'trẻ đang bước vào.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 25!
	\L_07744:
	\L_076f0:
	ZH 1:
	'... Cha.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Ồ, Kou đấy à. Có chuyện gì?'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Chúng ta lại sắp'
	R
	'xảy ra chiến tranh à?'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Đúng vậy. Nghe này,'
	R
	'Kou. Tiếp theo chúng ta'
	R
	'sẽ chiến đấu với lục địa.'
	\L_077a5:
	ZH 1:
	'Mở rộng ra từ NHẬT BẢN.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Ngược lại'
	R
	'với Nobunaga ngây ngất,'
	R
	'Kou tiếp tục cau mày.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Cha...'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Hử, con muốn quà từ lục địa'
	R
	'à?'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Cha ơi, xin'
	R
	'hãy dừng lại đi...'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Lời phàn nàn của'
	R
	'Kou yếu ớt và bộc phát.'
	\L_077a5:
	ZH 1:
	'Biểu cảm'
	R
	'của Nobunaga hoàn toàn'
	R
	'chuyển sang nghiêm túc.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Chiến tranh làm dân khổ.'
	R
	'Quanh thành bao đứa trẻ mất'
	R
	'cha...'
	\L_077a5:
	ZH 1:
	'Chưa đủ sao ạ? Chỉ đất nước'
	R
	'này thôi, chẳng đủ rồi'
	R
	'sao...?'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'... Ừm.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Như không chịu nổi ánh mắt'
	R
	'van nài'
	\L_077a5:
	ZH 1:
	'của Kou, Nobunaga quay lưng'
	R
	'đi.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Được rồi. Lần'
	R
	'này ta sẽ cố gắng không'
	R
	'để chiến tranh kéo dài.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Cha... Có vẻ như cha'
	R
	'sẽ không ngừng chiến đấu.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Kou cúi đầu'
	R
	'và cúi xuống sàn.'
	\L_077a5:
	ZH 1:
	'Trong khi cô'
	R
	'lặng lẽ khóc, Nobunaga'
	R
	'nói với cô từ phía sau.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Kou, cha phải giữ đất nước'
	\L_077a5:
	ZH 1:
	'này, vì cả những người đã'
	R
	'chết trong chiến trận.'
	\L_077a5:
	ZH 1:
	'Không thể để lũ ngoại bang'
	\L_077a5:
	ZH 1:
	'chiếm núi sông, đồng ruộng'
	\L_077a5:
	ZH 1:
	'và làng mạc này...'
	\L_077a5:
	ZH 1:
	'Cha không bắt'
	\L_077a5:
	ZH 1:
	'con hiểu. Con chỉ cần cầu'
	R
	'cha bình an.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Nobunaga để lại cho Kou'
	R
	'những lời đó và đứng dậy.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Thưa cha, cha'
	R
	'đi đâu vậy...?'
	\L_077a5:
	{VAR0326 \ 1:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ta sẽ chuẩn'
		R
		'bị cho chiến tranh.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'... Xin cha hãy bình an trở'
		R
		'về.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ừm.'
		\L_077a5:
	}
	{VAR0326 = 1:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ta nên kiểm tra'
		R
		'cô gái đó trước khi'
		R
		'chiến tranh bắt đầu.'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Kou cứng người vì'
		R
		'sốc. Nobunaga mở cánh'
		R
		'cửa trượt trong phòng.'
		\L_077a5:
		\L_07798:
		\L_076e2:
		\L_07752:
		\L_076b8:
		ZH 1:
		'Hắn đi qua một số cửa trượt'
		R
		'để đến một căn phòng nhất định.'
		\L_077a5:
		ZH 1:
		'Đó là một căn phòng trống rỗng đến kinh ngạc.'
		\L_077a5:
		ZH 1:
		'Đơn sơ như nhà tù, nhưng chỉ'
		R
		'có một lối vào và lối ra.'
		\L_077a5:
		ZH 1:
		'Ngoài cánh cửa Nobunaga mở ra,'
		R
		'thậm chí còn không có cửa sổ.'
		\L_077a5:
		ZH 1:
		'Ở một góc phòng là thứ mà Nobunaga tìm đến.'
		\L_077a5:
		\L_07798:
		!VAR0516 : 417!
		\L_076d4:
		!VAR0516 : 30!
		\L_07744:
		\L_07680:
		ZH 1:
		'Ta mong đợi'
		R
		'không kém nữ kiếm sĩ'
		R
		'giỏi nhất của Leazas.'
		\L_077a5:
		ZH 1:
		'Việc mang thai'
		R
		'đứa con của ta vẫn chưa'
		R
		'khiến ngươi phát điên.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'...'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Đó là Leila, giờ'
		R
		'đã hoàn toàn khác.'
		\L_077a5:
		ZH 1:
		'Cái bụng'
		R
		'khó coi của cô phình ra và'
		R
		'khuôn mặt trông hốc hác.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ngươi đang'
		R
		'buồn về điều gì vậy? Đó là'
		R
		'nơi vợ sinh con cho chồng.'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Nobunaga cười toe toét.'
		\L_077a5:
		ZH 1:
		'Khi hắn làm vậy, cái'
		R
		'bụng căng phồng của Leila'
		R
		'cử động một cách kỳ lạ.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'...!'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Ôi, một đứa trẻ khá năng'
		R
		'động. Ta chắc rằng bây giờ'
		R
		'ngươi đã quen với nó rồi.'
		\L_077a5:
		ZH 1:
		'Trước đây nó khá tệ.'
		\L_077a5:
		ZH 1:
		'Lúc đầu, ngươi đã cố gắng'
		R
		'tự sát bằng cách cắn đứt'
		R
		'lưỡi hoặc đập đầu vào cột.'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Nếu nhìn kỹ,'
		R
		'ngươi có thể thấy một số vết'
		R
		'sẹo nhẹ trên trán của Leila.'
		\L_077a5:
		\L_07798:
		\L_076f0:
		ZH 1:
		'...'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Bây giờ ta đã'
		R
		'cắt lưỡi của ngươi và'
		R
		'lính canh sẽ ngăn cản'
		\L_077a5:
		ZH 1:
		'ngươi nếu ngươi cố đập'
		R
		'đầu vào bất cứ thứ gì.'
		\L_077a5:
		ZH 1:
		'Em không cần phải'
		R
		'lo lắng gì cả, cứ nuôi con'
		R
		'của anh trong bụng em đi.'
		\L_077a5:
		ZH 1:
		'Đừng mổ bụng'
		R
		'cho đến lúc đó.'
		\L_077a5:
		ZH 1:
		'Haahahahahah!'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Leila trừng mắt'
		R
		'nhìn Nobunaga trong'
		R
		'khi hắn cười lớn.'
		\L_077a5:
		\L_07798:
		\L_0770c:
		ZH 1:
		'Tôi đã trở'
		R
		'thành vợ của người đàn'
		R
		'ông này cho Leazas.'
		\L_077a5:
		ZH 1:
		'Nhưng đối'
		R
		'với anh, phụ nữ chỉ là nơi'
		R
		'gieo hạt giống của anh...'
		\L_077a5:
		ZH 1:
		'Người đàn ông này...'
		\L_077a5:
		ZH 1:
		'Không, anh ta thậm chí'
		R
		'còn không phải là con người.'
		R
		'Anh ta là một con quỷ!'
		\L_077a5:
		ZH 1:
		'Tôi đã bị cưỡng hiếp...'
		\L_077a5:
		ZH 1:
		'Thậm chí không phải thế,'
		R
		'chỉ là cấy vào bên trong,'
		R
		'và trong vòng một tuần,'
		\L_077a5:
		ZH 1:
		'bụng tôi sưng lên!'
		\L_077a5:
		ZH 1:
		'Và mỗi khi đứa trẻ này'
		R
		'di chuyển trong tôi, cơn đau'
		R
		'lại chạy khắp cơ thể tôi...'
		\L_077a5:
		ZH 1:
		'Bên trong tôi'
		R
		'là gì vậy? Cái gì đang'
		R
		'ăn mòn cơ thể tôi vậy?!'
		\L_077a5:
		ZH 1:
		'Tôi sợ hãi và đã nhiều'
		R
		'lần nghĩ đến việc tự sát,'
		\L_077a5:
		ZH 1:
		'nhưng mọi nỗ lực của'
		R
		'tôi đều bị dừng lại...'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Leila trừng'
		R
		'mắt nhìn Nobunaga, nhưng'
		R
		'sau đó chán nản cúi đầu.'
		\L_077a5:
		\L_07798:
		\L_07680:
		ZH 1:
		'Leila?... Hm,'
		R
		'mất ý thức rồi.'
		\L_077a5:
		ZH 1:
		'Hãy sinh con cho'
		R
		'ta. Ta sẽ để ngươi'
		R
		'sống cho đến lúc đó.'
		\L_077a5:
		\L_07798:
		\L_076b8:
		ZH 1:
		'Nobunaga cười'
		R
		'vào bụng Leila. Bụng cô lại'
		R
		'quằn quại một cách kỳ lạ.'
		\L_077a5:
	}
	\L_07798:
	\L_076e2:
	\L_07752:
	\L_0778a:
	%0:
*L_03fe6:
	!VAR0516 : 0!
	%#M.ADV:
	!VAR0158 : 55!
	!VAR0045 : VAR0142!
	!VAR0046 : VAR0143!
	!VAR0516 : 1!
	%#M.ADV:
	!VAR0043 : VAR0045!
	!VAR0044 : VAR0046!
	!VAR0516 : 10!
	%#M.ADV:
	!VAR0516 : 1005!
	\L_0777c:
	SS 13:
	\L_076b8:
	ZM 32:
	ZH 1:
	'NHẬT BẢN'
	R
	ZM 24:
	ZH 1:
	R
	'Nagasaki Nagasaki.'
	\L_077a5:
	ZH 1:
	'Là thành phố duy nhất ở NHẬT'
	R
	'BẢN nối'
	\L_077a5:
	ZH 1:
	'liền với lục địa nên nơi đây'
	R
	'luôn nhộn nhịp.'
	\L_077a5:
	ZH 1:
	'Nhưng lúc này, thành phố'
	R
	'đang bao phủ trong một sự im'
	R
	'lặng khác thường.'
	\L_077a5:
	ZH 1:
	'Không có ai ở trên đường'
	R
	'phố.'
	\L_077a5:
	ZH 1:
	'Không có gì thắc mắc tại'
	R
	'sao.'
	\L_077a5:
	ZH 1:
	'Trong vài giờ nữa, thành phố'
	R
	'sẽ trở thành chiến trường.'
	\L_077a5:
	ZH 1:
	'Bộ chỉ huy quân sự NHẬT BẢN.'
	\L_077a5:
	ZH 1:
	'Hai vị tướng túc trực để bảo'
	R
	'vệ Nagasaki khỏi cuộc tấn'
	R
	'công của Leazas.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 420!
	\L_076d4:
	\L_07680:
	ZH 1:
	'Lũ ngu trên lục địa...'
	\L_077a5:
	ZH 1:
	'Dám đánh JAPAN, thật chẳng'
	R
	'biết thân biết phận.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 24!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Ngài Katsuie, chớ khinh'
	R
	'địch. Tin báo chúng'
	\L_077a5:
	ZH 1:
	'đã qua hết cầu Tenma, sắp'
	R
	'tới đây rồi.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Người khiển trách'
	R
	'Katsuie là một người phụ nữ'
	R
	'mang theo một cây cung lớn.'
	\L_077a5:
	ZH 1:
	'Ở NHẬT BẢN, việc phụ nữ'
	R
	'sử dụng vũ khí để chiến đấu'
	R
	'là điều hết sức bất thường.'
	\L_077a5:
	ZH 1:
	'Nhưng vị tướng'
	R
	'này, Isoroku Yamamoto,'
	\L_077a5:
	ZH 1:
	'đã được trao quyền'
	R
	'kiểm soát quân đội mặc'
	R
	'dù thân phận là phụ nữ.'
	\L_077a5:
	ZH 1:
	'Ở NHẬT BẢN,'
	R
	'đó là một hiện tượng hiếm'
	R
	'hoi gần như một phép lạ.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Hừ,'
	\L_077a5:
	ZH 1:
	'đừng lo, Isoroku.'
	\L_077a5:
	ZH 1:
	'Katsuie này sao thua lũ ngu'
	R
	'ấy được.'
	\L_077a5:
	ZH 1:
	'Cô cứ đứng sau mà xem, cầu'
	R
	'đàn'
	\L_077a5:
	ZH 1:
	'ông bình an như phận đàn bà'
	R
	'đi.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Đừng coi thường tôi!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Isoroku gạt'
	R
	'tay Katsuie mà anh đã đặt'
	R
	'lên vai cô từ lúc nào đó.'
	\L_077a5:
	ZH 1:
	'Sau đó,'
	\L_077a5:
	ZH 1:
	'cô trừng mắt nhìn khuôn'
	R
	'mặt đồi trụy của Katsuie'
	R
	'với ánh mắt hung bạo.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Vẫn bướng'
	R
	'bỉnh như ngày nào.'
	\L_077a5:
	ZH 1:
	'Với ngoại hình giống'
	R
	'của ngươi, ngươi sẽ có thể'
	R
	'có được một daimyo tử tế.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Isoroku mặc quần áo tương'
	R
	'tự như của nam giới vì chúng'
	R
	'giúp di chuyển dễ dàng hơn,'
	\L_077a5:
	ZH 1:
	'nhưng nó lại phản tác dụng'
	R
	'vào những lúc như thế này.'
	\L_077a5:
	ZH 1:
	'Cánh tay mảnh'
	R
	'khảnh và phần ngực'
	R
	'lộ ra dưới ánh nắng.'
	\L_077a5:
	ZH 1:
	'Họ có một sự'
	R
	'tròn trịa đầy nữ tính.'
	\L_077a5:
	ZH 1:
	'Katsuie nhìn chằm'
	R
	'chằm vào những phần này'
	R
	'một cách thô lỗ khi nói.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Thân là công chúa mà vì phục'
	R
	'hưng gia tộc lại cầm kiếm...'
	\L_077a5:
	ZH 1:
	'À, cầm cung sao.'
	\L_077a5:
	ZH 1:
	'Cũng ghê gớm đấy.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Ngài định sỉ nhục tôi sao?'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Tôi định khen ngợi ngươi.'
	R
	'Ngươi là một người ấn tượng,'
	R
	'không giống phụ nữ chút nào.'
	\L_077a5:
	ZH 1:
	'Chúa công'
	R
	'không chỉ đơn giản biến'
	\L_077a5:
	ZH 1:
	'ngươi thành một vị'
	R
	'tướng như một trò đùa.'
	\L_077a5:
	ZH 1:
	'Tôi cũng thừa nhận'
	R
	'kỹ năng của ngươi.'
	\L_077a5:
	ZH 1:
	'Chỉ tiếc là bố'
	R
	'ngươi không bằng một'
	R
	'nửa con người ngươi.'
	\L_077a5:
	ZH 1:
	'Nếu vậy thì gia'
	R
	'đình Yamamoto sẽ ổn thôi.'
	\L_077a5:
	ZH 1:
	'Ngươi có thể đang'
	R
	'tận hưởng cuộc sống của một'
	R
	'người phụ nữ ngay bây giờ.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Katsuie thậm chí còn không'
	R
	'thèm che giấu sự khinh bỉ'
	R
	'trong tiếng cười của mình.'
	\L_077a5:
	ZH 1:
	'Isoroku hạ người'
	R
	'xuống tư thế ngay lập tức.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Còn nói năng xúc phạm nữa'
	R
	'thì...!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Ánh mắt của Isoroku có'
	R
	'thể sẽ khiến một người đàn'
	R
	'ông bình thường phải sợ hãi.'
	\L_077a5:
	ZH 1:
	'Nhưng Katsuie lại tỏ'
	R
	'ra như không có chuyện gì.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Ngươi sẽ làm gì?'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Chém ngài!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Isoroku bật kiếm khỏi vỏ.'
	\L_077a5:
	ZH 1:
	'（Keng!）'
	\L_077a5:
	ZH 1:
	'Kiếm rơi xuống đất. Nàng ôm'
	R
	'tay, quỳ sụp xuống.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Lưng kiếm thôi. Nhưng vết'
	R
	'bầm sẽ còn lâu đấy.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Katsuie đã có lúc'
	R
	'rút thanh katana của mình'
	R
	'ra. Anh đang nhìn xuống cô.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Vậy, Isoroku,'
	R
	'trở thành người phụ'
	R
	'nữ của tôi thì sao?'
	\L_077a5:
	ZH 1:
	'Thậm chí có thể đưa cậu'
	R
	'đến gần hơn với việc khôi'
	\L_077a5:
	ZH 1:
	'phục gia đình nếu tôi'
	R
	'hỏi Chúa công.'
	\L_077a5:
	ZH 1:
	'Ít nhất,'
	\L_077a5:
	ZH 1:
	'lựa chọn tốt hơn cho'
	R
	'ngươi là cố gắng sử dụng'
	\L_077a5:
	ZH 1:
	'thanh katana mà ngươi'
	R
	'thực sự không thể sử dụng.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Isoroku cắn môi'
	R
	'và không trả lời.'
	\L_077a5:
	\L_07798:
	\L_0770c:
	ZH 1:
	'Thiếp...'
	\L_077a5:
	\L_07798:
	!VAR0516 : 418!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Tướng quân Katsuie, Tướng'
	R
	'quân Isoroku! Họ đang đến!'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Họ đến rồi à?!'
	R
	'Giết tất cả những người'
	R
	'nước ngoài bẩn thỉu!'
	\L_077a5:
	\L_07798:
	\L_07752:
	\L_076b8:
	ZH 1:
	'Katsuie tra thanh katana của'
	R
	'mình vào bao, quay người và'
	R
	'đi ra ngoài.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 24!
	\L_07744:
	\L_07680:
	ZH 1:
	'Isoroku, muốn giết ta thì'
	R
	'lấy cung nhắm lưng này.'
	\L_077a5:
	ZH 1:
	'Tài bắn của cô, chuyện ấy dễ'
	R
	'thôi nhỉ?'
	\L_077a5:
	ZH 1:
	'Nếu cô đủ gan và hèn hạ để'
	R
	'đánh sau lưng! Ha ha ha!'
	\L_077a5:
	\L_07798:
	\L_076e2:
	\L_076b8:
	ZH 1:
	'Isoroku nhìn chằm chằm'
	R
	'vào lưng Katsuie một cách'
	\L_077a5:
	ZH 1:
	'đầy căm ghét khi anh'
	R
	'ta cười lớn và bỏ đi.'
	\L_077a5:
	\L_07798:
	\L_0770c:
	ZH 1:
	'Giờ chỉ được nghĩ đến trận'
	R
	'chiến...'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Isoroku lắc đầu'
	R
	'mạnh mẽ và đứng dậy.'
	\L_077a5:
	ZH 1:
	'Cô nhặt thanh katana bị'
	R
	'rơi và trả nó lại bên mình.'
	\L_077a5:
	\L_07798:
	\L_0770c:
	ZH 1:
	'Lúc này... Với mình, chỉ còn'
	R
	'chiến trận...'
	\L_077a5:
	\L_07798:
	\L_07752:
	\L_0778a:
	SS VAR0515:
	%0:
*L_0477a:
	!VAR0516 : 0!
	%#M.ADV:
	!VAR0158 : 56!
	!VAR0045 : VAR0142!
	!VAR0046 : VAR0143!
	!VAR0516 : 1!
	%#M.ADV:
	!VAR0043 : VAR0045!
	!VAR0044 : VAR0046!
	!VAR0516 : 10!
	%#M.ADV:
	!VAR0516 : 1005!
	\L_0777c:
	!VAR0516 : 417!
	\L_076d4:
	!VAR0516 : 25!
	\L_07744:
	SS 14:
	\L_076b8:
	ZM 32:
	ZH 1:
	'Ōsaka'
	R
	ZM 24:
	ZH 1:
	R
	'Lâu đài Osaka Thưa cha...'
	\L_077a5:
	ZH 1:
	'Gần đây có sự hỗn loạn xung'
	R
	'quanh lâu đài. Mọi người có'
	R
	'vẻ khó chịu...'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Không rõ liệu Nobunaga'
	R
	'có nghe thấy Kou hay không.'
	\L_077a5:
	ZH 1:
	'Hắn chỉ'
	R
	'tiếp tục nhìn chằm chằm vào'
	R
	'những ngọn núi ở phía tây.'
	\L_077a5:
	\L_07798:
	\L_0769c:
	ZH 1:
	'... Họ đến rồi.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Nobunaga bực bội nhếch'
	R
	'miệng.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 418!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Thưa ngài!'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Một vị tướng xông'
	R
	'vào qua cửa trượt.'
	\L_077a5:
	ZH 1:
	'Anh nhanh chóng quỳ một'
	R
	'chân lên tấm chiếu tatami.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Ngươi đang la'
	R
	'hét về điều gì vậy?'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Xin Chúa công thứ lỗi! Vừa'
	R
	'có tin từ lính canh nên thần'
	R
	'tới bẩm báo!'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Được rồi. Vậy nó là gì?'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Quân lục địa đã tiến qua ba'
	R
	'ngọn núi.'
	\L_077a5:
	ZH 1:
	'Một số làng dọc đường bị'
	R
	'chúng cướp phá.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Hm... Ngươi nghĩ'
	R
	'chúng ta nên làm gì?'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Vị tướng trả'
	R
	'lời với vẻ bối rối khi đột'
	R
	'nhiên được yêu cầu trả lời.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Tôi tin rằng chúng'
	R
	'ta nên gửi quân đến'
	R
	'để ngăn chặn chúng.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 25!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Thưa cha, xin'
	R
	'hãy bảo vệ dân làng.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Nobunaga nhắm mắt lại'
	R
	'như đang suy nghĩ một lúc.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Câu trả lời hay.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Vậy thưa Cha,'
	R
	'điều đó có nghĩa là...'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Kou mỉm cười nhẹ.'
	\L_077a5:
	ZH 1:
	'Nhưng đó chỉ là cho'
	R
	'đến khi cô nghe thấy điều'
	R
	'tiếp theo mà Nobunaga nói.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 418!
	\L_07744:
	\L_07680:
	ZH 1:
	'Truyền dân làng,'
	\L_077a5:
	ZH 1:
	'cuốc hay dao rựa cũng được.'
	\L_077a5:
	ZH 1:
	'Bằng mọi giá phải chặn chúng'
	R
	'lại.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 25!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Thưa cha...!'
	\L_077a5:
	\L_07798:
	!VAR0516 : 418!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Nhưng Chúa'
	\L_077a5:
	ZH 1:
	'công, địch là quân được huấn'
	R
	'luyện.'
	\L_077a5:
	ZH 1:
	'Dân làng e chỉ chết vô'
	R
	'ích...'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Cứ thế đi. Đồng thời cho'
	R
	'quân chuẩn bị, ta'
	\L_077a5:
	ZH 1:
	'nghênh địch tại Osaka.'
	\L_077a5:
	ZH 1:
	'Dân làng sẽ câu giờ cho ta.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Vâng, thưa ngài.'
	\L_077a5:
	\L_07798:
	\L_07752:
	\L_076b8:
	ZH 1:
	'Tướng quân gật đầu một cái'
	R
	'rồi lập tức đứng dậy rời'
	R
	'khỏi phòng.'
	\L_077a5:
	\L_07798:
	!VAR0516 : 25!
	\L_07744:
	\L_076f0:
	ZH 1:
	'Cha... Vì sao cha lại gây'
	R
	'chiến?'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Vì đất nước, vì nhân dân.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Nếu vậy... Xin cha đầu hàng'
	R
	'đi.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Nobunaga nhìn'
	R
	'Kou với vẻ sửng sốt.'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Con không chịu nổi cảnh đổ'
	R
	'máu vô ích nữa.'
	\L_077a5:
	ZH 1:
	'Vua lục địa cũng là'
	\L_077a5:
	ZH 1:
	'con người, hẳn không bạc đãi'
	R
	'nước đã hàng mình đâu...'
	\L_077a5:
	ZH 1:
	'Cha...'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Nobunaga cay đắng lắc đầu.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Kou... Họ'
	R
	'đã gây ra vô số tội ác'
	R
	'mà ngươi không hề biết.'
	\L_077a5:
	ZH 1:
	'Họ cướp bóc không'
	R
	'thương tiếc của những công'
	R
	'dân nghèo của chúng ta.'
	\L_077a5:
	ZH 1:
	'Họ bắt đàn ông của chúng'
	R
	'ta làm nô lệ và hãm hiếp'
	\L_077a5:
	ZH 1:
	'phụ nữ của chúng ta'
	R
	'cho đến khi họ phát điên.'
	\L_077a5:
	ZH 1:
	'Trẻ em và người già'
	R
	'không có mục đích sử dụng'
	\L_077a5:
	ZH 1:
	'nào khác thì bị chế biến'
	R
	'thành thức ăn cho gia súc...'
	\L_077a5:
	\L_07798:
	\L_076f0:
	ZH 1:
	'Kou... Kou'
	R
	'không thể tin được có'
	R
	'người lại làm như vậy.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Chuyện xảy ra ở Nagasaki,'
	R
	'con đâu phải không biết.'
	\L_077a5:
	\L_07798:
	\L_076b8:
	ZH 1:
	'Kou quay đi,'
	R
	'như thể cô không thể chịu'
	R
	'nổi khi nghe Nobunaga nói.'
	\L_077a5:
	\L_07798:
	\L_07680:
	ZH 1:
	'Ta không thể thua.'
	\L_077a5:
	{VAR0325 = 3:
		\L_07798:
		\L_076e2:
		\L_07752:
		\L_076b8:
		ZH 1:
		'Với câu nói dứt khoát đó, Nobunaga'
		R
		'mở cánh cửa trượt trong phòng.'
		\L_077a5:
		ZH 1:
		'Phòng của Leila ở phía bên kia.'
		\L_077a5:
		\L_07798:
		!VAR0516 : 417!
		\L_076d4:
		!VAR0516 : 30!
		\L_07744:
		\L_07680:
		ZH 1:
		'Leila. Có'
		R
		'vẻ như quân đội quê hương'
		R
		'của ngươi sẽ sớm đến đây.'
		\L_077a5:
		ZH 1:
		'Họ thậm chí có thể'
