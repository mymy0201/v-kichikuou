	\L_02c16:
	\L_02bd0:
	!VAR0516 : 81!
	\L_02bc2:
	\L_02b6e:
	ZH 1:
	'Em không vô dụng...'
	\L_02c23:
	\L_02c16:
	\L_02afe:
	ZH 1:
	'Em chắc chắn là'
