*L_04a42:
	!VAR0516 : 0!
	%#M.ADV:
	!VAR0516 : 1001!
	\L_04eb0:
	\L_04dec:
	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Hành lang'
	\L_04ed9:
	\L_04ecc:
	!VAR0516 : 11!
	\L_04e08:
	\L_04db4:
	ZH 1:
	'Ờ...'
	\L_04ed9:
	\L_04ecc:
	\L_04dec:
	ZH 1:
	'Mặt Melfeis hơi đỏ và'
	R
	'cô ấy đang dựa vào tường'
	R
	'khi bước xuống hành lang.'
	\L_04ed9:
	\L_04ecc:
	\L_04db4:
	ZH 1:
	'Ừm...'
	\L_04ed9:
	\L_04ecc:
	\L_04dec:
	ZH 1:
	'Hông của Melfeis'
	R
	'thỉnh thoảng bị co giật.'
	\L_04ed9:
	\L_04ecc:
	\L_04db4:
	ZH 1:
	'Em... không thể...'
	\L_04ed9:
	\L_04ecc:
	\L_04dec:
	ZH 1:
	'Những ngón'
	R
	'tay run rẩy của Melfeis'
	R
	'từ từ chạm vào háng cô.'
	\L_04ed9:
	ZH 1:
	'Những ngón tay của'
	R
	'cô ấy di chuyển trái'
	R
	'với ý muốn của cô ấy,'
	\L_04ed9:
	ZH 1:
	'trên quần áo của cô ấy...'
	\L_04ed9:
	\L_04ecc:
	\L_04db4:
	ZH 1:
	'Ừm... À!!'
	\L_04ed9:
	\L_04ecc:
	\L_04dec:
	ZH 1:
	'Melfeis chạm vào âm hộ'
	R
	'đang nhỏ giọt của mình.'
	\L_04ed9:
	ZH 1:
	'Chỉ với đầu ngón tay sượt'
	R
	'qua nó, cô rên rỉ ngọt ngào.'
	\L_04ed9:
	\L_04ecc:
	\L_04dd0:
	ZH 1:
	'Em biết mình không nên,'
	R
	'nhưng... em không thể dừng'
	R
	'lại... Cơ thể em... Ah...'
	\L_04ed9:
	\L_04ecc:
	\L_04db4:
	ZH 1:
	'Ừm... Aah...!'
	\L_04ed9:
	\L_04ecc:
	\L_04e24:
	ZH 1:
	'À...'
	\L_04ed9:
	\L_04ecc:
	\L_04db4:
	ZH 1:
	'Hả!?'
	\L_04ed9:
	\L_04ecc:
	\L_04dec:
	ZH 1:
	'Melfeis điên cuồng nhìn'
	R
	'về hướng giọng nói phát ra.'
	\L_04ed9:
	\L_04ecc:
	!VAR0516 : 471!
	\L_04e78:
	\L_04e24:
	ZH 1:
	'U-Ừm... Cô'
	R
	'Melfeis... Có chuyện gì vậy?'
	\L_04ed9:
	\L_04ecc:
	\L_04dd0:
	ZH 1:
	'... Một người đàn ông...'
	\L_04ed9:
	\L_04ecc:
	\L_04dec:
	ZH 1:
	'Ánh mắt của Melfeis'
	R
	'lướt qua cơ thể người lính.'
	\L_04ed9:
	\L_04ecc:
	\L_04e24:
	ZH 1:
	'Đ-Ờ...'
	\L_04ed9:
	\L_04ecc:
	\L_04db4:
	ZH 1:
	'À...'
	\L_04ed9:
	\L_04ecc:
	\L_04dec:
	ZH 1:
	'Giọng nói'
	R
	'hoang mang của người lính'
	R
	'khiến Melfeis tỉnh lại.'
	\L_04ed9:
	\L_04ecc:
	\L_04db4:
	ZH 1:
	'Ưu...!!'
	\L_04ed9:
	\L_04ecc:
	\L_04e24:
	ZH 1:
	'Cô Melfeis!?'
	\L_04ed9:
	\L_04ecc:
	\L_04e86:
	\L_04dec:
	ZH 1:
	'Melfeis tập trung mọi'
	R
	'ý thức và sức mạnh có thể và'
	R
	'chạy trốn khỏi người lính.'
	\L_04ed9:
	\L_04ecc:
	\L_04dd0:
	ZH 1:
	'Thưa bệ hạ...'
	\L_04ed9:
	ZH 1:
	'Thưa bệ hạ...'
	R
	'thần có thể không đi'
	R
	'tiếp được... Làm ơn...'
	\L_04ed9:
	ZH 1:
	'Xin hãy giúp em...'
	\L_04ed9:
