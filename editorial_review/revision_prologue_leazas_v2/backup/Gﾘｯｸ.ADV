	\L_0193b:
	\L_0192e:
	\L_01886:
	ZH 1:
	'K-King... tôi...'
	\L_0193b:
	\L_0192e:
	\L_01816:
	ZH 1:
	'Gahahahaha!ôi chỉ đang'
