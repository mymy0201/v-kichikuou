	\L_03652:
	\L_035c6:
	ZM 32:
	ZH 1:
	'　　　Leazas Castle'
	R
	ZM 24:
	ZH 1:
	R
	'　　　　　Audience Room'
	\L_036b3:
	\L_036a6:
	\L_035fe:
	ZH 1:
	'I’m back.'
	\L_036b3:
	\L_036a6:
	\L_0358e:
	ZH 1:
	'Hey, old man.'
	R
	'Guess your joints withstood'
	R
	'the cold.'
	\L_036b3:
	\L_036a6:
	\L_035fe:
	ZH 1:
	'Yes, somehow...'
	R
	'My joints hurt down to my soul.'
	\L_036b3:
	\L_036a6:
	\L_0358e:
	ZH 1:
	'Gahahahahahahahaha.'
	R
	'What I’d expect of an old man.'
	R
	'You’re a good talker.'
	\L_036b3:
	\L_036a6:
	\L_035fe:
	ZH 1:
	'And I tried so hard, too...'
	\L_036b3:
	\L_036a6:
	\L_0358e:
	ZH 1:
	'You should’ve just stayed like'
	R
	'that, then. I like you better'
	R
	'like this anyway, I’m more'
	R
	'used to it.'
	\L_036b3:
	\L_036a6:
	\L_035fe:
	ZH 1:
	'Aah... Dear.'
	R
	'I’m tired, so I’m going to'
	R
	'drink some kelp tea.'
	\L_036b3:
	\L_036a6:
	\L_0358e:
	ZH 1:
	'Careful not to drink too much'
	R
	'and rust.'
	\L_036b3:
	\L_036a6:
	\L_035c6:
	ZH 1:
	'Thus, Freak returned to Leazas'
	R
	'Castle in his original body.'
