	'was around here.'
	\L_025a2:
	\L_02595:
	\L_024b5:
	ZH 1:
	'Rance was searching for'
	R
	'Aristoles.'
	\L_025a2:
	\L_02595:
	\L_02525:
	ZH 1:
	'...It’s a...'
	\L_025a2:
	ZH 1:
	'...Huhu...'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Hm?'
	\L_025a2:
	\L_02595:
	\L_024b5:
	ZH 1:
	'He heard voices from in front'
