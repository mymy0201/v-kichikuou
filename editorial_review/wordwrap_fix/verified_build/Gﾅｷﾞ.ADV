		!VAR0516 : 478!
		\L_0860b:
		\L_085b7:
		ZH 1:
		'Lãnh chúa Nagi, ông Ragarl,'
		\L_0866c:
		ZH 1:
		'có lệnh từ lãnh chúa Chizuko.Dẫn'
		R
		'đầu đơn vị chiến đấu với Leazas'
		R
		'ngay lập tức, cô ấy nói...'
		\L_0866c:
		\L_0865f:
		\L_08547:
		ZH 1:
		'Im lặng.'
		\L_0866c:
		\L_0865f:
		\L_085b7:
		ZH 1:
		'Đúng, nhưng...'
		\L_0866c:
		\L_0865f:
		\L_08547:
		ZH 1:
		'Tôi nói im lặng.'
		\L_0866c:
		\L_0865f:
		\L_0857f:
		ZH 1:
		'Ragarl giơ cánh tay trái lên.'
		\L_0866c:
		ZH 1:
		'Chiếc găng tay chứa đầy ma thuật'
		R
		'của anh ta bay ra và ghim quần'
		R
		'áo của pháp sư đưa tin vào'
		\L_0866c:
		ZH 1:
		'tường.'
		\L_0866c:
		\L_0865f:
		\L_085b7:
		ZH 1:
		'Agh... M-Mr.Ragarl...!'
		\L_0866c:
		\L_0865f:
		\L_08547:
		ZH 1:
		'Lần sau tôi sẽ giết anh,'
		\L_0866c:
		ZH 1:
		'đừng nói thêm lời nào nữa.Tôi sẽ'
		R
		'không cho phép việc tập luyện'
		R
		'của Nagi bị gián đoạn.'
		\L_0866c:
		\L_0865f:
		\L_085b7:
		ZH 1:
		'...Chào...'
		\L_0866c:
		\L_0865f:
		\L_08547:
		ZH 1:
		'Bây giờ, đừng phân tâm nữa,'
		R
		'Nagi.Bắt đầu lại từ đầu.'
		\L_0866c:
		\L_0865f:
		\L_08619:
		!VAR0516 : 45!
