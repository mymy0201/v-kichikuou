	\L_02643:
	\L_02636:
	\L_0251e:
	ZH 1:
	'Aristoles...'
	\L_02643:
	ZH 1:
	'I’m glad you’re alive...'
	\L_02643:
	ZH 1:
	'Mother’s dead...'
