	'HEART, YOU can’t do that!'
	\L_047b4:
	\L_047a7:
	\L_046ff:
	ZH 1:
	'............'
	\L_047b4:
	ZH 1:
	'Sorry...!!'
	\L_047b4:
	\L_047a7:
	\L_0471b:
