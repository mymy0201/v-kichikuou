	'anh chợt khựng lại.'
	\L_03535:
	\L_03528:
	Y 4, 3:
	!VAR0690 : VAR0000!
	\L_03410:
	{VAR0690 = 1:
		ZH 1:
		'Có vẻ như đây là nơi quản lý quỹ'
		R
		'chiến tranh của họ... Hoàn hảo.'
		\L_03535:
		\L_03528:
		\L_03448:
		ZH 1:
		'Gekkou đã vượt qua vô số ổ khóa'
		R
		'mà không cần nỗ lực gì.'
		\L_03535:
		\L_03528:
		\L_03410:
		ZH 1:
		'Để xem... tôi sẽ lấy một nửa.'
		\L_03535:
		\L_03528:
		\L_03472:
		\L_03448:
		ZH 1:
		'Anh ta đã đánh cắp 50% quỹ chiến'
