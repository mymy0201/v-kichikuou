		\L_06bc3:
		ZH 1:
		'...??'
		\L_06c78:
		\L_06c6b:
		\L_06b53:
		ZH 1:
		'The thing is...'
		\L_06c78:
		ZH 1:
		'Have you asked Hanty anything'
