	\L_06c6b:
	\L_06c25:
	!VAR0516 : 425!
	\L_06c17:
	\L_06bc3:
	ZH 1:
	'Why?'
	\L_06c78:
	\L_06c6b:
	\L_06b53:
	ZH 1:
	'I met him once back when I was'
