	'beat my dad one on one.'
	\L_06c78:
	\L_06c6b:
	\L_06b53:
	ZH 1:
	'...That’s definitely nothing'
	R
	'to scoff at...'
	\L_06c78:
	\L_06c6b:
	\L_06c25:
	!VAR0516 : 426!
	\L_06c17:
	\L_06bc3:
