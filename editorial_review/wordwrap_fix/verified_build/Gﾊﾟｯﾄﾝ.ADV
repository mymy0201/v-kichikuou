	!VAR0516 : 426!
	\L_06c17:
	\L_06b53:
	ZH 1:
	'Been a while, old man.'
	R
	'Can’t believe you’re alive...'
	\L_06c78:
	ZH 1:
	'I was positive you died.'
	\L_06c78:
	\L_06c6b:
	\L_06bc3:
	ZH 1:
