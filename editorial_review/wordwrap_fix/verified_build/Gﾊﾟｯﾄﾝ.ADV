		\L_06c6b:
		\L_06b53:
		ZH 1:
		'Who are you?'
		\L_06c78:
		\L_06c6b:
		\L_06bc3:
		ZH 1:
		'Hey, I’m General Aristoles’s'
		R
		'lieutenant general, Convert'
		R
		'Tax.'
		\L_06c78:
		ZH 1:
		'I’m indebted to you, nice to'
