	\L_065c5:
	PF0 VAR0056:
	\L_06539:
	ZM 32:
	ZH 1:
	'Thành Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng ngủ Rance.'
	R
	'Rance「Phù... Thật tình...」'
	\L_06626:
	\L_06619:
	\L_06539:
	ZH 1:
	'Rance bước vào'
	R
	'phòng và nhảy lên giường.'
	\L_06626:
	\L_06619:
	\L_06501:
	ZH 1:
	'Sill, nước.'
	\L_06626:
	\L_06619:
	\L_06571:
	ZH 1:
	'Vâng, thưa Chủ nhân Rance...'
	\L_06626:
	\L_06619:
	\L_065a9:
	ZH 1:
	'Sill lấy một ít nước'
	R
	'và mang đến cho Rance.'
	\L_06626:
	ZH 1:
	'Rance uống cạn một hơi.'
	\L_06626:
	\L_06619:
	\L_0651d:
	ZH 1:
	'Chuyện nguy hiểm thật...'
	\L_06626:
	ZH 1:
	'Muốn ta thành Ma Vương à...?'
	R
	'Lại còn giết Miki nữa...'
	\L_06626:
	ZH 1:
	'Có hơi... khó nói nhỉ...'
	\L_06626:
	\L_06619:
	\L_06501:
	ZH 1:
	'Ừm...'
	\L_06626:
	ZH 1:
	'Sill. Mà sao em'
	R
	'lại tới đón ta?'
	\L_06626:
	\L_06619:
	\L_06571:
	ZH 1:
	'Ừm... Ờ...'
	\L_06626:
	\L_06619:
	\L_06501:
	ZH 1:
	'Không có lý do gì à...'
	\L_06626:
	\L_06619:
	\L_06571:
	ZH 1:
	'... Em xin lỗi.'
	\L_06626:
	\L_06619:
	\L_06501:
	ZH 1:
	'Thôi được. Hôm'
	R
	'nay ta tha cho em.'
	\L_06626:
	\L_06619:
	\L_06571:
	ZH 1:
	'Cảm ơn Chủ nhân Rance...'
	\L_06626:
	\L_06619:
	\L_0658d:
	ZH 1:
	'Phù... May quá.'
	\L_06626:
	ZH 1:
	'Chủ nhân Rance... Em'
	R
	'biết chuyện... Em nghe'
	R
	'lén cô Satella nói...'
	\L_06626:
	\L_06619:
	\L_065a9:
	ZH 1:
	R
	'.........'
	\L_06626:
	ZH 1:
	R
	'......'
	\L_06626:
	ZH 1:
	R
	'...'
	\L_06626:
