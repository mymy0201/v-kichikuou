	\L_0a586:
	\L_0a516:
	ZH 1:
	'＜gõ cửa）'
	\L_0a593:
	\L_0a586:
	\L_0a4de:
	ZH 1:
	'Mềm mượt?'
	\L_0a593:
	\L_0a586:
	\L_0a46e:
	ZH 1:
	'Không, không.Không phải cô ấy,'
	R
	'cô Hazell.'
