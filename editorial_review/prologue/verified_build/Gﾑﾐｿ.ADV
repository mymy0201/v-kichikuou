		ZH 1:
		'Rance shrugged with'
		R
		'astonishment.'
		\L_00f6b:
		ZH 1:
		'His eyes suddenly stopped on a'
		R
		'book on the desk.'
		\L_00f6b:
		\L_00f5e:
		\L_00e46:
