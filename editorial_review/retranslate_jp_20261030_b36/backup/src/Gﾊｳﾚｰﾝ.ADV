	\L_04b6c:
	ZH 1:
	'Cái gì?'
	\L_04c91:
	\L_04c84:
	\L_04bdc:
	ZH 1:
	'Kẻ phản diện'
	R
	'tệ hại như tôi tưởng, chính'
