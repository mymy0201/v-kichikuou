	\L_04c91:
	\L_04c84:
	\L_04bdc:
	ZH 1:
	'............'
	\L_04c91:
	\L_04c84:
	\L_04b6c:
	ZH 1:
	'Ta hiểu rồi.'
	\L_04c91:
	ZH 1:
	'Đã bảo là'
