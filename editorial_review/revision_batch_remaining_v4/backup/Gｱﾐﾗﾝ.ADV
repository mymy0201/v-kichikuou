	\L_022a4:
	\L_02297:
	\L_021ef:
	ZH 1:
	'...Rốt cuộc là khi nào?'
	\L_022a4:
	\L_02297:
	\L_0217f:
	ZH 1:
	'Tôi không biết...'
	\L_022a4:
	\L_02297:
	\L_021ef:
	ZH 1:
	'Này!?'
	\L_022a4:
	\L_02297:
	\L_021b7:
	ZH 1:
	'Rance sờ'
	R
	'mông Amiran, và...'
	\L_022a4:
	\L_02297:
	\L_0217f:
	ZH 1:
	'Khi nào sẽ xảy ra?!'
	\L_022a4:
	\L_02297:
	\L_021ef:
	ZH 1:
	'Kyaah...!'
	\L_022a4:
	\L_02297:
	\L_021b7:
	ZH 1:
	'Anh lại đẩy'
