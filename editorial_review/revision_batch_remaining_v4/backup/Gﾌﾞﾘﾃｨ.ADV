	}
	{VAR0101 = 2:
		\L_024b9:
		!VAR0516 : 34!
		\L_024ab:
		\L_02457:
		ZH 1:
		'Ở phía bên kia'
		R
		'cánh cửa đó, chúng tôi đã'
		R
		'gặp một vị thần.Sau đó...'
		\L_0250c:
		\L_024ff:
		\L_024b9:
		!VAR0516 : 481!
		\L_024ab:
		\L_02457:
		ZH 1:
		'Nó đã đáp ứng mong muốn'
