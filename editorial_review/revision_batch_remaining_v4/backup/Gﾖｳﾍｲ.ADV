	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng yết kiến Yoooooo.'
	\L_00b07:
	\L_00afa:
	\L_00a8a:
	ZH 1:
	'Louis đến trước'
	R
	'Rance khi anh ấy đang đọc'
	R
	'truyện tranh về ngai vàng.'
	\L_00b07:
	\L_00afa:
	\L_009e2:
	ZH 1:
	'Trời ạ, anh thật kinh tởm.'
	\L_00b07:
	\L_00afa:
	\L_00a52:
	ZH 1:
	'Công việc của tôi đã'
	R
	'xong rồi, King.Tôi sẽ đi.'
	\L_00b07:
	\L_00afa:
	\L_009e2:
	ZH 1:
	'Ra ngoài ngay.'
	\L_00b07:
	\L_00afa:
	\L_00a52:
	ZH 1:
	'Chắc chắn,'
	R
	'chắc chắn. Gọi lại cho tôi'
	R
	'lần sau khi bạn muốn tôi.'
	\L_00b07:
	ZH 1:
	'Tôi rất thích'
	R
	'làm việc cho bạn. vì vậy,'
	R
	'hẹn gặp lại. Giữ sức khỏe.'
	\L_00b07:
	\L_00afa:
	\L_00ab4:
	\L_00a8a:
	ZH 1:
	'Louis rời đi.'
	\L_00b07:
	\L_00afa:
	\L_009e2:
	ZH 1:
	'Này, Maris.'
	\L_00b07:
	\L_00afa:
	!VAR0516 : 6!
	\L_00aa6:
	\L_00a52:
	ZH 1:
	'Vâng?'
	\L_00b07:
	\L_00afa:
	\L_009e2:
	ZH 1:
	'Hãy chắc chắn rằng'
	R
	'phòng của anh ấy đã được'
	R
	'khử trùng.Anh ấy bẩn thỉu.'
	\L_00b07:
	\L_00afa:
	\L_00a52:
	ZH 1:
	'Vâng, hiểu rồi.'
	\L_00b07:
