	\L_02144:
	\L_02128:
	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng ngủ của Rance'
	R
	'Rance đang đợi Shariela.'
	\L_02215:
	\L_02208:
	\L_0210c:
	ZH 1:
	'Muộn...'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Xin lỗi'
	R
	'thiếp... ra rồi muộn!'
	\L_02215:
	\L_02208:
	!VAR0516 : 22!
	\L_021b4:
	\L_020f0:
	ZH 1:
	'Sao lâu thế nhỉ?!'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Tôi rất xin'
	R
	'lỗi.Tôi đang bị phân'
	R
	'tâm bởi một thứ khác...'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Cái gì?'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Ảo ảnh kỳ diệu...'
	R
	'Tôi chưa bao giờ thấy'
	R
	'thứ gì giống như vậy...'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Ảo giác...?'
	\L_02215:
	\L_02208:
	\L_0210c:
	ZH 1:
	'Tôi đoán đó là vì cô'
	R
	'ấy không có trái tim khi'
	R
	'còn là một con búp bê...'
	\L_02215:
	ZH 1:
	'Cô ấy không thể không'
	R
	'quan tâm đến mọi thứ.'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Lần này tôi'
	R
	'sẽ tha thứ cho bạn.Lần'
	R
	'sau hãy cẩn thận hơn.'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Được rồi!'
	\L_02215:
	ZH 1:
	'TV khá thú'
	R
	'vị đấy, King Rance.À, tôi'
	R
	'cũng học được từ “thú vị”.'
	\L_02215:
	ZH 1:
	'Khi còn là búp'
	R
	'bê, tôi có thể phân biệt'
	R
	'giữa các chương trình,'
	\L_02215:
	ZH 1:
	'nhưng mãi đến gần đây'
	R
	'tôi mới hiểu được chúng...'
	\L_02215:
	\L_02208:
	\L_020f0:
	ZH 1:
	'Agh, thế là đủ'
	R
	'rồi.Chỉ cần đến đây.'
	\L_02215:
	\L_02208:
	\L_02160:
	ZH 1:
	'Được rồi!'
	\L_02215:
	\L_02208:
	PF1 VAR0056:
	SS 0:
	G 806:
	G 121:
	SS 24:
	\L_021d0:
	ZH 1:
	'Rance 「Được rồi, cởi'
	R
	'quần áo ra.Đặt háng của'
	R
	'ngươi lên trên mặt ta.」'
	PF0 VAR0056:
	\L_02215:
	ZH 1:
	'Shariela 「Bạn có'
	R
	'chắc không?Tôi có thể làm'
	R
	'rất nhiều thứ cho bạn. 」'
	\L_02215:
	ZH 1:
	'Rance 「Hôm nay ta muốn'
	R
	'làm vài việc cho ngươi.Hãy'
	R
	'làm những gì ta bảo cậu.」'
	\L_02215:
	ZH 1:
	'Shariela 「Được rồi...」'
	\L_02215:
	ZH 1:
	'Shariela đặt'
	R
	'âm hộ của mình trần'
	R
	'trụi trên mặt Rance.'
	\L_02215:
	ZH 1:
	'Shariela 「Vì lý'
	R
	'do nào đó... Điều này'
	R
	'làm tôi căng thẳng.」'
	\L_02215:
	ZH 1:
	'Rance 「Không'
	R
	'sao đâu.Còn tốt hơn là'
	R
	'không quan tâm chút nào.」'
	\L_02215:
	ZH 1:
	'Rance ôm'
	R
	'chặt lấy mông Shariela và lè'
	R
	'lưỡi về phía âm hộ của cô.'
	\L_02215:
	ZH 1:
	'Shariela 「C...!」'
	\L_02215:
	ZH 1:
	'Hông của'
	R
	'Shariela giật nảy lên.'
	\L_02215:
	ZH 1:
	'Shariela 「À... Bệ hạ...」'
	\L_02215:
	ZH 1:
	'Lưỡi của Rance cọ'
	R
	'vào nếp gấp của Shariela.'
	\L_02215:
	ZH 1:
	'Shariela 「À... À...」'
	\L_02215:
	ZH 1:
	'Shariela quan sát'
	R
	'Rance từ trên cao.'
	\L_02215:
	ZH 1:
	'Rance đẩy lưỡi vào'
	R
	'âm hộ của Shariela.'
	\L_02215:
	ZH 1:
	'Shariela 「Ừm...!!」'
	\L_02215:
	ZH 1:
	'Cơ thể Shariela rung'
	R
	'chuyển mạnh.Rance ôm chặt'
	R
	'cô và lè lưỡi vào sâu hơn.'
	\L_02215:
	ZH 1:
	'Shariela 「À, à à...」'
	\L_02215:
	ZH 1:
	'Thân mình của'
	R
	'Shariela rơi xuống giường.'
	\L_02215:
	ZH 1:
	'Shariela 「Dừng'
	R
	'lại, thưa Bệ hạ... Nếu'
	R
	'ngài làm vậy, tôi...」'
	\L_02215:
	ZH 1:
	'Rance gặm âm'
	R
	'vật của Shariela.'
	\L_02215:
	ZH 1:
	'Shariela 「Aah!!」'
	\L_02215:
	ZH 1:
	'Shariela nắm chặt tấm'
	R
	'ga trải giường và run'
	\L_02215:
	ZH 1:
	'lên vì khoái cảm'
	R
	'chạy dọc sống lưng.'
	\L_02215:
	ZH 1:
	'Rance 「Hãy cứ như'
	R
	'vậy nhé.Đừng di chuyển...」'
	\L_02215:
	ZH 1:
	'Rance bước ra từ'
	R
	'dưới Shariela và đẩy'
	\L_02215:
	ZH 1:
	'hoàn toàn siêu vũ khí'
	R
	'của mình vào cô từ phía sau.'
	\L_02215:
	ZH 1:
	'Shariela 「Aaaaaaah...!」'
	\L_02215:
	ZH 1:
	'Shariela hét lên.'
	\L_02215:
	ZH 1:
	'Rance 「Hồ...!」'
	\L_02215:
	ZH 1:
	'Shariela 「Ahn!」'
	\L_02215:
	ZH 1:
	'Rance nắm lấy'
	R
	'cánh tay của Shariela'
	R
	'và ép cô ấy đứng dậy.'
	\L_02215:
	ZH 1:
	'Shariela 「À... Aah...」'
	\L_02215:
	ZH 1:
	'Rance 「Tốt, Shariela.」'
	\L_02215:
	ZH 1:
	'Shariela 「Ừm... Mmmmmm!」'
	\L_02215:
	ZH 1:
	'Shariela đã cố gắng'
	R
	'hết sức có thể để siết'
	\L_02215:
	ZH 1:
	'chặt và di chuyển'
	R
	'hông của mình cùng với'
	R
	'chuyển động của Rance.'
	\L_02215:
	ZH 1:
	'Shariela 「À...'
	R
	'Bệ hạ... Bệ hạ!」'
	\L_02215:
	ZH 1:
	'Shariela lắc'
	R
	'đầu và thở hổn hển.'
	\L_02215:
	ZH 1:
	'Rance 「Kh... Cậu chặt'
	R
	'quá đấy, Shariela.Nếu ngươi'
	R
	'siết chặt ta như thế ... 」'
	\L_02215:
	ZH 1:
	'Shariela 「C... Aaaaaaah...!」'
	\L_02215:
	ZH 1:
	'Shariela run rẩy.'
	\L_02215:
	ZH 1:
	'Rance 「Kh...!」'
	\L_02215:
	ZH 1:
	'Bên trong Shariela'
	R
	'co bóp mạnh hơn trước,'
	R
	'đưa Rance lên cực khoái.'
	\L_02215:
