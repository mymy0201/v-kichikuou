		\L_028dc:
		\L_028cf:
		\L_0285f:
		ZH 1:
		'RÕ!!'
		\L_028dc:
		ZH 1:
		'Tiếng hô ồm ồm của đám đàn'
		R
		'ông đồng loạt vang lên.'
		\L_028dc:
		\L_028cf:
		\L_027b7:
		ZH 1:
		'Lần này, ta đánh vào thành'
		R
		'phố. Trong thành phố có'
		R
		'nhiều tiền hơn.'
		\L_028dc:
		\L_028cf:
		\L_0285f:
		ZH 1:
		'Ồ!!'
		\L_028dc:
		\L_028cf:
		\L_027b7:
		ZH 1:
		'Trong thị trấn có gái đẹp'
		R
		'hơn.'
		\L_028dc:
		\L_028cf:
		\L_0285f:
		ZH 1:
		'Ồ!'
		\L_028dc:
		\L_028cf:
		\L_027b7:
		ZH 1:
		'Tuy nhiên, các thành phố'
