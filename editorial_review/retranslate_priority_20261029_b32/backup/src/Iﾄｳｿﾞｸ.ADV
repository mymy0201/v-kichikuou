		\L_028dc:
		\L_028cf:
		\L_027b7:
		ZH 1:
		'Nhưng cứ sợ thì còn gì vui!'
		R
		'Có ta đây rồi.'
		\L_028dc:
		ZH 1:
		'Cứ yên tâm!!'
		\L_028dc:
		\L_028cf:
		\L_0285f:
		ZH 1:
		'Ồ!'
		\L_028dc:
		\L_028cf:
		\L_027b7:
		ZH 1:
		'Đi thôi!!'
		\L_028dc:
