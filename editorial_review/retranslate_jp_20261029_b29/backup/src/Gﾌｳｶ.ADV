	{VAR0000 = 2:
		\L_054cd:
		\L_053b5:
		ZH 1:
		'Hửm? “Cát”... à.'
		\L_054da:
		\L_054cd:
		\L_053ed:
		ZH 1:
		'Rance có vẻ không hào hứng'
		R
		'lắm. Thấy vậy, Fuuka nói.'
		\L_054da:
		\L_054cd:
		\L_05425:
		ZH 1:
		'Ngài Rance, đừng coi thường'
