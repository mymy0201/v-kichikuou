	\L_054b1:
	\L_053ed:
	ZM 32:
	ZH 1:
	'Nagasaki'
	R
	ZM 24:
	ZH 1:
	R
	'Đền Thờ Bên Ngoài Thị Trấn'
	\L_054da:
	\L_054cd:
	!VAR0516 : 100!
	\L_05479:
	\L_05425:
	ZH 1:
	'À...'
	\L_054da:
	\L_054cd:
	\L_053ed:
	ZH 1:
	'Fuuka nhìn thấy Rance'
	R
	'đang leo lên cầu thang và cố'
	R
	'gắng chạy về phía ngôi đền.'
	\L_054da:
	\L_054cd:
	!VAR0516 : 1!
	\L_05409:
	\L_053b5:
	ZH 1:
	'Đừng chạy!'
	\L_054da:
	ZH 1:
	'rance chạy lên cầu'
	R
	'thang một cách điên cuồng và'
	R
	'nắm lấy cánh tay của nàng.'
	\L_054da:
	ZH 1:
	'tại sao?! Tại'
	R
	'sao em đang chạy!?'
	\L_054da:
	\L_054cd:
	\L_05425:
	ZH 1:
	'Bởi vì...'
	\L_054da:
	\L_054cd:
	\L_053ed:
	ZH 1:
	'Fuuka nhìn đi chỗ khác.'
	\L_054da:
	\L_054cd:
	\L_05425:
	ZH 1:
	'Vì những gì anh'
	R
	'đã làm với tôi...'
	\L_054da:
	ZH 1:
	'Và tôi cũng không thích'
	R
	'việc anh nói về điều đó.'
	\L_054da:
	\L_054cd:
	\L_053b5:
	ZH 1:
	'Có lẽ ta không nên'
	R
	'la hét về điều đó,'
	\L_054da:
	ZH 1:
	'nhưng chỉ'
	R
	'điều đó thôi không khiến'
	R
	'ta trở thành người xấu.'
	\L_054da:
	ZH 1:
	'Ta đã cứu mạng'
	R
	'em, rõ ràng em nợ ta.'
	\L_054da:
	\L_054cd:
	\L_05425:
	ZH 1:
	'...'
	\L_054da:
	\L_054cd:
	\L_053ed:
	ZH 1:
	'Fuuka tiếp tục'
	R
	'cúi đầu và im lặng.'
	\L_054da:
	\L_054cd:
	\L_053b5:
	ZH 1:
	'Ch.'
	\L_054da:
	\L_054cd:
	\L_05417:
	\L_053ed:
	ZH 1:
	'Rance buông Tay Fuuka'
	R
	'và rời khỏi đền thờ với một'
	R
	'hương vị xấu trong miệng.'
	\L_054da:
	\L_054cd:
	\L_05425:
	ZH 1:
	'Vua Rance...'
	\L_054da:
	\L_054cd:
	\L_053ed:
	ZH 1:
	'Có một chút cô đơn trong Mắt'
	R
	'Fuuka khi cô nhìn lưng Rance'
	R
	'biến mất vào khoảng cách.'
	\L_054da:
	\L_054cd:
	\L_05487:
