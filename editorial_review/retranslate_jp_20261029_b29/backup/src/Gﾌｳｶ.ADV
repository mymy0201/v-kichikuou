	}
	{VAR0000 = 3:
		\L_054cd:
		\L_053b5:
		ZH 1:
		'Hừ... Gì đây, “Hung” á?'
		\L_054da:
		\L_054cd:
		\L_053ed:
		ZH 1:
		'Fuuka che miệng, có phần ái'
