	\L_05d78:
	\L_05cd0:
	ZH 1:
	'Chết... Bệ hạ!!'
	\L_05d85:
	\L_05d78:
	\L_05c60:
	ZH 1:
	'Ta nghe hết chuyện vừa rồi.'
	\L_05d85:
	ZH 1:
	'Nếu những tin'
