	\L_05d78:
	\L_05cd0:
	ZH 1:
	'Ơ... Ủa? A...!'
	\L_05d85:
	\L_05d78:
	\L_05d08:
	ZH 1:
	'Thanh kiếm cắm xuống đất,'
