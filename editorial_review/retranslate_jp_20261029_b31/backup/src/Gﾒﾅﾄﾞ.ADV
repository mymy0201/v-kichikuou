	\L_05d85:
	\L_05d78:
	\L_05cd0:
	ZH 1:
	'Ahahahaha.'
	\L_05d85:
	\L_05d78:
	\L_05c60:
	ZH 1:
	'Cứ giữ tinh thần'
	R
	'ấy mà cố gắng nhé.'
