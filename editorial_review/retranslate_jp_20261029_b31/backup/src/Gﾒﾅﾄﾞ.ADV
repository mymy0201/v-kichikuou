	'chia tay không, Menad?'
	\L_05d85:
	\L_05d78:
	\L_05c60:
	ZH 1:
	'Zarak?'
	\L_05d85:
	\L_05d78:
	\L_05cd0:
	ZH 1:
	'Hãy quên tôi'
