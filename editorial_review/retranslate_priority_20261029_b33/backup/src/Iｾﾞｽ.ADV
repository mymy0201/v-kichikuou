	\L_077f1:
	ZH 1:
	'Em gửi ý niệm báo “Ngài'
	R
	'Chizuko cho gọi” rồi tới'
	R
	'nơi,'
	\L_077f1:
	ZH 1:
	'nhưng phòng trống không!'
	\L_077f1:
	\L_077e4:
	\L_076cc:
	ZH 1:
	'............'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'（Bốp!）'
	\L_077f1:
	\L_077e4:
	\L_0773c:
	ZH 1:
	'À...!'
	\L_077f1:
	\L_077e4:
	!VAR0516 : 0!
	%#M.ADV:
	SS VAR0515:
	%0:
*L_04de4:
	!VAR0158 : 65!
	!VAR0045 : VAR0142!
	!VAR0046 : VAR0143!
	!VAR0516 : 1!
	%#M.ADV:
	!VAR0043 : VAR0045!
	!VAR0044 : VAR0046!
