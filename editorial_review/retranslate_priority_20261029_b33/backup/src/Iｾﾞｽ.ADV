		R
		'ừm... ... Xin chúc mừng.'
		\L_077f1:
		\L_077e4:
	}
	\L_076cc:
	ZH 1:
	'Ừ. Lại tiến thêm một bước'
	R
	'tới tham vọng của ta.'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Chinh phục'
	R
	'Vương quốc Zeth.'
