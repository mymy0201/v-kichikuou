	\L_077e4:
	\L_076cc:
	ZH 1:
	'Uspira...'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Anh mở hộp.'
	\L_077f1:
	ZH 1:
	'Viên'
