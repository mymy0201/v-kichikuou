		\L_077f1:
		\L_077e4:
		\L_0773c:
		ZH 1:
		'Được rồi, sữa.'
		\L_077f1:
		\L_077e4:
		\L_0779e:
		\L_07704:
		ZH 1:
		'Sill đi lấy sữa.'
