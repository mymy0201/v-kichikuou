	\L_077e4:
	\L_076cc:
	ZH 1:
	'Cái gì...!?'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Chizuko loạng'
	R
	'choạng lùi về phía sau'
