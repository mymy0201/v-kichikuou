	\L_05eb2:
	\L_05e5e:
	ZH 1:
	'Camilla...'
	\L_05f13:
	\L_05f06:
	\L_05e26:
	ZH 1:
	'Kayblis nhìn Camilla,'
	R
	'mắt long lanh như'
	R
	'nhìn vật yêu dấu.'
	\L_05f13:
	ZH 1:
	'Hắn vươn tay.'
	\L_05f13:
	ZH 1:
	'(Bốp!)'
	\L_05f13:
	\L_05f06:
	\L_05ec0:
	!VAR0516 : 442!
	\L_05eb2:
	\L_05e5e:
	ZH 1:
