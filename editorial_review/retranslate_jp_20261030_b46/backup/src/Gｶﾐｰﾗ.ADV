	{VAR0690 = 1:
		PF1 VAR0056:
		G 806:
		\L_05ece:
		ZH 1:
		'Giọng chàng trai 「Aah...」'
		PF0 VAR0056:
		\L_05f13:
		ZH 1:
		'Giọng nam 「Aah... Cô Camilla...」'
		\L_05f13:
		G 204:
		SS 17:
		ZH 1:
		'căn phòng được bao phủ bởi rèm cửa nhiều màu.'
		\L_05f13:
*L_03c0a:
		ZH 1:
		'rèm cửa tiếp tục lên xung quanh'
		R
		'cầu thang được lắp đặt trong phòng,'
		\L_05f13:
		ZH 1:
		'ở trên cùng là một tấm đệm'
		R
		'làm bằng vải chất lượng cao.'
		\L_05f13:
		ZH 1:
		'Hơn hết, lạnh hơn băng, đẹp hơn'
		R
		'hoa, Camilla ngồi khỏa thân.'
		\L_05f13:
		ZH 1:
		'Các chàng trai tụ tập quanh cô. Họ'
		R
		'là những nạn nhân của cô đã bị cô mê'
		\L_05f13:
		ZH 1:
		'hoặc đến mức không thể thoát ra được.'
		\L_05f13:
		ZH 1:
		'Cậu Bé Tóc Bạc 「Aah... Cô'
		R
		'Camilla... Tóc của cậu rất đẹp...」'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc vàng 「Cô Camilla...'
		R
		'Hôm nay tôi hát cho cậu nghe nhé?」'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc hồng 「Aah...'
		R
		'Cô Camilla... Cô Camilla...」'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc xanh 「... À...」'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc nâu 「... Ừm...」'
		\L_05f13:
		ZH 1:
		'Không Giống như những cậu bé khác,'
		\L_05f13:
		ZH 1:
		'những cậu bé tóc xanh và'
		R
		'nâu không chắc phải làm gì.'
		\L_05f13:
		ZH 1:
		'Họ chưa quen với hậu cung này.'
		\L_05f13:
		ZH 1:
		'Nhưng vì lý do đó mà cơ thể của chúng'
		R
		'phản ứng nhiều hơn những con khác,'
		\L_05f13:
		ZH 1:
		'và những cự vật còn non nớt của'
		R
		'chúng cứng đờ một cách đau đớn.'
		\L_05f13:
		ZH 1:
		'Camila 「............」'
		\L_05f13:
		ZH 1:
		'Camilla từ từ duỗi chân về'
		R
		'phía chàng trai tóc xanh.'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc xanh 「À...!!」'
		\L_05f13:
		ZH 1:
		'Chân của Camilla tóm lấy'
		R
		'cự vật cứng ngắc của cậu bé'
		\L_05f13:
		ZH 1:
		'và từ từ di chuyển lên xuống chỉ một lần.'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc xanh 「Aaaaaaaaah...!!」'
		R
		'điều đó một mình khiến cậu bé tóc'
		\L_05f13:
		ZH 1:
		'xanh đạt cực khoái trên đỉnh Chân Camilla.'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc xanh 「À... tôi...」'
		\L_05f13:
		ZH 1:
		'Camila 「............」'
		\L_05f13:
		ZH 1:
		'(ptssh)'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc xanh 「A... Aaaahn!」'
		\L_05f13:
		ZH 1:
		'Camilla tát vào má cậu bé.'
		R
		'Ngay cả khi gục xuống sàn,'
		\L_05f13:
		ZH 1:
		'hắn vẫn lên đỉnh chỉ sau cú chạm của Camilla.'
		\L_05f13:
		ZH 1:
		'Camilla 「... Làm sạch đi...」 nàng'
		\L_05f13:
		ZH 1:
		'đưa chân bẩn của mình ra cho cậu bé tóc nâu.'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc nâu 「Huh...?」'
		\L_05f13:
		ZH 1:
		'Anh nhìn Camilla với đôi mắt ướt đến mức mờ đi.'
		\L_05f13:
		ZH 1:
		'Nhưng đôi mắt của Camilla rất kiên quyết và cô'
		\L_05f13:
		ZH 1:
		'không hề có ý định lắng nghe hy vọng của cậu bé.'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc nâu 「C-Cảm ơn cậu...'
		\L_05f13:
		ZH 1:
		'Tôi rất vui khi được chạm vào'
		R
		'chân cậu...」 cậu bé tóc nâu'
		\L_05f13:
		ZH 1:
		'run rẩy trong khi nhẹ nhàng chạm Vào Chân Camilla.'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc nâu 「A... Ahn!」'
		R
		'cơ thể cậu bé tóc nâu run rẩy.'
		\L_05f13:
		ZH 1:
		'Chỉ cần từ đầu ngón tay chạm Vào Chân Camilla,'
		\L_05f13:
		ZH 1:
		'hắn đã lên đến đỉnh điểm với niềm vui lạ thường.'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc nâu 「À...'
		\L_05f13:
		ZH 1:
		'Ahn...」 cậu bé tóc nâu run rẩy'
		R
		'vì thích Thú khi Bị Camilla đánh,'
		\L_05f13:
		ZH 1:
		'và tinh dịch của Cậu làm bẩn khuôn mặt'
		R
		'của cậu bé tóc xanh nằm trên sàn nhà.'
		\L_05f13:
		ZH 1:
		'Camilla 「... Heh... Heheh...」'
		\L_05f13:
		ZH 1:
		'Camilla cười tinh tế khi nhìn thấy nó.'
		\L_05f13:
		ZH 1:
		'Camilla 「... Các chàng trai ngoan...'
		R
		'Bây giờ, nữa... Không để ta chán...」'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc vàng 「... Vâng, thưa cô Camilla...'
		\L_05f13:
		ZH 1:
		'Nếu là vì cô, tôi sẽ làm bất cứ điều gì...」'
		\L_05f13:
		ZH 1:
		'Chàng trai tóc hồng 「Tôi cũng vậy...」'
		\L_05f13:
		ZH 1:
		'Tôi thậm chí sẽ quan hệ tình dục với một người'
		\L_05f13:
		ZH 1:
		'phụ nữ bẩn thỉu khác nếu tôi phải làm vậy...」'
		\L_05f13:
		ZH 1:
		'Cậu Bé Tóc Bạc 「tôi đã tự cắt tay mình...」'
		\L_05f13:
		ZH 1:
		'Nếu Cô Camilla cũng muốn tôi,'
		R
		'tôi sẽ cười khi làm điều đó...」'
		\L_05f13:
		ZH 1:
		'Camilla 「... Heh...'
		\L_05f13:
		ZH 1:
		'Gahahahaha!...」 tiếng nói mê hoặc'
		R
		'của các chàng trai tiếp tục lần lượt,'
		\L_05f13:
		ZH 1:
		'không ngừng như nước từ suối, tràn ngập căn phòng.'
		\L_05f13:
