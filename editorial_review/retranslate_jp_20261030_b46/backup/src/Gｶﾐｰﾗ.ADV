		\L_05eea:
		!VAR0516 : 247!
		\L_05e42:
		\L_05e26:
		ZM 32:
		ZH 1:
		'Nơi ẩn náu trên núi'
		R
		ZM 24:
		ZH 1:
		R
		'Chỗ ẩn náu Camilla.'
		R
		'Kaybnyan「Nyaaan!! Đến'
		R
		'rồi! Mở ra, Reincock!!」'
		\L_05f13:
		\L_05f06:
		\L_05e26:
		ZH 1:
		'Kaybnyan cào cửa chỗ'
		R
		'ẩn náu để mài móng.'
		\L_05f13:
		\L_05f06:
		!VAR0516 : 442!
		\L_05eb2:
		\L_05e5e:
		ZH 1:
		'Áá!! Làm gì cửa nhà người'
		R
		'ta thế!! Đồ mèo ngốc!'
		\L_05f13:
		\L_05f06:
		\L_05dee:
		ZH 1:
		'Ồn quá, chỉ ngài Lis'
		R
		'được sai bảo nyan thôi.'
		\L_05f13:
		ZH 1:
		'Thư của ngài Lis đây,'
		R
		'bảo Camilla ngoáy'
		R
		'tai nghe cho kỹ nyan.'
		\L_05f13:
		\L_05f06:
		\L_05e5e:
		ZH 1:
		'Phải nói bao lần nữa!! Đã'
		R
		'bảo đừng gọi tên trống không'
		\L_05f13:
		ZH 1:
		'với ngài Camilla cơ mà!!'
		\L_05f13:
		ZH 1:
		'Với lại, đến trong tai'
		R
		'người cũng sạch sẽ đấy!!'
		\L_05f13:
		\L_05f06:
		\L_05e26:
		ZH 1:
		'Nhưng Kaybnyan không nghe'
		R
		'lời phàn nàn của Reincock.'
		\L_05f13:
		ZH 1:
		'Nó vừa ngân nga vừa lục'
		R
		'bên trong áo choàng.'
		\L_05f13:
		\L_05f06:
		\L_05dee:
		ZH 1:
		'Hừm hưm~. Nyan đi giao'
		R
		'thư~, thư ngài Lis~.'
		R
		'Cất đâu rồi nyan~?'
		\L_05f13:
		ZH 1:
		'To quá nên chắc chắn'
		R
		'đã cầm thế này...'
		\L_05f13:
		ZH 1:
		'...Đã cầm...'
		\L_05f13:
		ZH 1:
		'Nyaaaa!! Làm mất thư'
		R
		'ngài Lis rồi nyan!!'
		\L_05f13:
		ZH 1:
		'Tại con gấu nyan!?'
		\L_05f13:
		ZH 1:
		'Con gấu có lỗi nyan!'
		R
		'Nhưng, nhưng, làm'
		R
		'sao đây, Reincock~~!!'
		\L_05f13:
		\L_05f06:
		\L_05e5e:
		ZH 1:
		'Sao ta phải lo chuyện'
		R
		'ấy cho ngươi chứ!'
		\L_05f13:
		\L_05f06:
		\L_05dee:
		ZH 1:
		'Híí, không, lộ ra thì ngài'
		R
		'Lis giết nyan mất! Làm'
		R
		'sao đây... (Cuống quýt.)'
		\L_05f13:
		\L_05f06:
		\L_05e5e:
		ZH 1:
		'Đồ ngốc. Dù sao ngài'
		R
		'Camilla cũng chẳng bao giờ'
		R
		'hồi âm cho ngài Kayblis.'
		\L_05f13:
		ZH 1:
		'Cứ báo không nhận được thư'
		R
		'trả lời là xong chứ gì.'
		\L_05f13:
		\L_05f06:
		\L_05dee:
		ZH 1:
		'À, ra vậy... Reincock'
		R
		'cũng tốt bụng ghê nyan.'
		\L_05f13:
		\L_05f06:
		\L_05e5e:
		ZH 1:
		'Hừ. Ta chỉ nói'
		R
		'đúng sự thật thôi!'
		\L_05f13:
		\L_05f06:
		\L_05e26:
		ZH 1:
		'Thế là Kaybnyan lấp'
		R
		'liếm nhiệm vụ của mình.'
		\L_05f13:
		ZH 1:
		'Bức thư tình Kayblis dồn'
		R
		'hết tâm huyết viết sẽ'
		R
		'chẳng đến mắt Camilla...'
		\L_05f13:
		\L_05f06:
	}
