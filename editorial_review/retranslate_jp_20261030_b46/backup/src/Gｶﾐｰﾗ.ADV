	'sau một bức màn và bị buộc'
	\L_05f13:
	ZH 1:
	'tội với một thanh'
	R
	'kiếm chỉ Vào Rance.'
	\L_05f13:
	\L_05f06:
	\L_05dee:
	ZH 1:
	'Whoa, bây giờ.'
	\L_05f13:
