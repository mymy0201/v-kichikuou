		'thư cho Camilla. Ngài'
		R
		'Lis nổi giận mất nyan.'
		\L_05f13:
		ZH 1:
		'Phù, nguy hiểm'
		R
		'thật đấy nyan...'
		\L_05f13:
		\L_05f06:
		\L_05e26:
		ZH 1:
		'Bỏ lại con gấu đã'
		R
		'chết, Kaybnyan tới'
		R
		'chỗ ẩn náu Camilla...'
		\L_05f13:
		\L_05f06:
