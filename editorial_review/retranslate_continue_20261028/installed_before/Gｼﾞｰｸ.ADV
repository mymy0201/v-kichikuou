	'đây!! Đỡ này!!'
	\L_02515:
	\L_02508:
	\L_023f0:
	ZH 1:
	'Kh...'
	\L_02515:
	\L_02508:
	\L_02452:
	\L_02460:
	ZH 1:
	'À!? Ngươi đã đi'
