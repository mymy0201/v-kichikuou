	\L_0226b:
	\L_021df:
	ZH 1:
	'Rance đang'
	R
	'nằm và Shariela đang bám'
	R
	'chặt vào bên cạnh anh.'
	\L_022cc:
	\L_022bf:
	\L_021a7:
	ZH 1:
	'Khò... khò...'
	\L_022cc:
	\L_022bf:
	\L_021df:
	ZH 1:
	'Rance ngáy to,'
	R
	'cơ thể và tâm hồn anh'
	R
	'hoàn toàn sảng khoái.'
	\L_022cc:
	ZH 1:
	'Shariela quan'
	R
	'sát anh thật kỹ.'
	\L_022cc:
	\L_022bf:
	\L_02217:
	ZH 1:
	'Ngài Rance...'
	\L_022cc:
	\L_022bf:
	\L_0224f:
	ZH 1:
	'Shariela nhẹ nhàng'
	R
	'chọc vào má Rance.'
	\L_022cc:
	\L_022bf:
	\L_021a7:
	ZH 1:
	'Guh... Zzzzzz...'
	\L_022cc:
	\L_022bf:
	\L_02217:
	ZH 1:
	'Huhu...'
	\L_022cc:
	\L_022bf:
	\L_0224f:
	ZH 1:
	'Shariela cười vui vẻ'
	R
	'và cũng nhắm mắt lại.'
	\L_022cc:
