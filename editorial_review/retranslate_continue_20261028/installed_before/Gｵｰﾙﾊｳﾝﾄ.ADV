	\L_0102c:
	\L_00fe6:
	\L_00f4c:
	ZH 1:
	'Rance giáng một đòn chí mạng'
	R
	'xuống Olhound.'
	\L_01039:
	\L_0102c:
	\L_00f14:
	ZH 1:
	'Hừ. Lỡ tay chém một kẻ'
