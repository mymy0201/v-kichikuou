	%0:
*L_020a9:
	!VAR0649 : 100!
	\L_023ea:
	ZH 1:
	'Ta quyết rồi. Lão già, lão'
	R
	'bị tử hình.'
	\L_0250f:
	ZH 1:
	'Sống lâu vậy'
	\L_0250f:
	ZH 1:
	'chắc chẳng còn gì luyến tiếc'
	R
	'nữa.'
	\L_0250f:
	\L_02502:
	\L_0245a:
	ZH 1:
	'............'
	\L_0250f:
	\L_02502:
	\L_023ea:
	ZH 1:
	'Maris! Mau giải lão đi.'
	\L_0250f:
	\L_02502:
	\L_024bc:
	!VAR0516 : 6!
	\L_024ae:
	\L_0245a:
	ZH 1:
	'Thần tuân lệnh.'
	\L_0250f:
	\L_02502:
	\L_02492:
	ZH 1:
	'Theo lệnh của Maris,'
	R
	'Lelyukov bị lính Leazas'
	R
	'đưa đến nơi hành quyết.'
	\L_0250f:
	\L_02502:
	\L_0244c:
	\L_024bc:
	\L_02492:
	ZH 1:
	R
	'.........'
	\L_0250f:
	ZH 1:
	R
	'......'
	\L_0250f:
	ZH 1:
	R
	'...'
	\L_0250f:
	ZH 1:
	'Lelyukov Berkov bị quân'
	R
	'Leazas xử tử.'
	\L_0250f:
	\L_02502:
	!VAR0516 : 0!
	%#M.ADV:
