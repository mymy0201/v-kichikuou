	'rằng chị thích anh Rick.'
	\L_07c33:
	\L_07c26:
	\L_07b0e:
	ZH 1:
	'Không phải.'
	\L_07c33:
	\L_07c26:
	\L_07b7e:
	ZH 1:
	'Thế tại sao chị'
