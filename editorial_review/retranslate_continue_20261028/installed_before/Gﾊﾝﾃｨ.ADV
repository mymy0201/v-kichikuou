		R
		'hay?」'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Thuở nhỏ, Patton cũng từng'
		R
		'nói vậy với tôi...'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'...Từ nay,'
		\L_010f8:
		ZH 1:
		'trước mặt cô, ta tuyệt đối'
		R
		'không nói câu ấy nữa.'
		\L_010f8:
		ZH 1:
		'Gì vậy chứ... Tùy cậu.'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Hừm, ta sẽ làm vậy.'
		\L_010f8:
		\L_010eb:
		\L_010a5:
		!VAR0516 : 6!
		\L_01097:
