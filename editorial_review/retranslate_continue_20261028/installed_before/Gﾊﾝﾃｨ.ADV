		\L_010cf:
		!VAR0516 : 1!
		\L_01027:
		!VAR0516 : 424!
		\L_01097:
		\L_0100b:
		ZM 32:
		ZH 1:
		'Thành Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến. Cậu tìm tôi'
		R
		'có việc gì?'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Ừ, muốn hỏi một chuyện.'
		\L_010f8:
		ZH 1:
		'Cô thật lòng yêu Patton sao?'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'............'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Nếu không thì theo ta. Ta sẽ'
		R
		'quý trọng cô.'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Nếu tôi yêu Patton thì cậu'
		R
		'chịu bỏ cuộc dễ dàng sao?'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Đàn ông tốt đâu ép buộc phụ'
		R
		'nữ.'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Vậy...'
		\L_010f8:
		ZH 1:
		'Hanty「Vậy mong cậu bỏ'
		R
		'cuộc.」 Rance「Biết ngay'
		R
		'mà.」'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Vậy thì...'
		\L_010f8:
		ZH 1:
		'Một lần thôi cũng được, cho'
		R
		'ta làm tình với em đi.'
		\L_010f8:
		ZH 1:
		'Ta sẽ đưa em lên thiên'
		R
		'đường. Gahahahaha!'
		\L_010f8:
		ZH 1:
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Chết tôi cũng không chịu.'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Patton có ra sao thì em'
		R
		'cũng mặc kệ à?'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Cùng lắm tôi dẫn Patton'
		R
		'rời khỏi đây là xong!'
		\L_010f8:
		\L_010eb:
		\L_010a5:
		!VAR0516 : 6!
		\L_01097:
		\L_01043:
		ZH 1:
		'Bệ hạ Rance...'
		\L_010f8:
		\L_010eb:
		\L_0100b:
		ZH 1:
		'Maris thì thầm với Rance.'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Theo điều tra, cô ấy có khả'
		R
		'năng dịch chuyển tức thời.'
		\L_010f8:
		ZH 1:
		'Dù xảy ra chuyện gì cũng có'
		R
		'thể trốn đi...'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Phiền thật...'
		\L_010f8:
		ZH 1:
		'Vì thế lúc này,'
		\L_010f8:
		ZH 1:
		'để quân ngài Patton trở'
		R
		'thành'
		\L_010f8:
		ZH 1:
		'kẻ thù sẽ bất lợi cho chúng'
		R
		'ta...'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Ừm.'
		\L_010f8:
		ZH 1:
		'Hanty.'
		\L_010f8:
		\L_010eb:
		\L_010a5:
		!VAR0516 : 424!
		\L_01097:
		\L_01043:
		ZH 1:
		'Cái gì?'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Vừa rồi là nói dối. Ta chỉ'
		R
		'thử xem cô nghĩ gì về'
		R
		'Patton.'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Tôi không thích đùa ác. Đừng'
		R
		'thử'
		\L_010f8:
		ZH 1:
		'lòng như thế. Tình cảm tôi'
		\L_010f8:
		ZH 1:
		'dành cho Patton... con người'
		R
		'chẳng hiểu được đâu.'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Ta là anh hùng mà, ta hiểu'
		R
		'được đấy.'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'............'
		\L_010f8:
		\L_010eb:
		\L_010a5:
		\L_0107b:
		ZH 1:
		'Không nói thêm lời nào,'
		R
		'Hanty rảo bước rời trước'
		R
		'ngai vàng.'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Này! Ai cho cô đi hả?!'
		\L_010f8:
		\L_010eb:
		!VAR0516 : 6!
		\L_01097:
		\L_01043:
		ZH 1:
		'Bệ hạ Rance...'
		\L_010f8:
		ZH 1:
		'Chẳng phải cô ấy đã tỏ rõ'
		R
		'rằng không muốn nói về tình'
		R
		'cảm sao...?'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Thật tình... Đúng là cô nàng'
		R
		'ngỗ nghịch! Lẩm bẩm...'
		\L_010f8:
		\L_010eb:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
	{VAR0690 = 2:
		!VAR0516 : 0!
		%#M.ADV:
		!VAR0516 : 1046!
		\L_010cf:
		!VAR0516 : 1!
		\L_01027:
		!VAR0516 : 424!
		\L_01097:
		\L_0100b:
		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng diện kiến'
		\L_010f8:
		\L_010eb:
		\L_0100b:
		ZH 1:
		'Hanty đến theo lệnh'
		R
		'triệu tập của Rance.'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Này... Em vẫn còn trinh'
		R
		'phải không? Tinh thể trên'
		R
		'trán em có màu đỏ kìa.'
		\L_010f8:
		ZH 1:
		'Người Kalar tiện thật đấy.'
		R
		'Nhìn phát là biết ngay.'
		\L_010f8:
		ZH 1:
		'Gahahahaha!'
		\L_010f8:
		ZH 1:
		'Người Kalar còn trinh thì có'
		R
		'gì lạ đâu chứ.'
		\L_010f8:
		ZH 1:
		'Giữ gìn trinh tiết là điều'
		R
		'quan trọng nhất đối với'
		R
		'người Kalar chúng tôi mà.'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Ý em là phụ nữ loài người'
		R
		'thì không thế à?'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Tôi đâu có ý đó chứ!'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Nói gì thì nói, chắc em'
		R
		'đang để dành cho Patton'
		R
		'chứ gì.'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Đồ ngốc!!!!!'
		\L_010f8:
		\L_010eb:
		\L_010a5:
		\L_0107b:
		ZH 1:
		'Hanty hét lớn rồi giận dỗi'
		R
		'bỏ đi.'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'... Bộ trúng tim đen'
		R
		'rồi à...?'
		\L_010f8:
		\L_010eb:
		!VAR0516 : 6!
		\L_01097:
		\L_01043:
		ZH 1:
		'Cô ấy không có ý định quan'
		R
		'hệ nam nữ với ngài Patton'
		R
		'đâu ạ.'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Em nghe Hanty nói thế à?'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Dạ không.'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Thế sao em biết?'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Chỉ là cảm'
		\L_010f8:
		ZH 1:
		'giác...'
		\L_010f8:
		ZH 1:
		'Có người đàn ông khiến mình'
		R
		'muốn giữ quan hệ trong sáng'
		R
		'cũng đâu lạ...'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Ta chẳng hiểu nổi.'
		\L_010f8:
		ZH 1:
		'Thế là tốt rồi ạ. Nếu ngài'
		R
		'mà hiểu, thiếp sẽ gọi bác sĩ'
		R
		'ngay lập tức đấy.'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Em đang khen ta hay mỉa mai'
		R
		'ta đấy?'
		\L_010f8:
		\L_010eb:
		\L_01043:
		ZH 1:
		'Đâu có bên nào đâu ạ... Hi'
		R
		'hi...'
		\L_010f8:
		\L_010eb:
		\L_00fd3:
		ZH 1:
		'Hừ! Đàn bà các người cứ hở'
		R
		'ra là hùa nhau bắt nạt đàn'
		R
		'ông... Quá quắt thật.'
		\L_010f8:
		\L_010eb:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
