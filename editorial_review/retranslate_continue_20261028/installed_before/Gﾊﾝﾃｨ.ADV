		ZH 1:
		R
		'.........'
		\L_010f8:
		ZH 1:
		R
		'......'
		\L_010f8:
		ZH 1:
		R
		'...'
		\L_010f8:
		ZH 1:
		'Đã một giờ rồi... Hanty vẫn'
		R
