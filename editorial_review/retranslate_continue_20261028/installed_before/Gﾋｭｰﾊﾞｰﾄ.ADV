		\L_011c3:
		ZH 1:
		'Tôi nghĩ câu đó cũng đúng'
		R
		'với ngài đấy.'
		\L_01278:
		\L_0126b:
		\L_01153:
		ZH 1:
		'Cái gì!?'
		\L_01278:
		\L_0126b:
		\L_011c3:
		ZH 1:
		'Tôi muốn sống như ngài.'
		\L_01278:
		ZH 1:
		'Xin đừng phật ý, nhưng ngài'
		R
		'chẳng bị điều gì trói'
		R
		'buộc...'
		\L_01278:
		ZH 1:
		'Trông ngài thật tự do.'
		\L_01278:
		\L_0126b:
		\L_01153:
		ZH 1:
		'Hừm. Đoán vậy.'
		\L_01278:
		ZH 1:
		'Nhưng phải có tài năng như'
		R
		'ta mới sống thế được.'
		\L_01278:
		\L_0126b:
		\L_011c3:
		ZH 1:
		'Trung nghĩa, liều cả mạng'
		R
		'sống... Chẳng'
		\L_01278:
		ZH 1:
		'có thứ gì nhảm nhí bằng hiệp'
		R
		'sĩ.'
		\L_01278:
		\L_0126b:
		\L_01225:
		!VAR0516 : 6!
		\L_01217:
		\L_011c3:
		ZH 1:
		'Xin phép ngắt lời...'
		\L_01278:
		ZH 1:
		'Ngài Hubert, theo tôi, với'
		\L_01278:
		ZH 1:
		'ngài Patton chẳng có hiệp sĩ'
		R
		'nào đáng tin hơn ngài.'
		\L_01278:
		\L_0126b:
		\L_01225:
		!VAR0516 : 425!
		\L_01217:
		\L_011c3:
		ZH 1:
		'Không phải vì là hiệp sĩ.'
		R
		'Tôi ở'
		\L_01278:
		ZH 1:
		'bên vì chúng tôi là bạn'
		R
		'thân. Tôi không coi cậu'
		\L_01278:
		ZH 1:
		'ấy là chủ quân, cậu ấy cũng'
		\L_01278:
		ZH 1:
		'chẳng coi tôi là thuộc hạ'
		R
		'trung thành.'
		\L_01278:
		\L_0126b:
		\L_01225:
		!VAR0516 : 6!
		\L_01217:
		\L_011c3:
		ZH 1:
		'Theo tôi, tình bạn cao quý,'
		R
		'vượt xa quan hệ chủ tớ.'
		\L_01278:
		\L_0126b:
		\L_01225:
		!VAR0516 : 425!
		\L_01217:
		\L_011c3:
		ZH 1:
		'Xin cô đừng nói thế.'
		\L_01278:
		ZH 1:
		'Chuyện này đâu nên nói thành'
		R
		'lời, phải không?'
		\L_01278:
		\L_0126b:
		\L_01225:
		!VAR0516 : 6!
		\L_01217:
		\L_011c3:
		ZH 1:
		'Hì hì... Phải nhỉ.'
		\L_01278:
		\L_0126b:
		\L_01153:
		ZH 1:
		'Maris... Cô phải lòng tên'
		R
		'này rồi à?'
		\L_01278:
		\L_0126b:
		\L_011c3:
		ZH 1:
		'Ôi, Bệ hạ cứ trêu... Hô hô'
		R
		'hô.'
		\L_01278:
		\L_0126b:
		\L_01225:
		!VAR0516 : 425!
		\L_01217:
		\L_011c3:
		ZH 1:
		'Ha ha ha.'
		\L_01278:
		ZH 1:
		'Được người đẹp phải lòng'
		R
		'cũng đâu tệ.'
		\L_01278:
		\L_0126b:
		\L_01153:
		ZH 1:
		'Ta không nhường cho ngươi'
		R
		'đâu.'
		\L_01278:
		\L_0126b:
		\L_011c3:
		ZH 1:
		'Được rồi, được rồi.'
		\L_01278:
		\L_0126b:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
