	!VAR0516 : 1!
	\L_078f8:
	\L_078a4:
	ZH 1:
	'Này, Merim. Có muốn cùng'
	R
	'nhau thám hiểm ngục tối?'
	\L_079d7:
	\L_079ca:
	!VAR0516 : 63!
	\L_07968:
	\L_07914:
	ZH 1:
	'Vâng, xin'
