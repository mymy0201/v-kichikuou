	\L_078a4:
	ZH 1:
	'Một con mèo...?'
	\L_079d7:
	ZH 1:
	'Hãy thử kêu meo meo.'
	\L_079d7:
	\L_079ca:
	\L_07914:
	ZH 1:
	'Meoooo.'
	\L_079d7:
	\L_079ca:
	\L_078a4:
	ZH 1:
	'Được.'
	\L_079d7:
	ZH 1:
	'Vậy ta về đây.'
	\L_079d7:
	\L_079ca:
	\L_07914:
	ZH 1:
	'Meo, meo, meo... ... Meo.'
	\L_079d7:
	\L_079ca:
	\L_078c0:
