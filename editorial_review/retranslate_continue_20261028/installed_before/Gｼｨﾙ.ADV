	\L_0a1b9:
	\L_0a111:
	ZH 1:
	'U-Ừm... Chủ nhân Rance?'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a0a1:
	ZH 1:
	'Em đang làm'
