	\L_0a1c6:
	\L_0a1b9:
	\L_0a111:
	ZH 1:
	'Ừm...'
	\L_0a1c6:
	ZH 1:
	'Đấm nàng.'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a149:
	ZH 1:
	'(pow)'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a0a1:
	ZH 1:
	'À!!'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a149:
	ZH 1:
	'Soul bị vệ sĩ của'
	R
	'bà Gorch đấm vào mặt.'
