	\L_0a111:
	ZH 1:
	'Vâ...'
	\L_0a1c6:
	ZH 1:
	'Vâng, chủ nhân Rance!'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a0a1:
	ZH 1:
	'... Hmph... Ta chỉ mang'
