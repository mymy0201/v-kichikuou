	PF0 VAR0056:
	\L_0a0a1:
	ZH 1:
	'Ừm...'
	\L_0a1c6:
	ZH 1:
	'Hả... Ta ngủ'
	R
	'quên khi nào vậy?hwaa...'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a0d9:
	ZH 1:
	'Rance dụi mắt'
	R
	'và từ từ đứng dậy.'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a0bd:
	ZH 1:
	'Chăn... À, Sill đắp cho'
	R
	'mình à.'
	\L_0a1c6:
	ZH 1:
	'............'
	\L_0a1c6:
	ZH 1:
	'Quả nhiên là thân thể của'
	R
	'em quen thuộc nhất,'
	\L_0a1c6:
	ZH 1:
	'làm tình với em vẫn là'
	R
	'sướng nhất.'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a111:
	ZH 1:
	'Ừm...'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a149:
	ZH 1:
	'Bên cạnh Rance,'
	R
	'Sill đang thở nhẹ trong'
	R
	'giấc ngủ. Cô lăn qua.'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a111:
	ZH 1:
	'Chủ nhân'
	R
	'Rance... Cảm ơn... ngài...'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a0a1:
	ZH 1:
	'Sill?'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a111:
	ZH 1:
	'... Zzz... Zzz...'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a0a1:
	ZH 1:
	'... Nói mớ cũng cảm ơn ta à.'
	R
	'... Đồ ngốc. Không có'
	\L_0a1c6:
	ZH 1:
	'em, ta bất tiện lắm đấy.'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a0d9:
	ZH 1:
	'Rance nghịch tóc của Sill.'
	\L_0a1c6:
	\L_0a1b9:
	\L_0a0bd:
	ZH 1:
	'Nào......'
	\L_0a1c6:
	ZH 1:
	'Phải đi trừng trị kẻ ngu'
	R
	'xuẩn dám biến Sill thành bò'
	R
	'mới được.'
	\L_0a1c6:
	ZH 1:
	'...Thật là... Mình cũng'
	R
	'đoán được là ai rồi...'
	\L_0a1c6:
	ZH 1:
	'Thiệt tình...'
	\L_0a1c6:
	ZH 1:
	'Phải gọi ả ra khỏi hậu'
	R
	'cung rồi trừng phạt cho ra'
	R
	'trò mới được.'
