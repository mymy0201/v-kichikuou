		ZH 1:
		'（ding）'
		\L_0295f:
		ZH 1:
		'Somita dùng nắm'
		R
		'đấm đập vào lòng bàn tay.'
		R
		'đúng vậy. Tôi quên mất...'
		\L_0295f:
		\L_02952:
		\L_0283a:
		ZH 1:
		'Vâng, vì vậy hãy'
		R
		'làm điều đó. Được chứ?'
		\L_0295f:
		\L_02952:
		\L_028aa:
		ZH 1:
		'Ngay bây giờ?'
		\L_0295f:
		\L_02952:
		\L_0283a:
		ZH 1:
		'Vâng.'
		\L_0295f:
		\L_02952:
		\L_028aa:
		ZH 1:
		'Hiểu...'
		\L_0295f:
		ZH 1:
		'Tôi tin rằng trao'
		R
		'tình yêu cho những người'
		R
		'đáng thương là một trong'
		\L_0295f:
		ZH 1:
		'những nhiệm vụ quan'
		R
		'trọng của thiên thần.'
		\L_0295f:
		ZH 1:
		'Đây là lần đầu tiên của'
		R
		'tôi nhưng tôi sẽ cố gắng.'
		\L_0295f:
		\L_02952:
		\L_028e2:
		ZH 1:
		'Somita cúi đầu.'
		\L_0295f:
		\L_02952:
		\L_02856:
		ZH 1:
		'... Không phải là'
		R
		'ta đang cầu xin sự thương'
		R
		'hại hay gì cả, mà thôi kệ.'
		\L_0295f:
		\L_02952:
		\L_0283a:
		ZH 1:
		'Aaaa được rồi!!'
		\L_0295f:
		\L_02952:
		\L_028e2:
		ZH 1:
		'Bên cạnh Rance đang'
		R
		'cởi bỏ quần áo của mình,'
		\L_0295f:
		ZH 1:
		'Somita một cách'
		R
		'thanh lịch tháo chiếc móc'
