	\L_023c9:
	\L_02321:
	ZH 1:
	'Chaos...'
	\L_023d6:
	\L_023c9:
	\L_022e9:
	ZH 1:
	'Nikkou hơi nheo mắt, khiến'
	R
	'Chaos chột dạ.'
	\L_023d6:
	\L_023c9:
	\L_022b1:
	ZH 1:
	'N-Nhưng... Ừm...'
	\L_023d6:
	\L_023c9:
	\L_02313:
	!VAR0516 : 1!
	\L_02305:
	\L_022b1:
	ZH 1:
	'Im đi, đồ kiếm ngu. Sao thế,'
