	\L_023d6:
	\L_023c9:
	\L_02321:
	ZH 1:
	'............'
	\L_023d6:
	\L_023c9:
	\L_0233d:
	ZH 1:
	'Khó xử quá... Mình phải làm'
	R
	'sao đây...'
	\L_023d6:
	\L_023c9:
	\L_022e9:
	ZH 1:
	'Kentarou bối'
	R
	'rối khi xem cuộc tranh cãi'
	R
	'(?) giữa Rance và Chaos.'
	\L_023d6:
	\L_023c9:
	\L_02383:
	!VAR0516 : 34!
	\L_02375:
	\L_02321:
	ZH 1:
	'Hai người đang làm phiền chủ'
	R
	'nhân Kentarou.'
	\L_023d6:
	\L_023c9:
	\L_022b1:
	ZH 1:
	'Ồ, cô Nikkou. Ta mong gặp cô'
	R
	'mãi.'
	\L_023d6:
	\L_023c9:
	\L_02313:
	!VAR0516 : 80!
	\L_02305:
	\L_022b1:
	ZH 1:
	'Chết tiệt. Nếu'
	R
	'Nikkou không để bản kiếm đụ'
	R
	'thì hãy rời đi!'
