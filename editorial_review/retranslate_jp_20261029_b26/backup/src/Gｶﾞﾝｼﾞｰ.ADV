	{VAR0690 = 1:
		\L_0573f:
		ZH 1:
		'Thưa bệ hạ Rance... Thật'
		R
		'mừng khi thấy hôm nay ngài'
		R
		'vẫn mạnh khỏe.'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Ồn quá, đừng cố dùng từ khó'
		R
		'hiểu. Ta không thích kiểu'
		R
		'khách sáo ấy.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Vâng...'
		\L_057f4:
		ZH 1:
		'Vậy ta xin đổi cách nói.'
		\L_057f4:
		ZH 1:
		'Ngài gọi ta có việc gì?'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Chính cái đó. Ta đang thắc'
		R
		'mắc về nó.'
		\L_057f4:
		\L_057e7:
		\L_05707:
		ZH 1:
		'Rance dùng mũi chân chỉ vào'
		R
		'vai Gandhi đang quỳ. Con'
		R
		'chim đó là gì?'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'À, đây là loài chim Mach'
		R
		'Piyo... Nó tên Yashichi.'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Một mach piyo?'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Ta cũng không hiểu rõ tập'
		R
		'tính của chúng.'
		\L_057f4:
		ZH 1:
		'Một hôm đi đường, đang'
		\L_057f4:
		ZH 1:
		'ăn ngoài trời thì có thứ bay'
		R
		'tới.'
		\L_057f4:
		ZH 1:
		'Tưởng ruồi, ta lấy đũa gắp,'
		R
		'hóa ra là Yashichi.'
		\L_057f4:
		ZH 1:
		'（Yashichi） Piyooo!'
		\L_057f4:
		ZH 1:
		'Từ đó nó cứ quấn lấy ta, bay'
		R
		'quanh vai thế này.'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Nó đang đậu trên vai ngươi'
		R
		'đấy thôi.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Không, đó là tàn ảnh.'
		\L_057f4:
		ZH 1:
		'Nghe nói Mach Piyo mà dừng'
		R
		'lại thì sẽ chết, nên'
		\L_057f4:
		ZH 1:
		'nó luôn bay với tốc độ'
		R
		'cao...'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'... Ta hiểu'
		R
		'rồi. Đủ. Biến đi.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Vâng.'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Ồ, và còn một điều nữa.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Vâng, ngài còn điều gì?'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Con chim đó'
		R
		'có ăn được không?'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Chuyện đó thì...'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'............'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'............'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Được rồi, đi đi.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Vâng.'
		\L_057f4:
		\L_057e7:
		\L_057a1:
		\L_05707:
		ZH 1:
		'Gandhi cúi đầu kính cẩn và'
		R
		'rời khỏi phòng tiếp kiến.'
		\L_057f4:
		\L_057e7:
		\L_056eb:
		ZH 1:
		'Vì để ý thứ kỳ quặc ấy mà ta'
		R
		'mất thời gian nghe chuyện vô'
		R
		'nghĩa...'
		\L_057f4:
