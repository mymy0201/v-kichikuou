	\L_0778a:
	\L_076c6:
	ZH 1:
	'Isoroku.'
	\L_077eb:
	\L_077de:
	\L_07736:
	ZH 1:
	'Vâng?'
	\L_077eb:
	\L_077de:
	\L_076c6:
	ZH 1:
	'Có vẻ như em'
	R
	'thực sự cảm thấy rất vui'
	R
	'khi kết thúc trận đấu.'
	\L_077eb:
	\L_077de:
	\L_07736:
	ZH 1:
	'Thiếp-thiếp không có!'
	\L_077eb:
	\L_077de:
	\L_076fe:
	ZH 1:
	'Isoroku đỏ mặt'
	R
	'và nhìn xuống. Toàn thân cô'
	R
	'cứng đờ, hai tay siết chặt.'
	\L_077eb:
	\L_077de:
	\L_076c6:
	ZH 1:
	'Chẳng có gì'
	R
	'đáng phải xấu hổ cả.'
	\L_077eb:
	ZH 1:
	'Cảm thấy tốt'
	R
	'không phải là điều xấu.'
	\L_077eb:
	\L_077de:
	\L_07736:
	ZH 1:
	'Nhưng... thiếp...'
	\L_077eb:
	\L_077de:
	\L_076c6:
	ZH 1:
	'Việc tận hưởng niềm vui sẽ'
	R
	'không ngăn cản em có thai.'
	\L_077eb:
	ZH 1:
	'Em có thể làm cả hai việc'
	R
	'cùng một lúc và hạ gục hai'
	R
	'con chim bằng một hòn đá.'
	\L_077eb:
	ZH 1:
	'Gahahahaha!'
	\L_077eb:
	\L_077de:
	\L_07752:
	ZH 1:
	'Nhưng... Ngài đã'
	R
	'có vợ rồi, Vua Rance.'
	\L_077eb:
	ZH 1:
	'Thiếp sẽ không'
	R
	'làm gì khác ngoài việc chấp'
	R
	'nhận hạt giống của chàng...'
	\L_077eb:
	ZH 1:
	'Thiếp phải làm vậy.'
	\L_077eb:
	\L_077de:
	\L_076c6:
	ZH 1:
	'Isoroku?'
	\L_077eb:
	\L_077de:
	\L_07736:
	ZH 1:
	'Vua Rance, liệu'
	R
	'sau ngày hôm nay thiếp'
	R
	'có mang thai không?'
	\L_077eb:
	\L_077de:
	\L_076c6:
	ZH 1:
	'Không biết.'
	R
	'Hãy hỏi bác sĩ.'
	\L_077eb:
	\L_077de:
	\L_07736:
	ZH 1:
	'Vâng... Cảm ơn chàng.'
	\L_077eb:
	\L_077de:
	\L_07798:
	\L_076fe:
	ZH 1:
	'Isoroku cúi đầu và'
	R
	'rời khỏi phòng ngủ.'
	\L_077eb:
	@L_076af:
*L_064de:
	{VAR0438 < VAR0517 + 4:
		\L_07736:
		ZH 1:
		'Vua Rance...'
		R
		'Đó là Isoroku.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'Ồ, vào đi, vào đi.'
		\L_077eb:
		\L_077de:
		!VAR0516 : 24!
		\L_0778a:
		\L_076fe:
		ZH 1:
		'Cánh cửa'
		R
		'cọt kẹt mở ra. Isoroku'
		R
		'từ từ bước vào phòng.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'... Ồ.'
		\L_077eb:
		\L_077de:
		\L_07736:
		ZH 1:
		'Làm ơn đừng'
		R
		'nhìn nhiều quá...'
		\L_077eb:
		\L_077de:
		\L_076fe:
		ZH 1:
		'Bụng của Isoroku'
		R
		'phồng lên rõ rệt.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'Đ-Nó không thực sự'
		R
		'quan trọng đâu. Dù sao nó'
		R
		'cũng thuộc về tôi một nửa.'
		\L_077eb:
		\L_077de:
		\L_07736:
		ZH 1:
		'Tại hạ xin lỗi... Tại'
		R
		'hạ cũng không có kinh nghiệm'
		R
		'với những việc này, nên...'
		\L_077eb:
		\L_077de:
		\L_076fe:
		ZH 1:
		'Isoroku vội vàng cúi đầu.'
		\L_077eb:
		ZH 1:
		'Chuyển động đó không'
		R
		'còn nhẹ nhàng như cách'
		R
		'nàng di chuyển trước đó.'
		\L_077eb:
		ZH 1:
		'Đó có thể là kết quả của rất'
		R
		'nhiều suy nghĩ của Isoroku'
		R
		'về đứa trẻ bên trong cô.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'Thôi, ngồi xuống đi.'
		\L_077eb:
		\L_077de:
		\L_07736:
		ZH 1:
		'Vâng, xin lỗi.'
		\L_077eb:
		\L_077de:
		\L_076fe:
		ZH 1:
		'Isoroku nhẹ nhàng'
		R
		'ngồi ở mép giường.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'Tôi ngồi cạnh'
		R
		'ngươi có được không?'
		\L_077eb:
		\L_077de:
		\L_07736:
		ZH 1:
		'Không, không hề.'
		\L_077eb:
		\L_077de:
		\L_076fe:
		ZH 1:
		'Rance ngồi'
		R
		'cạnh nàng. Anh nhìn chằm'
		R
		'chằm vào bụng Isoroku.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'Tôi chưa bao giờ'
		R
		'thực sự nghĩ nó sẽ trông'
		R
		'như thế nào... thế này...'
		\L_077eb:
		ZH 1:
		'Bây giờ tôi'
		R
		'cảm thấy khá kỳ lạ khi nhìn'
		R
		'thấy nó trông như thế này.'
		\L_077eb:
		\L_077de:
		\L_07736:
		ZH 1:
		'Xin đừng'
		R
		'lo lắng, đứa trẻ dường'
		R
		'như đang lớn rất nhanh.'
		\L_077eb:
		\L_077de:
		\L_076fe:
		ZH 1:
		'Isoroku mỉm'
		R
		'cười thân thiện với Rance,'
		R
		'rồi nhìn xuống bụng mình.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'Ngươi có phiền nếu'
		R
		'tôi chạm vào nó không?'
		\L_077eb:
		\L_077de:
		\L_07736:
		ZH 1:
		'...'
		\L_077eb:
		ZH 1:
		'Hãy tiếp tục.'
		\L_077eb:
		\L_077de:
		\L_076fe:
		ZH 1:
		'Sau một lúc'
		R
		'do dự, Isoroku trả'
		R
		'lời, má cô hơi đỏ.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'Ừm... ồ. Tôi hiểu rồi.'
		\L_077eb:
		\L_077de:
		\L_076fe:
		ZH 1:
		'Rance xoa xoa, cảm giác hơi'
		R
		'khác so với khi anh thường'
		R
		'chạm vào làn da phụ nữ.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'Vì ngươi mà tôi không'
		R
		'thể làm gì với Isoroku.'
		\L_077eb:
		ZH 1:
		'Nhh. Nhanh lên'
		R
		'và ra khỏi đó.'
		\L_077eb:
		ZH 1:
		'Tại sao một kẻ'
		R
		'tầm thường như ngươi lại có'
		R
		'được Isoroku cho riêng mình?'
		\L_077eb:
		\L_077de:
		\L_07736:
		ZH 1:
		'... Hê.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'Cái gì? Có'
		R
		'gì buồn cười vậy?'
		\L_077eb:
		\L_077de:
		\L_07736:
		ZH 1:
		'Không có gì.'
		\L_077eb:
		\L_077de:
		\L_076c6:
		ZH 1:
		'Ch, tất cả là lỗi của anh!'
		\L_077eb:
		\L_077de:
		\L_076fe:
		ZH 1:
		'Isoroku nhìn và mỉm cười'
		R
		'khi Rance càu nhàu với cơn'
		\L_077eb:
		ZH 1:
		'thịnh nộ thực sự với'
		R
		'đứa trẻ trong bụng cô.'
		\L_077eb:
		@L_076af:
	}
