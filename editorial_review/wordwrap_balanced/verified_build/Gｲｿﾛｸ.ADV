	\L_077de:
	\L_076c6:
	ZH 1:
	'Tôi.'
	\L_077eb:
	\L_077de:
	\L_076fe:
	ZH 1:
	'Rance ưỡn ngực.'
	\L_077eb:
	\L_077de:
