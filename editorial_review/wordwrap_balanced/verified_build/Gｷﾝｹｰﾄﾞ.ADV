	{VAR0000 = 1:
		\L_0119d:
		ZH 1:
		'Kẻ hèn này được'
		R
		'diện kiến tân vương Leazas'
		R
		'thật là vinh hạnh vô cùng.'
		\L_01252:
		\L_01245:
		\L_01165:
		ZH 1:
		'Kinkaid quỳ trước'
		R
		'Rance, cúi gằm đầu.'
		\L_01252:
		\L_01245:
		\L_0112d:
		ZH 1:
		'Ừ. Không cần'
		R
		'khách sáo thế đâu.'
		\L_01252:
		\L_01245:
		\L_0119d:
		ZH 1:
		'Ôi, thần nào xứng'
		R
		'đáng được Bệ hạ ưu ái...!'
		\L_01252:
		\L_01245:
		\L_01165:
		ZH 1:
		'Kinkaid hơi ngẩng đầu'
		R
		'lên, mắt mở to vẻ xúc động.'
		\L_01252:
		\L_01245:
		\L_0119d:
		ZH 1:
		'Chỉ được Bệ hạ sai khiến đã'
		R
		'là phúc phận lớn lao, vậy mà'
		R
		'Bệ hạ còn ban lời vàng ngọc!'
		\L_01252:
		ZH 1:
		'Được nghe giọng nói'
		R
		'tuyệt diệu của Bệ hạ'
		\L_01252:
		ZH 1:
		'thôi cũng đủ khiến'
		R
		'thần lên tận mây xanh...!'
		\L_01252:
		\L_01245:
		\L_0112d:
		ZH 1:
		'N-Này, Kinkaid. Càng nghe'
		R
		'càng quái đản, dừng lại đi.'
		\L_01252:
		\L_01245:
		\L_0119d:
		ZH 1:
		'Dạ... Vậy thưa'
		R
		'Bệ hạ Rance... Bệ hạ'
		R
		'triệu thần có việc gì?'
		\L_01252:
		\L_01245:
		\L_0112d:
		ZH 1:
		'Hừm... Quên rồi.'
		R
		'Chẳng có gì, lui đi.'
		\L_01252:
		\L_01245:
		\L_011b9:
		ZH 1:
		'Chậc, nịnh bợ uổng công...'
		\L_01252:
		\L_01245:
		\L_0112d:
		ZH 1:
		'... Ngươi vừa nghĩ gì đấy?'
		\L_01252:
		\L_01245:
		\L_0119d:
		ZH 1:
