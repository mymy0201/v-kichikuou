	@L_01de1:
*L_01e1f:
	SS VAR0515:
	\L_02343:
	ZH 1:
	'Rance phớt lờ những'
	R
	'gì bà Unga nói và nói'
	R
	'chuyện vui vẻ với bà.'
	\L_02430:
	\L_02423:
	\L_0230b:
	ZH 1:
	'Vậy ngươi nghĩ'
	R
	'sao? Park vẫn đang được'
	R
	'điều hành, thấy không?'
	\L_02430:
	\L_02423:
	\L_0237b:
	ZH 1:
	'Ờ...'
	\L_02430:
	ZH 1:
	'Vâng... Cảm ơn ngươi.'
	\L_02430:
	ZH 1:
	'À, rác rưởi...'
	\L_02430:
	\L_02423:
	\L_023b3:
	ZH 1:
	'Sayori nhặt'
	R
	'một chiếc lon rỗng trên'
	R
	'đường và bỏ vào thùng rác.'
	\L_02430:
	\L_02423:
	\L_0237b:
	ZH 1:
	'Sẽ thật đáng tiếc'
	R
	'nếu một đứa trẻ vấp'
	R
	'phải và bị thương.'
	\L_02430:
	\L_02423:
	\L_023b3:
	ZH 1:
	'Khuôn mặt'
	R
	'của Sayori trở thành khuôn'
	R
	'mặt của giám đốc công viên.'
	\L_02430:
	ZH 1:
	'Khuôn mặt của người mẹ'
	R
	'bình tĩnh tiếp cận mọi việc.'
	\L_02430:
	\L_02423:
	\L_0230b:
	ZH 1:
	'............'
	\L_02430:
	ZH 1:
	'Bà thích trò chơi'
	R
	'nào nhất, bà Unga?'
	\L_02430:
	\L_02423:
	\L_0237b:
	ZH 1:
	'Tất cả đều... Nhưng nếu'
	R
	'tôi phải chọn một, thì đó.'
	\L_02430:
	\L_02423:
	\L_023b3:
	ZH 1:
	'Cô chỉ vào'
	R
	'vòng quay ngựa gỗ.'
	\L_02430:
	\L_02423:
	\L_0237b:
	ZH 1:
	'Khi tôi và chồng'
	R
	'xây dựng công viên này,'
	\L_02430:
	ZH 1:
	'thứ đầu tiên'
	R
	'chúng tôi mua là chiếc'
	R
	'vòng quay ngựa gỗ đó.'
	\L_02430:
	\L_02423:
	\L_0230b:
	ZH 1:
	'Chuyến đi đó'
	R
	'thật khập khiễng...'
	\L_02430:
	ZH 1:
	'Mình sẽ sửa'
	R
	'sang lại để có ngựa gỗ'
	R
	'S&M... Để con gái sướng...'
	\L_02430:
	\L_02423:
	\L_0237b:
	ZH 1:
	'............'
	\L_02430:
	\L_02423:
	\L_023b3:
	ZH 1:
	'Sayori chỉ trích'
	R
	'Rance bằng ánh mắt.'
	\L_02430:
	\L_02423:
	\L_0230b:
	ZH 1:
	'Đừng giận, tôi đùa đấy.'
	\L_02430:
	\L_02423:
	\L_02343:
	ZH 1:
	'Họ đi một vòng'
	R
	'qua M Land và quay'
	R
	'trở lại lâu đài.'
	\L_02430:
	\L_02423:
	!VAR0516 : 0!
	%#M.ADV:
	%0:
*L_020a1:
	{VAR0477 = 1:
		\L_02327:
		ZH 1:
		'Hmmm, tôi cảm'
		R
		'thấy hơi tệ...'
		\L_02430:
		ZH 1:
		'Nhưng tôi còn'
		R
		'chưa làm cô một lần nào cả,'
		R
		'tôi không thể để cô đi được.'
		\L_02430:
		ZH 1:
		'Ít nhất hãy làm tình với cô'
		R
		'một lần, rồi tôi sẽ nghĩ xem'
		R
		'phải làm gì với cô sau đó...'
		\L_02430:
		ZH 1:
		'Nhưng nếu'
		R
		'cô tốt thì tôi không đời'
		R
		'nào để cô đi... Có lẽ...'
		\L_02430:
		\L_02423:
		@L_01e1f:
	}
