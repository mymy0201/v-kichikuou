	\L_03775:
	\L_036b1:
	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Trước bức'
	R
	'tường lâu đài Bên cạnh bức'
	R
	'tường lâu đài khổng lồ,'
	\L_0379e:
	ZH 1:
	'một cái bóng'
	R
	'đang lắng xuống.'
	\L_0379e:
	ZH 1:
	'Nó dao động'
	R
	'một chút. Khoảnh khắc'
	R
	'tiếp theo, nó biến mất.'
	\L_0379e:
	ZH 1:
	'Bức tường cao chót vót'
	R
	'vô dụng trước sinh vật này.'
	\L_0379e:
	ZH 1:
	'Cái bóng tràn vào'
	R
	'lâu đài. Đó là ninja'
	R
	'của NHẬT BẢN, Gekkou.'
	\L_0379e:
	\L_03791:
	!VAR0516 : 421!
	\L_036cd:
	\L_03679:
	ZH 1:
	'Giờ thì...'
	\L_0379e:
	\L_03791:
	Y 4, 2:
	{VAR0000 = 1:
		@L_00a38:
	}
	\L_036b1:
	ZH 1:
	'Gekkou tiến qua lâu đài.'
	R
	'Đôi chân anh chợt khựng lại.'
	\L_0379e:
	\L_03791:
	Y 4, 3:
	!VAR0690 : VAR0000!
	\L_03679:
	{VAR0690 = 1:
		ZH 1:
		'Có vẻ như đây'
		R
		'là nơi quản lý quỹ chiến'
		R
		'tranh của họ... Hoàn hảo.'
		\L_0379e:
		\L_03791:
		\L_036b1:
		ZH 1:
		'Gekkou đã vượt'
		R
		'qua vô số ổ khóa mà'
		R
		'không cần nỗ lực gì.'
		\L_0379e:
		\L_03791:
		\L_03679:
		ZH 1:
		'Để xem... tôi'
		R
		'sẽ lấy một nửa.'
		\L_0379e:
		\L_03791:
		\L_036db:
		\L_036b1:
		ZH 1:
		'Anh ta đã đánh cắp 50%'
		R
		'quỹ chiến tranh và một lần'
		R
		'nữa bỏ đi như một cái bóng.'
		\L_0379e:
		!VAR0519 : VAR0519 / 2!
	}
	{VAR0690 = 2:
		ZH 1:
		'Có vẻ như đây'
		R
		'là nơi quản lý quỹ chiến'
