*L_02ec2:
	!VAR0154 : 5!
	{VAR0102 = 0:
		\L_03791:
		!VAR0516 : 6!
		\L_0373d:
		\L_036e9:
		ZH 1:
		'Đó là tất cả những'
		R
		'gì cậu có thể làm. Chúng'
		R
		'tôi đã bao vây cậu rồi.'
		\L_0379e:
		\L_03791:
		\L_03679:
		ZH 1:
		'Ờ...'
		\L_0379e:
		\L_03791:
		\L_036b1:
		ZH 1:
		'Shinobu nhanh chóng tỉnh'
		R
		'táo và kiểm tra xung quanh.'
		\L_0379e:
		ZH 1:
		'Cô cau có và trừng'
		R
		'mắt nhìn Maris trước mặt.'
		\L_0379e:
		\L_03791:
		\L_036e9:
		ZH 1:
		'Cho dù cậu có được'
		R
		'huấn luyện đặc biệt đến đâu,'
		\L_0379e:
		ZH 1:
		'cậu cũng không thể'
		R
		'làm gì được với nhiều'
		R
		'lính canh như thế này.'
		\L_0379e:
		ZH 1:
		'Chúng tôi cũng'
		R
		'đã có lính canh sẵn ở sân'
		R
		'rồi. Hãy từ bỏ và đầu hàng.'
		\L_0379e:
		\L_03791:
		\L_036b1:
		ZH 1:
		'Hàng chục lính canh'
		R
		'đều chĩa vũ khí vào Shinobu.'
		\L_0379e:
		@L_030c0:
	}
	\L_03791:
	!VAR0516 : 7!
	\L_0373d:
	\L_036e9:
	ZH 1:
	'Cậu không thể thoát khỏi!'
	R
	'Đầu hàng một cách hòa bình!'
	\L_0379e:
	\L_03791:
	\L_03679:
	ZH 1:
	'Cái gì!?'
	\L_0379e:
	\L_03791:
	\L_036b1:
	ZH 1:
	'Shinobu nhanh'
	R
	'chóng lấy lại bình tĩnh'
	R
	'và nhìn xung quanh.'
	\L_0379e:
	ZH 1:
	'Hàng chục vệ binh'
	R
	'hoàng gia của Leazas'
	R
	'đang vây quanh cô.'
	\L_0379e:
	\L_03791:
	\L_036e9:
	ZH 1:
	'Cậu có thể trông giống một'
	R
	'cô bé, nhưng tôi biết cậu là'
	R
	'một kunoichi đã qua đào tạo.'
	\L_0379e:
	ZH 1:
	'Tôi sẽ không mất'
	R
	'cảnh giác. Tốt nhất'
	R
	'là cậu nên từ bỏ.'
	\L_0379e:
	\L_03791:
	\L_036b1:
	ZH 1:
	'Shinobu trừng mắt nhìn'
	R
	'Leila chĩa kiếm vào cô.'
	\L_0379e:
*L_030c0:
	\L_03791:
	\L_036db:
	\L_0374b:
	\L_036b1:
	ZH 1:
	'Một sự im lặng'
	R
	'kỳ lạ và sự căng thẳng'
	R
	'tột độ bao trùm khu vực.'
	\L_0379e:
	ZH 1:
	'Nó bị vỡ bởi tiếng'
	R
	'hét của một người đàn ông.'
	\L_0379e:
	\L_03791:
	\L_03679:
	ZH 1:
	'Shinobu!'
	\L_0379e:
	\L_03791:
	\L_036b1:
	ZH 1:
	'Một cửa sổ bị'
	R
	'vỡ. Những mảnh thủy tinh'
	R
	'vương vãi khắp sàn nhà.'
	\L_0379e:
	\L_03791:
	!VAR0516 : 421!
	\L_036cd:
	\L_036b1:
	ZH 1:
	'Người đàn ông nhảy qua cửa'
	R
	'sổ đáp xuống các mảnh kính'
	R
	'mà không gây ra tiếng động.'
	\L_0379e:
	\L_03791:
	!VAR0516 : 422!
	\L_0373d:
	\L_036e9:
	ZH 1:
	'... Gekkou.'
	\L_0379e:
	!VAR0154 : 5!
	{VAR0102 = 0:
		\L_03791:
		!VAR0516 : 6!
		\L_0373d:
		\L_036e9:
		ZH 1:
		'Cậu đang làm'
		R
		'gì vậy? Bắt chúng!'
		\L_0379e:
		\L_03791:
		\L_036b1:
		ZH 1:
		'Maris ra lệnh cho lính canh,'
		\L_0379e:
		ZH 1:
		'nhưng ánh sáng kỳ'
		R
		'lạ trong mắt Gekkou khiến'
		R
		'họ không thể di chuyển.'
		\L_0379e:
	}
	\L_03791:
	!VAR0516 : 7!
	\L_0373d:
	\L_036e9:
	ZH 1:
	'E-Mọi người,'
	R
	'bắt chúng lại!'
	\L_0379e:
	\L_03791:
	\L_036b1:
	ZH 1:
	'Leila ra lệnh,'
	\L_0379e:
	ZH 1:
	'nhưng tất cả mọi người'
	R
	'bao gồm cả cô đều chùn'
	\L_0379e:
	ZH 1:
	'bước trước ánh sáng'
	R
	'kỳ lạ trong mắt Gekkou.'
	\L_0379e:
	\L_03791:
	!VAR0516 : 422!
	\L_0373d:
	\L_03679:
	ZH 1:
	'Cậu đã sẵn sàng chưa?'
	\L_0379e:
	\L_03791:
	\L_036e9:
	ZH 1:
	'... Ừ. Tôi biết.'
	\L_0379e:
	\L_03791:
	\L_036b1:
	ZH 1:
	'Gekkou mỉm cười'
	R
	'hài lòng trước câu'
	R
	'trả lời của Shinobu.'
	\L_0379e:
	\L_03791:
	\L_03679:
	ZH 1:
	'Chúng ta sẽ'
	R
	'luôn ở bên nhau.'
	\L_0379e:
	\L_03791:
	\L_036b1:
	ZH 1:
	'Lời nói của Gekkou khiến'
	R
	'Shinobu mỉm cười đáp lại.'
	\L_0379e:
	ZH 1:
	'Cả hai đều rút thứ'
	R
	'gì đó có hình dạng giống'
	R
	'một cái ống ra khỏi túi.'
	\L_0379e:
	\L_03791:
	\L_036db:
	\L_0374b:
	!VAR0154 : 5!
	{VAR0102 = 0:
		!VAR0516 : 6!
		\L_0373d:
		\L_036e9:
		ZH 1:
		'Cái gì...?'
		\L_0379e:
		ZH 1:
		'Mọi người hãy ẩn nấp!'
		\L_0379e:
		\L_03791:
		\L_0374b:
		\L_036b1:
		ZH 1:
		'Mọi người đều bị'
		R
		'sốc trước tiếng hét'
		\L_0379e:
		ZH 1:
		'của Maris và điên cuồng'
		R
		'làm theo mệnh lệnh của nàng,'
		\L_0379e:
		ZH 1:
		'ngay khi điều đó xảy ra.'
		\L_0379e:
		ZH 1:
		'KABOOOOOOOOOOOOOOOOM!'
		\L_0379e:
		ZH 1:
		'Âm thanh đinh tai'
		R
		'nhức óc không chỉ'
		\L_0379e:
		ZH 1:
		'làm rung chuyển lâu đài'
		R
		'mà cả khu vực xung quanh.'
		\L_0379e:
		ZH 1:
		'Maris và những người'
		R
		'lính ẩn náu đã bị mưa đá,'
		\L_0379e:
		ZH 1:
		'tro tàn và máu thịt'
		R
		'của hai ninja trút xuống.'
		\L_0379e:
		\L_03791:
		!VAR0516 : 6!
		\L_0373d:
		\L_036e9:
		ZH 1:
		'Có vẻ như thực sự đúng'
		R
		'là các ninja sẽ tự kết'
		\L_0379e:
		ZH 1:
		'liễu đời mình nếu họ'
		R
		'thất bại trong nhiệm vụ...'
		\L_0379e:
		\L_03791:
		\L_036b1:
		ZH 1:
		'Maris, bình'
		R
		'thường cực kỳ điềm tĩnh, tái'
		R
		'nhợt và lau máu trên người.'
		\L_0379e:
		@L_035eb:
	}
	!VAR0516 : 7!
	\L_0373d:
	\L_036e9:
	ZH 1:
	'Đó là... Mọi'
	R
	'người, hãy ẩn nấp!'
	\L_0379e:
	\L_03791:
	\L_0374b:
	\L_036b1:
	ZH 1:
	'Mọi người đều bị'
	R
	'sốc trước tiếng hét'
	\L_0379e:
	ZH 1:
	'của Leila và điên cuồng'
	R
	'làm theo mệnh lệnh của nàng,'
	\L_0379e:
	ZH 1:
	'ngay trước khi nó xảy ra.'
	\L_0379e:
	ZH 1:
	'KABOOOOOOOOOOOOOOOOM!'
	\L_0379e:
	ZH 1:
	'Âm thanh đinh tai'
	R
	'nhức óc không chỉ'
	\L_0379e:
	ZH 1:
	'làm rung chuyển lâu đài'
	R
	'mà cả khu vực xung quanh.'
	\L_0379e:
	ZH 1:
	'Leila và những người'
	R
	'lính ẩn nấp đã bị mưa đá,'
	\L_0379e:
	ZH 1:
	'tro bụi và máu thịt'
	R
	'của hai ninja trút xuống.'
	\L_0379e:
	\L_03791:
	!VAR0516 : 7!
	\L_0373d:
	\L_03705:
	ZH 1:
	'Có vẻ như thực sự đúng'
	R
	'là các ninja sẽ tự kết'
	\L_0379e:
	ZH 1:
	'liễu đời mình nếu họ'
	R
	'thất bại trong nhiệm vụ...'
	\L_0379e:
	\L_03791:
	\L_036b1:
	ZH 1:
	'Khi làn khói tan đi,'
	R
	'Leila nhìn chằm chằm vào chỗ'
	R
	'trống nơi hai ninja đã đứng.'
