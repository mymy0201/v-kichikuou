	'mỏi không có trong'
	R
	'từ điển của ta.'
	\L_032ab:
	ZH 1:
	'Đi thôi,'
	R
	'Rebecca. Hãy đến với ta!'
	\L_032ab:
	\L_0329e:
	\L_031f6:
	ZH 1:
	'... Được'
	R
	'rồi... Ngài Rance...'
