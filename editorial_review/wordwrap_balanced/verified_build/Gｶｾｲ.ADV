	!VAR0690 : VAR0000!
	{VAR0690 = 1:
		\L_043a8:
		ZH 1:
		'Vì vậy, ta đã'
		R
		'tự hỏi về một cái gì đó'
		R
		'trong một thời gian...'
		\L_044cd:
		\L_044c0:
		\L_04418:
		ZH 1:
		'Vâng, nó là gì?'
		\L_044cd:
		\L_044c0:
		\L_043a8:
		ZH 1:
		'Ngươi mua quần'
		R
		'áo như vậy Ở đâu?'
		\L_044cd:
		\L_044c0:
		\L_04418:
		ZH 1:
		'Aah... Cậu đang thắc'
		R
		'mắc về quần áo của tôi à?'
		\L_044cd:
		\L_044c0:
		\L_043a8:
		ZH 1:
		'Vâng, đúng vậy.'
		\L_044cd:
		\L_044c0:
		\L_04418:
		ZH 1:
		'Của tôi...'
		\L_044cd:
		ZH 1:
		'vì vậy,'
		\L_044cd:
		ZH 1:
		'cậu hiểu ý thức thời trang'
