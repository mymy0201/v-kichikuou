	'bằng cơ thể của mình.'
	\L_05219:
	\L_0520c:
	\L_05164:
	ZH 1:
	'Im đi!!'
	\L_05219:
	\L_0520c:
	\L_050f4:
	ZH 1:
	'Aah, còn'
