	'có thể tuyệt vời đến thế.'
	\L_0bb5d:
	ZH 1:
	'Thật sự.'
	\L_0bb5d:
	\L_0bb50:
	\L_0baa8:
	ZH 1:
	'Đó là vì anh ta có cơ'
	R
