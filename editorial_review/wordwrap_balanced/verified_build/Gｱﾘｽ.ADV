	\L_0ba38:
	ZH 1:
	'（Gấu） Rawr rawr.'
	\L_0bb5d:
	ZH 1:
	'... Đã hiểu.'
	\L_0bb5d:
	\L_0bb50:
	\L_0baa8:
	ZH 1:
