	\L_0bb5d:
	\L_0bb50:
	\L_0baa8:
	ZH 1:
	'Họ là ai?'
	\L_0bb5d:
	\L_0bb50:
	\L_0ba38:
	ZH 1:
	'Những người'
	R
	'này không được xếp hạng'
