	\L_0bb5d:
	ZH 1:
	'Tôi làm điều đó'
	R
	'mà không hề suy nghĩ.'
	\L_0bb5d:
	\L_0bb50:
	\L_0baa8:
	ZH 1:
	'Còn các nhân'
