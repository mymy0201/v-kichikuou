	\L_0bb5d:
	\L_0bb50:
	\L_0ba38:
	ZH 1:
	'（Gấu） Raaaaaawr...'
	\L_0bb5d:
	\L_0bb50:
	\L_0ba70:
	ZH 1:
	'Gấu gầm gừ buồn bã...'
	\L_0bb5d:
	\L_0bb50:
	\L_0baa8:
	ZH 1:
	'Ở cạnh một'
