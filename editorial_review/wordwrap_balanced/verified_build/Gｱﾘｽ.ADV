	'ý tưởng một chàng trai ngoài'
	\L_0bb5d:
	ZH 1:
	'tôi bắt một cô gái'
	R
	'làm việc cho anh ta,'
	\L_0bb5d:
	ZH 1:
	'nhưng lại'
	R
	'thích nói chuyện với'
	R
	'một chàng trai hơn.'
	\L_0bb5d:
	ZH 1:
	'Được rồi, tôi'
	R
	'sẽ nghe lời ngươi.'
	\L_0bb5d:
	\L_0bb50:
	\L_0baa8:
	ZH 1:
	'Rất vui được gặp cậu.'
	\L_0bb5d:
	ZH 1:
	'Alice là'
	R
	'Takashi Saeki.21 tuổi.'
	\L_0bb5d:
	ZH 1:
	'Alice làm việc'
	R
	'như một nghệ sĩ CG.'
	\L_0bb5d:
	ZH 1:
	'Thật khó để làm việc'
