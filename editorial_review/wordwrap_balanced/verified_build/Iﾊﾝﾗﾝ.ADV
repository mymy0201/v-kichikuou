	'phí thời gian...'
	\L_02be2:
	ZH 1:
	'Hết cách rồi.'
	R
	'Đành phải làm thôi.'
	\L_02be2:
	ZH 1:
	'Nếu ta nhớ không lầm...'
	\L_02be2:
	ZH 1:
	'Maris đã'
