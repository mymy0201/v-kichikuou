	'người đang đợi chàng kìa,'
	R
	'chàng yêu. Mau lên nào!'
	\L_02be2:
	\L_02bd5:
	\L_02abd:
	ZH 1:
	'Chắc chắn rồi.'
	\L_02be2:
	\L_02bd5:
	\L_02af5:
	ZH 1:
	'Rance và Lia cùng'
