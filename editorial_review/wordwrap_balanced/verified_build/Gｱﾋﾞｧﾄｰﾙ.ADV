	\L_085f4:
	\L_0854c:
	ZH 1:
	'À...'
	\L_08601:
	\L_085f4:
	\L_0853e:
	\L_08514:
	ZH 1:
	'Rance bỏ đi.'
	\L_08601:
	\L_085f4:
	\L_08568:
	ZH 1:
