	'thì họ cũng không thể'
	R
	'chữa khỏi cho nàng...'
	\L_07819:
	\L_0780c:
	\L_07764:
	ZH 1:
	'Không~.'
	\L_07819:
	ZH 1:
	'Nhưng Milli có vẻ cảm'
