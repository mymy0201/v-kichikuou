	\L_04047:
	\L_03ff3:
	ZH 1:
	'Chàng yêu,'
	R
	'thiếp nên kết thúc cuộc'
	R
	'chiến này nhanh chóng đi.'
	\L_040a8:
	\L_0409b:
	\L_03f83:
	ZH 1:
	'Vâng. Ta biết.'
