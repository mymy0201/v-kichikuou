	'Linh Tinh Anh. Camilla.'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b277:
	!VAR0516 : 59!
	\L_0b269:
	\L_0b24d:
	ZH 1:
	'Quý ông quỷ. Sieg.'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b277:
	!VAR0516 : 416!
	\L_0b269:
	\L_0b24d:
	ZH 1:
	'Một trong Tứ'
	R
	'Linh Tinh Anh. Kesselring.'
