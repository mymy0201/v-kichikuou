	\L_0b269:
	\L_0b24d:
	ZH 1:
	'Con quỷ sử'
	R
	'dụng phép thuật mạnh nhất'
	R
	'và điên rồ nhất. Mắt đỏ.'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b277:
	!VAR0516 : 74!
