	\L_0b269:
	PF0 VAR0056:
	\L_0b1dd:
	ZH 1:
	'Hazel đang ngồi'
	R
	'thẫn thờ trên sàn nhà.'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b215:
	ZH 1:
	'Tốt quá, cô'
	R
	'Hawzel. Tôi cảm thấy mình'
	R
	'cũng mạnh mẽ hơn trước.'
	\L_0b2ca:
	ZH 1:
	'Vâng. Tôi cảm thấy'
	R
	'như bây giờ tôi có thể'
	R
	'chiến đấu mạnh mẽ hơn.'
	\L_0b2ca:
	ZH 1:
	'Con quỷ duyên dáng'
	R
	'của chúng ta. Gahahahaha!'
	\L_0b2ca:
	ZH 1:
	'Chúng ta có thể chiến đấu'
	R
	'ngay lập tức. Hãy triệu tập'
	R
	'chúng tôi bất cứ lúc nào.'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b24d:
	ZH 1:
	'Những con quái vật'
	R
	'cười một cách thô tục'
	R
	'khi rời khỏi Hawzel.'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b277:
	\L_0b1a5:
	ZH 1:
	'............'
	\L_0b2ca:
	ZH 1:
	'Ờ...'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b1dd:
	ZH 1:
	'Hazel rùng mình.'
	\L_0b2ca:
	ZH 1:
	'Chất dịch cơ thể'
	R
	'chảy xuống đùi cô.'
	\L_0b2ca:
	ZH 1:
	'Chúng là'
	R
	'chất lỏng mà lũ quái vật'
	R
	'đã tiết ra bên trong cô.'
	\L_0b2ca:
	ZH 1:
	'Dấu vết máu'
	R
	'của cô do mất trinh'
	R
	'cũng có lẫn vào đó.'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b1a5:
	ZH 1:
	'Ờ...'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b1dd:
	ZH 1:
	'Hawzel dùng cả hai tay'
	R
	'che miệng lại để không ai có'
	R
	'thể nghe thấy tiếng cô khóc.'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b1a5:
	ZH 1:
	'Ưu...'
	\L_0b2ca:
	ZH 1:
	'Ờ...'
	\L_0b2ca:
	\L_0b2bd:
	\L_0b1dd:
	ZH 1:
	'Hawzel bắt đầu khóc vì'
	R
	'chất lỏng tràn vào người cô.'
	\L_0b2ca:
	ZH 1:
	'Sau đó cuộc'
	R
	'chiến lại bắt đầu.'
	\L_0b2ca:
