		\L_029f5:
		ZM 32:
		ZH 1:
		'Sào huyệt Sơn tặc'
		\L_02ae2:
		ZM 24:
		ZH 1:
		'Rance đang'
		R
		'đứng tự hào trước một tập'
		R
		'hợp lớn những tên trộm.'
		\L_02ae2:
		ZH 1:
		'được rồi, thời'
		R
		'gian cho một số ăn cắp'
		R
		'nghiêm trọng. Đi thôi.'
		\L_02ae2:
		ZH 1:
		'chúng ta đang'
		R
		'hướng tới các thành phố.'
		\L_02ae2:
		ZH 1:
		'Lấy tất cả mọi thứ từ'
		R
		'những cư dân thành phố sống'
		R
		'cuộc sống vô tư của họ!!'
		\L_02ae2:
		ZH 1:
		'để đáp lại mệnh lệnh Của'
		R
		'Rance, những tên trộm ngày'
		R
		'càng phấn khích và cổ vũ.'
		\L_02ae2:
		\L_02ad5:
	}
	{VAR0329 = 0:
		!VAR0329 : 1!
		!VAR0516 : 0!
		%#M.ADV:
		!VAR0516 : 1008!
		\L_02ab9:
		!VAR0516 : 1!
		\L_02a11:
		\L_029f5:
		ZM 32:
		ZH 1:
		'Sào huyệt Sơn tặc'
		\L_02ae2:
		ZM 24:
		\L_02ad5:
		\L_029bd:
		ZH 1:
		'được rồi, chúng ta'
		R
		'sẽ bắt đầu làm việc ngay bây'
		R
		'giờ! Hiểu chưa, mọi người?!'
		\L_02ae2:
		\L_02ad5:
		\L_02a65:
		ZH 1:
		'Ồ!!'
		\L_02ae2:
		ZH 1:
		'Giọng nói khàn'
		R
		'khàn của nhiều người đàn'
		R
		'ông đồng loạt vang lên.'
		\L_02ae2:
		\L_02ad5:
		\L_029bd:
		ZH 1:
		'Lần này, chúng'
		R
		'ta đang tấn công các thành'
		R
		'phố. Các thành phố có tiền.'
		\L_02ae2:
		\L_02ad5:
		\L_02a65:
		ZH 1:
		'Ồ!!'
		\L_02ae2:
		\L_02ad5:
		\L_029bd:
		ZH 1:
		'Các thành phố có phụ nữ.'
		\L_02ae2:
		\L_02ad5:
		\L_02a65:
		ZH 1:
		'Ồ!'
		\L_02ae2:
		\L_02ad5:
		\L_029bd:
		ZH 1:
		'Tuy nhiên, các thành phố'
		R
		'có hơi nguy hiểm một chút.'
		\L_02ae2:
		\L_02ad5:
		\L_02a65:
		ZH 1:
		'　　.........'
		\L_02ae2:
		\L_02ad5:
		\L_029bd:
		ZH 1:
		'Nhưng mà, cứ sợ mãi'
		R
		'thì chán lắm! Hãy nhìn xem,'
		R
		'ngươi sẽ có ta với ngươi.'
		\L_02ae2:
		ZH 1:
		'Đừng sợ hãi!!'
		\L_02ae2:
		\L_02ad5:
		\L_02a65:
		ZH 1:
		'Ồ!'
		\L_02ae2:
		\L_02ad5:
		\L_029bd:
		ZH 1:
		'Đi thôi!!'
		\L_02ae2:
		\L_02ad5:
		\L_02a65:
		ZH 1:
		'Ồ.'
