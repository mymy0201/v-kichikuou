		'đã giúp đỡ Soul và tôi'
		R
		'khi chúng tôi còn nhỏ.'
		\L_02ae2:
		ZH 1:
		'Ít nhất tôi'
		R
		'muốn bỏ qua chúng...'
		\L_02ae2:
		\L_02ad5:
		\L_029bd:
		ZH 1:
		'Kẻ trộm không nên'
