		\L_02ad5:
		\L_029bd:
		ZH 1:
		'Cái gì?'
		\L_02ae2:
		\L_02ad5:
		\L_02a2d:
		ZH 1:
		'Có một tiệm bánh gần'
		R
		'ngoại ô thành phố này có'
		\L_02ae2:
		ZH 1:
		'một cặp vợ chồng già'
