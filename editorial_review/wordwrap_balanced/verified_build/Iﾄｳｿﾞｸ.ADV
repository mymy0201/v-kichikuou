		\L_02ad5:
		\L_02a2d:
		ZH 1:
		'Nhưng...'
		\L_02ae2:
		\L_02ad5:
		\L_029bd:
		ZH 1:
		'Chà, chú mày có'
		R
		'thể làm gì? Cứ làm việc'
		R
		'theo cách chú mày muốn.'
		\L_02ae2:
		\L_02ad5:
		\L_02a2d:
		ZH 1:
		'Được rồi! Cảm'
