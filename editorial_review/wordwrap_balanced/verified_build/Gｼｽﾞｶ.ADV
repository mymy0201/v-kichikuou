	'aaaaaaaa'
	R
	'aaaaaaaaaaaaaaaaaaaaaaaa'
	\L_049a7:
	ZH 1:
	'aaaaaaaa'
	R
	'aaaaaaaaaaaaaaaaaaaaaaaa'
	R
	'aaaaaaaa'
	\L_049a7:
	ZH 1:
	'aaaaaaaaaaaaaaaaaaaaaaaa'
	R
	'aaaaaaaa aaaaaaaaaaaa!?'
	\L_049a7:
	\L_0499a:
	\L_048ba:
	ZH 1:
	'Tiếng hét của'
	R
	'Rance khi nghe báo cáo'
	R
	'vang vọng khắp lâu đài.'
	\L_049a7:
	\L_0499a:
	\L_04882:
	ZH 1:
	'Tại sao'
	R
	'Shizuka lại rời đi?!!'
	\L_049a7:
	\L_0499a:
	\L_048f2:
	ZH 1:
	'Nàng... Ờ...'
	\L_049a7:
	\L_0499a:
	\L_04954:
	!VAR0516 : 5!
	\L_04946:
	\L_048f2:
	ZH 1:
	'Không có gì to'
	R
	'tát đâu chàng yêu.'
	\L_049a7:
	ZH 1:
	'Ngay cả khi chàng'
	R
	'không có cô nàng tomboy'
	R
	'đó, chàng vẫn có thiếp!'
	\L_049a7:
	\L_0499a:
	\L_04882:
	ZH 1:
	'Chà, nàng là'
	R
	'một trong những người'
	R
	'phụ nữ yêu quý của ta.'
	\L_049a7:
	ZH 1:
	'Ta không thể để nàng đi.'
	\L_049a7:
	ZH 1:
	'Chết tiệt...'
	\L_049a7:
	ZH 1:
	'Ta sẽ tìm'
	R
	'lại nàng, Shizuka.'
	\L_049a7:
	ZH 1:
	'Sau đó chúng ta sẽ làm tình'
	R
	'cho đến khi sự vĩ đại của'
	R
	'ta ăn sâu vào tâm trí nàng!'
