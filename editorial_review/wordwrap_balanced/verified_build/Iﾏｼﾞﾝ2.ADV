	'Rance, Vua của Leazas...'
	R
	'Nếu ai đó giết anh ta...'
	\L_013e4:
	ZH 1:
	'Họ có thể không có'
	R
	'một cuộc sống dễ chịu.'
	\L_013e4:
	\L_013d7:
	\L_0132f:
	ZH 1:
	'Đã hiểu.'
	\L_013e4:
	\L_013d7:
	\L_012bf:
	ZH 1:
	'Đi thôi...'
	R
	'Theo tôi, Hornet.'
	\L_013e4:
	\L_013d7:
	\L_0132f:
	ZH 1:
	'Vâng, thưa Công chúa nhỏ.'
	\L_013e4:
	\L_013d7:
	\L_01321:
	\L_01391:
	\L_013c9:
	\L_012f7:
	ZH 1:
	'Vì vậy,'
	\L_013e4:
	ZH 1:
	'đội quân do Ma Vương'
	R
	'chỉ huy Công chúa nhỏ đã'
	\L_013e4:
	ZH 1:
	'tấn công nhân loại như'
	R
	'một làn sóng dâng cao.'
	\L_013e4:
	ZH 1:
	'Trước sức'
