		\L_032e3:
		ZH 1:
		'Ừ... Ối...'
		\L_03408:
		\L_033fb:
		\L_032ff:
		ZH 1:
		'Tuy nhiên, điều đó'
		R
		'thực sự rất gần...'
		\L_03408:
		ZH 1:
		'Ta đã bị'
		R
		'mắc kẹt một chân trong'
		R
		'một thế giới nguy hiểm.'
		\L_03408:
		ZH 1:
		'Các em gái'
		R
		'chết tiệt, chết tiệt...'
		\L_03408:
		\L_033fb:
		\L_03353:
		ZH 1:
		'Em đãi cậu nhé?'
		\L_03408:
		\L_033fb:
		\L_032ff:
		ZH 1:
		'Nghĩ mà xem...'
		\L_03408:
		\L_033fb:
		\L_0331b:
		ZH 1:
		'Rance nhìn vào'
		R
		'siêu vũ khí của mình.'
		\L_03408:
		ZH 1:
		'Mọi chuyện vẫn'
		R
		'còn khó khăn vì chàng không'
		R
		'thể đạt cực khoái sớm hơn.'
		\L_03408:
		\L_033fb:
		\L_032e3:
		ZH 1:
		'Sill. Hãy'
		R
		'chăm sóc điều này.'
		\L_03408:
		\L_033fb:
		\L_03353:
		ZH 1:
		'Hả...? Kyah.'
		\L_03408:
		\L_033fb:
		\L_0338b:
		ZH 1:
		'Sill ngoảnh mắt'
		R
		'khỏi siêu vũ khí.'
		\L_03408:
		\L_033fb:
		\L_032e3:
		ZH 1:
		'Đừng xấu hổ nữa!'
		R
		'Đi nào, đi thôi!'
		\L_03408:
		\L_033fb:
		\L_03353:
		ZH 1:
		'Kyah... Ngài Rance...!'
