*L_01160:
	!VAR0516 : 381!
	\L_0178b:
	!VAR0516 : 394!
	\L_017fb:
	\L_01753:
	ZH 1:
	'Tôi là một lập trình viên.'
	\L_0185c:
	ZH 1:
	'Hầu hết các phần'
	R
	'của trò chơi có sự'
	\L_0185c:
	ZH 1:
	'tham gia của người chơi'
	R
	'đều là tác phẩm của tôi.'
	\L_0185c:
	ZH 1:
	'Tôi đang trong quá trình'
	R
	'tạo ra thứ gì đó sẽ lập biểu'
	\L_0185c:
	ZH 1:
	'đồ dữ liệu trong suốt'
	R
	'trò chơi từ lợi ích cá nhân.'
	\L_0185c:
	ZH 1:
	'Nghĩ lại'
	R
	'thì tôi vẫn chưa xem'
	R
	'xong bộ phim mở đầu.'
	\L_0185c:
	ZH 1:
	'Ồ vâng, tôi cũng mở đầu.'
	\L_0185c:
	ZH 1:
	'phần mở đầu giải'
	R
	'thích câu chuyện trở lại'
	R
	'khi cậu bắt đầu trò chơi.'
	\L_0185c:
	ZH 1:
	'Và phần mở đầu thực sự gắn'
	R
	'kết các phân đoạn đạo tặc và'
	R
	'quân phản loạn của trò chơi.'
	\L_0185c:
	ZH 1:
	'Nhưng tôi đã quá mải mê'
	R
	'với lợi ích cá nhân của mình'
	\L_0185c:
	ZH 1:
	'và cuối cùng phải xin'
	R
	'lỗi về kịch bản này nhà văn.'
	\L_0185c:
	ZH 1:
	'đó là một cái cớ'
	R
	'tốt để đưa nó đi.'
	\L_0185c:
	ZH 1:
	'Huhu...'
	\L_0185c:
	\L_0184f:
	\L_01809:
