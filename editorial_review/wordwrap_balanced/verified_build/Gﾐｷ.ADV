	\L_06fdd:
	ZH 1:
	'（swoosh）'
	\L_0705a:
	\L_0704d:
	\L_06fa5:
	ZH 1:
	'Wha...? Uah!!'
	\L_0705a:
	\L_0704d:
	\L_06f97:
	!VAR0516 : 54!
	\L_06f89:
	\L_06f35:
	ZH 1:
	'Kentarou!!'
	\L_0705a:
	\L_0704d:
	\L_06fa5:
	ZH 1:
	'Tao ổn!'
	\L_0705a:
	ZH 1:
	'Haa!!'
	\L_0705a:
	\L_0704d:
