	\L_0461f:
	ZM 32:
	ZH 1:
	'Đường núi hẹp'
	\L_0470c:
	ZM 24:
	ZH 1:
	'Lực Lượng Của Redeye đang cố'
	R
	'gắng đi qua dãy núi hẹp để tấn'
	R
	'Công Leazas'
	\L_0470c:
	ZH 1:
	'lãnh thổ.'
	\L_0470c:
	\L_046ff:
	!VAR0158 : 1!
	!VAR0045 : VAR0142!
	!VAR0046 : VAR0143!
