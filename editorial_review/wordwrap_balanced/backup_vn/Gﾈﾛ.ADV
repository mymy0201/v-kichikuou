	\L_00eb5:
	\L_00e99:
	ZH 1:
	'trung tướng đeo kính, Cream'
	R
	'Ganoblade, xuất hiện.'
	\L_00f16:
	\L_00f09:
	\L_00e61:
	ZH 1:
	'Tướng Nero,'
	\L_00f16:
	ZH 1:
	'tôi có kế hoạch ở đây để sử dụng'
