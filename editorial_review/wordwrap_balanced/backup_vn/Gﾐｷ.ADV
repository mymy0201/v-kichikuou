	\L_06c86:
	ZH 1:
	'............'
	\L_06dab:
	\L_06d9e:
	\L_06cbe:
	ZH 1:
	'cô nghĩ rằng cô nhìn thấy khuôn'
	R
	'mặt của Kentarou phản chiếu trên'
	R
	'sông,'
	\L_06dab:
	ZH 1:
	'nhưng nó nhanh chóng biến mất.'
	\L_06dab:
	ZH 1:
	'Đương nhiên rồi.Kentarou đã'
