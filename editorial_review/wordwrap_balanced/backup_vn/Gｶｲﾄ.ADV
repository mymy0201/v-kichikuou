	ZH 1:
	'Zeth'
	R
	ZM 24:
	ZH 1:
	R
	'Làng Xanh'
	\L_022a0:
	ZH 1:
	'Kite quay trở lại ngôi làng bị'
	R
	'con người bỏ rơi.'
	\L_022a0:
