	ZM 24:
	ZH 1:
	R
	'Vườn'
	\L_025a2:
	ZH 1:
	'Rance đang đi dọc theo.'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Khá chắc chắn là người giúp việc'
	R
	'đã nói rằng anh ấy ở quanh đây.'
	\L_025a2:
	\L_02595:
	\L_024b5:
	ZH 1:
	'Rance đang tìm Kiếm Aristoles.'
	\L_025a2:
	\L_02595:
	\L_02525:
	ZH 1:
	'...Đó là một...'
	\L_025a2:
	ZH 1:
	'...Huhu...'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Ừm?'
	\L_025a2:
	\L_02595:
	\L_024b5:
	ZH 1:
	'Anh nghe thấy giọng nói từ phía'
	R
	'trước bồn hoa.'
