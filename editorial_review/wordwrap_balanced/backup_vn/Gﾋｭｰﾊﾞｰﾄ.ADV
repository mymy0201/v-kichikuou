	{VAR0690 = 2:
		!VAR0516 : 0!
		%#M.ADV:
		!VAR0516 : 1046!
		\L_012a6:
		!VAR0516 : 1!
		\L_011fe:
		!VAR0516 : 425!
		\L_0126e:
		\L_011e2:
		ZM 32:
		ZH 1:
		'Lâu đài Leazas'
		R
		ZM 24:
		ZH 1:
		R
		'Phòng yết kiến'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Bạn gọi là Vua của Leazas?'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Vâng, Các Hiệp sĩ Leazas dường'
		R
		'như đang tự hỏi về bạn.'
		\L_012cf:
		ZH 1:
		'họ nghĩ rằng lời nói và hành vi'
		R
		'của bạn không phải là rất hiệp'
		R
		'sĩ.'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Hoooh... Ngạc nhiên là họ thấy'
		R
		'điều đó.'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Người Lạ nổi bật.'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Tôi nghĩ điều tương tự cũng có'
		R
		'thể xảy ra với bạn.'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Cái gì!?'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Tôi muốn sống theo cách của bạn.'
		\L_012cf:
		ZH 1:
		'Đừng xúc phạm, nhưng bạn không'
		R
		'bị ràng buộc bởi bất cứ điều'
		R
		'gì...'
		\L_012cf:
		ZH 1:
		'Dù thế nào đi nữa, bạn trông có'
		R
		'vẻ tự do.'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Hừm.Đoán vậy.Tuy nhiên, điều đó'
		R
		'chỉ có thể thực hiện được nếu'
		R
		'bạn có tài năng như tôi.'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Tôi không phải là kẻ sẽ mạo hiểm'
		R
		'mạng sống của mình vì lòng trung'
		R
		'thành...'
		\L_012cf:
		ZH 1:
		'Không phù hợp để trở thành một'
		R
		'thứ ngu ngốc như một hiệp sĩ.'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 6!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Xin Lỗi để làm gián đoạn,'
		R
		'nhưng...'
		\L_012cf:
		ZH 1:
		'Cách tôi nhìn thấy Nó, Hubert,'
		R
		'Có vẻ Như Patton Không có hiệp'
		R
		'sĩ nào đáng tin cậy hơn bạn.'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 425!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Việc tôi trở thành hiệp sĩ chẳng'
		R
		'liên quan gì cả.'
		\L_012cf:
		ZH 1:
		'chúng tôi chỉ là những người bạn'
		R
		'cũ đã ở bên nhau một thời gian'
		R
		'dài.'
		\L_012cf:
		ZH 1:
		'Tôi không coi anh ta là chúa tể'
		R
		'của mình, và anh ta cũng không'
		R
		'coi tôi là thần dân trung thành.'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 6!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Tôi nghĩ tình bạn vượt xa mối'
		R
		'quan hệ giữa chúa tể và thần'
		R
		'dân.'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 425!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Cắt nó đi, nếu bạn muốn.Đây'
		R
		'không phải là điều tôi có thể'
		R
		'diễn đạt bằng lời,'
		\L_012cf:
		ZH 1:
		'bạn biết không?'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 6!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Huhu... Bạn nói đúng.'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Maris... Bạn đã yêu anh chàng'
		R
		'này chưa?'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Ồ, tất nhiên là không rồi, thưa'
		R
		'Vua... Hohohoh.'
		\L_012cf:
		\L_012c2:
		\L_0127c:
		!VAR0516 : 425!
		\L_0126e:
		\L_0121a:
		ZH 1:
		'Hahahahahahaha.Tôi không cảm'
		R
		'thấy tệ khi có một cô gái hấp'
		R
		'dẫn phải lòng tôi.'
		\L_012cf:
		\L_012c2:
		\L_011aa:
		ZH 1:
		'Dừng lại.'
		\L_012cf:
		\L_012c2:
		\L_0121a:
		ZH 1:
		'Được rồi, được rồi.'
		\L_012cf:
		\L_012c2:
		!VAR0516 : 0!
		%#M.ADV:
		%0:
	}
