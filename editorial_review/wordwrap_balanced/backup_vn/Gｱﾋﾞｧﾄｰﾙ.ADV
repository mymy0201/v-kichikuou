	!VAR0690 : VAR0000!
	{VAR0690 = 1:
		\L_07885:
		ZH 1:
		'Ngài đã gọi à, Vua Rance?'
		\L_0793a:
		\L_0792d:
		\L_07815:
		ZH 1:
		'bạn trông đẹp hơn bao giờ hết.'
		R
		'Tốt!'
		\L_0793a:
		\L_0792d:
		\L_07885:
		ZH 1:
		'Chà... Tôi rất vui. Nhưng tôi có'
		R
		'thể nói rằng bạn đang nói đùa.'
		\L_0793a:
		\L_0792d:
		\L_07815:
		ZH 1:
		'Tôi không đùa đâu, Em thật sự'
		R
		'rất đẹp.'
		\L_0793a:
		\L_0792d:
		\L_07885:
		ZH 1:
		'Dừng lại... Tôi là một người phụ'
		R
		'nữ với một gia đình, 7 năm anh'
		R
		'cả của bạn.'
		\L_0793a:
		\L_0792d:
		\L_07815:
		ZH 1:
		'Bất cứ điều gì, đó là okay.'
		\L_0793a:
		ZH 1:
		'Dù bạn đã kết hôn và lớn tuổi'
		R
		'hơn tôi thì miễn là bạn nóng'
		R
		'bỏng là được.'
		\L_0793a:
		ZH 1:
		'Ngủ Với Tôi, Phi công. Hãy quan'
		R
		'hệ tình dục.'
		\L_0793a:
		\L_0792d:
		\L_07885:
		ZH 1:
		'Trời ạ...'
		\L_0793a:
		ZH 1:
		'Kể cả những trò đùa cũng có giới'
		R
		'hạn của nó, Vua Rance.Tôi có một'
		R
		'người chồng mà tôi quan tâm.'
		\L_0793a:
		ZH 1:
		'cho dù bạn có nghiêm túc hay'
		R
		'không, tôi Sẽ không phản bội anh'
		R
		'ấy.'
		\L_0793a:
		ZH 1:
		'vì vậy, hãy nghĩ về một trò đùa'
		R
		'khác để chào tôi với lần sau.'
		\L_0793a:
		\L_0792d:
		\L_07815:
		ZH 1:
		'Một câu nói đùa để chào hỏi...'
		R
		'Tôi không biết.'
		\L_0793a:
		\L_0792d:
		\L_07885:
		ZH 1:
		'sau đó cố gắng nghĩ ra điều gì'
		R
		'đó. Xin Lỗi, Vua Rance.'
		\L_0793a:
		\L_0792d:
		\L_0784d:
		ZH 1:
		'Aviator nhẹ nhàng gật đầu rồi'
		R
		'rời đi.'
		\L_0793a:
		\L_0792d:
		\L_078e7:
		\L_07815:
		ZH 1:
		'cô ấy khá lạ...'
		\L_0793a:
		ZH 1:
		'Có vẻ như cô ấy sẽ không cố gắng'
		R
		'quyến rũ cô ấy một cách nghiêm'
		R
		'túc. Ch... Khập khiễng.'
		\L_0793a:
		\L_0792d:
