	\L_054d2:
	\L_0547e:
	ZH 1:
	'...Mah... Hakii... Nkereh...'
	\L_055a3:
	\L_05596:
	\L_054b6:
	ZH 1:
	'Giáo hoàng Mulalaloux ở một'
