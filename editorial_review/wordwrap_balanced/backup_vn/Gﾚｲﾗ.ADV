	'và rời khỏi ngai vàng.'
	\L_075ce:
	\L_075c1:
	\L_074a9:
	ZH 1:
	'Nhàm chán, nhàm chán.'
	R
	'Boriiiiiiiiiiii.'
	\L_075ce:
	\L_075c1:
	!VAR0516 : 6!
	\L_0756d:
	\L_07519:
	ZH 1:
	'Ngài luôn nghĩ rằng mình sẽ đạt'
