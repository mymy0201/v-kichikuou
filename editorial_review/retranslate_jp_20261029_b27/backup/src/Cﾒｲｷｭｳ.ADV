	\L_07571:
	ZH 1:
	'Mèo à...?'
	\L_076a4:
	ZH 1:
	'Thử kêu meo một tiếng xem.'
	\L_076a4:
	\L_07697:
	\L_075e1:
	ZH 1:
	'Meooooo.'
	\L_076a4:
	\L_07697:
	\L_07571:
	ZH 1:
	'... Được.'
	\L_076a4:
	ZH 1:
	'Vậy về thôi.'
	\L_076a4:
	\L_07697:
	\L_075e1:
	ZH 1:
	'Meo meo đấy,'
	R
	'meo... ... Meoooo.'
	\L_076a4:
	\L_07697:
	\L_0758d:
	ZH 1:
	'Nhưng chắc có ý nghĩa'
