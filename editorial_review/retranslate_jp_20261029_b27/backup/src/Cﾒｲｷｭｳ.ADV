		R
		'thần, đúng không?'
		\L_076a4:
		ZH 1:
		'Dẫn ta tới đó.'
		\L_076a4:
		\L_07697:
		\L_075e1:
		ZH 1:
		'Vâng... Mời đi lối này.'
		\L_076a4:
		\L_07697:
		\L_075a9:
		ZH 1:
		'Theo Nikkou, Rance bất'
