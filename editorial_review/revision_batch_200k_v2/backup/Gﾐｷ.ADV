	R
	'ta muốn đưa nó vào nhanh,'
	\L_06dab:
	ZH 1:
	'liếm âm hộ'
	R
	'Của Miki khắp nơi.'
	\L_06dab:
	ZH 1:
	'Miki 「Ừm... Uu...」'
	\L_06dab:
	ZH 1:
	'Rance cố gắng từ từ'
