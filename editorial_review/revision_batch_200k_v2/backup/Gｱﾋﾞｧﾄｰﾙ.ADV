	{VAR0690 = 1:
		\L_07885:
		ZH 1:
		'Ngài đã gọi'
		R
		'à, Vua Rance? bạn trông'
		R
		'đẹp hơn bao giờ hết. Tốt!'
		\L_0793a:
		\L_0792d:
		\L_07885:
		ZH 1:
		'Chà... Tôi'
		R
		'rất vui. Nhưng tôi có thể'
		R
		'nói rằng bạn đang nói đùa.'
		\L_0793a:
		\L_0792d:
		\L_07815:
		ZH 1:
		'Tôi không đùa đâu,'
		R
		'Em thật sự rất đẹp.'
		\L_0793a:
		\L_0792d:
		\L_07885:
		ZH 1:
		'Dừng lại... Tôi là'
		R
		'một người phụ nữ với một gia'
		R
		'đình, 7 năm anh cả của bạn.'
		\L_0793a:
		\L_0792d:
		\L_07815:
		ZH 1:
		'Bất cứ điều'
		R
		'gì, đó là okay.'
		\L_0793a:
		ZH 1:
		'Dù bạn đã kết hôn và'
		R
		'lớn tuổi hơn tôi thì miễn'
		R
		'là bạn nóng bỏng là được.'
		\L_0793a:
		ZH 1:
		'Ngủ Với Tôi, Phi'
		R
		'công. Hãy quan hệ tình dục.'
		\L_0793a:
		\L_0792d:
		\L_07885:
		ZH 1:
		'Trời ạ...'
		\L_0793a:
		ZH 1:
		'Kể cả những trò đùa'
		R
		'cũng có giới hạn của nó,'
		\L_0793a:
		ZH 1:
		'Vua Rance.Tôi có một'
		R
		'người chồng mà tôi quan tâm.'
		\L_0793a:
		ZH 1:
		'cho dù bạn có'
		R
		'nghiêm túc hay không, tôi'
		R
		'Sẽ không phản bội anh ấy.'
		\L_0793a:
		ZH 1:
		'vì vậy, hãy'
		R
		'nghĩ về một trò đùa khác'
		R
		'để chào tôi với lần sau.'
		\L_0793a:
		\L_0792d:
		\L_07815:
		ZH 1:
		'Một câu nói đùa để'
		R
		'chào hỏi... Tôi không biết.'
		\L_0793a:
		ZH 1:
		'sau đó cố gắng'
		R
		'nghĩ ra điều gì đó.'
		R
		'Xin Lỗi, Vua Rance.'
		\L_0793a:
		\L_0792d:
		\L_0784d:
		ZH 1:
		'Aviator nhẹ nhàng gật đầu'
		R
		'rồi rời đi. cô ấy khá lạ...'
		\L_0793a:
		ZH 1:
		'Có vẻ như cô ấy sẽ'
		R
		'không cố gắng quyến rũ cô ấy'
		R
		'một cách nghiêm túc. Ch...'
		\L_0793a:
		ZH 1:
		'Khập khiễng.'
		\L_0793a:
