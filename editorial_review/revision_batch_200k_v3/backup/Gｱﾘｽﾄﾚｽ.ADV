	\L_02595:
	\L_024ed:
	ZH 1:
	'Cảm ơn Bạn.'
	\L_025a2:
	ZH 1:
	'Ừm...'
	\L_025a2:
	\L_02595:
	\L_0247d:
	ZH 1:
	'Cái gì, có'
