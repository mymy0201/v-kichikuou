	\L_02bd4:
	\L_02bb8:
	ZM 32:
	ZH 1:
	'Lâu đài Leazas'
	R
	ZM 24:
	ZH 1:
	R
	'Phòng ngủ của Rance'
	R
	'Ừ, tôi muốn đụ Ran...'
	\L_02ca5:
	ZH 1:
	'Tôi không muốn'
	R
	'ép buộc cô ấy,'
	\L_02ca5:
	ZH 1:
	'nhưng có lẽ cô'
	R
	'ấy đã thay đổi ý định.Cũng'
	R
	'có thể thử gọi cho cô ấy.'
	\L_02ca5:
	\L_02c98:
	\L_02bb8:
	ZH 1:
	'Rance ra lệnh'
	R
	'cho ai đó gọi Ran.'
	\L_02ca5:
	\L_02c98:
	!VAR0516 : 66!
	\L_02c44:
	\L_02bb8:
	ZH 1:
	'Chẳng bao'
	R
	'lâu sau, Ran xuất hiện'
	R
	'với vẻ mặt ngơ ngác.'
	\L_02ca5:
	\L_02c98:
	\L_02b80:
	ZH 1:
	'Này.'
	\L_02ca5:
	\L_02c98:
	\L_02bf0:
	ZH 1:
	'Ừm... Tại sao...?'
	\L_02ca5:
	\L_02c98:
	\L_02b80:
	ZH 1:
	'Ồ,'
	\L_02ca5:
	ZH 1:
	'tôi không bắt bạn phải'
	R
	'quan tâm đến tôi hay gì'
	\L_02ca5:
	ZH 1:
	'cả.Tôi chỉ muốn hỏi'
	R
	'liệu bạn có đổi ý không.'
	\L_02ca5:
	\L_02c98:
	\L_02bf0:
	ZH 1:
	'............'
	\L_02ca5:
	\L_02c98:
	\L_02b80:
	ZH 1:
	'Cậu ghét tôi đến vậy sao?'
	\L_02ca5:
	\L_02c98:
	\L_02bf0:
	ZH 1:
	'.........'
	\L_02ca5:
	\L_02c98:
	\L_02c28:
	ZH 1:
	'Ran lắc đầu.'
	\L_02ca5:
	\L_02c98:
	\L_02b80:
	ZH 1:
	'Vậy thì...'
	\L_02ca5:
	\L_02c98:
	\L_02bf0:
	ZH 1:
	'Rance... Tôi coi cậu'
	R
	'như một người bạn...'
	\L_02ca5:
	ZH 1:
	'Bởi vì tôi ghét sự'
	R
	'thiếu quyết đoán của bản'
	\L_02ca5:
	ZH 1:
	'thân nên tôi ngưỡng'
	R
	'mộ tính cách của cậu...'
	\L_02ca5:
	ZH 1:
	'Nhưng tôi nghĩ tình dục'
	R
	'lại là một vấn đề khác...'
	\L_02ca5:
	ZH 1:
	'Tôi chỉ muốn'
	R
	'làm tình với người mà'
	R
	'tôi sẽ gắn bó cả đời…'
	\L_02ca5:
	ZH 1:
	'Có lẽ điều đó đã'
	R
	'lỗi thời, nhưng tôi là vậy.'
	\L_02ca5:
	\L_02c98:
	\L_02b80:
	ZH 1:
	'............'
	\L_02ca5:
	ZH 1:
	'Chà... tôi'
	R
	'chỉ mừng là bạn không'
	R
	'ghét tôi.Ngoài ra...'
	\L_02ca5:
	\L_02c98:
	\L_02bf0:
	ZH 1:
	'Vâng?'
	\L_02ca5:
	\L_02c98:
	\L_02b80:
	ZH 1:
	'Anh sẽ là người đàn'
	R
	'ông bên em suốt cuộc'
	\L_02ca5:
	ZH 1:
	'đời.Không ai có thể'
	R
	'tốt hơn.Thế còn nó thì sao?'
	\L_02ca5:
	\L_02c98:
	\L_02bf0:
	ZH 1:
	'.............'
	\L_02ca5:
	ZH 1:
	'Bạn đã có một người vợ'
	R
	'tốt ở Hoàng hậu Lia rồi...'
	\L_02ca5:
	\L_02c98:
	\L_02b80:
	ZH 1:
	'Aah, đúng'
	R
	'rồi... Tôi quên mất'
	R
	'điều đó.Gahahahahahahahaha.'
	\L_02ca5:
	\L_02c98:
	\L_02bf0:
	ZH 1:
	'Làm sao bạn có'
	R
	'thể quên được điều đó...?'
	\L_02ca5:
	\L_02c98:
	\L_02b80:
	ZH 1:
	'Ờ... Dù sao thì,'
	R
	'thế thôi.Bạn có thể'
	R
	'trở về phòng của bạn.'
	\L_02ca5:
	\L_02c98:
	\L_02bf0:
	ZH 1:
	'Được rồi...'
	R
	'Chúc ngủ ngon...'
	\L_02ca5:
	\L_02c98:
	\L_02b80:
	ZH 1:
	'Ừ, chúc ngủ ngon.'
	\L_02ca5:
	\L_02c98:
	\L_02c52:
	\L_02c28:
	ZH 1:
	'Ran lặng lẽ'
	R
	'rời khỏi phòng Rance.'
	\L_02ca5:
	\L_02c98:
	\L_02b80:
	ZH 1:
	'............'
	\L_02ca5:
	\L_02c98:
	\L_02bb8:
	ZH 1:
	'Rance hơi thất vọng.'
