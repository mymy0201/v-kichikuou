	ZM 24:
	ZH 1:
	R
	'Bầu Trời Phía Trên Một'
	R
	'người đang lơ lửng.Đúng hơn,'
	\L_02e75:
	ZH 1:
	'có thể chính xác hơn'
	R
	'khi nói rằng một sinh vật'
	R
	'hình người đang lơ lửng.'
	\L_02e75:
	\L_02e68:
	!VAR0516 : 445!
	\L_02da4:
	\L_02d50:
	ZH 1:
	'............'
	\L_02e75:
	\L_02e68:
	\L_02d88:
	ZH 1:
	'Đó là quỷ Lôi,'
	\L_02e75:
	ZH 1:
	'một người đàn ông'
	R
	'không thể chạm vào'
	\L_02e75:
	ZH 1:
	'người khác do cơ thể'
	R
	'anh ta liên tục xả điện.'
	\L_02e75:
	ZH 1:
	'Lei nhìn xuống thành phố'
	R
	'sau trận chiến và nhẹ nhàng'
	R
	'đeo găng tay cách điện vào.'
	\L_02e75:
	ZH 1:
	'Đó là một'
	R
	'phong tục mà anh ấy có khi'
	R
	'một trận chiến kết thúc.'
	\L_02e75:
	\L_02e68:
	\L_02d50:
	ZH 1:
	'Hừm...'
	\L_02e75:
	\L_02e68:
	\L_02d88:
	ZH 1:
	'Một nỗi đau như'
	R
	'trái tim anh bị một cái gai'
	R
	'nhỏ đâm xuyên qua người Lei.'
	\L_02e75:
	ZH 1:
	'Anh ấy luôn cảm thấy'
	R
	'như vậy sau một trận chiến.'
	\L_02e75:
	ZH 1:
	'Kể từ khi'
	R
	'anh gặp một người phụ'
	R
	'nữ nào đó.Trước đó,'
	\L_02e75:
	ZH 1:
	'chiến đấu chỉ là một'
	R
	'trò chơi đối với Lei...'
	\L_02e75:
	ZH 1:
	'Anh từng coi việc đánh'
	R
	'nhau là chuyện đương nhiên'
	\L_02e75:
	ZH 1:
	'và không hề hối hận'
	R
	'về việc mình đã đánh nhau.'
	\L_02e75:
	ZH 1:
	'cuộc sống.'
	\L_02e75:
	\L_02e68:
	\L_02d50:
	ZH 1:
	'Đức Maria...'
	\L_02e75:
	\L_02e68:
	\L_02d88:
	ZH 1:
	'Con vật thì thầm,'
	R
	'rồi rời khỏi thành phố.'
