		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'............'
		\L_057f4:
		\L_057e7:
		\L_056cf:
		ZH 1:
		'Được rồi, đi đi.'
		\L_057f4:
		\L_057e7:
		\L_0573f:
		ZH 1:
		'Có.'
		\L_057f4:
		\L_057e7:
		\L_057a1:
		\L_05707:
		ZH 1:
		'Gandhi cúi đầu kính cẩn'
