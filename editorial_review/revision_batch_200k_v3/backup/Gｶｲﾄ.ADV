	\L_021b3:
	ZM 32:
	ZH 1:
	'Zeth'
	R
	ZM 24:
	ZH 1:
	R
	'Cung điện Zeth Hôm'
	R
	'nay Kite lại đứng ở'
	\L_022a0:
	ZH 1:
	'nơi hành quyết công'
	R
	'khai của một đấu trường.'
	\L_022a0:
	ZH 1:
	'Anh ta đang'
	R
	'đối mặt với một thương gia'
	R
	'béo mặc quần áo sang trọng.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Chào... Chào...'
	\L_022a0:
	ZH 1:
	'thương gia đang'
	R
	'khóc trong khi rùng mình và'
	R
	'chỉ một thanh kiếm Vào Diều.'
	\L_022a0:
	ZH 1:
	'Toàn thân anh'
	R
	'ướt đẫm mồ hôi,'
	\L_022a0:
	ZH 1:
	'nước mắt'
	R
	'chảy ra từ mắt anh và có'
	R
	'một ít bọt ở khóe miệng.'
	\L_022a0:
	ZH 1:
	'Kite đã buộc anh ta'
	R
	'phải chiến đấu. có gì sai?'
	R
	'Bạn đã thực hiện tấn công?'
	\L_022a0:
	ZH 1:
	'Tôi vẫn đang đứng.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'P-Xin hãy thương'
	R
	'xót! Tôi đã làm gì?!! bạn'
	R
	'sống trong sự sang trọng.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Hả...?'
	\L_022a0:
	ZH 1:
	'bạn sống trong sự sang'
	R
	'trọng và lấp đầy túi của bạn'
	\L_022a0:
	ZH 1:
	'mà không chăm sóc cho'
	R
	'người bệnh hoặc người nghèo.'
	\L_022a0:
	ZH 1:
	'đây là hình phạt của bạn.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Th-thật nực cười!'
	R
	'Không có những người tồi'
	R
	'tệ hơn tôi?! Tại sao tôi?!!'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Người có bệnh'
	R
	'cũng nói như vậy.Người nghèo'
	R
	'chết cũng thắc mắc điều đó.'
	\L_022a0:
	ZH 1:
	'Và cả những'
	R
	'người mắc bệnh nan y nữa...'
	R
	'điều đó không có ý nghĩa gì!'
	\L_022a0:
	ZH 1:
	'Điều này có liên'
	R
	'quan gì đến tôi?'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Chết đi.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Hả...?'
	\L_022a0:
	\L_02293:
	\L_021b3:
	ZH 1:
	'Diều một tay ôm đầu'
	R
	'người đàn ông và siết chặt.'
	\L_022a0:
	ZH 1:
	'âm thanh của'
	R
	'thịt và xương bị đập vỡ'
	R
	'lan truyền khắp khu vực.'
	\L_022a0:
	ZH 1:
	'Máu và não'
	R
	'bay như trái chín.'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'............'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Người Dân'
	R
	'Zeth được lệnh phải xem đã'
	R
	'làm như vậy trong im lặng.'
	\L_022a0:
	ZH 1:
	'họ run lên vì sợ hãi và'
	R
	'sợ rằng họ có thể là người'
	R
	'tiếp theo như họ đã làm...'
