	ZM 32:
	ZH 1:
	'Zeth'
	R
	ZM 24:
	ZH 1:
	R
	'Làng Xanh Diều đang'
	R
	'đứng ở lối vào Làng Xanh'
	R
	'nhìn vào làng phong cảnh.'
	\L_022a0:
	\L_02293:
	!VAR0516 : 57!
	\L_0223f:
	\L_021eb:
	ZH 1:
	'Diều...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Aah... Calo?'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calory đã đứng cạnh'
	R
	'Kite và nhìn chằm chằm'
	\L_022a0:
	ZH 1:
	'vào anh ấy một lúc'
	R
	'mà anh ấy không để ý.'
	\L_022a0:
	ZH 1:
	'có gì sai? Có'
	R
	'chuyện gì xảy ra không?'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Không... tôi'
	R
	'chỉ đang tìm...'
	\L_022a0:
	ZH 1:
	'Tôi rất vui'
	R
	'vì có những cơ sở có'
	R
	'thể sinh sống ở đây.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Tôi...'
	\L_022a0:
	ZH 1:
	'tôi rất biết ơn cậu,'
	\L_022a0:
	ZH 1:
	'Kite.Chúng tôi bị'
	R
	'con người bỏ rơi nhưng bạn'
	R
	'vẫn rất tốt với chúng tôi...'
	\L_022a0:
	ZH 1:
	'Ngoài ra... tôi...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Nó là gì?'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'À...'
	\L_022a0:
	\L_02293:
	\L_021b3:
	ZH 1:
	'Calory đỏ mặt khi Kite'
	R
	'đột nhiên nhìn vào mặt cô.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'K-Không... tôi...'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calory bối'
	R
	'rối và ngã xuống.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Kyah...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Calo!'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Kite đỡ cú ngã'
	R
	'của mình bằng một tay.Cô'
	R
	'đang dựa vào ngực anh.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'À...'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calo càng đỏ mặt hơn.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'T-tôi xin lỗi!Ôi,'
	R
	'tôi đang làm gì vậy...?'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Bạn không cần'
	R
	'phải bối rối như vậy.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Y-bạn nói'
	R
	'đúng... Ôi, tôi...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Calo.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Y-Có?!'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Tôi sẽ làm tất cả những gì'
	R
	'có thể, nên... Đừng nghĩ đến'
	R
	'việc tự kết liễu đời mình.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'...Được rồi...'
	\L_022a0:
	ZH 1:
	'Nếu đó là điều'
	R
	'cậu muốn, Kite... tôi hứa.'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'...Cảm ơn...'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Kite và Calory tiếp'
	R
	'tục quan sát Làng Xanh.'
	\L_022a0:
	\L_02293:
	\L_02207:
	ZH 1:
	'Ước gì thời gian'
	R
	'ngừng lại ngay lúc này...'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calory nhẹ nhàng nắm'
	R
	'lấy ngón trỏ của Kite.'
