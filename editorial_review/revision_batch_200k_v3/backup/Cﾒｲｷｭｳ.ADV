	ZH 1:
	'Khiêu vũ.'
	\L_076a4:
	\L_07697:
	\L_075e1:
	ZH 1:
	'Hả??'
	\L_076a4:
	\L_07697:
	\L_07571:
	ZH 1:
	'Khi cánh cửa'
