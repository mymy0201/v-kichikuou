	!VAR0160 : 11!
	{VAR0150 = 100:
		\L_075e1:
		ZH 1:
		'Lượng tuyết'
		R
		'rơi lớn ở đây khiến việc'
		R
		'này trở nên rất nguy hiểm,'
		\L_076a4:
		ZH 1:
		'nhưng nhờ vào'
		R
