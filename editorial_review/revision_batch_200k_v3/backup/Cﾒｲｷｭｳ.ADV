		\L_076a4:
		\L_07697:
		\L_07571:
		ZH 1:
		'Được rồi, mhm.'
		\L_076a4:
		\L_07697:
	}
	{VAR0150 = 0:
		\L_075e1:
		ZH 1:
		'Vua Rance, ngài có'
