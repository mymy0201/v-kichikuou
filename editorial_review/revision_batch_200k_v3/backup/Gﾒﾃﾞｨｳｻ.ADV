	\L_029ca:
	\L_02922:
	ZH 1:
	'Hả!?'
	\L_029d7:
	\L_029ca:
	\L_028b2:
	ZH 1:
	'Tôi xong'
	R
	'rồi.Đi thôi, Alefgard.'
	\L_029d7:
	\L_029ca:
	\L_02922:
	ZH 1:
	'Hả... Đã rồi à?'
	\L_029d7:
	\L_029ca:
	\L_028b2:
	ZH 1:
	'Vâng.'
	\L_029d7:
	\L_029ca:
	\L_02922:
	ZH 1:
	'Uh... Ừm... bạn'
