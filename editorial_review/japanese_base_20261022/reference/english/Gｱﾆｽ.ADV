	R
	'Mgh, the enemy country!!'
	R
	'Take this!!'
	R
	'White Destruction...'
	\L_03431:
	\L_03424:
	\L_0337c:
	ZH 1:
	'I told you to stop!!'
	R
	'Lightning!!'
	\L_03431:
	\L_03424:
	\L_03344:
	ZH 1:
	'  ＜kaboooooooooom!＞'
	\L_03431:
	ZH 1:
