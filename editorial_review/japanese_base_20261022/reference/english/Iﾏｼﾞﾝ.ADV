	'herself.'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a43b:
	ZH 1:
	'But...'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a49d:
	!VAR0516 : 429!
	\L_0a48f:
	\L_0a43b:
	ZH 1:
