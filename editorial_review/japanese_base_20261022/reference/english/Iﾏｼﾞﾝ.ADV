	ZH 1:
	'Until then...'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a43b:
	ZH 1:
	'Ms. Hornet...'
	\L_0a4f0:
	\L_0a4e3:
	\L_0a473:
	ZH 1:
