	ZH 1:
	'It’s rumored to have 1000'
	R
	'floors.'
	\L_076a4:
	\L_07697:
	\L_07571:
	ZH 1:
	'Hmmmm.'
	\L_076a4:
	\L_07697:
	{VAR0101 = 1:
