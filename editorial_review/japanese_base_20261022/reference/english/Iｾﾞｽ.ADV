	\L_077e4:
	\L_0773c:
	ZH 1:
	'Thanks.'
	R
	'It’s beautiful...'
	\L_077f1:
	\L_077e4:
	\L_076cc:
	ZH 1:
	'Yeah...'
	\L_077f1:
	\L_077e4:
	\L_07704:
	ZH 1:
	'Uspira brought her face close'
	R
