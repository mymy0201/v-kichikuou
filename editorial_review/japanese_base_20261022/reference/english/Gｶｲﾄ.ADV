	ZH 1:
	'...Did she pass away...?'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calory sobbed uncontrollably'
	R
	'while she nodded.'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Did she pass on peacefully?'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calory shook her head.'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Then...'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
