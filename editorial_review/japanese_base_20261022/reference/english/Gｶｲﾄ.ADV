	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Lyla... Lylaaa!'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'The sickest girl that couldn’t'
