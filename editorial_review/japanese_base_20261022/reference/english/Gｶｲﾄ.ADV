	\L_02293:
	\L_021eb:
	ZH 1:
	'N-No... I...'
	\L_022a0:
	\L_02293:
	\L_02223:
	ZH 1:
	'Calory was flustered and fell'
	R
	'over.'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'Kyah...'
	\L_022a0:
	\L_02293:
	\L_0217b:
	ZH 1:
	'Calory!'
