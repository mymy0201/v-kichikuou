	\L_0217b:
	ZH 1:
	'What...?'
	\L_022a0:
	\L_02293:
	\L_021eb:
	ZH 1:
	'She committed suicide...'
	R
	'Just a moment ago...'
	\L_022a0:
	ZH 1:
	'She said she remembered when'
	R
	'she caught greening disease...'
	\L_022a0:
	ZH 1:
	'How her own parents looked at'
