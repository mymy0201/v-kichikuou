	ZH 1:
	'Uh... Eheheh.'
	\L_01287:
	\L_0127a:
	\L_0119a:
	ZH 1:
	'Kayblis awkwardly scratched'
	R
	'his head and grinned in'
	R
	'embarrassment.'
