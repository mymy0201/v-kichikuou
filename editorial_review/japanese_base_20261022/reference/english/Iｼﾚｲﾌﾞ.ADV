	\L_0519d:
	\L_05190:
	\L_05078:
	ZH 1:
	'You’d just get in the way, kid.'
	\L_0519d:
	\L_05190:
	\L_050e8:
	ZH 1:
	'Heeey, that’s mean.'
	R
	'Fine, then. I’ll use phantom'
	R
	'beasts for my unit.'
	\L_0519d:
