	\L_0519d:
	\L_05190:
	\L_050e8:
	ZH 1:
	'Okay, okay.'
	R
	'Am I handling regular'
	R
	'soldiers?'
	\L_0519d:
	\L_05190:
	\L_05078:
	ZH 1:
	'That’s right. Don’t make it so'
